{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ip-transit.html",
      "destination": "/ip-transit",
      "permanent": true
    },
    {
      "source": "/cloud-connectivity.html",
      "destination": "/cloud-connectivity",
      "permanent": true
    },
    {
      "source": "/colocation.html",
      "destination": "/colocation",
      "permanent": true
    },
    {
      "source": "/ddos-protection.html",
      "destination": "/ddos-protection",
      "permanent": true
    },
    {
      "source": "/managed-noc.html",
      "destination": "/managed-noc",
      "permanent": true
    },
    {
      "source": "/wavelengths.html",
      "destination": "/wavelengths",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
