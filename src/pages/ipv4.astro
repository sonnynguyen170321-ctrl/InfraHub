---
// src/pages/ipv4.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="IPv4 Address Sourcing & Leasing (/24-/20) | InfraHub"
  description="Source clean, pre-checked IPv4 address blocks for carrier-grade NAT, bare-metal hosting, and ISP expansion. RPKI ROA validation with verified clean reputation."
  canonicalPath="/ipv4"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">Numbering Resources</span>
          <span class="pill-badge badge-teal">Partner Sourced</span>
        </div>
        <h1 class="service-title">IPv4 Address Sourcing & Leasing</h1>
        <p class="service-lead">
          Secure clean, ready-to-announce IPv4 subnets (/24 to /18) across RIPE NCC, ARIN, and APNIC regions. We facilitate lease contracts, transfer brokerage, RPKI ROA signing, and Letter of Authorization (LOA) delivery.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=ipv4" class="btn btn-accent btn-lg">Request IPv4 Allocation</a>
        </div>
      </div>

      <div class="content-section">
        <span class="section-sub-tag">Addressing Options</span>
        <h2>Leasing vs Permanent Transfer</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <h3>IPv4 Leasing (OpEx)</h3>
            <p>Flexible month-to-month or annual leases without tying up millions in capital. Immediate LOA and RPKI authorization to announce on your ASN.</p>
          </div>
          <div class="problem-card">
            <h3>Direct Transfer (CapEx)</h3>
            <p>Permanent ownership transfer through official RIR mechanisms (RIPE, ARIN, APNIC) with verified chain-of-custody and zero lien encumbrances.</p>
          </div>
          <div class="problem-card">
            <h3>Reputation & Blacklist Check</h3>
            <p>Every IP block undergoes rigorous reputation checks (Spamhaus, SURBL, Barracuda) before delivery to ensure clean mail and web deliverability.</p>
          </div>
        </div>
      </div>

      <div class="service-footer-cta">
        <h2>Secure IPv4 Subnets for Your Network</h2>
        <a href="/lets-talk?service=ipv4" class="btn btn-accent btn-lg">Consult an IPv4 Specialist</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container { max-width: 1040px; }
  .service-header { text-align: left; max-width: 860px; margin: 0 0 64px; padding-bottom: 24px; border-bottom: 1px solid var(--border-color); }
  .header-badge-row { display: flex; justify-content: flex-start; gap: 8px; margin-bottom: 16px; }
  .service-title { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 20px; }
  .service-lead { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 32px; }
  .service-hero-actions { display: flex; justify-content: center; gap: 14px; }
  .content-section { margin-bottom: 72px; }
  .section-sub-tag { display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent-blue); margin-bottom: 8px; }
  .content-section h2 { font-size: 1.85rem; font-weight: 700; margin-bottom: 18px; }
  .problem-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }
  .problem-card { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; }
  .problem-card h3 { font-size: 1.1rem; margin-bottom: 10px; color: var(--text-primary); }
  .problem-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
  .service-footer-cta { padding: 40px 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 16px; border-top: 1px solid var(--border-color); }
</style>
