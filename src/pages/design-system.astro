---
// src/pages/design-system.astro
// Phase 6 Master Plan §27 Design System Sandbox & Architecture Showcase
import Layout from '../layouts/Layout.astro';

const colorSwatches = [
  { name: 'Deep Bedrock', hex: '#050811', role: 'Base 1000 / Deepest Contrast Layer', textLight: true },
  { name: 'Midnight Slate', hex: '#0b1120', role: 'Base 950 / Master Terminal Canvas', textLight: true },
  { name: 'Infrastructure Cobalt', hex: '#2563eb', role: 'Signal Primary / Core Conduit Actions', textLight: true },
  { name: 'Electric Sky', hex: '#38bdf8', role: 'Convergence Cyan / Telemetry & Kickers', textLight: false },
  { name: 'Mineral White', hex: '#f8fafc', role: 'Paper Light / Editorial Typography', textLight: false },
  { name: 'Metric Amber', hex: '#f59e0b', role: 'Diagnostic Alert / SPOF & Route Flaps', textLight: false },
  { name: 'Slate Hairline', hex: '#1e293b', role: 'Structural Dividers & Coordinate Grids', textLight: true }
];

const sampleLedgerItems = [
  { asn: 'AS13335', entity: 'Cloudflare Transit Interconnect', latency: '4.2ms', status: 'DIVERSE' },
  { asn: 'AS15169', entity: 'Google Cloud Direct Peering', latency: '8.7ms', status: 'DIVERSE' },
  { asn: 'AS6939', entity: 'Hurricane Electric Global Transit', latency: '14.1ms', status: 'SHARED_CONDUIT' }
];
---

<Layout
  title="InfraHub Design System — Technical Architecture & Primitives"
  description="Master design system sandbox and component reference for InfraHub $50,000 infrastructure brand."
  canonicalPath="/design-system"
>
  <div class="design-system-page">
    
    <!-- Hero Header -->
    <section class="section section-bedrock blueprint-grid">
      <div class="container">
        <div class="technical-kicker">INFRASTRUCTURE FIELD GUIDE • SPECIFICATION V2.0</div>
        <h1 class="ds-title">InfraHub Design System</h1>
        <p class="ds-lead">
          The verified token architecture, typography hierarchy, architectural ledger components, and surface contrast rules governing the $50,000 InfraHub brand redesign.
        </p>
        <div class="ds-meta-bar">
          <span class="telemetry-badge telemetry-badge-sky">GRID: 32PX MASTER</span>
          <span class="telemetry-badge">WCAG 2.2 AAA VERIFIED</span>
          <span class="telemetry-badge telemetry-badge-amber">ZERO AI SLOP GUARDRAIL</span>
        </div>
      </div>
    </section>

    <!-- 1. Color Palette Tokens -->
    <section class="section section-midnight">
      <div class="container">
        <div class="technical-kicker">01 • CHROMATIC SYSTEM</div>
        <h2>Canonical Brand Tokens</h2>
        <p class="ds-section-sub">
          High-assurance telemetry palette engineered for readability on optical displays and laser engraving survival.
        </p>

        <div class="swatch-grid">
          {colorSwatches.map((s) => (
            <div class="swatch-card" style={`background-color: ${s.hex}; color: ${s.textLight ? '#f8fafc' : '#0b1120'};`}>
              <div class="swatch-name">{s.name}</div>
              <div class="swatch-hex font-mono">{s.hex}</div>
              <div class="swatch-role">{s.role}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 2. Typography & Telemetry -->
    <section class="section section-bedrock">
      <div class="container">
        <div class="technical-kicker">02 • TYPOGRAPHIC HIERARCHY</div>
        <h2>Swiss Editorial Meets Network Telemetry</h2>
        <p class="ds-section-sub">
          Pairing IBM Plex Sans for editorial clarity with IBM Plex Mono for physical conduit measurements.
        </p>

        <div class="type-specimen-deck">
          <div class="type-row">
            <div class="type-label font-mono">H1 / 56px / 1.15</div>
            <div class="type-sample">
              <div class="sample-h1" style="font-size: 2.75rem; font-weight: 700; line-height: 1.15; margin: 0;">Direct Wholesale Connectivity</div>
            </div>
          </div>

          <div class="type-row">
            <div class="type-label font-mono">H2 / 36px / 1.25</div>
            <div class="type-sample">
              <div class="sample-h2" style="font-size: 2rem; font-weight: 700; line-height: 1.25; margin: 0;">Logical Diversity Does Not Equal Physical Diversity</div>
            </div>
          </div>

          <div class="type-row">
            <div class="type-label font-mono">Mono / 14px / 1.5</div>
            <div class="type-sample font-mono">
              BGP_CONVERGENCE_DELTA: +14.2ms | SPOF_LOCATION: MILE_MARKER_42.1 | RISK_INDEX: 73/100
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Button Primitives -->
    <section class="section section-midnight">
      <div class="container">
        <div class="technical-kicker">03 • INTERACTION PRIMITIVES</div>
        <h2>Button Hierarchy & State Control</h2>
        <p class="ds-section-sub">
          Single-action discipline: primary actions anchor in solid Cobalt, secondary in precision blueprint outlines.
        </p>

        <div class="button-showcase">
          <button type="button" class="btn btn-cobalt">
            Initiate Technical Scoping &rarr;
          </button>
          <button type="button" class="btn btn-blueprint">
            Inspect Topology Model
          </button>
          <button type="button" class="btn btn-secondary" style="color: #f8fafc; border-color: rgba(255,255,255,0.2);">
            View Verified Partners
          </button>
        </div>
      </div>
    </section>

    <!-- 4. Architectural Ledger -->
    <section class="section section-bedrock">
      <div class="container">
        <div class="technical-kicker">04 • ARCHITECTURAL LEDGER</div>
        <h2>Systematic Matrix & Telemetry Rows</h2>
        <p class="ds-section-sub">
          Replacing equal-card grids with disciplined hairline ledgers for technical authority.
        </p>

        <div class="architectural-ledger">
          {sampleLedgerItems.map((item) => (
            <div class="ledger-row">
              <div class="ledger-meta">
                <span class="telemetry-badge font-mono">{item.asn}</span>
                <span class="ledger-title">{item.entity}</span>
              </div>
              <div class="ledger-status">
                <span class="font-mono latency-value">{item.latency}</span>
                <span class={item.status === 'SHARED_CONDUIT' ? 'telemetry-badge telemetry-badge-amber' : 'telemetry-badge telemetry-badge-sky'}>
                  {item.status}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .design-system-page {
    background-color: var(--color-bedrock);
    color: var(--color-paper);
  }

  .ds-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .ds-lead {
    font-size: 1.25rem;
    color: var(--text-on-dark-muted);
    max-width: 65ch;
    margin-bottom: 32px;
  }

  .ds-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ds-section-sub {
    font-size: 1.05rem;
    color: var(--text-on-dark-muted);
    margin-bottom: 40px;
    max-width: 60ch;
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }

  .swatch-card {
    padding: 24px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    min-height: 140px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .swatch-name {
    font-weight: 700;
    font-size: 1.1rem;
  }

  .swatch-hex {
    font-size: 0.85rem;
  }

  .swatch-role {
    font-size: 0.75rem;
  }

  .type-specimen-deck {
    border-top: 1px solid var(--color-slate-border);
  }

  .type-row {
    padding: 24px 0;
    border-bottom: 1px solid var(--color-hairline);
    display: grid;
    grid-template-columns: 200px 1fr;
    align-items: baseline;
    gap: 24px;
  }

  .type-label {
    font-size: 0.8rem;
    color: var(--color-sky);
  }

  .button-showcase {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .ledger-meta {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ledger-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-paper);
  }

  .ledger-status {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .latency-value {
    color: var(--color-sky);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .type-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .ds-title {
      font-size: 2.25rem;
    }
    .ledger-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
