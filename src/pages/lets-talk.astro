---
// src/pages/lets-talk.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Let's Talk Infrastructure  -  Technical Sourcing & Qualification"
  description="Discuss your infrastructure, connectivity, cloud, security, or hardware requirements with our technical sourcing architects."
  canonicalPath="/lets-talk"
>
  <div class="section section-hero network-overlay">
    <div class="container talk-container">
      <!-- Left Column: Context & Guidelines -->
      <div class="talk-intro">
        <span class="pill-badge badge-blue">Direct Qualification</span>
        <h1 class="talk-title">Tell us what you're trying to build.</h1>
        <p class="talk-sub">
          You don't need an exact part number or provider decided. Start with your technical constraints, budget, and geographic goals  -  our architects will map suitable specialist providers.
        </p>

        <div class="qualification-card">
          <h2 class="qual-heading">What happens after you submit:</h2>
          <ul class="qual-steps">
            <li>
              <span class="step-badge">1</span>
              <div>
                <strong>Architect Review</strong>
                <p>We review your technical requirements, latency needs, and commercial criteria.</p>
              </div>
            </li>
            <li>
              <span class="step-badge">2</span>
              <div>
                <strong>Ecosystem Evaluation</strong>
                <p>We match 2-3 vetted specialist providers capable of delivering the solution.</p>
              </div>
            </li>
            <li>
              <span class="step-badge">3</span>
              <div>
                <strong>Direct Introduction</strong>
                <p>We introduce you directly to the engineering team for contracting and implementation.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="commercial-callout">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
          <p>
            <strong>Zero Additional Fees:</strong> InfraHub is compensated by our participating partners. Sourcing through InfraHub never adds fees or markups to your provider invoices.
          </p>
        </div>
      </div>

      <!-- Right Column: Qualification Form -->
      <div class="talk-form-card">
        <form id="inquiry-form" class="qualification-form" novalidate>
          <div id="form-error-alert" class="form-alert alert-error" style="display: none;" role="alert"></div>
          
          <!-- Hidden Context Inputs -->
          <input type="hidden" name="sourcePage" id="context-source-page" value="/lets-talk" />
          <input type="hidden" name="serviceParam" id="context-service" value="" />
          <input type="hidden" name="partnerParam" id="context-partner" value="" />
          <input type="hidden" name="offerSlug" id="context-offer" value="" />
          <input type="hidden" name="utmSource" id="context-utm-source" value="" />
          <input type="hidden" name="utmCampaign" id="context-utm-campaign" value="" />

          <!-- Context Pill (if arriving from an offer/partner) -->
          <div id="context-badge-wrap" class="context-badge-wrap" style="display: none;">
            <span class="pill-badge badge-teal" id="context-badge-text">Inquiring about: ...</span>
          </div>

          <!-- Question 1: What are you looking for? -->
          <div class="form-group">
            <label for="lookingFor" class="form-label">What are you looking for? <span class="required">*</span></label>
            <select name="lookingFor" id="lookingFor" class="form-select" required>
              <option value="" disabled selected>Select an infrastructure area...</option>
              <option value="hardware">Hardware & Servers (Buy / Refurbished)</option>
              <option value="dedicated-infrastructure">Dedicated Infrastructure & Bare Metal</option>
              <option value="cloud">Cloud & Virtualization (Private Cloud / VMware Alt)</option>
              <option value="connectivity">Connectivity & IP Transit (10G-400G / Wavelengths)</option>
              <option value="ddos-security">DDoS Protection & Detection (FastNetMon / BGP)</option>
              <option value="cybersecurity">Cybersecurity & Network Audit</option>
              <option value="managed-services">Managed Services & 24/7 NOC</option>
              <option value="ipv4">IPv4 Sourcing & Leasing</option>
              <option value="other">Other Infrastructure Requirement</option>
            </select>
          </div>

          <!-- Question 2: Target Location -->
          <div class="form-group">
            <label for="targetLocation" class="form-label">Target Location / Datacenter</label>
            <input 
              type="text" 
              name="targetLocation" 
              id="targetLocation" 
              class="form-input" 
              placeholder="e.g. Frankfurt, London, Singapore, Equinix, Interxion, etc." 
            />
          </div>

          <!-- Question 3: Requirements Description -->
          <div class="form-group">
            <label for="requirementsDescription" class="form-label">Tell us about your requirements <span class="required">*</span></label>
            <textarea 
              name="requirementsDescription" 
              id="requirementsDescription" 
              class="form-textarea" 
              rows="4" 
              placeholder="Describe port speeds, commit levels, server specifications, timeline, or current technical challenges..."
              required
            ></textarea>
          </div>

          <!-- Question 4: Timeline -->
          <div class="form-group">
            <label for="timeline" class="form-label">Implementation Timeline <span class="required">*</span></label>
            <select name="timeline" id="timeline" class="form-select" required>
              <option value="" disabled selected>Select anticipated timeline...</option>
              <option value="immediate">Immediate (Next 7-14 days)</option>
              <option value="under-30-days">Under 30 days</option>
              <option value="1-3-months">1 to 3 months</option>
              <option value="3-plus-months">3+ months</option>
              <option value="researching">Just researching options</option>
            </select>
          </div>

          <!-- Contact Details -->
          <div class="form-row">
            <div class="form-group">
              <label for="contactName" class="form-label">Your Name <span class="required">*</span></label>
              <input type="text" name="contactName" id="contactName" class="form-input" required />
            </div>
            <div class="form-group">
              <label for="companyName" class="form-label">Company Name <span class="required">*</span></label>
              <input type="text" name="companyName" id="companyName" class="form-input" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="workEmail" class="form-label">Work Email <span class="required">*</span></label>
              <input type="email" name="workEmail" id="workEmail" class="form-input" required />
            </div>
            <div class="form-group">
              <label for="phone" class="form-label">Phone Number (Optional)</label>
              <input type="tel" name="phone" id="phone" class="form-input" />
            </div>
          </div>

          <!-- Honeypot Bot Shield -->
          <div style="display:none;" aria-hidden="true">
            <label for="website_trap_field">Do not fill this field</label>
            <input type="text" name="website_trap_field" id="website_trap_field" tabindex="-1" autocomplete="off" aria-label="Do not fill" />
          </div>

          <button type="submit" id="submit-btn" class="btn btn-accent btn-block btn-lg">
            <span>Send Technical Requirement</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>

          <p class="form-privacy-note">
            We value your privacy. Your information is only shared with approved specialist providers relevant to your requirement.
          </p>
        </form>

        <!-- Success Confirmation State -->
        <div id="form-success-card" class="form-success-card" style="display: none;">
          <div class="success-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h2>Requirement Received</h2>
          <p>
            Thank you. Your inquiry reference is <strong id="lead-id-display">#LEAD-0000</strong>.
          </p>
          <p class="success-desc">
            An infrastructure architect is reviewing your specifications and will follow up shortly with qualified options.
          </p>
          <a href="/" class="btn btn-secondary">Back to Homepage</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .talk-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: flex-start;
  }
  @media (min-width: 1024px) {
    .talk-container {
      grid-template-columns: 1fr 1.15fr;
      gap: 64px;
    }
  }

  .talk-title {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 16px 0 18px;
  }

  .talk-sub {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 36px;
  }

  /* Qualification Card */
  .qualification-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 28px;
    margin-bottom: 24px;
  }
  .qual-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 20px;
  }
  .qual-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .qual-steps li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .step-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: var(--accent-blue);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .qual-steps strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 2px;
  }
  .qual-steps p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .commercial-callout {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    background-color: var(--accent-teal-light);
    border: 1px solid rgba(13, 148, 136, 0.25);
    border-radius: var(--radius-md);
  }
  .commercial-callout p {
    font-size: 0.88rem;
    color: #0f766e;
    line-height: 1.5;
  }

  /* Form Card */
  .talk-form-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 40px;
    box-shadow: var(--shadow-xl);
  }
  @media (max-width: 640px) {
    .talk-form-card {
      padding: 24px;
    }
  }

  .context-badge-wrap {
    margin-bottom: 20px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .required {
    color: #ef4444;
  }

  .form-input, .form-select, .form-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
    font-size: 0.95rem;
    transition: var(--transition-fast);
  }
  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--accent-blue);
    background-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .form-privacy-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 14px;
    line-height: 1.45;
  }

  .form-alert {
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    margin-bottom: 20px;
  }
  .alert-error {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  /* Success Card */
  .form-success-card {
    text-align: center;
    padding: 36px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .success-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: var(--accent-teal-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .form-success-card h2 {
    font-size: 1.7rem;
    font-weight: 700;
  }
  .success-desc {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 420px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Parse URL Search Parameters for Context Passing
    const params = new URLSearchParams(window.location.search);
    const service = params.get('service');
    const partner = params.get('partner');
    const offer = params.get('offer');
    const industry = params.get('industry');
    const utmSource = params.get('utm_source');
    const utmCampaign = params.get('utm_campaign');

    const badgeWrap = document.getElementById('context-badge-wrap');
    const badgeText = document.getElementById('context-badge-text');

    if (offer) {
      document.getElementById('context-offer').value = offer;
      badgeWrap.style.display = 'block';
      badgeText.textContent = `Inquiring about offer: ${offer}`;
    } else if (partner) {
      document.getElementById('context-partner').value = partner;
      badgeWrap.style.display = 'block';
      badgeText.textContent = `Inquiring about partner: ${partner}`;
    } else if (service) {
      document.getElementById('context-service').value = service;
      badgeWrap.style.display = 'block';
      badgeText.textContent = `Inquiring about solution: ${service}`;
    }

    if (utmSource) document.getElementById('context-utm-source').value = utmSource;
    if (utmCampaign) document.getElementById('context-utm-campaign').value = utmCampaign;

    // Form Submission Handler
    const form = document.getElementById('inquiry-form');
    const submitBtn = document.getElementById('submit-btn');
    const errorAlert = document.getElementById('form-error-alert');
    const successCard = document.getElementById('form-success-card');
    const leadIdDisplay = document.getElementById('lead-id-display');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert.style.display = 'none';

        const honeypot = document.getElementById('website_trap_field').value;
        if (honeypot) return; // Bot trapped

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Basic Client Validation
        if (!data.lookingFor || !data.requirementsDescription || !data.timeline || !data.contactName || !data.companyName || !data.workEmail) {
          errorAlert.textContent = 'Please complete all required fields marked with an asterisk (*).';
          errorAlert.style.display = 'block';
          return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Processing Requirement...</span>';

        try {
          const res = await fetch('/api/inquiry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          const result = await res.json();

          if (res.ok && result.success) {
            form.style.display = 'none';
            leadIdDisplay.textContent = `#${result.leadId || 'INQ-' + Date.now().toString().slice(-6)}`;
            successCard.style.display = 'flex';
          } else {
            errorAlert.textContent = result.message || 'Unable to submit your requirement. Please contact inquiries@infrahub.tech directly.';
            errorAlert.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Send Technical Requirement</span>';
          }
        } catch (err) {
          errorAlert.textContent = 'Network error communicating with the qualification engine. Please email inquiries@infrahub.tech directly.';
          errorAlert.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Send Technical Requirement</span>';
        }
      });
    }
  });
</script>
