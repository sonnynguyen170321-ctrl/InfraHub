---
// src/pages/cybersecurity.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Enterprise Cybersecurity & Network Hardening | InfraHub"
  description="Source independent external penetration testing, perimeter vulnerability audits, and BGP routing security for telecom and enterprise infrastructure."
  canonicalPath="/cybersecurity"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">Perimeter Security</span>
          <span class="pill-badge badge-teal">Partner Delivered</span>
        </div>
        <h1 class="service-title">Enterprise Cybersecurity & Network Hardening</h1>
        <p class="service-lead">
          Protect critical infrastructure from external intrusion and supply chain vulnerabilities. We connect engineering teams with specialized cybersecurity partners for perimeter penetration testing, edge firewalling, and threat monitoring.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=cybersecurity" class="btn btn-accent btn-lg">Request Security Consultation</a>
        </div>
      </div>

      <div class="content-section">
        <span class="section-sub-tag">Defensive Capabilities</span>
        <h2>Core Cybersecurity Sourcing Disciplines</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <h3>External Penetration Testing</h3>
            <p>Rigorous red-team assessments of exposed IP ranges, BGP routers, hypervisor management interfaces, and VPN gateways.</p>
          </div>
          <div class="problem-card">
            <h3>Web Application Firewalling (WAF)</h3>
            <p>Layer 7 inspection protecting APIs and customer portals against SQLi, XSS, credential stuffing, and automated bot scraping.</p>
          </div>
          <div class="problem-card">
            <h3>Compliance & Vulnerability Audits</h3>
            <p>Gap assessments for ISO 27001, SOC 2 Type II, and European NIS2 infrastructure directive readiness.</p>
          </div>
        </div>
      </div>

      <div class="service-footer-cta">
        <h2>Schedule an Infrastructure Security Audit</h2>
        <a href="/lets-talk?service=cybersecurity" class="btn btn-accent btn-lg">Consult a Cybersecurity Specialist</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container { max-width: 1040px; }
  .service-header { text-align: left; max-width: 860px; margin: 0 0 64px; padding-bottom: 24px; border-bottom: 1px solid var(--border-color); }
  .header-badge-row { display: flex; justify-content: flex-start; gap: 8px; margin-bottom: 16px; }
  .service-title { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 700; line-height: 1.15; margin-bottom: 20px; }
  .service-lead { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 32px; }
  .service-hero-actions { display: flex; justify-content: center; gap: 14px; }
  .content-section { margin-bottom: 72px; }
  .section-sub-tag { display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent-blue); margin-bottom: 8px; }
  .content-section h2 { font-size: 1.85rem; font-weight: 700; margin-bottom: 18px; }
  .problem-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }
  .problem-card { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; }
  .problem-card h3 { font-size: 1.1rem; margin-bottom: 10px; color: var(--text-primary); }
  .problem-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
  .service-footer-cta { padding: 40px 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 16px; border-top: 1px solid var(--border-color); }
</style>
