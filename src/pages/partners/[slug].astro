---
// src/pages/partners/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const partners = await getCollection('partners');
  return partners
    .filter(partner => partner.data.partnerPageEnabled && partner.data.relationshipConfirmed && partner.data.publicNameApproved)
    .map(partner => ({
      params: { slug: partner.slug },
      props: { partner }
    }));
}

const { partner } = Astro.props;
const { Content } = await partner.render();
---

<Layout 
  title={`${partner.data.name} + InfraHub | Partner Ecosystem`}
  description={partner.data.tagline}
  canonicalPath={`/partners/${partner.slug}`}
>
  <div class="section section-hero network-overlay">
    <div class="container partner-detail-container">
      <div class="partner-detail-header">
        <div class="partner-header-badge">
          <span class="pill-badge badge-blue">{partner.data.category}</span>
          <span class="partner-status-label">InfraHub partner ecosystem</span>
        </div>
        <h1 class="partner-hero-title">{partner.data.name} + InfraHub</h1>
        <p class="partner-hero-tagline">{partner.data.tagline}</p>
        <a href={partner.data.officialWebsite} class="official-site-link" target="_blank" rel="noopener noreferrer">
          Visit {partner.data.name}'s official website <span aria-hidden="true">&nearr;</span>
        </a>
      </div>

      <div class="partner-main-grid">
        <div class="partner-prose-content">
          <div class="capabilities-box">
            <h2>Key capabilities</h2>
            <ul class="caps-list">
              {partner.data.capabilities.map(cap => (
                <li>
                  <span class="cap-marker" aria-hidden="true">•</span>
                  <span>{cap}</span>
                </li>
              ))}
            </ul>
            {partner.data.sourceUrls.length > 0 && (
              <p class="source-note">
                Capability descriptions are aligned to {partner.data.name}'s official public materials.
              </p>
            )}
          </div>

          <div class="markdown-body">
            <Content />
          </div>
        </div>

        <aside class="partner-sidebar">
          <div class="partner-action-card">
            <h2>Discuss {partner.data.name}</h2>
            <p>
              Tell InfraHub what you are trying to achieve. We can help assess whether {partner.data.name} fits the requirement and coordinate an introduction where appropriate.
            </p>
            <a href={`/lets-talk?partner=${partner.slug}`} class="btn btn-accent btn-block btn-lg">
              <span>Discuss Your Requirement</span>
            </a>
            
            <div class="partner-sourcing-assurances">
              <p>Requirement-led evaluation</p>
              <p>Direct provider introduction where appropriate</p>
              <p>Partner-delivered services remain contracted and delivered by the provider</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style>
  .partner-detail-container {
    max-width: 1040px;
  }

  .partner-detail-header {
    max-width: 800px;
    margin-bottom: 54px;
  }

  .partner-header-badge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .partner-status-label {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .partner-hero-title {
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 800;
    margin-bottom: 14px;
  }

  .partner-hero-tagline {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.5;
    max-width: 64ch;
  }

  .official-site-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 18px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--accent-blue);
  }

  .official-site-link:hover {
    text-decoration: underline;
  }

  .partner-main-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: flex-start;
  }
  @media (min-width: 992px) {
    .partner-main-grid {
      grid-template-columns: 1fr 340px;
    }
  }

  .capabilities-box {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 40px;
  }
  .capabilities-box h2 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .caps-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .caps-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .cap-marker {
    color: var(--accent-blue);
    line-height: 1.4;
    flex-shrink: 0;
  }

  .source-note {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .markdown-body {
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .markdown-body h2 {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 32px 0 14px;
  }
  .markdown-body h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 24px 0 10px;
  }
  .markdown-body p {
    margin-bottom: 16px;
  }
  .markdown-body ul {
    list-style: disc;
    padding-left: 20px;
    margin-bottom: 20px;
  }

  .partner-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 24px);
  }

  .partner-action-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 32px;
    box-shadow: var(--shadow-lg);
  }
  .partner-action-card h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .partner-action-card > p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .partner-sourcing-assurances {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .partner-sourcing-assurances p {
    margin: 0;
  }
</style>
