---
// src/pages/partners/[slug].astro — Partner Architecture Framework & Decision Layer (Parts XVII & XVIII)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { fallbackDecisionLayer } from '../../lib/partner-decision-layer';

export async function getStaticPaths() {
  const partners = await getCollection('partners');
  return partners
    .filter(partner => partner.data.partnerPageEnabled && partner.data.relationshipConfirmed && partner.data.publicNameApproved)
    .map(partner => ({
      params: { slug: partner.slug },
      props: { partner }
    }));
}

const { partner } = Astro.props;
const { Content } = await partner.render();

// The decision layer is content, not template. A record that has not been populated falls
// back to provider-neutral guidance rather than to partner-specific claims.
const signature = partner.data.decisionLayer ?? fallbackDecisionLayer(partner.data.name);
const sourceRefs = signature.sourceRefs ?? [];
---

<Layout 
  title={`${partner.data.name} — Specialist Partner Profile | InfraHub`}
  description={partner.data.tagline}
  canonicalPath={`/partners/${partner.slug}`}
  ogImage="/images/og/partner.png"
  ogImageAlt="InfraHub partner profile"
>
  <div class="partner-profile-page">
    <div class="container partner-profile-container">
      
      <!-- Profile Header / Identity Ribbon -->
      <header class="profile-header">
        <div class="header-breadcrumb-row">
          <a href="/partners" class="breadcrumb-link">&larr; Partner Ecosystem Ledger</a>
          <span class="breadcrumb-sep">/</span>
          <span class="breadcrumb-current">{partner.data.name}</span>
        </div>

        <div class="header-main-flex">
          <div class="header-brand-box">
            {partner.data.logoApproved && partner.data.logoStatus === 'approved' && partner.data.logo ? (
              <img 
                src={partner.data.logo} 
                alt={`${partner.data.name} logo`} 
                class="profile-logo-img"
                loading="eager"
                width="160"
                height="36"
              />
            ) : (
              <span class="profile-text-mark">{partner.data.name}</span>
            )}
            <div class="header-title-block">
              <h1 class="profile-title">{partner.data.name}</h1>
              <p class="profile-short-role">{partner.data.shortRole || partner.data.tagline}</p>
            </div>
          </div>

          <div class="header-meta-actions">
            <a 
              href={partner.data.officialWebsite} 
              class="btn btn-secondary btn-sm"
              target="_blank" 
              rel="noopener noreferrer"
            >
              <span>Corporate Website</span>
              <span class="ext-icon" aria-hidden="true">&nearr;</span>
            </a>
            <a href={`/lets-talk?partner=${partner.slug}`} class="btn btn-accent btn-sm">
              <span>Discuss Requirement</span>
            </a>
          </div>
        </div>

        <p class="profile-tagline measure-lead">{partner.data.tagline}</p>
      </header>

      <!-- Signature Technical Architecture Block (Part XVII: Subject-Specific Architecture) -->
      <section class="signature-architecture-section">
        <div class="sig-header">
          <div class="sig-kicker-row">
            <span class="routing-junction" aria-hidden="true"></span>
            <span class="sig-kicker">Technical architecture</span>
          </div>
          <h2 class="sig-title">{signature.architectureTitle}</h2>
          <p class="sig-subtitle measure-technical">{signature.architectureSubtitle}</p>
        </div>

        <div class="sig-steps-grid">
          {signature.steps.map(step => (
            <div class="sig-step-card">
              <span class="sig-step-num">{step.num}</span>
              <h3 class="sig-step-title">{step.title}</h3>
              <p class="sig-step-desc">{step.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- The Buyer-Decision Layer (Part XVIII: Questions We Ask First, When Fits, Commercial Caution) -->
      <section class="buyer-decision-layer">
        <div class="decision-header">
          <span class="decision-kicker">Buyer decision criteria</span>
          <h2 class="decision-title">What Changes the Answer</h2>
          <p class="decision-subhead measure-lead">
            We evaluate specialist providers based on operational constraints rather than marketing catalogs. Consider these criteria before contracting.
          </p>
        </div>

        <div class="decision-triad-grid">
          <!-- Column 1: Questions We Ask First -->
          <div class="decision-col-card">
            <div class="col-indicator-bar" style="background: var(--accent-blue);"></div>
            <h3 class="decision-col-title">Questions We Ask First</h3>
            <ul class="decision-questions-list">
              {signature.decisionQuestions.map(q => (
                <li>
                  <span class="q-marker" aria-hidden="true">&rarr;</span>
                  <span>{q}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Column 2: When This Fits vs Alternative -->
          <div class="decision-col-card">
            <div class="col-indicator-bar" style="background: var(--accent-cyan);"></div>
            <h3 class="decision-col-title">Workload Suitability</h3>
            <div class="fit-block">
              <span class="fit-tag tag-fits">When this fits</span>
              <p class="fit-text">{signature.whenFits}</p>
            </div>
            <div class="fit-block" style="margin-top: 14px;">
              <span class="fit-tag tag-alt">When an alternative fits</span>
              <p class="fit-text">{signature.whenAlternative}</p>
            </div>
          </div>

          <!-- Column 3: Commercial & Operational Caution -->
          <div class="decision-col-card">
            <div class="col-indicator-bar" style="background: var(--accent-amber);"></div>
            <h3 class="decision-col-title">What Buyers Often Miss</h3>
            <div class="caution-box">
              <span class="caution-kicker">Commercial and sourcing factor</span>
              <p class="caution-text">{signature.commercialCaution}</p>
            </div>
            <p class="advisory-reassurance">
              InfraHub can work through these constraints with you before an introduction is made.
            </p>
          </div>
        </div>

        {sourceRefs.length > 0 && (
          <p class="decision-sources">
            <span class="decision-sources-label">Sources</span>
            {sourceRefs.map((ref, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <a href={ref} rel="noopener nofollow" target="_blank">{new URL(ref).hostname.replace(/^www./, "")}</a>
              </>
            ))}
          </p>
        )}
      </section>

      <!-- Editorial Narrative Prose & Sourced Capabilities -->
      <section class="partner-prose-section">
        <div class="prose-layout-grid">
          
          <!-- Left: Narrative Prose Content -->
          <div class="prose-main-col">
            <div class="markdown-body">
              <Content />
            </div>

            <!-- Verified Capabilities Block -->
            <div class="verified-caps-block">
              <h3 class="caps-block-title">Published capability scope</h3>
              <p class="caps-block-note">
                Descriptions below are aligned to {partner.data.name}'s current public materials:
              </p>
              <ul class="caps-detail-list">
                {partner.data.capabilities.map(cap => (
                  <li>
                    <span class="cap-bullet" aria-hidden="true">&check;</span>
                    <span>{cap}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Right: Direct Consultation & Governance Sidebar -->
          <aside class="prose-sidebar-col">
            <div class="consultation-card">
              <span class="consult-kicker">QUALIFIED INTRODUCTION</span>
              <h3 class="consult-title">Evaluate {partner.data.name}</h3>
              <p class="consult-desc">
                Discuss the requirement with InfraHub. We help clarify technical constraints, compare relevant options, and coordinate an introduction. Provider-specific pricing, availability, and service commitments are confirmed before contracting.
              </p>
              <a href={`/lets-talk?partner=${partner.slug}`} class="btn btn-accent btn-block btn-lg">
                <span>Discuss Your Requirement</span>
              </a>

              <div class="governance-assurances-list">
                <div class="assurance-item">
                  <span class="assure-icon">&check;</span>
                  <span>Requirement-led architectural evaluation</span>
                </div>
                <div class="assurance-item">
                  <span class="assure-icon">&check;</span>
                  <span>Provider-specific commercial terms</span>
                </div>
                <div class="assurance-item">
                  <span class="assure-icon">&check;</span>
                  <span>Direct introduction to the selected specialist</span>
                </div>
              </div>
            </div>
          </aside>

        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .partner-profile-page {
    background-color: var(--bg-primary);
    padding: 64px 0 112px;
  }

  .partner-profile-container {
    max-width: var(--max-width);
  }

  /* Header */
  .profile-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 36px;
    margin-bottom: 56px;
  }

  .header-breadcrumb-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .breadcrumb-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 600;
  }

  .breadcrumb-link:hover {
    text-decoration: underline;
  }

  .header-main-flex {
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }

  @media (min-width: 900px) {
    .header-main-flex {
      flex-direction: row;
      align-items: center;
    }
  }

  .header-brand-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 600px) {
    .header-brand-box {
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }
  }

  .profile-logo-img {
    height: 32px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    display: block;
  }

  .profile-text-mark {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .profile-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .profile-short-role {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent-blue);
    margin: 2px 0 0;
    font-weight: 600;
  }

  .header-meta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ext-icon {
    font-size: 0.82rem;
  }

  .profile-tagline {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Signature Architecture Section */
  .signature-architecture-section {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 48px;
    margin-bottom: 64px;
  }

  .sig-header {
    margin-bottom: 32px;
  }

  .sig-kicker-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .sig-kicker {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  .sig-title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
  }

  .sig-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .sig-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 860px) {
    .sig-steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .sig-step-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sig-step-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .sig-step-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.35;
  }

  .sig-step-desc {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Buyer Decision Layer */
  .buyer-decision-layer {
    margin-bottom: 64px;
    border-top: 2px solid var(--text-primary);
    padding-top: 36px;
  }

  .decision-header {
    margin-bottom: 32px;
  }

  .decision-kicker {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }

  .decision-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px;
  }

  .decision-subhead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .decision-triad-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .decision-triad-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .decision-col-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    overflow: hidden;
  }

  .col-indicator-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
  }

  .decision-col-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .decision-questions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .decision-questions-list li {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .q-marker {
    color: var(--accent-blue);
    font-weight: 700;
    flex-shrink: 0;
  }

  .fit-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fit-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .tag-fits { color: var(--accent-cyan); }
  .tag-alt { color: var(--text-muted); }

  .fit-text {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .caution-box {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-amber);
    padding: 16px 18px;
    border-radius: var(--radius-sm);
  }

  .caution-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--accent-amber);
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 4px;
  }

  .caution-text {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .decision-sources {
    margin-top: 20px;
    font-size: 0.8rem;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
  }

  .decision-sources-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .decision-sources a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .advisory-reassurance {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  /* Prose & Sidebar Layout */
  .prose-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 900px) {
    .prose-layout-grid {
      grid-template-columns: 1fr 340px;
      align-items: start;
    }
  }

  .markdown-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .markdown-body h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 32px 0 14px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 8px;
  }

  .markdown-body h3 {
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 24px 0 10px;
  }

  .markdown-body p {
    margin-bottom: 16px;
  }

  .verified-caps-block {
    margin-top: 40px;
    border-top: 1px solid var(--border-color);
    padding-top: 24px;
  }

  .caps-block-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
  }

  .caps-block-note {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin: 0 0 16px;
  }

  .caps-detail-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .caps-detail-list li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .cap-bullet {
    color: var(--accent-blue);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Sidebar Consultation Card */
  .consultation-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: sticky;
    top: 100px;
  }

  .consult-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  .consult-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .consult-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .governance-assurances-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border-color);
    padding-top: 16px;
    margin-top: 6px;
  }

  .assurance-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .assure-icon {
    color: var(--accent-blue);
    font-size: 0.85rem;
    font-weight: 700;
    flex-shrink: 0;
  }
</style>
