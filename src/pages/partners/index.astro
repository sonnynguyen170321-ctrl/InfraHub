---
// src/pages/partners/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPartners = await getCollection('partners');

// Filter strictly for partners with confirmed relationship and approved naming
const publishedPartners = allPartners
  .filter(p => p.data.partnerPageEnabled && p.data.relationshipConfirmed && p.data.publicNameApproved)
  .sort((a, b) => (a.data.homepagePriority ?? 10) - (b.data.homepagePriority ?? 10));

const categories = [
  'All Disciplines',
  'Infrastructure & Cloud',
  'Network & Connectivity',
  'Security',
  'Managed Operations',
  'Virtualization',
  'AI & Transformation'
];
---

<Layout 
  title="Our Partner Ecosystem — Infrastructure & Technology Specialists"
  description="Explore InfraHub's partner ecosystem across cloud, connectivity, DDoS security, IPv4, virtualization, network operations, and AI transformation."
  canonicalPath="/partners"
>
  <div class="partners-page-wrapper">
    <div class="container partners-container">
      
      <!-- Editorial Header -->
      <header class="catalog-header">
        <span class="catalog-kicker">SPECIALIST PARTNER ECOSYSTEM</span>
        <h1 class="catalog-title">Infrastructure and technology specialists.<br />Connected through InfraHub.</h1>
        <p class="catalog-lead">
          InfraHub works with specialist infrastructure operators, software vendors, and technology platforms. We start with the buyer's requirement, then identify where a partner's actual capabilities fit.
        </p>
      </header>

      <!-- Category Filter Tabs -->
      <nav class="category-filter-nav" aria-label="Partner Categories">
        {categories.map((cat, idx) => (
          <button 
            type="button" 
            class={`category-tab ${idx === 0 ? 'active' : ''}`}
            data-category={cat === 'All Disciplines' ? 'all' : cat}
          >
            {cat}
          </button>
        ))}
      </nav>

      <!-- Partners Directory Grid -->
      <div class="partners-directory-grid" id="partners-grid">
        {publishedPartners.map(partner => (
          <article class="partner-dir-card" data-category={partner.data.category}>
            <div class="partner-dir-top">
              <div class="partner-brand-area">
                {partner.data.logoApproved && partner.data.logoStatus === 'approved' && partner.data.logo ? (
                  <img 
                    src={partner.data.logo} 
                    alt={`${partner.data.name} logo`} 
                    class="partner-card-logo"
                    width="120"
                    height="28"
                  />
                ) : (
                  <div class="partner-text-mark">
                    <span class="partner-name">{partner.data.name}</span>
                    {partner.data.shortRole && <span class="partner-role">{partner.data.shortRole}</span>}
                  </div>
                )}
              </div>
              <span class="partner-category-pill">{partner.data.category}</span>
            </div>

            <div class="partner-dir-body">
              <h2 class="partner-headline">
                <a href={`/partners/${partner.slug}`}>{partner.data.name}</a>
              </h2>
              <p class="partner-tagline">{partner.data.tagline}</p>
              
              <ul class="partner-caps-list">
                {partner.data.capabilities.slice(0, 3).map(cap => (
                  <li>{cap}</li>
                ))}
              </ul>
            </div>

            <div class="partner-dir-footer">
              <a href={`/partners/${partner.slug}`} class="btn btn-secondary btn-sm">
                <span>View Partner Profile</span>
              </a>
              <a href={partner.data.officialWebsite} class="partner-discuss-link" target="_blank" rel="noopener noreferrer">
                <span>Official Website</span>
                <span class="link-arrow" aria-hidden="true">&nearr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Sourcing Inquiry Band -->
      <section class="partners-inquiry-band">
        <div class="inquiry-content">
          <h2 class="inquiry-title">Join the InfraHub sourcing ecosystem</h2>
          <p class="inquiry-desc">
            Do you provide specialist infrastructure, networking, security, cloud, virtualization, managed operations, or enterprise technology capabilities?
          </p>
        </div>
        <a href="mailto:partners@infrahub.tech" class="btn btn-secondary">
          <span>Inquire About Onboarding</span>
        </a>
      </section>

    </div>
  </div>
</Layout>

<style>
  .partners-page-wrapper {
    background-color: #ffffff;
    padding: 72px 0 96px;
  }

  .partners-container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .catalog-header {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 40px;
  }

  .catalog-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  .catalog-title {
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .catalog-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 65ch;
  }

  /* Filter Tabs */
  .category-filter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 8px;
  }

  .category-tab {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 8px 16px;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .category-tab:hover {
    color: var(--text-primary);
    border-color: #cbd5e1;
  }

  .category-tab.active {
    background: #0f172a;
    color: #ffffff;
    border-color: #0f172a;
  }

  /* Partners Directory Grid */
  .partners-directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media (min-width: 768px) {
    .partners-directory-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  .partner-dir-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .partner-dir-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .partner-dir-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 18px;
  }

  .partner-card-logo {
    height: 24px;
    width: auto;
    object-fit: contain;
  }

  .partner-text-mark {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .partner-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .partner-role {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .partner-category-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: #475569;
    background: #f1f5f9;
    padding: 4px 10px;
    border-radius: 4px;
  }

  .partner-dir-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex-grow: 1;
  }

  .partner-headline {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .partner-headline a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .partner-headline a:hover {
    color: var(--accent-blue);
  }

  .partner-tagline {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .partner-caps-list {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .partner-caps-list li {
    font-size: 0.88rem;
    line-height: 1.5;
    color: #475569;
    position: relative;
    padding-left: 18px;
  }

  .partner-caps-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-blue);
    font-weight: bold;
  }

  .partner-dir-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--border-color);
  }

  .partner-discuss-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .partner-discuss-link:hover {
    color: var(--accent-blue);
  }

  .link-arrow {
    transition: transform 160ms ease;
    display: inline-block;
  }

  .partner-discuss-link:hover .link-arrow {
    transform: translate(2px, -2px);
  }

  /* Inquiry Band */
  .partners-inquiry-band {
    background: #0b1120;
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 44px 36px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }

  @media (min-width: 860px) {
    .partners-inquiry-band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }
  }

  .inquiry-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 600px;
  }

  .inquiry-title {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .inquiry-desc {
    font-size: 0.98rem;
    line-height: 1.6;
    color: #cbd5e1;
  }
</style>

<script>
  function setupCategoryFilters() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
    const cards = document.querySelectorAll<HTMLElement>('.partner-dir-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const cat = tab.getAttribute('data-category');
        cards.forEach(card => {
          if (cat === 'all' || card.getAttribute('data-category') === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupCategoryFilters);
</script>
