---
// src/pages/partners/index.astro — Editorial Ecosystem Ledger
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPartners = await getCollection('partners');

// Filter strictly for partners with confirmed relationship and approved naming
const publishedPartners = allPartners.filter(
  p => p.data.partnerPageEnabled && p.data.relationshipConfirmed && p.data.publicNameApproved
);

// Map partners into authoritative discipline groups per Part XVI
const disciplines = [
  {
    id: "infrastructure-cloud",
    number: "01",
    name: "Infrastructure & Cloud",
    scope: "Dedicated compute, hypervisors, bare-metal clusters, and distributed edge infrastructure.",
    partners: publishedPartners.filter(p => ['gcore', 'zenlayer'].includes(p.slug))
  },
  {
    id: "security",
    number: "02",
    name: "Defensive & Routing Security",
    scope: "DDoS detection, routing controls, traffic diversion, and managed network or application protection.",
    partners: publishedPartners.filter(p => ['fastnetmon', 'stormwall'].includes(p.slug))
  },
  {
    id: "network-resources",
    number: "03",
    name: "Network & IP Resources",
    scope: "IPv4 address leasing, transfer governance, RPKI validation, and address monetization.",
    partners: publishedPartners.filter(p => p.slug === 'ipxo')
  },
  {
    id: "virtualization",
    number: "04",
    name: "Virtualization Architecture",
    scope: "Enterprise open-source hypervisors, VMware migration paths, backup, and cluster replication.",
    partners: publishedPartners.filter(p => p.slug === 'vates')
  },
  {
    id: "managed-operations",
    number: "05",
    name: "Managed Network Operations",
    scope: "24/7 NOC services, network engineering, automation, and incident-response workflows.",
    partners: publishedPartners.filter(p => p.slug === 'itcare')
  },
  {
    id: "technology-decision",
    number: "06",
    name: "Technology Decision Support",
    scope: "Market mapping, vendor due diligence, build-vs-buy analysis, and practitioner evidence.",
    partners: publishedPartners.filter(p => p.slug === 'airframe')
  }
];
---

<Layout 
  title="Specialist Partner Ecosystem — Infrastructure Field Guide"
  description="Explore InfraHub's curated partner ecosystem across cloud compute, DDoS protection, IPv4 leasing, virtualization, 24/7 NOC operations, and technology diligence."
  canonicalPath="/partners"
>
  <div class="ledger-page-wrapper">
    <div class="container ledger-container">
      
      <!-- Editorial Header -->
      <header class="ledger-header">
        <div class="ledger-kicker-row">
          <span class="routing-junction" aria-hidden="true"></span>
          <span class="ledger-kicker">INFRASTRUCTURE ECOSYSTEM // DIRECTORY LEDGER</span>
        </div>
        <h1 class="ledger-title">Infrastructure and technology specialists.<br />Connected through InfraHub.</h1>
        <p class="ledger-lead measure-lead">
          InfraHub works with specialist infrastructure operators, software vendors, and technical platforms. We qualify the buyer requirement first, then identify where each partner's published capabilities may fit.
        </p>
      </header>

      <!-- Editorial Ecosystem Ledger (No Generic Card Grid) -->
      <div class="ecosystem-ledger">
        {disciplines.map(discipline => (
          <section class="discipline-section" id={discipline.id}>
            <!-- Discipline Group Header -->
            <div class="discipline-header-row">
              <div class="discipline-label-col">
                <span class="discipline-index">{discipline.number}</span>
                <h2 class="discipline-name">{discipline.name}</h2>
              </div>
              <p class="discipline-scope measure-technical">{discipline.scope}</p>
            </div>

            <!-- Ledger Entries Table -->
            <div class="ledger-entries-list">
              {discipline.partners.map((partner, pIdx) => (
                <article class="ledger-row-item">
                  
                  <!-- Column 1: Brand & Identity -->
                  <div class="ledger-col-brand">
                    <a href={`/partners/${partner.slug}`} class="partner-logo-anchor" aria-label={`${partner.data.name} profile`}>
                      {partner.data.logoApproved && partner.data.logoStatus === 'approved' && partner.data.logo ? (
                        <img 
                          src={partner.data.logo} 
                          alt={`${partner.data.name} logo`} 
                          class="ledger-partner-logo"
                          loading={discipline.number === "01" && pIdx === 0 ? "eager" : "lazy"}
                          width="130"
                          height="30"
                        />
                      ) : (
                        <span class="ledger-text-logo">{partner.data.name}</span>
                      )}
                    </a>
                    <a 
                      href={partner.data.officialWebsite} 
                      class="partner-ext-link" 
                      target="_blank" 
                      rel="noopener noreferrer"
                      title={`Visit ${partner.data.name} corporate site`}
                    >
                      <span>{partner.data.officialWebsite.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                      <span class="ext-arrow" aria-hidden="true">&nearr;</span>
                    </a>
                  </div>

                  <!-- Column 2: Architectural Scope & Context -->
                  <div class="ledger-col-content">
                    <div class="partner-headline-row">
                      <h3 class="partner-title">
                        <a href={`/partners/${partner.slug}`}>{partner.data.name}</a>
                      </h3>
                      <span class="partner-short-role">{partner.data.shortRole || partner.data.tagline}</span>
                    </div>
                    <p class="partner-narrative measure-technical">
                      {partner.data.tagline}. The profile explains where the partner can fit, what to evaluate, and where another approach may make more sense.
                    </p>
                    
                    <div class="capabilities-inline">
                      <span class="caps-label">Published capability scope:</span>
                      <ul class="caps-inline-list">
                        {partner.data.capabilities.slice(0, 3).map((cap, cIdx) => (
                          <li>
                            {cap}{cIdx < 2 ? <span class="cap-sep" aria-hidden="true">·</span> : null}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <!-- Column 3: Navigation Actions -->
                  <div class="ledger-col-actions">
                    <a href={`/partners/${partner.slug}`} class="btn btn-secondary btn-sm ledger-profile-btn">
                      <span>Technical Scope &rarr;</span>
                    </a>
                    <a href={`/lets-talk?partner=${partner.slug}`} class="ledger-inquire-link">
                      <span>Inquire Sourcing</span>
                    </a>
                  </div>

                </article>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Sourcing Inquiry Band -->
      <section class="ledger-inquiry-band">
        <div class="inquiry-inner">
          <div class="inquiry-text-col">
            <span class="inquiry-kicker">ECOSYSTEM ADVISORY</span>
            <h2 class="inquiry-title">Need guidance on provider selection?</h2>
            <p class="inquiry-desc measure-lead">
              InfraHub compares requirements across carriers, infrastructure operators, and technology vendors, then helps clarify provider fit, routing, technical requirements, and commercial questions before introduction.
            </p>
          </div>
          <div class="inquiry-action-col">
            <a href="/lets-talk?service=advisory" class="btn btn-accent btn-lg">
              <span>Discuss Your Requirement</span>
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .ledger-page-wrapper {
    background-color: var(--bg-primary);
    padding: 48px 0 96px;
  }

  .ledger-container {
    max-width: var(--max-width);
  }

  /* Header */
  .ledger-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 40px;
    margin-bottom: 56px;
  }

  .ledger-kicker-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .ledger-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  .ledger-title {
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 20px;
  }

  .ledger-lead {
    font-size: 1.12rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  /* Discipline Groups */
  .discipline-section {
    margin-bottom: 64px;
    border-top: 2px solid var(--text-primary);
    padding-top: 24px;
  }

  .discipline-header-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 24px;
    align-items: baseline;
  }

  @media (min-width: 900px) {
    .discipline-header-row {
      grid-template-columns: 320px 1fr;
      gap: 40px;
    }
  }

  .discipline-label-col {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .discipline-index {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-blue);
  }

  .discipline-name {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0;
  }

  .discipline-scope {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  /* Ledger Entries Table / List */
  .ledger-entries-list {
    border-top: 1px solid var(--border-color);
  }

  .ledger-row-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border-color);
    transition: background-color 160ms var(--ease-out);
  }

  @media (min-width: 900px) {
    .ledger-row-item {
      grid-template-columns: 220px 1fr 180px;
      gap: 36px;
      align-items: start;
    }
  }

  /* Brand Column */
  .ledger-col-brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  .partner-logo-anchor {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .ledger-partner-logo {
    height: 26px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    display: block;
  }

  .ledger-text-logo {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .partner-ext-link {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 120ms var(--ease-out);
  }

  .partner-ext-link:hover {
    color: var(--accent-blue);
  }

  .ext-arrow {
    font-size: 0.82rem;
  }

  /* Content Column */
  .ledger-col-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .partner-headline-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 16px;
  }

  .partner-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
  }

  .partner-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .partner-title a:hover {
    color: var(--accent-blue);
  }

  .partner-short-role {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-blue);
    font-weight: 500;
  }

  .partner-narrative {
    font-size: 0.94rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .capabilities-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: baseline;
    font-size: 0.85rem;
    margin-top: 4px;
  }

  .caps-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .caps-inline-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    list-style: none;
    padding: 0;
    margin: 0;
    color: var(--text-secondary);
  }

  .cap-sep {
    color: var(--border-color);
    margin-left: 10px;
  }

  /* Actions Column */
  .ledger-col-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
  }

  @media (min-width: 900px) {
    .ledger-col-actions {
      align-items: flex-end;
    }
  }

  .ledger-profile-btn {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .ledger-profile-btn {
      width: auto;
    }
  }

  .ledger-inquire-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 120ms var(--ease-out);
  }

  .ledger-inquire-link:hover {
    color: var(--accent-blue);
  }

  /* Inquiry Band */
  .ledger-inquiry-band {
    margin-top: 80px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-blue);
    padding: 40px;
    border-radius: var(--radius-sm);
  }

  .inquiry-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .inquiry-inner {
      grid-template-columns: 1fr auto;
      gap: 48px;
    }
  }

  .inquiry-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    display: block;
    margin-bottom: 8px;
  }

  .inquiry-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 10px;
  }

  .inquiry-desc {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
