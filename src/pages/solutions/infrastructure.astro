---
// src/pages/solutions/infrastructure.astro
// Phase 8: Solution Family Architecture — Infrastructure & Compute
import Layout from '../../layouts/Layout.astro';

const situations = [
  {
    title: "High-Throughput Workload Contention",
    detail: "Virtualization hypervisor overhead and noisy-neighbor storage contention degrading database or API response times. We structure dedicated single-tenant bare-metal nodes with raw NVMe arrays."
  },
  {
    title: "GPU & AI Model Inference Scaling",
    detail: "Scaling distributed LLM inference, embedding generation, or model fine-tuning requiring dedicated NVIDIA H100, L40S, or A100 GPUs interconnected via 400G RoCE or InfiniBand fabrics."
  },
  {
    title: "Facility Footprint & Rack Power Density",
    detail: "Outgrowing fragmented server rooms or low-density retail racks. We source dedicated colocation suites from 10kW to 40kW+ per cabinet with carrier-neutral meet-me-room cross-connects."
  },
  {
    title: "Hardware Procurement & Refurbished Lifecycles",
    detail: "Supply chain delays or restrictive OEM lead times. We source certified enterprise Dell PowerEdge and HPE platforms with vendor warranties, burn-in testing, and rapid deployment."
  }
];

const approaches = [
  {
    kicker: "COMPUTE NODES",
    title: "Dedicated Bare Metal",
    desc: "Single-tenant enterprise server nodes with unmetered high-bandwidth uplinks across Tier-III facilities in Europe, North America, and Asia.",
    route: "/dedicated-servers",
    action: "Explore Dedicated Servers →"
  },
  {
    kicker: "COMMERCIAL PACKAGES",
    title: "Wholesale Compute Offers",
    desc: "Pre-configured and tested bare-metal packages available for rapid turn-up with verified monthly commercial terms.",
    route: "/offers",
    action: "Explore Server Offers →"
  },
  {
    kicker: "TAILORED CLUSTERS",
    title: "Custom IaaS Stacks",
    desc: "Bespoke combinations of compute clusters, dedicated private storage networks, and low-latency transit feeds.",
    route: "/custom-iaas",
    action: "Explore Custom IaaS →"
  },
  {
    kicker: "ACCELERATED AI",
    title: "GPU & AI Infrastructure",
    desc: "High-density enterprise GPU clusters optimized for AI training, tensor inference, and real-time computer vision pipelines.",
    route: "/gpu-ai-infrastructure",
    action: "Explore GPU Systems →"
  },
  {
    kicker: "DATA CENTER PODS",
    title: "Colocation Space & Power",
    desc: "Carrier-neutral datacenter space from quarter racks to dedicated private cages with 2N power and 24/7 smart remote hands.",
    route: "/colocation",
    action: "Explore Colocation →"
  },
  {
    kicker: "CAPITAL EFFICIENCY",
    title: "Enterprise Hardware Procurement",
    desc: "Procure factory-certified new or refurbished server chassis with testing certifications, warranty coverage, and component sparing.",
    route: "/enterprise-hardware",
    action: "Explore Hardware Brokerage →"
  }
];

const diligenceFactors = [
  {
    factor: "Out-of-Band IPMI / iDRAC Isolation",
    inquiry: "Are remote management consoles isolated on private, VPN-gated management VLANs with hardware root-of-trust authentication?"
  },
  {
    factor: "Continuous Power Density & Cooling",
    inquiry: "Is rack power delivered via dual redundant A+B feeds from independent UPS strings, supported by N+1 generator backup?"
  },
  {
    factor: "Network Port Bonding & Transit",
    inquiry: "Are uplinks configured with redundant LACP bonds to separate leaf switches to eliminate single-switch failure domains?"
  },
  {
    factor: "On-Site Spares & Hardware RMA",
    inquiry: "What is the contractual replacement window for failed NVMe drives, RAM DIMMs, or power supplies at the host facility?"
  }
];

const partners = [
  {
    name: "Zenlayer",
    role: "Global Bare Metal, Edge Compute & Cloud Interconnect",
    slug: "zenlayer"
  },
  {
    name: "Gcore",
    role: "High-Performance Bare Metal, AI Clusters & Global Hosting",
    slug: "gcore"
  },
  {
    name: "Vates",
    role: "Turnkey Enterprise Server Hardware & Hypervisor Integration",
    slug: "vates"
  },
  {
    name: "ITcare",
    role: "Data Center Engineering, Remote Hands & Server Maintenance",
    slug: "itcare"
  }
];
---

<Layout 
  title="Infrastructure Solutions (Bare Metal, IaaS, GPU, Colocation) | InfraHub"
  description="Source high-performance dedicated servers, custom IaaS stacks, GPU AI training nodes, enterprise hardware, and colocation across global Tier-III facilities."
  canonicalPath="/solutions/infrastructure"
  ogImage="/images/og/solution.png"
  ogImageAlt="InfraHub Infrastructure & Compute solution family"
>
  <!-- Chapter 01: Hero / Discipline Thesis -->
  <section class="section section-bedrock solution-hero blueprint-grid" aria-label="Discipline Overview">
    <div class="container solution-container">
      <div class="solution-hero-header">
        <div class="technical-kicker">Discipline 03 • Dedicated Bare Metal, IaaS &amp; Compute Pods</div>
        <h1 class="solution-h1">Infrastructure &amp; Compute</h1>
        <p class="solution-lead">
          Single-tenant dedicated servers, custom IaaS configurations, GPU AI acceleration, and wholesale datacenter colocation sourced around your strict workload constraints.
        </p>

        <!-- Monospace Telemetry Specs -->
        <div class="telemetry-bar">
          <span class="telemetry-badge telemetry-badge-sky">HARDWARE: SINGLE-TENANT DEDICATED</span>
          <span class="telemetry-badge">PORTS: 10G – 100G UNMETERED</span>
          <span class="telemetry-badge">DENSITY: 10KW – 40KW+ PER RACK</span>
          <span class="telemetry-badge">MANAGEMENT: ISOLATED IPMI / OOB</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 02: Situational Triggers -->
  <section class="section section-midnight" aria-label="When This Fits">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Trigger Scenarios</div>
        <h2 class="editorial-h2">When to evaluate dedicated infrastructure</h2>
      </div>

      <div class="situations-grid">
        {situations.map((item, idx) => (
          <div class="situation-item">
            <span class="situation-num">0{idx + 1}</span>
            <h3 class="situation-title">{item.title}</h3>
            <p class="situation-desc">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 03: Available Approaches / Sourcing Ledger -->
  <section class="section section-bedrock" aria-label="Available Approaches">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Architecture Portfolio</div>
        <h2 class="editorial-h2">Available compute and facility approaches</h2>
        <p class="section-desc">From dedicated single-server nodes to complete private data center cages with redundant optical feeds.</p>
      </div>

      <div class="architectural-ledger">
        {approaches.map((item) => (
          <div class="ledger-row solution-approach-row">
            <div class="ledger-cell cell-kicker">
              <span class="approach-kicker">{item.kicker}</span>
            </div>
            <div class="ledger-cell cell-title">
              <h3 class="approach-title">{item.title}</h3>
            </div>
            <div class="ledger-cell cell-desc">
              <p class="approach-desc">{item.desc}</p>
            </div>
            <div class="ledger-cell cell-action">
              <a href={item.route} class="btn-approach-link">{item.action}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 04: Technical Diligence & Verification -->
  <section class="section section-midnight" aria-label="Engineering Diligence">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Verification Standards</div>
        <h2 class="editorial-h2">What we verify during infrastructure qualification</h2>
        <p class="section-desc">Hardware reliability, thermal management, and power redundancy must be proven by audit rather than marketing assurances.</p>
      </div>

      <div class="diligence-matrix">
        {diligenceFactors.map((df) => (
          <div class="diligence-card">
            <div class="diligence-header">
              <span class="diligence-dot" aria-hidden="true"></span>
              <h3 class="diligence-factor">{df.factor}</h3>
            </div>
            <p class="diligence-inquiry">{df.inquiry}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 05: Verified Ecosystem Specialists -->
  <section class="section section-bedrock" aria-label="Verified Ecosystem Specialists">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Ecosystem Specialists</div>
        <h2 class="editorial-h2">Verified infrastructure providers</h2>
        <p class="section-desc">InfraHub coordinates requirements with specialist data centers, server operators, and hardware distributors.</p>
      </div>

      <div class="specialists-grid">
        {partners.map((partner) => (
          <a href={`/partners/${partner.slug}`} class="specialist-card" title={`View ${partner.name} architecture profile`}>
            <div class="specialist-header">
              <span class="specialist-name">{partner.name}</span>
              <span class="specialist-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <p class="specialist-role">{partner.role}</p>
          </a>
        ))}
      </div>

      <div class="operating-disclosure">
        <p class="disclosure-text">
          <strong class="disclosure-strong">Delivery Governance:</strong> InfraHub qualifies workload criteria, evaluates facility specifications, and coordinates direct technical introductions. Physical colocation space, bare-metal server delivery, and hardware warranty contracts are executed directly by the selected specialist provider.
        </p>
      </div>
    </div>
  </section>

  <!-- Chapter 06: Conversion Action -->
  <section class="section section-midnight solution-cta-band" aria-label="Technical Consultation">
    <div class="container solution-container">
      <div class="cta-inner-card">
        <div class="cta-left">
          <div class="technical-kicker">Hardware Sourcing</div>
          <h2 class="cta-headline">Source High-Performance Infrastructure</h2>
          <p class="cta-desc">
            Provide your server specifications, GPU requirements, or colocation power parameters. We evaluate available inventory across our ecosystem and structure provider introductions.
          </p>
        </div>
        <div class="cta-right">
          <a href="/lets-talk?service=dedicated-infrastructure" class="btn btn-cobalt btn-lg">Consult an Infrastructure Architect</a>
          <span class="cta-subtext">Direct Principal Access • Response Under 2 Hours</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .solution-hero {
    padding: 104px 0 72px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .solution-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  .solution-hero-header {
    max-width: 860px;
  }

  .solution-h1 {
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 16px 0 20px;
  }

  .solution-lead {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--color-paper);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 780px;
  }

  .telemetry-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-label-row {
    margin-bottom: 48px;
    max-width: 780px;
  }

  .editorial-h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 650;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 10px 0 12px;
  }

  .section-desc {
    font-size: 1.02rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  /* Situations Grid */
  .situations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .situations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .situation-item {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    padding: 32px 28px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .situation-num {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-sky);
    letter-spacing: 0.08em;
  }

  .situation-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .situation-desc {
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* Solution Approach Row */
  .solution-approach-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: center;
    padding: 24px 28px;
  }

  @media (min-width: 840px) {
    .solution-approach-row {
      grid-template-columns: 180px 220px 1fr auto;
      gap: 24px;
    }
  }

  .approach-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-sky);
  }

  .approach-title {
    font-size: 1.12rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .approach-desc {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  .btn-approach-link {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-sky);
    text-decoration: none;
    white-space: nowrap;
    transition: color 140ms ease;
  }

  .btn-approach-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Diligence Matrix */
  .diligence-matrix {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .diligence-matrix {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .diligence-card {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    padding: 24px 26px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .diligence-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .diligence-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-sky);
  }

  .diligence-factor {
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .diligence-inquiry {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  /* Specialists Grid */
  .specialists-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }

  @media (min-width: 640px) {
    .specialists-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .specialists-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .specialist-card {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    padding: 22px 20px;
    border-radius: 4px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    transition: border-color 140ms ease;
  }

  .specialist-card:hover {
    border-color: var(--color-sky);
  }

  .specialist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .specialist-name {
    font-size: 1.08rem;
    font-weight: 650;
    color: #ffffff;
  }

  .specialist-arrow {
    font-size: 1rem;
    color: var(--color-sky);
  }

  .specialist-role {
    font-size: 0.82rem;
    color: #94a3b8;
    line-height: 1.45;
    margin: 0;
  }

  .operating-disclosure {
    padding: 18px 22px;
    background: rgba(11, 17, 32, 0.6);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
  }

  .disclosure-text {
    font-size: 0.86rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .disclosure-strong {
    color: var(--color-paper);
  }

  /* CTA Band */
  .solution-cta-band {
    padding: 72px 0 96px;
  }

  .cta-inner-card {
    background: #050811;
    border: 1px solid var(--color-hairline);
    border-radius: 6px;
    padding: 54px 44px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 860px) {
    .cta-inner-card {
      grid-template-columns: 1.4fr 1fr;
      gap: 56px;
    }
  }

  .cta-headline {
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin: 10px 0 16px;
  }

  .cta-desc {
    font-size: 1.02rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .cta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .cta-subtext {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-on-dark-muted);
    letter-spacing: 0.04em;
  }
</style>
