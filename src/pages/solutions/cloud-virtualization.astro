---
// src/pages/solutions/cloud-virtualization.astro
// Phase 8: Solution Family Architecture — Cloud & Virtualization
import Layout from '../../layouts/Layout.astro';
import DecisionNavigator, { type DecisionStep } from '../../components/DecisionNavigator.astro';
import CloudTopologyExplorer from '../../components/CloudTopologyExplorer.astro';

const cloudDecisionSteps: DecisionStep[] = [
  {
    id: "workload",
    number: "01",
    title: "Workload Profile",
    lead: "What primary infrastructure challenge are you addressing?",
    options: [
      {
        id: "vmware-exit",
        label: "VMware Migration",
        summary: "Broadcom licensing increases making renewal economically untenable.",
        tradeOff: "Requires hypervisor driver parity and VMDK conversion window.",
        spec: "Target: Vates XCP-ng with warm live migration delta replication."
      },
      {
        id: "sovereign-vpc",
        label: "Sovereign Private Cloud",
        summary: "Regulatory mandates requiring physical single-tenancy and EU jurisdiction.",
        tradeOff: "Slightly higher initial commitment vs pay-as-you-go multi-tenant hyperscalers.",
        spec: "Target: ISO27001/Tier-III facility, zero US CLOUD Act exposure."
      },
      {
        id: "custom-iaas",
        label: "Custom IaaS Stack",
        summary: "Tailored bare-metal hypervisors with dedicated NVMe SAN storage.",
        tradeOff: "Requires capacity planning vs automatic elastic burst.",
        spec: "Target: AMD EPYC 96-core nodes, 100G RoCEv2 storage networking."
      }
    ]
  },
  {
    id: "hypervisor",
    number: "02",
    title: "Hypervisor",
    lead: "Which virtualization engine fits your operational tooling?",
    options: [
      {
        id: "xcp-ng",
        label: "Vates XCP-ng / Xen Orchestra",
        summary: "Turnkey enterprise open-source hypervisor with mature backup/replication.",
        tradeOff: "Replaces vCenter UI with Xen Orchestra management plane.",
        spec: "Support: Enterprise upstream SLA backed directly by Vates maintainers."
      },
      {
        id: "kvm-proxmox",
        label: "KVM / Proxmox VE",
        summary: "Lightweight Linux kernel-based virtualization with native ZFS and Ceph.",
        tradeOff: "Requires Linux systems engineering depth for multi-site clustering.",
        spec: "Storage: Native Ceph hyperconverged storage and Corosync quorum."
      },
      {
        id: "dedicated-vmware",
        label: "Dedicated Single-Tenant VMware",
        summary: "Retains VMware ESXi stack on dedicated hardware to avoid migration.",
        tradeOff: "Subject to Broadcom per-core core-licensing fee schedules.",
        spec: "Compliance: Preserves existing VMware vSphere operational runbooks."
      }
    ]
  },
  {
    id: "storage",
    number: "03",
    title: "Storage Fabric",
    lead: "What IOPS and storage latency does your workload demand?",
    options: [
      {
        id: "all-nvme",
        label: "Dedicated All-NVMe Fabric",
        summary: "Sub-millisecond access for transactional relational and NoSQL databases.",
        tradeOff: "Higher initial storage cost per usable TB than hybrid arrays.",
        spec: "Latency: < 0.25 ms RTT over dedicated 100G NVMe-oF RoCE fabric."
      },
      {
        id: "distributed-ceph",
        label: "Distributed Ceph Cluster",
        summary: "Resilient scale-out block and object storage with self-healing replication.",
        tradeOff: "Requires dedicated network bandwidth and 3+ storage nodes minimum.",
        spec: "Resilience: 3x replication factor with zero single points of failure."
      },
      {
        id: "tiered-storage",
        label: "Tiered NVMe + Capacity Pool",
        summary: "High-speed NVMe tier for hot VM cache with dense SAS pool for cold data.",
        tradeOff: "Cold data tier has lower throughput during bulk retrieval.",
        spec: "Economics: Lowest cost per TB for multi-hundred terabyte footprints."
      }
    ]
  },
  {
    id: "tenancy",
    number: "04",
    title: "Tenancy & Boundary",
    lead: "What hardware isolation level does compliance require?",
    options: [
      {
        id: "single-tenant",
        label: "100% Dedicated Hardware",
        summary: "Entire chassis, CPU sockets, RAM, and NICs assigned exclusively to your organization.",
        tradeOff: "No shared pool pooling; sizing must account for peak headroom.",
        spec: "Security: Physical air-gap between physical hypervisors; zero CPU cache contention."
      },
      {
        id: "private-vlan",
        label: "Private Isolated VLAN / Cluster",
        summary: "Dedicated VLANs and storage LUNs on shared compute nodes with reservation guarantees.",
        tradeOff: "Shared underlying physical chassis; requires trust in hypervisor isolation.",
        spec: "Isolation: Dedicated Layer 2 VXLAN encapsulation and guaranteed RAM reservation."
      }
    ]
  },
  {
    id: "dr",
    number: "05",
    title: "Disaster Recovery",
    lead: "What are your RPO and RTO continuity requirements?",
    options: [
      {
        id: "delta-replication",
        label: "Continuous Delta Replication (RPO < 15m)",
        summary: "Automated incremental block replication to a secondary Tier-III facility.",
        tradeOff: "Requires secondary capacity and dedicated inter-datacenter bandwidth.",
        spec: "RPO: < 15 minutes; automated one-click failover via Xen Orchestra."
      },
      {
        id: "immutable-backup",
        label: "Air-Gapped Immutable Snapshots",
        summary: "Daily encrypted VM backups with retention lock against ransomware modification.",
        tradeOff: "RTO involves boot time from remote backup storage repository.",
        spec: "Security: Write-Once-Read-Many (WORM) S3 object-lock compliance."
      }
    ]
  }
];

const situations = [
  {
    title: "Broadcom / VMware Licensing Escalation",
    detail: "Facing sudden multi-fold licensing cost increases and forced bundling under Broadcom VMware contracts. We evaluate turnkey open-source hypervisor alternatives (Vates XCP-ng) with verified migration paths."
  },
  {
    title: "Data Sovereignty & Legal Compliance",
    detail: "Workloads constrained by GDPR, HIPAA, or sovereign data mandates requiring dedicated physical hypervisors, single-tenant storage, and zero extraterritorial cloud exposure."
  },
  {
    title: "Unpredictable Hyperscaler Consumption",
    detail: "Variable public cloud billing meters for vCPU, RAM, and IOPS making OPEX forecasting impossible. We design dedicated private cloud clusters with fixed monthly commercial models."
  },
  {
    title: "Resilient Multi-Site Disaster Recovery",
    detail: "Cross-region backup pipelines engineered with continuous delta replication, verifiable RPO under 15 minutes, and tested automated recovery runbooks."
  }
];

const approaches = [
  {
    kicker: "HYPERVISOR MIGRATION",
    title: "VMware Alternatives (Vates XCP-ng)",
    desc: "An enterprise alternative to VMware ESXi/vCenter with delta backup, warm live migration, and licensing that is not penalized per CPU core.",
    route: "/partners/vates",
    action: "Explore Vates Architecture →"
  },
  {
    kicker: "DEDICATED SOVEREIGN",
    title: "Private Cloud Sourcing",
    desc: "Single-tenant enterprise virtual private clouds on dedicated hypervisor hardware in Tier-III facilities across Europe, the US, and Asia.",
    route: "/private-cloud",
    action: "Explore Private Cloud →"
  },
  {
    kicker: "TAILORED IAAS",
    title: "Custom IaaS Stacks",
    desc: "Bespoke combinations of dedicated hypervisors, private Layer 2 interconnects, and redundant SAN/Ceph storage arrays.",
    route: "/custom-iaas",
    action: "Explore Custom IaaS →"
  },
  {
    kicker: "BARE-METAL HOSTS",
    title: "Dedicated Virtualization Nodes",
    desc: "High-density dual AMD EPYC and Intel Xeon server nodes configured specifically for virtualization clustering and high-RAM consolidation.",
    route: "/dedicated-servers",
    action: "Explore Dedicated Nodes →"
  },
  {
    kicker: "HYBRID CONNECTIVITY",
    title: "Direct Cloud Interconnect",
    desc: "Private Layer 2 on-ramps connecting dedicated on-premise private clouds directly to AWS, Azure, and Google Cloud environments.",
    route: "/cloud-connectivity",
    action: "Explore Cloud Connect →"
  }
];

const diligenceFactors = [
  {
    factor: "Warm Migration Feasibility",
    inquiry: "Can existing VMDK workloads be converted with warm live delta sync to keep cutover downtime under scheduled maintenance windows?"
  },
  {
    factor: "Hypervisor Overcommit Ratios",
    inquiry: "What are the safe vCPU-to-pCPU and memory allocation ceilings without inducing CPU ready time or noisy-neighbor contention?"
  },
  {
    factor: "Storage IOPS & Fabric Latency",
    inquiry: "Is virtual disk I/O delivered over NVMe-oF, dedicated SAS fabrics, or distributed Ceph clusters with redundant 25G/100G networking?"
  },
  {
    factor: "Enterprise Support Upstream",
    inquiry: "Is hypervisor and orchestration support backed by direct SLA access to core developers and engineering maintainers?"
  }
];

const partners = [
  {
    name: "Vates",
    role: "Open-Source Virtualization Stack (XCP-ng / Xen Orchestra)",
    slug: "vates"
  },
  {
    name: "Zenlayer",
    role: "Distributed Cloud, Edge Compute & Bare-Metal Nodes",
    slug: "zenlayer"
  },
  {
    name: "Gcore",
    role: "Global Cloud, Edge Infrastructure & Managed Hosting",
    slug: "gcore"
  },
  {
    name: "ITcare",
    role: "Hypervisor Management, 24/7 NOC & Cloud Automation",
    slug: "itcare"
  }
];
---

<Layout 
  title="Cloud & Virtualization Solutions (Private Cloud, VMware Alt) | InfraHub"
  description="Escape hyperscaler lock-in and Broadcom licensing shocks. Sourcing private clouds, Vates XCP-ng, and Kubernetes bare-metal nodes."
  canonicalPath="/solutions/cloud-virtualization"
  ogImage="/images/og/solution.png"
  ogImageAlt="InfraHub Cloud & Virtualization solution family"
>
  <!-- Chapter 01: Hero / Discipline Thesis -->
  <section class="section section-bedrock solution-hero blueprint-grid" aria-label="Discipline Overview">
    <div class="container solution-container">
      <div class="solution-hero-header">
        <div class="technical-kicker">Discipline 02 • Sovereign Cloud & Virtualization Architecture</div>
        <h1 class="solution-h1">Cloud &amp; Virtualization</h1>
        <p class="solution-lead">
          Private cloud environments, open-source hypervisors, container platforms, and disaster recovery architectures, evaluated against where data must reside and what licensing actually costs.
        </p>

        <!-- Monospace Telemetry Specs -->
        <div class="telemetry-bar">
          <span class="telemetry-badge telemetry-badge-sky">HYPERVISORS: VATES XCP-NG / KVM</span>
          <span class="telemetry-badge">LICENSING: ZERO PER-CORE TAX</span>
          <span class="telemetry-badge">REPLICATION: SYNCHRONOUS / DELTA DR</span>
          <span class="telemetry-badge">ISOLATION: SINGLE-TENANT HARDWARE</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 02: Situational Triggers -->
  <section class="section section-midnight" aria-label="When This Fits">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Trigger Scenarios</div>
        <h2 class="editorial-h2">When to evaluate private cloud and virtualization migration</h2>
      </div>

      <div class="situations-grid">
        {situations.map((item, idx) => (
          <div class="situation-item">
            <span class="situation-num">0{idx + 1}</span>
            <h3 class="situation-title">{item.title}</h3>
            <p class="situation-desc">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 03: Available Approaches / Sourcing Ledger -->
  <section class="section section-bedrock" aria-label="Available Approaches">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Architecture Portfolio</div>
        <h2 class="editorial-h2">Virtualization and private cloud approaches</h2>
        <p class="section-desc">From full VMware replacement to bespoke sovereign private clouds on single-tenant bare metal.</p>
      </div>

      <DecisionNavigator
        disciplineId="cloud"
        kicker="Interactive Architecture Decision Map"
        heading="Navigate Cloud & Hypervisor Trade-offs"
        subheading="Step through workload sizing, hypervisor selection, and storage fabrics to assemble an exact infrastructure specification."
        serviceParam="cloud"
        steps={cloudDecisionSteps}
      />

      <div class="architectural-ledger">
        {approaches.map((item) => (
          <div class="ledger-row solution-approach-row">
            <div class="ledger-cell cell-kicker">
              <span class="approach-kicker">{item.kicker}</span>
            </div>
            <div class="ledger-cell cell-title">
              <h3 class="approach-title">{item.title}</h3>
            </div>
            <div class="ledger-cell cell-desc">
              <p class="approach-desc">{item.desc}</p>
            </div>
            <div class="ledger-cell cell-action">
              <a href={item.route} class="btn-approach-link">{item.action}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 04: Technical Diligence & Verification -->
  <section class="section section-midnight" aria-label="Engineering Diligence">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Verification Standards</div>
        <h2 class="editorial-h2">What we verify during cloud qualification</h2>
        <p class="section-desc">Migrating hypervisors and private cloud platforms requires rigorous technical analysis before committing production workloads.</p>
      </div>

      <div class="diligence-matrix">
        {diligenceFactors.map((df) => (
          <div class="diligence-card">
            <div class="diligence-header">
              <span class="diligence-dot" aria-hidden="true"></span>
              <h3 class="diligence-factor">{df.factor}</h3>
            </div>
            <p class="diligence-inquiry">{df.inquiry}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 05: Signature Proof Artifact (Sovereign Cloud Architecture) -->
  <section class="section section-bedrock" aria-label="Sovereign Cloud Topology Proof">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Signature Proof</div>
        <h2 class="editorial-h2">Sovereign vs. multi-tenant hypervisor topology</h2>
        <p class="section-desc">Inspect physical hardware isolation, unmetered storage fabrics, and sovereign legal boundaries.</p>
      </div>

      <div class="embedded-exhibit-wrap">
        <CloudTopologyExplorer />
      </div>
    </div>
  </section>

  <!-- Chapter 06: Verified Ecosystem Specialists -->
  <section class="section section-midnight" aria-label="Verified Ecosystem Specialists">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Ecosystem Specialists</div>
        <h2 class="editorial-h2">Verified virtualization &amp; cloud providers</h2>
        <p class="section-desc">InfraHub collaborates with established hypervisor maintainers and sovereign hosting specialists.</p>
      </div>

      <div class="specialists-grid">
        {partners.map((partner) => (
          <a href={`/partners/${partner.slug}`} class="specialist-card" title={`View ${partner.name} architecture profile`}>
            <div class="specialist-header">
              <span class="specialist-name">{partner.name}</span>
              <span class="specialist-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <p class="specialist-role">{partner.role}</p>
          </a>
        ))}
      </div>

      <div class="operating-disclosure">
        <p class="disclosure-text">
          <strong class="disclosure-strong">Delivery Governance:</strong> InfraHub advises on architecture selection, migration scope, and capacity sizing. For partner platforms (such as Vates enterprise stacks), software licensing, implementation engineering, and SLA contracts are provided directly by the specialist provider.
        </p>
      </div>
    </div>
  </section>

  <!-- Chapter 06: Conversion Action -->
  <section class="section section-midnight solution-cta-band" aria-label="Technical Consultation">
    <div class="container solution-container">
      <div class="cta-inner-card">
        <div class="cta-left">
          <div class="technical-kicker">Architecture Diligence</div>
          <h2 class="cta-headline">Evaluate Your Virtualization Migration</h2>
          <p class="cta-desc">
            Share your current VM estate, CPU core footprint, and storage profile. We evaluate hypervisor parity, calculate licensing savings, and coordinate specialist introductions.
          </p>
        </div>
        <div class="cta-right">
          <a href="/lets-talk?service=cloud" class="btn btn-cobalt btn-lg">Consult a Cloud Architect</a>
          <span class="cta-subtext">Direct Principal Access • Response Under 2 Hours</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .solution-hero {
    padding: 104px 0 72px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .solution-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  .solution-hero-header {
    max-width: 860px;
  }

  .solution-h1 {
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 16px 0 20px;
  }

  .solution-lead {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--color-paper);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 780px;
  }

  .telemetry-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-label-row {
    margin-bottom: 48px;
    max-width: 780px;
  }

  .editorial-h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 650;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 10px 0 12px;
  }

  .section-desc {
    font-size: 1.02rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  /* Situations Grid */
  .situations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .situations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .situation-item {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    padding: 32px 28px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .situation-num {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-sky);
    letter-spacing: 0.08em;
  }

  .situation-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .situation-desc {
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* Solution Approach Row */
  .solution-approach-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: center;
    padding: 24px 28px;
  }

  @media (min-width: 840px) {
    .solution-approach-row {
      grid-template-columns: 180px 220px 1fr auto;
      gap: 24px;
    }
  }

  .approach-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-sky);
  }

  .approach-title {
    font-size: 1.12rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .approach-desc {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  .btn-approach-link {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-sky);
    text-decoration: none;
    white-space: nowrap;
    transition: color 140ms ease;
  }

  .btn-approach-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Diligence Matrix */
  .diligence-matrix {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .diligence-matrix {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .diligence-card {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    border-left: 3px solid var(--color-cobalt);
    padding: 24px 26px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .diligence-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .diligence-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-sky);
  }

  .diligence-factor {
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .diligence-inquiry {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  /* Specialists Grid */
  .specialists-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }

  @media (min-width: 640px) {
    .specialists-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .specialists-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .specialist-card {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    padding: 22px 20px;
    border-radius: 4px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    transition: border-color 140ms ease;
  }

  .specialist-card:hover {
    border-color: var(--color-sky);
  }

  .specialist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .specialist-name {
    font-size: 1.08rem;
    font-weight: 650;
    color: #ffffff;
  }

  .specialist-arrow {
    font-size: 1rem;
    color: var(--color-sky);
  }

  .specialist-role {
    font-size: 0.82rem;
    color: #94a3b8;
    line-height: 1.45;
    margin: 0;
  }

  .operating-disclosure {
    padding: 18px 22px;
    background: rgba(11, 17, 32, 0.6);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
  }

  .disclosure-text {
    font-size: 0.86rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .disclosure-strong {
    color: var(--color-paper);
  }

  /* CTA Band */
  .solution-cta-band {
    padding: 72px 0 96px;
  }

  .cta-inner-card {
    background: #050811;
    border: 1px solid var(--color-hairline);
    border-radius: 6px;
    padding: 54px 44px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 860px) {
    .cta-inner-card {
      grid-template-columns: 1.4fr 1fr;
      gap: 56px;
    }
  }

  .cta-headline {
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin: 10px 0 16px;
  }

  .cta-desc {
    font-size: 1.02rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .cta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .cta-subtext {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #64748b;
    letter-spacing: 0.04em;
  }
</style>
