---
// src/pages/solutions/network-connectivity.astro
// Phase 8: Solution Family Architecture — Network & Connectivity
import Layout from '../../layouts/Layout.astro';
import RouteDiversityExplorer from '../../components/RouteDiversityExplorer.astro';

const situations = [
  {
    title: "Egress & Transit Cost Escalation",
    detail: "Public cloud egress charges or transit overage fees are exceeding budgeted infrastructure thresholds. We evaluate multi-Gbps committed transit and direct private interconnects to cap transfer costs."
  },
  {
    title: "Data Center Interconnect (DCI)",
    detail: "Interconnecting geographically dispersed server clusters or colocation footprints with deterministic, unmetered optical DWDM wavelengths engineered for sub-millisecond round-trip times."
  },
  {
    title: "Carrier Path & BGP Multi-Homing",
    detail: "Single-homed uplinks or shared upstream paths creating unacceptable operational single points of failure. We verify dual carrier physical diversity before contracting."
  },
  {
    title: "IPv4 Prefix Exhaustion",
    detail: "Scaling hosting, VPN, or infrastructure footprints constrained by lack of clean address space. We structure clean, RPKI-validated IPv4 lease allocations and transfer brokerage."
  }
];

const approaches = [
  {
    kicker: "WHOLESALE UPSTREAM",
    title: "IP Transit (10G – 400G)",
    desc: "Carrier-neutral upstream transit with 95th percentile burst options, full BGP tables, and community traffic engineering.",
    route: "/ip-transit",
    action: "Explore IP Transit →"
  },
  {
    kicker: "OPTICAL TRANSPORT",
    title: "Dedicated Wavelengths",
    desc: "Lit DWDM optical transport for high-bandwidth datacenter interconnect. Latency follows physical fiber, verified against real subterranean conduit maps.",
    route: "/wavelengths",
    action: "Explore Wavelengths →"
  },
  {
    kicker: "HYBRID ON-RAMP",
    title: "Direct Cloud Connect",
    desc: "Private Layer 2 cross-connects to AWS Direct Connect, Azure ExpressRoute, and Google Cloud, modeled around your exact ingress and egress traffic profile.",
    route: "/cloud-connectivity",
    action: "Explore Cloud Connect →"
  },
  {
    kicker: "PRIVATE ETHERNET",
    title: "Layer 2 Connectivity",
    desc: "Deterministic point-to-point and multipoint Ethernet private lines (E-Line / E-LAN) bypassing the public Internet entirely.",
    route: "/layer-2-connectivity",
    action: "Explore Layer 2 →"
  },
  {
    kicker: "NUMBERING RESOURCES",
    title: "IPv4 Solutions",
    desc: "IPv4 address block leasing and transfer brokerage. RPKI validation, routing acceptance, and reputation history are verified prior to prefix announcement.",
    route: "/ipv4",
    action: "Explore IPv4 Sourcing →"
  }
];

const diligenceFactors = [
  {
    factor: "Commit vs Burst Ratio",
    inquiry: "What is the peak-to-average throughput profile, and does the 95th percentile billing tier impose punitive burst multipliers?"
  },
  {
    factor: "Physical Conduit Diversity",
    inquiry: "Do secondary carrier paths share subterranean bridge crossings, manholes, or building entry points with primary circuits?"
  },
  {
    factor: "Cross-Connect Economics",
    inquiry: "Are facility cross-connect MRCs included in the circuit contract, or billed as uncoordinated recurring charges by the MMR operator?"
  },
  {
    factor: "SLA & Route Failover",
    inquiry: "Are MTTR thresholds backed by contractual credit schedules, and what BGP community strings are available for fine-grained routing control?"
  }
];

const partners = [
  {
    name: "Zenlayer",
    role: "Distributed Cloud, Edge Compute & Global Network Connectivity",
    slug: "zenlayer"
  },
  {
    name: "Gcore",
    role: "Cloud, Edge, AI & Global Content Delivery Network",
    slug: "gcore"
  },
  {
    name: "IPXO",
    role: "Automated IPv4 Address Leasing & Management Platform",
    slug: "ipxo"
  },
  {
    name: "ITcare",
    role: "Network Engineering, 24/7 Managed NOC & Automation",
    slug: "itcare"
  }
];
---

<Layout 
  title="Network & Connectivity Solutions (Transit, Wavelengths, Cloud) | InfraHub"
  description="Carrier-neutral IP Transit, lit optical DWDM wavelengths, Layer 2 Ethernet, cloud interconnects, and clean IPv4 allocations."
  canonicalPath="/solutions/network-connectivity"
  ogImage="/images/og/solution.png"
  ogImageAlt="InfraHub Network & Connectivity solution family"
>
  <!-- Chapter 01: Hero / Discipline Thesis -->
  <section class="section section-bedrock solution-hero blueprint-grid" aria-label="Discipline Overview">
    <div class="container solution-container">
      <div class="solution-hero-header">
        <div class="technical-kicker">Discipline 01 • Wholesale Carrier & Optical Connectivity</div>
        <h1 class="solution-h1">Network &amp; Connectivity</h1>
        <p class="solution-lead">
          Wholesale IP transit, point-to-point lit wavelengths, direct cloud on-ramps, and address allocations sourced across Europe, the Americas, and Asia.
        </p>

        <!-- Monospace Telemetry Specs -->
        <div class="telemetry-bar">
          <span class="telemetry-badge telemetry-badge-sky">COMMITS: 10G – 400G</span>
          <span class="telemetry-badge">PORT PROTOCOLS: BGP / FULL FEEDS</span>
          <span class="telemetry-badge">TRANSPORT: DWDM LIT WAVELENGTHS</span>
          <span class="telemetry-badge">NUMBERING: RPKI VERIFIED IPV4</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Chapter 02: Situational Triggers -->
  <section class="section section-midnight" aria-label="When This Fits">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Trigger Scenarios</div>
        <h2 class="editorial-h2">When to evaluate wholesale network sourcing</h2>
      </div>

      <div class="situations-grid">
        {situations.map((item, idx) => (
          <div class="situation-item">
            <span class="situation-num">0{idx + 1}</span>
            <h3 class="situation-title">{item.title}</h3>
            <p class="situation-desc">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 03: Available Approaches / Sourcing Ledger -->
  <section class="section section-bedrock" aria-label="Available Approaches">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Architecture Portfolio</div>
        <h2 class="editorial-h2">Available connectivity disciplines</h2>
        <p class="section-desc">Each circuit and allocation is structured with explicit technical specifications and verified delivery parameters.</p>
      </div>

      <div class="architectural-ledger">
        {approaches.map((item) => (
          <div class="ledger-row solution-approach-row">
            <div class="ledger-cell cell-kicker">
              <span class="approach-kicker">{item.kicker}</span>
            </div>
            <div class="ledger-cell cell-title">
              <h3 class="approach-title">{item.title}</h3>
            </div>
            <div class="ledger-cell cell-desc">
              <p class="approach-desc">{item.desc}</p>
            </div>
            <div class="ledger-cell cell-action">
              <a href={item.route} class="btn-approach-link">{item.action}</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 04: Technical Diligence & Verification -->
  <section class="section section-midnight" aria-label="Engineering Diligence">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Verification Standards</div>
        <h2 class="editorial-h2">What we verify before carrier introduction</h2>
        <p class="section-desc">Standard sales quotes often obscure physical single-points-of-failure and asymmetric billing models. We establish these factors upfront.</p>
      </div>

      <div class="diligence-matrix">
        {diligenceFactors.map((df) => (
          <div class="diligence-card">
            <div class="diligence-header">
              <span class="diligence-dot" aria-hidden="true"></span>
              <h3 class="diligence-factor">{df.factor}</h3>
            </div>
            <p class="diligence-inquiry">{df.inquiry}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Chapter 05: Signature Proof Artifact (Route Diversity Explorer) -->
  <section class="section section-bedrock" aria-label="Route Diversity Signature Proof">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Signature Proof</div>
        <h2 class="editorial-h2">Physical vs. logical route diversity</h2>
        <p class="section-desc">Why dual carrier contracts frequently fail to provide physical diversity in the ground.</p>
      </div>

      <div class="embedded-exhibit-wrap">
        <RouteDiversityExplorer />
      </div>
    </div>
  </section>

  <!-- Chapter 06: Verified Ecosystem Specialists -->
  <section class="section section-midnight" aria-label="Verified Ecosystem Specialists">
    <div class="container solution-container">
      <div class="section-label-row">
        <div class="technical-kicker">Ecosystem Specialists</div>
        <h2 class="editorial-h2">Verified connectivity providers</h2>
        <p class="section-desc">InfraHub coordinates requirements with specialist carriers and infrastructure providers across our verified ecosystem.</p>
      </div>

      <div class="specialists-grid">
        {partners.map((partner) => (
          <a href={`/partners/${partner.slug}`} class="specialist-card" title={`View ${partner.name} architecture profile`}>
            <div class="specialist-header">
              <span class="specialist-name">{partner.name}</span>
              <span class="specialist-arrow" aria-hidden="true">&rarr;</span>
            </div>
            <p class="specialist-role">{partner.role}</p>
          </a>
        ))}
      </div>

      <div class="operating-disclosure">
        <p class="disclosure-text">
          <strong class="disclosure-strong">Delivery Governance:</strong> InfraHub qualifies technical requirements, verifies physical route diversity, and structures carrier options. For partner-delivered circuits, the selected carrier contracts directly and guarantees operational SLAs under their master services agreement.
        </p>
      </div>
    </div>
  </section>

  <!-- Chapter 07: Conversion Action -->
  <section class="section section-bedrock solution-cta-band" aria-label="Technical Consultation">
    <div class="container solution-container">
      <div class="cta-inner-card">
        <div class="cta-left">
          <div class="technical-kicker">Direct Architecture Scoping</div>
          <h2 class="cta-headline">Source Network Capacity</h2>
          <p class="cta-desc">
            Provide your route endpoints, commit capacity, and diversity requirements. An engineer evaluates matching carrier paths and schedules a technical review.
          </p>
        </div>
        <div class="cta-right">
          <a href="/lets-talk?service=connectivity" class="btn btn-cobalt btn-lg">Consult a Network Architect</a>
          <span class="cta-subtext">Direct Principal Access • Response Under 2 Hours</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .solution-hero {
    padding: 104px 0 72px;
    border-bottom: 1px solid var(--color-hairline);
  }

  .solution-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  .solution-hero-header {
    max-width: 860px;
  }

  .solution-h1 {
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 16px 0 20px;
  }

  .solution-lead {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--color-paper);
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 780px;
  }

  .telemetry-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .section-label-row {
    margin-bottom: 48px;
    max-width: 780px;
  }

  .editorial-h2 {
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    font-weight: 650;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 10px 0 12px;
  }

  .section-desc {
    font-size: 1.02rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  /* Situations Grid */
  .situations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .situations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .situation-item {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    padding: 32px 28px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .situation-num {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-sky);
    letter-spacing: 0.08em;
  }

  .situation-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .situation-desc {
    font-size: 0.92rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  /* Solution Approach Row */
  .solution-approach-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: center;
    padding: 24px 28px;
  }

  @media (min-width: 840px) {
    .solution-approach-row {
      grid-template-columns: 180px 220px 1fr auto;
      gap: 24px;
    }
  }

  .approach-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-sky);
  }

  .approach-title {
    font-size: 1.12rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .approach-desc {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  .btn-approach-link {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-sky);
    text-decoration: none;
    white-space: nowrap;
    transition: color 140ms ease;
  }

  .btn-approach-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Diligence Matrix */
  .diligence-matrix {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .diligence-matrix {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .diligence-card {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    border-left: 3px solid var(--color-cobalt);
    padding: 24px 26px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .diligence-header {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .diligence-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-sky);
  }

  .diligence-factor {
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.4;
    margin: 0;
  }

  .diligence-inquiry {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.55;
    margin: 0;
  }

  /* Embedded Route Explorer */
  .embedded-exhibit-wrap {
    margin-top: 24px;
  }

  /* Specialists Grid */
  .specialists-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }

  @media (min-width: 640px) {
    .specialists-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .specialists-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .specialist-card {
    background: #0f172a;
    border: 1px solid var(--color-hairline);
    padding: 22px 20px;
    border-radius: 4px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    transition: border-color 140ms ease;
  }

  .specialist-card:hover {
    border-color: var(--color-sky);
  }

  .specialist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .specialist-name {
    font-size: 1.08rem;
    font-weight: 650;
    color: #ffffff;
  }

  .specialist-arrow {
    font-size: 1rem;
    color: var(--color-sky);
  }

  .specialist-role {
    font-size: 0.82rem;
    color: #94a3b8;
    line-height: 1.45;
    margin: 0;
  }

  .operating-disclosure {
    padding: 18px 22px;
    background: rgba(11, 17, 32, 0.6);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
  }

  .disclosure-text {
    font-size: 0.86rem;
    color: #94a3b8;
    line-height: 1.5;
    margin: 0;
  }

  .disclosure-strong {
    color: var(--color-paper);
  }

  /* CTA Band */
  .solution-cta-band {
    padding: 72px 0 96px;
  }

  .cta-inner-card {
    background: #0b1120;
    border: 1px solid var(--color-hairline);
    border-radius: 6px;
    padding: 54px 44px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 860px) {
    .cta-inner-card {
      grid-template-columns: 1.4fr 1fr;
      gap: 56px;
    }
  }

  .cta-headline {
    font-size: clamp(2rem, 3.4vw, 2.6rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin: 10px 0 16px;
  }

  .cta-desc {
    font-size: 1.02rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .cta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .cta-subtext {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #64748b;
    letter-spacing: 0.04em;
  }
</style>
