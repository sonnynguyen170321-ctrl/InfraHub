---
// src/pages/enterprise-hardware.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Enterprise Server & Network Hardware Sourcing | InfraHub"
  description="Source new and refurbished enterprise server, switching, and optical hardware. Compare condition, testing, warranty, stock, lead time, and supplier terms before purchase."
  canonicalPath="/enterprise-hardware"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">Hardware Direct</span>
          <span class="pill-badge badge-teal">Mode A Sourcing</span>
        </div>
        <h1 class="service-title">Enterprise Hardware Procurement</h1>
        <p class="service-lead">
          InfraHub can source new and refurbished enterprise server, switching, optical, and storage hardware. Testing, warranty, condition, stock, and delivery commitments are confirmed against the specific supplier quotation.
        </p>
        <div class="service-hero-actions">
          <a href="/offers/dell-poweredge-r650-refurbished" class="btn btn-accent btn-lg">View Featured R650 Server</a>
          <a href="/lets-talk?service=hardware" class="btn btn-secondary btn-lg">Request Custom Hardware Quote</a>
        </div>
      </div>

      <div class="content-section">
        <span class="section-sub-tag">Quality Assurance</span>
        <h2>When Refurbished Hardware Can Make Sense</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <h3>50%-70% Cost Reduction</h3>
            <p>Acquire identical enterprise reliability (Dell R650/R750) at a fraction of manufacturer list pricing.</p>
          </div>
          <div class="problem-card">
            <h3>48-Hour Dispatch from EU Stock</h3>
            <p>Skip 16-week factory lead times. In-stock components ship configured and burn-in tested immediately.</p>
          </div>
          <div class="problem-card">
            <h3>3-Year Advanced Replacement</h3>
            <p>All hardware comes backed by standard 3-year advanced hardware replacement warranties.</p>
          </div>
        </div>
      </div>

      <div class="service-footer-cta">
        <h2>Request Hardware Pricing & Inventory</h2>
        <a href="/lets-talk?service=hardware" class="btn btn-accent btn-lg">Contact Hardware Sourcing Desk</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container { max-width: 1040px; }
  .service-header { text-align: left; max-width: 860px; margin: 0 0 64px; padding-bottom: 24px; border-bottom: 1px solid var(--border-color); }
  .header-badge-row { display: flex; justify-content: flex-start; gap: 8px; margin-bottom: 16px; }
  .service-title { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 20px; }
  .service-lead { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 32px; }
  .service-hero-actions { display: flex; justify-content: center; gap: 14px; }
  .content-section { margin-bottom: 72px; }
  .section-sub-tag { display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent-blue); margin-bottom: 8px; }
  .content-section h2 { font-size: 1.85rem; font-weight: 700; margin-bottom: 18px; }
  .problem-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }
  .problem-card { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; }
  .problem-card h3 { font-size: 1.1rem; margin-bottom: 10px; color: var(--text-primary); }
  .problem-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
  .service-footer-cta { padding: 40px 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 16px; border-top: 1px solid var(--border-color); }
</style>
