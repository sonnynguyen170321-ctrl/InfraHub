---
// src/pages/offers/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { publicPriceLabel } from '../../lib/offer-pricing';

const now = new Date();
const allOffers = await getCollection('offers');
const activeOffers = allOffers
  .filter(o => {
    if (!o.data.publicApproved) return false;
    if (o.data.status !== 'active') return false;
    if (o.data.expiryDate && now > o.data.expiryDate) return false;
    return true;
  })
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());
---

<Layout 
  title="Commercial Opportunities & Infrastructure Allocations — InfraHub"
  description="Explore current commercial opportunities across dedicated servers, IP transit, hardware, and DDoS protection available through the InfraHub partner network."
  canonicalPath="/offers"
  ogImage="/images/og/offer.png"
  ogImageAlt="InfraHub commercial sourcing board"
>
  <div class="offers-page-wrapper">
    <div class="container offers-container">
      
      <!-- Editorial Header -->
      <header class="offers-header">
        <span class="offers-kicker">Commercial Sourcing Board</span>
        <h1 class="offers-title">Featured Infrastructure Offers</h1>
        <p class="offers-lead">
          Current public opportunities that have cleared InfraHub's publication checks. Availability and commercial terms remain subject to the specific provider or supplier confirmation.
        </p>
      </header>

      <!-- Empty State Guard -->
      {activeOffers.length === 0 ? (
        <div class="offers-empty-state">
          <div class="empty-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
          <h2 class="empty-title">No open public allocations at this time.</h2>
          <p class="empty-desc">
            Public commercial allocations are being updated for the current cycle. Infrastructure sourcing requests and bespoke quotations are evaluated continuously on demand.
          </p>
          <a href="/lets-talk" class="btn btn-accent btn-lg">
            <span>Discuss your specific requirement</span>
            <span class="link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      ) : (
        <!-- Structured Commercial Board -->
        <div class="commercial-board">
          {activeOffers.map(offer => (
            <article class="board-row-item">
              <div class="board-col-main">
                <div class="board-badge-group">
                  <span class="category-pill">{offer.data.category}</span>
                  <span class="location-label">{offer.data.location}</span>
                </div>
                <h2 class="board-title">
                  <a href={`/offers/${offer.slug}`}>{offer.data.title}</a>
                </h2>
                <p class="board-desc">{offer.data.shortDescription}</p>
                <div class="board-specs">
                  {offer.data.specifications.slice(0, 2).map(spec => (
                    <span class="spec-tag">{spec}</span>
                  ))}
                </div>
              </div>

              <div class="board-col-commercial">
                <div class="price-block">
                  <span class="price-term">Commercial Rate</span>
                  <span class="price-amount">{publicPriceLabel(offer.data)}</span>
                </div>
                <div class="board-actions">
                  <a href={`/offers/${offer.slug}`} class="btn btn-secondary btn-sm">
                    <span>Details</span>
                  </a>
                  <a href={`/lets-talk?offer=${offer.slug}`} class="btn btn-accent btn-sm">
                    <span>Request Terms</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}

      <!-- Bottom Advisory Note -->
      <div class="offers-advisory-note">
        <p>
          <strong>Need a custom configuration?</strong> InfraHub quotes custom server specs, high-bandwidth optical waves, and multi-region transit allocations not listed on the public board. <a href="/lets-talk">Talk with an infrastructure sourcing advisor &rarr;</a>
        </p>
      </div>

    </div>
  </div>
</Layout>

<style>
  .offers-page-wrapper {
    background-color: #ffffff;
    padding: 80px 0 112px;
  }

  .offers-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .offers-header {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 48px;
  }

  .offers-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }

  .offers-title {
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .offers-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  /* Empty State */
  .offers-empty-state {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 64px 32px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-width: 680px;
    margin: 0 auto;
  }

  .empty-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .empty-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Commercial Board */
  .commercial-board {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .board-row-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 38px 36px;
    border-bottom: 1px solid var(--border-color);
    background: #ffffff;
    align-items: center;
    transition: background 160ms ease;
  }

  .board-row-item:hover {
    background: #fbfcfe;
  }

  .board-row-item:last-child {
    border-bottom: none;
  }

  @media (min-width: 860px) {
    .board-row-item {
      grid-template-columns: 1fr 240px;
      gap: 44px;
    }
  }

  .board-col-main {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .board-badge-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .category-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-blue);
    background: #eff6ff;
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.01em;
  }

  .location-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #64748b;
  }

  .board-title {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.45;
  }

  .board-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .board-title a:hover {
    color: var(--accent-blue);
  }

  .board-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  .board-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .spec-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #475569;
    background: #f1f5f9;
    padding: 3px 8px;
    border-radius: 4px;
  }

  /* Commercial Column */
  .board-col-commercial {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  @media (min-width: 860px) {
    .board-col-commercial {
      align-items: flex-end;
      text-align: right;
    }
  }

  .price-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .price-term {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #64748b;
    letter-spacing: 0.01em;
  }

  .price-amount {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .board-actions {
    display: flex;
    gap: 10px;
  }

  /* Advisory Note */
  .offers-advisory-note {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-blue);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
  }

  .offers-advisory-note p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .offers-advisory-note a {
    color: var(--accent-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .offers-advisory-note a:hover {
    text-decoration: underline;
  }
</style>
