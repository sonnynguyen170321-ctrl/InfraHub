---
// src/pages/offers/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { publicPriceLabel } from '../../lib/offer-pricing';

export async function getStaticPaths() {
  const now = new Date();
  const offers = await getCollection('offers');
  return offers
    .filter(offer => {
      if (!offer.data.publicApproved) return false;
      if (offer.data.status !== 'active') return false;
      if (offer.data.expiryDate && now > offer.data.expiryDate) return false;
      return true;
    })
    .map(offer => ({
      params: { slug: offer.slug },
      props: { offer }
    }));
}

const { offer } = Astro.props;
const { Content } = await offer.render();

const SITE = 'https://infrahub.tech';
const offerUrl = `${SITE}/offers/${offer.slug}`;

// Hardware is a Product; transit, colocation, scrubbing and the rest are Services. Branching
// on the collection's own category keeps the markup describing what the thing actually is
// rather than forcing everything into one shape.
const isHardware = offer.data.category === 'hardware';

// Never render a record's price string directly. publicPriceLabel returns the exact price
// only when the record carries owner approval, a confirmed price status, a display value and
// a source reference; otherwise it returns the request label.
const priceLabel = publicPriceLabel(offer.data);

// Partner-delivered services are contracted by the provider; directly sourced hardware is
// confirmed per quotation. The two are different transactions, so they say different things.
const isPartnerDelivered = Boolean(offer.data.partner) && !isHardware;

// Public offer pages deliberately keep structured data conservative.
// InfraHub may source hardware directly, while partner-delivered services are contracted by
// the selected provider. The content model does not yet encode enough verified contractual
// detail to assert a universal seller/provider relationship in schema.org markup.
const primaryNode = isHardware
  ? {
      '@type': 'Product',
      '@id': `${offerUrl}#product`,
      name: offer.data.title,
      description: offer.data.shortDescription,
      category: offer.data.category
    }
  : {
      '@type': 'Service',
      '@id': `${offerUrl}#service`,
      name: offer.data.title,
      description: offer.data.shortDescription,
      serviceType: offer.data.category,
      areaServed: offer.data.location
    };

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    primaryNode,
    {
      '@type': 'BreadcrumbList',
      '@id': `${offerUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
        { '@type': 'ListItem', position: 2, name: 'Featured Offers', item: `${SITE}/offers` },
        { '@type': 'ListItem', position: 3, name: offer.data.title }
      ]
    }
  ]
};
---

<Layout 
  title={`${offer.data.title} — Offer Details`}
  description={offer.data.shortDescription}
  canonicalPath={`/offers/${offer.slug}`}
  ogImage="/images/og/offer.png"
  ogImageAlt="InfraHub commercial sourcing board"
>
  <div class="section section-hero network-overlay">
    <div class="container offer-detail-container">
      <div class="offer-detail-main">
        <div class="offer-detail-header">
          <div class="offer-tags">
            <span class="pill-badge badge-blue">{offer.data.category}</span>
            <span class="pill-badge badge-teal">{offer.data.status}</span>
          </div>
          <h1 class="offer-main-title">{offer.data.title}</h1>
          <div class="offer-meta-strip">
            <div class="meta-item">
              <span class="meta-label">Location</span>
              <span class="meta-val">{offer.data.location}</span>
            </div>
            {offer.data.partner && (
              <div class="meta-item">
                <span class="meta-label">Partner Delivery</span>
                <span class="meta-val">{offer.data.partner}</span>
              </div>
            )}
            <div class="meta-item">
              <span class="meta-label">Pricing</span>
              <span class="meta-val price-accent">{priceLabel}</span>
            </div>
          </div>
        </div>

        <div class="offer-body-content">
          <h2>Core Technical Specifications</h2>
          <ul class="specs-checklist">
            {offer.data.specifications.map(spec => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{spec}</span>
              </li>
            ))}
          </ul>

          <div class="markdown-prose">
            <Content />
          </div>

          <div class="what-happens-next">
            <h2>What happens after requesting this offer?</h2>
            <p>
              InfraHub reviews the request and confirms current availability, technical conditions, and commercial terms with the relevant supplier or provider where applicable.
            </p>
            {isPartnerDelivered && (
              <p>
                The selected provider confirms the applicable contract, service commitments, implementation and delivery terms.
              </p>
            )}
            {isHardware && (
              <p>
                For directly sourced hardware, supply, warranty, testing and delivery terms are confirmed per quotation with the sourcing supplier.
              </p>
            )}
          </div>
        </div>
      </div>

      <!-- Right Column: Sticky Request Card -->
      <aside class="offer-sidebar">
        <div class="request-card">
          <span class="request-price-label">Commercial Pricing</span>
          <div class="request-price">{priceLabel}</div>
          <p class="request-terms">Availability, technical conditions and commercial terms are confirmed per request.</p>

          <a href={`/lets-talk?offer=${offer.slug}`} class="btn btn-accent btn-block btn-lg">
            <span>Request This Offer</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <p class="request-note">
            InfraHub confirms current availability and commercial terms with the relevant supplier or provider before anything is committed.
          </p>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
</Layout>

<style>
  .offer-detail-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: flex-start;
  }
  @media (min-width: 992px) {
    .offer-detail-container {
      grid-template-columns: 1fr 360px;
    }
  }

  .offer-tags {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }

  .offer-main-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 24px;
  }

  .offer-meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    padding: 24px 32px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    margin-bottom: 48px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .meta-label {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .meta-val {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-primary);
  }
  .price-accent {
    color: var(--accent-blue);
  }

  .specs-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 16px 0 32px;
  }
  .specs-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 1rem;
    color: var(--text-secondary);
  }
  .specs-checklist svg {
    margin-top: 3px;
    flex-shrink: 0;
  }

  .markdown-prose {
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }
  .markdown-prose h2, .markdown-prose h3 {
    margin: 24px 0 12px;
    color: var(--text-primary);
  }
  .markdown-prose p {
    margin-bottom: 16px;
  }

  .what-happens-next {
    padding: 32px 36px;
    background-color: var(--accent-teal-light);
    border: 1px solid rgba(13, 148, 136, 0.25);
    border-radius: var(--radius-md);
  }
  .what-happens-next h2 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #0f766e;
    margin-bottom: 10px;
  }
  .what-happens-next p {
    font-size: 0.94rem;
    color: #115e59;
    line-height: 1.6;
  }

  /* Sticky Sidebar */
  .offer-sidebar {
    position: sticky;
    top: calc(var(--header-height) + 24px);
  }

  .request-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 36px;
    box-shadow: var(--shadow-lg);
  }

  .request-price-label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .request-price {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 6px 0 10px;
  }
  .request-terms {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    line-height: 1.4;
  }

  .request-note {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }
</style>
