---
// src/pages/private-cloud.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Private Cloud Sourcing & Sovereign Infrastructure — InfraHub"
  description="Source compliant, single-tenant private cloud platforms hosted in sovereign European datacenters with full hypervisor isolation."
  canonicalPath="/private-cloud"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">Cloud Infrastructure</span>
          <span class="pill-badge badge-teal">Partner Delivered</span>
        </div>
        <h1 class="service-title">Dedicated Private Cloud Sourcing</h1>
        <p class="service-lead">
          Achieve cloud agility without cloud sprawl. We help enterprises source dedicated private cloud clusters with single-tenant compute nodes, software-defined storage, and strict data residency compliance.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=private-cloud" class="btn btn-accent btn-lg">Request Private Cloud Sourcing</a>
        </div>
      </div>

      <div class="content-section">
        <span class="section-sub-tag">Enterprise Value</span>
        <h2>Why Sovereign Private Cloud</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <h3>Jurisdictional Sovereignty</h3>
            <p>Sovereign European legal jurisdiction under GDPR and NIS2 with zero extraterritorial US CLOUD Act exposure.</p>
          </div>
          <div class="problem-card">
            <h3>Fixed Predictable Costs</h3>
            <p>Eliminate volatile API request bills, per-core licensing surcharges, and punitive cloud egress fees.</p>
          </div>
          <div class="problem-card">
            <h3>Single-Tenant Isolation</h3>
            <p>Dedicated physical CPU cores, memory channels, and encrypted NVMe storage isolated from all external tenants.</p>
          </div>
        </div>
      </div>

      <div class="service-footer-cta text-center">
        <h2>Design Your Private Cloud Topology</h2>
        <a href="/lets-talk?service=private-cloud" class="btn btn-accent btn-lg">Consult a Cloud Architect</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container { max-width: 1040px; }
  .service-header { text-align: center; max-width: 820px; margin: 0 auto 64px; }
  .header-badge-row { display: flex; justify-content: center; gap: 8px; margin-bottom: 16px; }
  .service-title { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 20px; }
  .service-lead { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 32px; }
  .service-hero-actions { display: flex; justify-content: center; gap: 14px; }
  .content-section { margin-bottom: 72px; }
  .section-sub-tag { display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-blue); margin-bottom: 8px; }
  .content-section h2 { font-size: 1.85rem; font-weight: 700; margin-bottom: 18px; }
  .problem-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }
  .problem-card { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; }
  .problem-card h3 { font-size: 1.1rem; margin-bottom: 10px; color: var(--text-primary); }
  .problem-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
  .service-footer-cta { padding: 40px 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
</style>
