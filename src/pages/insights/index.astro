---
// src/pages/insights/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allInsights = await getCollection('insights');
allInsights.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<Layout 
  title="Technical Insights & Network Analysis — InfraHub"
  description="Practical engineering analyses on IP transit economics, physical route diversity, VMware migration strategies, and DDoS mitigation architectures."
  canonicalPath="/insights"
>
  <div class="section section-hero network-overlay">
    <div class="container">
      <header class="catalog-header">
        <span class="catalog-kicker">ENGINEERING INTELLIGENCE & ANALYSIS</span>
        <h1 class="catalog-title">Technical Insights for Infrastructure Buyers</h1>
        <p class="catalog-lead">Rigorous, vendor-neutral analysis written for network engineers, systems architects, and infrastructure directors.</p>
      </header>

      <div class="insights-archive-grid">
        {allInsights.map(insight => (
          <article class="insight-card">
            <div class="insight-card-top">
              <div class="insight-meta">
                <span class="pill-badge badge-teal">{insight.data.category}</span>
                <span class="insight-time">{insight.data.readTime}</span>
              </div>
              <h2 class="insight-title">
                <a href={`/insights/${insight.slug}`}>{insight.data.title}</a>
              </h2>
              <p class="insight-summary">{insight.data.summary}</p>
            </div>
            <div class="insight-card-bottom">
              <a href={`/insights/${insight.slug}`} class="btn btn-secondary btn-sm">
                <span>Read Full Analysis</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .insights-archive-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    margin-top: 48px;
  }
  @media (min-width: 640px) {
    .insights-archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .insights-archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .insight-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--transition);
  }
  .insight-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .insight-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .insight-time {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .insight-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 12px;
  }
  .insight-title a:hover {
    color: var(--accent-blue);
  }

  .insight-summary {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .insight-card-bottom {
    padding-top: 16px;
    border-top: 1px solid var(--border-color);
  }
</style>
