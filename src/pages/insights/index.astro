---
// src/pages/insights/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allInsights = await getCollection('insights');
allInsights.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const leadArticle = allInsights[0];
const remainingArticles = allInsights.slice(1);
---

<Layout 
  title="Technical Insights & Network Analysis — InfraHub"
  description="Practical engineering analyses on IP transit economics, physical route diversity, VMware migration strategies, and DDoS mitigation architectures."
  canonicalPath="/insights"
  ogImage="/images/og/insight.png"
  ogImageAlt="InfraHub technical insights"
>
  <div class="insights-page-wrapper">
    <div class="container insights-container">
      
      <!-- Publication Header -->
      <header class="insights-header">
        <span class="insights-kicker">Engineering Analysis</span>
        <h1 class="insights-title">Technical Insights for Infrastructure Buyers</h1>
        <p class="insights-lead">
          Practical technical analysis, architecture frameworks, and economic evaluations for infrastructure directors, network engineers, and systems architects.
        </p>
      </header>

      <!-- Lead Featured Article -->
      {leadArticle && (
        <article class="lead-article-card">
          <div class="lead-article-visual">
            <img 
              src="/images/physical-route-diversity.jpg" 
              alt={leadArticle.data.title}
              class="lead-img"
              width="800"
              height="450"
            />
          </div>
          <div class="lead-article-content">
            <div class="article-meta">
              <span class="meta-category">{leadArticle.data.category}</span>
              <span class="meta-separator">/</span>
              <span class="meta-time">{leadArticle.data.readTime}</span>
            </div>
            <h2 class="lead-title">
              <a href={`/insights/${leadArticle.slug}`}>{leadArticle.data.title}</a>
            </h2>
            <p class="lead-summary">{leadArticle.data.summary}</p>
            <div class="lead-action">
              <a href={`/insights/${leadArticle.slug}`} class="btn btn-secondary btn-sm">
                <span>Read Analysis</span>
                <span class="link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      )}

      <!-- Archive / Chronological Entries -->
      <div class="insights-archive-section">
        <h2 class="archive-heading">All Technical Analyses</h2>
        
        <div class="insights-archive-list">
          {remainingArticles.map(article => (
            <article class="archive-row-item">
              <div class="archive-meta">
                <span class="meta-category">{article.data.category}</span>
                <span class="meta-separator">/</span>
                <span class="meta-time">{article.data.readTime}</span>
              </div>
              <div class="archive-body">
                <h3 class="archive-title">
                  <a href={`/insights/${article.slug}`}>{article.data.title}</a>
                </h3>
                <p class="archive-summary">{article.data.summary}</p>
              </div>
              <div class="archive-action">
                <a href={`/insights/${article.slug}`} class="archive-read-link">
                  <span>Read</span>
                  <span class="link-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .insights-page-wrapper {
    background-color: #ffffff;
    padding: 72px 0 96px;
  }

  .insights-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .insights-header {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 40px;
  }

  .insights-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }

  .insights-title {
    font-size: clamp(2.4rem, 4.4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .insights-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  /* Lead Featured Article */
  .lead-article-card {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .lead-article-card {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }
  }

  .lead-article-visual {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .lead-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 16 / 10;
  }

  .lead-article-content {
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .meta-category {
    font-weight: 700;
    color: var(--accent-blue);
  }

  .meta-separator {
    color: #94a3b8;
  }

  .meta-time {
    color: #64748b;
  }

  .lead-title {
    font-size: clamp(1.5rem, 2.5vw, 1.9rem);
    font-weight: 700;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }

  .lead-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .lead-title a:hover {
    color: var(--accent-blue);
  }

  .lead-summary {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .lead-action {
    padding-top: 8px;
  }

  /* Archive List */
  .insights-archive-section {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .archive-heading {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .insights-archive-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .archive-row-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 24px 28px;
    border-bottom: 1px solid var(--border-color);
    background: #ffffff;
    align-items: center;
    transition: background 160ms ease;
  }

  .archive-row-item:hover {
    background: #f8fafc;
  }

  .archive-row-item:last-child {
    border-bottom: none;
  }

  @media (min-width: 800px) {
    .archive-row-item {
      grid-template-columns: 180px 1fr 90px;
      gap: 32px;
    }
  }

  .archive-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .archive-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .archive-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .archive-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .archive-title a:hover {
    color: var(--accent-blue);
  }

  .archive-summary {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  .archive-action {
    display: flex;
    justify-content: flex-end;
  }

  .archive-read-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
  }

  .link-arrow {
    transition: transform 160ms ease;
    display: inline-block;
  }

  .archive-row-item:hover .link-arrow {
    transform: translateX(3px);
  }
</style>
