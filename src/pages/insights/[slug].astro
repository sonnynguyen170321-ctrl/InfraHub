---
// src/pages/insights/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map(insight => ({
    params: { slug: insight.slug },
    props: { insight }
  }));
}

const { insight } = Astro.props;
const { Content } = await insight.render();

const SITE = 'https://infrahub.tech';
const articleUrl = `${SITE}/insights/${insight.slug}`;

// TechArticle rather than Article: these are engineering analyses, and the more specific type
// is what the content actually is. Every value below comes from the content collection  -  no
// field is asserted that the front matter does not already carry, and `image` is omitted
// rather than invented because the build ships no article artwork.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${articleUrl}#article`,
      headline: insight.data.title,
      description: insight.data.summary,
      datePublished: insight.data.publishDate.toISOString(),
      articleSection: insight.data.category,
      inLanguage: 'en',
      author: {
        '@type': 'Organization',
        name: insight.data.author
      },
      publisher: {
        '@type': 'Organization',
        name: 'InfraHub',
        url: SITE
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${articleUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
        { '@type': 'ListItem', position: 2, name: 'Insights', item: `${SITE}/insights` },
        { '@type': 'ListItem', position: 3, name: insight.data.title }
      ]
    }
  ]
};
---

<Layout 
  title={`${insight.data.title} | InfraHub Insights`}
  description={insight.data.summary}
  canonicalPath={`/insights/${insight.slug}`}
  ogImage="/images/og/insight.png"
  ogImageAlt="InfraHub technical insight"
  ogType="article"
>
  <article class="section section-hero network-overlay">
    <div class="container article-container">
      <div class="article-header">
        <div class="article-meta-top">
          <span class="pill-badge badge-teal">{insight.data.category}</span>
          <span class="article-read-time">{insight.data.readTime}</span>
        </div>
        <h1 class="article-headline">{insight.data.title}</h1>
        <p class="article-sub">{insight.data.summary}</p>
        <div class="article-author-strip">
          <span>By {insight.data.author}</span>
          <span>·</span>
          <span>Published {insight.data.publishDate.toISOString().slice(0, 10)}</span>
        </div>
      </div>

      <div class="article-content-body">
        <Content />
      </div>

      <div class="article-footer-cta">
        <h2>Have a related infrastructure question?</h2>
        <p>Talk to our network and cloud architects to evaluate your specific workload constraints.</p>
        <a href="/lets-talk" class="btn btn-accent btn-lg">Start a Technical Conversation</a>
      </div>
    </div>
  </article>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
</Layout>

<style>
  .article-container {
    max-width: 840px;
  }

  .article-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border-color);
  }

  .article-meta-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .article-read-time {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .article-headline {
    font-size: clamp(2.2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .article-sub {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .article-author-strip {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .article-content-body {
    line-height: 1.8;
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .article-content-body h2 {
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 40px 0 16px;
  }

  .article-content-body h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 28px 0 12px;
  }

  .article-content-body p {
    margin-bottom: 20px;
  }

  .article-content-body ul, .article-content-body ol {
    padding-left: 24px;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .article-footer-cta {
    margin-top: 64px;
    padding: 48px 36px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .article-footer-cta h2 {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .article-footer-cta p {
    color: var(--text-secondary);
    max-width: 540px;
  }
</style>
