---
// src/pages/gpu-ai-infrastructure.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="GPU & AI Infrastructure Sourcing (NVIDIA H100, L40S) | InfraHub"
  description="Source high-density GPU bare-metal servers and AI training clusters with high-bandwidth InfiniBand and RoCE networking across specialized datacenter facilities."
  canonicalPath="/gpu-ai-infrastructure"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">AI & High-Performance Compute</span>
          <span class="pill-badge badge-teal">Partner Sourced</span>
        </div>
        <h1 class="service-title">GPU & AI Infrastructure Sourcing</h1>
        <p class="service-lead">
          Secure dedicated GPU compute for large-language model (LLM) training, inference scaling, and computer vision workloads without long hyperscaler queue delays or exorbitant pricing.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=gpu-ai" class="btn btn-accent btn-lg">Request GPU Cluster Availability</a>
        </div>
      </div>

      <div class="content-section">
        <span class="section-sub-tag">GPU Accelerators</span>
        <h2>Representative Partner GPU Architectures</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <h3>NVIDIA H100 SXM5 / PCIe</h3>
            <p>Partner-provisioned configurations featuring 80GB HBM3 memory and up to 3.2 Tbps bi-directional NVLink interconnect for foundation model pre-training and distributed clusters.</p>
          </div>
          <div class="problem-card">
            <h3>NVIDIA L40S & A100</h3>
            <p>Partner cluster profiles for high-efficiency inference acceleration, fine-tuning, and multimodal generation with PCIe Gen5 bandwidth.</p>
          </div>
          <div class="problem-card">
            <h3>High-Density AI Colocation</h3>
            <p>Facilities delivering 30kW to 60kW+ per cabinet with rear-door heat exchangers or direct-to-chip liquid cooling.</p>
          </div>
        </div>
      </div>

      <div class="service-footer-cta">
        <h2>Source GPU Compute Capacity</h2>
        <a href="/lets-talk?service=gpu-ai" class="btn btn-accent btn-lg">Consult a GPU Solutions Architect</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container { max-width: 1040px; }
  .service-header { text-align: left; max-width: 860px; margin: 0 0 64px; padding-bottom: 24px; border-bottom: 1px solid var(--border-color); }
  .header-badge-row { display: flex; justify-content: flex-start; gap: 8px; margin-bottom: 16px; }
  .service-title { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 20px; }
  .service-lead { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 32px; }
  .service-hero-actions { display: flex; justify-content: center; gap: 14px; }
  .content-section { margin-bottom: 72px; }
  .section-sub-tag { display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; color: var(--accent-blue); margin-bottom: 8px; }
  .content-section h2 { font-size: 1.85rem; font-weight: 700; margin-bottom: 18px; }
  .problem-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }
  .problem-card { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; }
  .problem-card h3 { font-size: 1.1rem; margin-bottom: 10px; color: var(--text-primary); }
  .problem-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
  .service-footer-cta { padding: 40px 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: 16px; border-top: 1px solid var(--border-color); }
</style>
