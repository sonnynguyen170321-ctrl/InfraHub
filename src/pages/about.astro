---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';

// The commercial roles are data rather than three repeated card blocks: the page reads as an
// ordered account of how a transaction actually happens, not as a feature grid.
const roles = [
  {
    index: '01',
    type: 'Sourcing & procurement',
    title: 'Hardware sourcing',
    desc: 'Sourcing enterprise server hardware, optical transceivers, switches, and related infrastructure through specialist suppliers. Warranty, stock, testing, and delivery terms are confirmed for each quotation rather than assumed across suppliers.',
    scope: 'Servers / Switches / Optics / Memory allocations'
  },
  {
    index: '02',
    type: 'Specialist introduction',
    title: 'Partner-delivered services',
    desc: 'InfraHub reviews the requirement and coordinates an introduction to the selected provider. The provider contracts and operates the service under its own agreement and service commitments.',
    scope: 'IP transit / Wavelengths / DDoS scrubbing / Managed NOC'
  },
  {
    index: '03',
    type: 'Architecture & evaluation',
    title: 'Advisory & evaluation',
    desc: 'InfraHub helps compare technical and commercial options: multi-carrier BGP evaluations, physical path diversity reviews, and hypervisor migration cost comparisons.',
    scope: 'Route diversity / BGP strategy / VMware alternatives'
  }
];
---

<Layout 
  title="About InfraHub — Infrastructure Sourcing & Advisory"
  description="Learn about InfraHub's commercial model, delivery roles, and mission to connect businesses with specialist infrastructure providers."
  canonicalPath="/about"
>
  <div class="about-page-wrapper">
    <div class="container about-container">
      
      <!-- Editorial Header -->
      <header class="about-header">
        <span class="about-kicker">Company &amp; Commercial Model</span>
        <h1 class="about-title">Better infrastructure decisions begin with understanding the requirement.</h1>
        <p class="about-lead">
          InfraHub provides infrastructure sourcing and technical advisory. We help engineering and commercial teams clarify technical constraints, compare architectural options, and reach specialist providers across networking, compute, cloud, security, and hardware.
        </p>
      </header>

      <!-- Business Architecture Narrative -->
      <section class="about-narrative-section">
        <div class="narrative-grid">
          <div class="narrative-main">
            <h2 class="narrative-heading">How InfraHub Operates</h2>
            <p class="narrative-prose">
              The modern infrastructure market is fragmented. No single carrier, cloud hyperscaler, or hardware distributor leads across every metro, route, and workload.
            </p>
            <p class="narrative-prose">
              InfraHub clarifies technical parameters—such as committed data rates, latency thresholds, physical conduit diversity, and hypervisor dependencies—before identifying providers suited to that scope.
            </p>
          </div>

          <div class="commercial-disclosure-box">
            <h3 class="disclosure-title">Commercial role</h3>
            <p class="disclosure-text">
              InfraHub's commercial role can vary by engagement and is clarified before an introduction or transaction proceeds.
            </p>
            <p class="disclosure-text">
              Provider-specific pricing, contracting and service commitments are confirmed with the selected provider.
            </p>
          </div>
        </div>
      </section>

      <!-- Three Commercial Delivery Roles -->
      <section class="roles-section">
        <div class="roles-header">
          <h2 class="roles-title">How a requirement is delivered</h2>
          <p class="roles-subhead">
            Infrastructure requirements differ in delivery mechanics. InfraHub states its role in each one before anything proceeds.
          </p>
        </div>

        <div class="roles-rows">
          {roles.map(role => (
            <article class="role-row">
              <div class="role-row-meta">
                <span class="role-index">{role.index}</span>
                <span class="role-type">{role.type}</span>
              </div>
              <div class="role-row-body">
                <h3 class="role-title">{role.title}</h3>
                <p class="role-desc">{role.desc}</p>
              </div>
              <p class="role-scope">{role.scope}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Closing Direct Action -->
      <section class="about-cta-band">
        <div class="cta-inner">
          <div class="cta-copy">
            <h2 class="cta-title">Discuss an upcoming infrastructure requirement.</h2>
            <p class="cta-desc">Whether you have a known specification or need assistance benchmarking options, our advisory desk is ready to review your constraints.</p>
          </div>
          <div class="cta-actions">
            <a href="/lets-talk" class="btn btn-accent btn-lg">Discuss your requirement</a>
            <a href="/partners" class="cta-link">
              <span>Review our partner ecosystem</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  .about-page-wrapper {
    background-color: #ffffff;
    padding: 72px 0 96px;
  }

  .about-container {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  /* Editorial Header */
  .about-header {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 48px;
  }

  .about-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }

  .about-title {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .about-lead {
    font-size: 1.18rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  /* Narrative Section */
  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .narrative-grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 64px;
    }
  }

  .narrative-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .narrative-heading {
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .narrative-prose {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .commercial-disclosure-box {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-blue);
    border-radius: var(--radius-sm);
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .disclosure-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .disclosure-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Three Commercial Roles */
  .roles-section {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .roles-header {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .roles-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .roles-subhead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .roles-rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
  }

  .role-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border-color);
  }

  @media (min-width: 860px) {
    .role-row {
      grid-template-columns: 200px minmax(0, 1fr) 220px;
      gap: 40px;
      align-items: baseline;
    }
  }

  .role-row-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .role-index {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .role-type {
    font-size: 0.82rem;
    font-weight: 600;
    color: #64748b;
  }

  .role-row-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .role-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .role-desc {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
  }

  .role-scope {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #475569;
    line-height: 1.5;
  }

  /* Closing CTA Band */
  .about-cta-band {
    background: #0b1120;
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 48px 40px;
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  @media (min-width: 860px) {
    .cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }
  }

  .cta-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 580px;
  }

  .cta-title {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .cta-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #cbd5e1;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #cbd5e1;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .cta-link:hover {
    color: #ffffff;
  }

  .link-arrow {
    transition: transform 160ms ease;
    display: inline-block;
  }

  .cta-link:hover .link-arrow {
    transform: translateX(3px);
  }
</style>
