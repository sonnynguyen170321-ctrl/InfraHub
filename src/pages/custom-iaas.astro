---
// src/pages/custom-iaas.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Custom IaaS & Dedicated Telecom Stacks — InfraHub"
  description="Bespoke Infrastructure-as-a-Service combining dedicated bare metal, private carrier networking, and specialized datacenter colocation (e.g. VoIP and streaming stacks)."
  canonicalPath="/custom-iaas"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">Tailored Solutions</span>
          <span class="pill-badge badge-teal">Advisory & Sourced</span>
        </div>
        <h1 class="service-title">Custom Infrastructure as a Service (IaaS)</h1>
        <p class="service-lead">
          For workloads that don't fit into a standard off-the-shelf server package. We design bespoke infrastructure stacks integrating dedicated compute, private carrier interconnects, and specialized datacenter environments.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=custom-iaas" class="btn btn-accent btn-lg">Describe Your Stack</a>
        </div>
      </div>

      <div class="content-section">
        <span class="section-sub-tag">Workload Specialization</span>
        <h2>Ideal Workloads for Custom IaaS</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <h3>VoIP & Telecom Platforms</h3>
            <p>Dedicated SIP signaling servers paired with direct Layer 2 carrier interconnects and low-latency transit routing.</p>
          </div>
          <div class="problem-card">
            <h3>Financial Execution Backends</h3>
            <p>Deterministic kernel-bypass network cards (Solarflare/AMD Xilinx) combined with sub-millisecond optical DCI links.</p>
          </div>
          <div class="problem-card">
            <h3>Private Streaming Clusters</h3>
            <p>High-egress storage servers directly cross-connected to multiple 100G IP transit upstreams with 95th percentile burst pooling.</p>
          </div>
        </div>
      </div>

      <div class="service-footer-cta text-center">
        <h2>Build Your Custom Infrastructure Stack</h2>
        <a href="/lets-talk?service=custom-iaas" class="btn btn-accent btn-lg">Consult an Infrastructure Architect</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container { max-width: 1040px; }
  .service-header { text-align: center; max-width: 820px; margin: 0 auto 64px; }
  .header-badge-row { display: flex; justify-content: center; gap: 8px; margin-bottom: 16px; }
  .service-title { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 20px; }
  .service-lead { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 32px; }
  .service-hero-actions { display: flex; justify-content: center; gap: 14px; }
  .content-section { margin-bottom: 72px; }
  .section-sub-tag { display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-blue); margin-bottom: 8px; }
  .content-section h2 { font-size: 1.85rem; font-weight: 700; margin-bottom: 18px; }
  .problem-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }
  .problem-card { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; }
  .problem-card h3 { font-size: 1.1rem; margin-bottom: 10px; color: var(--text-primary); }
  .problem-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
  .service-footer-cta { padding: 40px 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
</style>
