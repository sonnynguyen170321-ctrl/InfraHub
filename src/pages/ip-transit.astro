---
// src/pages/ip-transit.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Carrier-Neutral IP Transit Sourcing (10G–400G) — InfraHub"
  description="Compare Tier-1 and regional IP Transit providers. Evaluate 95th percentile burst billing, committed data rates, BGP community feeds, and cross-connect costs."
  canonicalPath="/ip-transit"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <!-- Service Hero -->
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">Network & Connectivity</span>
          <span class="pill-badge badge-teal">Partner Delivered</span>
        </div>
        <h1 class="service-title">Enterprise & Wholesale IP Transit</h1>
        <p class="service-lead">
          Connect your Autonomous System (ASN) to global Tier-1 backbones and regional transit providers. We evaluate port commitments, 95th percentile burst ratios, BGP community controls, and cross-connect fees across major colocation MMRs.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=ip-transit" class="btn btn-accent btn-lg">Request Transit Comparison</a>
          <a href="#decision-framework" class="btn btn-secondary btn-lg">Review Decision Factors</a>
        </div>
      </div>

      <!-- Problem Statement -->
      <div class="content-section">
        <span class="section-sub-tag">The Challenge</span>
        <h2>What problem are you trying to solve?</h2>
        <p>
          Selecting IP transit solely on price-per-megabit frequently leads to operational surprises: unexpected burst penalties, poor latency to specific regional eyeballs, or asymmetric routing loops. Technical buyers generally need transit to address:
        </p>
        <div class="problem-grid">
          <div class="problem-card">
            <h3>Eyeball Reachability</h3>
            <p>Direct low-latency paths to consumer ISPs without traversing congested third-party peering fabrics.</p>
          </div>
          <div class="problem-card">
            <h3>BGP Traffic Engineering</h3>
            <p>Granular BGP community support to deprioritize backup upstreams or shape outbound flows by geographic destination.</p>
          </div>
          <div class="problem-card">
            <h3>Cost Predictability</h3>
            <p>Balancing committed data rates (CDR) against unpredictable traffic spikes using 95th percentile calculations.</p>
          </div>
        </div>
      </div>

      <!-- Available Approaches -->
      <div class="content-section">
        <span class="section-sub-tag">Architecture</span>
        <h2>Available Transit Approaches</h2>
        <div class="approach-grid">
          <div class="approach-card">
            <h3>Single Tier-1 Backbone</h3>
            <p class="approach-desc">Connect directly to a global Tier-1 network with extensive settlement-free peering.</p>
            <ul class="approach-bullets">
              <li>Lowest hop count for global international destinations</li>
              <li>Strict SLA commitments on packet delivery and latency</li>
              <li>Higher cost per megabit; higher commit requirements</li>
            </ul>
          </div>

          <div class="approach-card">
            <h3>Multi-Homed Blended Transit</h3>
            <p class="approach-desc">Purchase a pre-blended BGP transit mix delivered over a single cross-connect.</p>
            <ul class="approach-bullets">
              <li>Automatic BGP best-path failover without running your own routers</li>
              <li>Economical commit thresholds for growing networks</li>
              <li>Less granular control over individual carrier communities</li>
            </ul>
          </div>

          <div class="approach-card">
            <h3>Direct Dual Multi-Homing</h3>
            <p class="approach-desc">Contract two distinct Tier-1 / Tier-2 carriers to your own BGP edge routers.</p>
            <ul class="approach-bullets">
              <li>Maximum fault tolerance against carrier-wide outages</li>
              <li>Full control over local preference and AS-path prepending</li>
              <li>Requires ASN ownership and dual MMR cross-connect fees</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Technical Decision Factors -->
      <div class="content-section" id="decision-framework">
        <span class="section-sub-tag">Technical Evaluation</span>
        <h2>Technical Decision Factors</h2>
        <div class="factors-table-wrap">
          <table class="factors-table">
            <thead>
              <tr>
                <th>Factor</th>
                <th>Consideration</th>
                <th>Why It Matters</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Port vs Commit (CDR)</strong></td>
                <td>100G port with 20G commit vs 10G unmetered</td>
                <td>Provides headroom to absorb DDoS spikes or viral traffic surges without port saturation.</td>
              </tr>
              <tr>
                <td><strong>95th Percentile Billing</strong></td>
                <td>Top 5% of monthly traffic samples discarded</td>
                <td>Protects against transient traffic spikes driving up monthly bandwidth bills.</td>
              </tr>
              <tr>
                <td><strong>Route Feeds</strong></td>
                <td>Full BGP Table (~950k IPv4 / ~200k IPv6) vs Default Route</td>
                <td>Full table requires enterprise router memory (16GB+ RAM) but enables optimal path selection.</td>
              </tr>
              <tr>
                <td><strong>BGP Communities</strong></td>
                <td>Blackhole (RTBH), geographic prepending, no-export</td>
                <td>Essential for autonomous DDoS defense and traffic steering during cable maintenance.</td>
              </tr>
              <tr>
                <td><strong>MMR Cross-Connect Costs</strong></td>
                <td>Monthly recurring fee paid to datacenter operator</td>
                <td>Often costs more than the bandwidth itself in premium facilities (e.g. Equinix, Interxion).</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- When It Fits vs When Another Approach Fits -->
      <div class="content-section">
        <div class="fit-comparison-grid">
          <div class="fit-card fit-yes">
            <h3>When Direct IP Transit Fits</h3>
            <ul>
              <li>You own an Autonomous System Number (ASN) and public IP allocation.</li>
              <li>You operate servers in a carrier-neutral colocation facility.</li>
              <li>You require guaranteed upstream path diversity and SLA credits.</li>
              <li>You consume 1 Gbps or more of consistent outbound or inbound traffic.</li>
            </ul>
          </div>

          <div class="fit-card fit-no">
            <h3>When Another Approach May Be Better</h3>
            <ul>
              <li><strong>Local Cloud or Dedicated Server:</strong> If you consume under 500 Mbps, host-bundled transit is more economical.</li>
              <li><strong>IXP Peering:</strong> If over 60% of your traffic flows to local ISPs, an Internet Exchange port reduces transit spend.</li>
              <li><strong>CDN Offload:</strong> For static media delivery, an edge CDN reduces origin transit costs by 80%+.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- How InfraHub Helps -->
      <div class="content-section">
        <div class="infrahub-role-card">
          <span class="pill-badge badge-blue">Our Sourcing Role</span>
          <h2>How InfraHub Helps You Source IP Transit</h2>
          <p>
            Rather than calling individual carrier sales desks, InfraHub reviews your colocation facility MMR presence and issues a comparative analysis detailing:
          </p>
          <div class="role-points-grid">
            <div class="role-point">
              <h3>1. MMR On-Net Verification</h3>
              <p>We confirm which carriers have lit fiber in your exact meet-me-room to eliminate third-party tail circuit costs.</p>
            </div>
            <div class="role-point">
              <h3>2. Pricing & Commit Benchmarking</h3>
              <p>We provide wholesale market pricing benchmarks for 10G, 40G, 100G, and 400G ports.</p>
            </div>
            <div class="role-point">
              <h3>3. Cross-Connect Coordination</h3>
              <p>We help secure Letters of Authorization (LOA/CFA) directly from the carrier for rapid patching.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Relevant Active Offers -->
      <div class="content-section">
        <div class="service-offers-banner">
          <div>
            <span class="pill-badge badge-teal">Live Promotional Sourcing</span>
            <h3>Active Transit Offer: 100G in Frankfurt</h3>
            <p>20G CDR on 100G port, burstable 95th percentile, from €1,450/month across Equinix & Interxion facilities.</p>
          </div>
          <a href="/offers/100g-transit-frankfurt" class="btn btn-primary">View Offer Details</a>
        </div>
      </div>

      <!-- CTA -->
      <div class="service-footer-cta text-center">
        <h2>Discuss Your Transit Requirements</h2>
        <p>Talk with a network sourcing architect to evaluate carriers in your target facility.</p>
        <a href="/lets-talk?service=ip-transit" class="btn btn-accent btn-lg">Request Transit Sourcing</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container {
    max-width: 1040px;
  }

  .service-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 64px;
  }

  .header-badge-row {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .service-title {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .service-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 32px;
  }

  .service-hero-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .content-section {
    margin-bottom: 72px;
  }

  .section-sub-tag {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    margin-bottom: 8px;
  }

  .content-section h2 {
    font-size: 1.85rem;
    font-weight: 700;
    margin-bottom: 18px;
  }

  .content-section > p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 780px;
    margin-bottom: 28px;
  }

  /* Problem Grid */
  .problem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 768px) {
    .problem-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .problem-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
  }
  .problem-card h3 {
    font-size: 1.1rem;
    margin-bottom: 10px;
    color: var(--text-primary);
  }
  .problem-card p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Approaches Grid */
  .approach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .approach-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .approach-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--shadow-sm);
  }
  .approach-card h3 {
    font-size: 1.25rem;
    margin-bottom: 10px;
  }
  .approach-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .approach-bullets {
    list-style: disc;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* Table */
  .factors-table-wrap {
    overflow-x: auto;
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }
  .factors-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.92rem;
  }
  .factors-table th, .factors-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
  }
  .factors-table th {
    background-color: var(--bg-secondary);
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-primary);
  }
  .factors-table tr:last-child td {
    border-bottom: none;
  }

  /* Fit Comparison */
  .fit-comparison-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .fit-comparison-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .fit-card {
    border-radius: var(--radius-lg);
    padding: 32px;
  }
  .fit-card h3 {
    font-size: 1.3rem;
    margin-bottom: 16px;
  }
  .fit-card ul {
    list-style: disc;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .fit-yes {
    background-color: var(--accent-teal-light);
    border: 1px solid rgba(13, 148, 136, 0.3);
    color: #0f766e;
  }
  .fit-yes h3 { color: #0f766e; }
  .fit-yes ul { color: #115e59; }

  .fit-no {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
  }
  .fit-no h3 { color: var(--text-primary); }

  /* Role Card */
  .infrahub-role-card {
    background-color: var(--bg-dark);
    color: #ffffff;
    border-radius: var(--radius-xl);
    padding: 48px;
  }
  .infrahub-role-card h2 {
    color: #ffffff;
    margin: 12px 0 16px;
  }
  .infrahub-role-card > p {
    color: var(--text-on-dark-muted);
    font-size: 1.05rem;
    margin-bottom: 32px;
  }
  .role-points-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .role-points-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .role-point {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    padding: 24px;
  }
  .role-point h3 {
    color: #ffffff;
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .role-point p {
    color: var(--text-on-dark-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Active Offer Banner */
  .service-offers-banner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
    justify-content: space-between;
    padding: 32px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 768px) {
    .service-offers-banner {
      flex-direction: row;
      align-items: center;
    }
  }
  .service-offers-banner h3 {
    font-size: 1.35rem;
    margin: 8px 0 6px;
  }
  .service-offers-banner p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .service-footer-cta {
    padding: 40px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
</style>
