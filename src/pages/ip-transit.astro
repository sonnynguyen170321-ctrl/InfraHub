---
// src/pages/ip-transit.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="IP Transit Sourcing & Comparison — InfraHub"
  description="Compare IP Transit providers by port and commit, billing model, routing policy, BGP communities, cross-connect cost, resilience, and regional reach."
  canonicalPath="/ip-transit"
>
  <div class="service-page-wrapper">
    <div class="container service-container">
      
      <!-- 01 Service Hero -->
      <header class="service-hero-band">
        <span class="service-kicker">Network & Connectivity</span>
        <h1 class="service-title">Enterprise & Wholesale IP Transit</h1>
        <p class="service-lead">
          Connect your Autonomous System (ASN) through suitable upstream providers. InfraHub helps compare port and commit, percentile billing, routing policy, BGP communities, facility costs, DDoS controls, and resilience requirements.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=ip-transit" class="btn btn-accent btn-lg">Request Transit Comparison</a>
          <a href="#decision-factors" class="btn btn-secondary btn-lg">Review Decision Factors</a>
        </div>
      </header>

      <!-- 02 Core Decision Parameters -->
      <section class="service-section">
        <h2 class="section-headline">What IP Transit decision are you actually making?</h2>
        <p class="section-lead">
          Selecting IP transit solely on headline price per megabit can hide differences in burst billing, path quality, interconnection cost, support, and routing control. Three useful areas to compare are:
        </p>
        
        <div class="architectural-triad">
          <div class="triad-item">
            <span class="triad-num">01</span>
            <h3 class="triad-title">Eyeball Reachability</h3>
            <p class="triad-desc">
              Routing quality to the residential, enterprise, cloud, and content networks that matter to your traffic, including the provider's regional peering and upstream relationships.
            </p>
          </div>
          <div class="triad-item">
            <span class="triad-num">02</span>
            <h3 class="triad-title">BGP Traffic Engineering</h3>
            <p class="triad-desc">
              Provider-supported BGP communities can help with preference, prepending, blackholing, and other traffic-engineering actions. The exact community set must be confirmed per carrier.
            </p>
          </div>
          <div class="triad-item">
            <span class="triad-num">03</span>
            <h3 class="triad-title">Cost Predictability</h3>
            <p class="triad-desc">
              Balancing committed data rates (CDR) against traffic spikes using transparent 95th percentile burst calculations and appropriate port sizing.
            </p>
          </div>
        </div>
      </section>

      <!-- 03 Meaningful Network Topology Diagram (SVG) -->
      <section class="service-section">
        <h2 class="section-headline">Transit Architecture &amp; Upstream Topologies</h2>
        <p class="section-lead">
          The diagram below is illustrative. A real design may combine multiple upstreams, Internet Exchange peering, and separate DDoS controls depending on the ASN and facilities involved:
        </p>

        <div class="topology-diagram-container">
          <svg viewBox="0 0 900 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="topology-svg" role="img" aria-label="Illustrative network transit topology showing a customer ASN connected to two transit providers, an Internet Exchange, and an external mitigation service">
            <rect width="900" height="360" rx="8" fill="#0b1120" />
            
            <!-- Grid Lines Background -->
            <path d="M50 0V360M150 0V360M250 0V360M350 0V360M450 0V360M550 0V360M650 0V360M750 0V360M850 0V360" stroke="#1e293b" stroke-width="0.8" stroke-dasharray="4 4" opacity="0.6"/>
            <path d="M0 60H900M0 120H900M0 180H900M0 240H900M0 300H900" stroke="#1e293b" stroke-width="0.8" stroke-dasharray="4 4" opacity="0.6"/>

            <!-- Interconnect Lines -->
            <!-- Customer to Upstream A -->
            <path d="M220 180 C 320 180, 320 70, 440 70" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" />
            <text x="310" y="105" fill="#93c5fd" font-family="monospace" font-size="11">BGP Session</text>

            <!-- Customer to Upstream B -->
            <path d="M220 180 C 320 180, 320 150, 440 150" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" />
            <text x="310" y="158" fill="#93c5fd" font-family="monospace" font-size="11">Second Upstream</text>

            <!-- Customer to Regional IXP -->
            <path d="M220 180 C 320 180, 320 230, 440 230" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" />
            <text x="310" y="215" fill="#6ee7b7" font-family="monospace" font-size="11">IXP Peering</text>

            <!-- Customer to DDoS Diversion -->
            <path d="M220 180 C 320 180, 320 300, 440 300" stroke="#f59e0b" stroke-width="2" stroke-dasharray="6 4" stroke-linecap="round" />
            <text x="310" y="280" fill="#fcd34d" font-family="monospace" font-size="11">Mitigation Control</text>

            <!-- Customer Border Routers Node -->
            <g transform="translate(60, 130)">
              <rect width="160" height="100" rx="6" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5" />
              <text x="80" y="32" fill="#ffffff" font-family="sans-serif" font-weight="700" font-size="14" text-anchor="middle">Customer Edge</text>
              <text x="80" y="52" fill="#94a3b8" font-family="monospace" font-size="11" text-anchor="middle">Customer ASN</text>
              <rect x="20" y="68" width="120" height="20" rx="3" fill="#0f172a" />
              <text x="80" y="82" fill="#38bdf8" font-family="monospace" font-size="10" text-anchor="middle">eBGP Border Routers</text>
            </g>

            <!-- Target 1: Upstream Carrier A -->
            <g transform="translate(440, 45)">
              <rect width="200" height="50" rx="6" fill="#1e293b" stroke="#334155" stroke-width="1" />
              <text x="100" y="24" fill="#ffffff" font-family="sans-serif" font-weight="700" font-size="13" text-anchor="middle">Upstream Carrier A</text>
              <text x="100" y="40" fill="#94a3b8" font-family="monospace" font-size="10" text-anchor="middle">Transit Provider A</text>
            </g>
            <path d="M640 70 H730" stroke="#475569" stroke-width="1.5" />

            <!-- Target 2: Upstream Carrier B -->
            <g transform="translate(440, 125)">
              <rect width="200" height="50" rx="6" fill="#1e293b" stroke="#334155" stroke-width="1" />
              <text x="100" y="24" fill="#ffffff" font-family="sans-serif" font-weight="700" font-size="13" text-anchor="middle">Upstream Carrier B</text>
              <text x="100" y="40" fill="#94a3b8" font-family="monospace" font-size="10" text-anchor="middle">Transit Provider B</text>
            </g>
            <path d="M640 150 H730" stroke="#475569" stroke-width="1.5" />

            <!-- Target 3: Internet Exchange (IXP) -->
            <g transform="translate(440, 205)">
              <rect width="200" height="50" rx="6" fill="#1e293b" stroke="#10b981" stroke-width="1" />
              <text x="100" y="24" fill="#ffffff" font-family="sans-serif" font-weight="700" font-size="13" text-anchor="middle">Metro Internet Exchange</text>
              <text x="100" y="40" fill="#6ee7b7" font-family="monospace" font-size="10" text-anchor="middle">IXP / Bilateral Peering</text>
            </g>
            <path d="M640 230 H730" stroke="#475569" stroke-width="1.5" />

            <!-- Target 4: DDoS Scrubbing Center -->
            <g transform="translate(440, 280)">
              <rect width="200" height="50" rx="6" fill="#1e293b" stroke="#f59e0b" stroke-width="1" />
              <text x="100" y="24" fill="#ffffff" font-family="sans-serif" font-weight="700" font-size="13" text-anchor="middle">External Mitigation</text>
              <text x="100" y="40" fill="#fcd34d" font-family="monospace" font-size="10" text-anchor="middle">Provider-Specific Handoff</text>
            </g>
            <path d="M640 305 H730" stroke="#475569" stroke-width="1.5" />

            <!-- Global Internet Cloud -->
            <g transform="translate(730, 50)">
              <rect width="130" height="280" rx="6" fill="#0f172a" stroke="#334155" stroke-width="1" />
              <text x="65" y="130" fill="#e2e8f0" font-family="sans-serif" font-weight="700" font-size="14" text-anchor="middle">Global</text>
              <text x="65" y="150" fill="#e2e8f0" font-family="sans-serif" font-weight="700" font-size="14" text-anchor="middle">Internet</text>
              <text x="65" y="175" fill="#64748b" font-family="monospace" font-size="10" text-anchor="middle">Destination Networks</text>
            </g>
          </svg>
        </div>
      </section>

      <!-- 04 Comparison Framework Table -->
      <section class="service-section" id="decision-factors">
        <h2 class="section-headline">Decision Factors &amp; Specifications</h2>
        <div class="factors-table-wrap">
          <table class="factors-table">
            <thead>
              <tr>
                <th>Evaluation Parameter</th>
                <th>Example / Detail to Confirm</th>
                <th>Why It Matters to the Buyer</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Port vs Commit (CDR)</strong></td>
                <td><span class="mono-text">e.g. 100G port with 20G CDR</span></td>
                <td>Provides immediate capacity to absorb traffic surges without port saturation.</td>
              </tr>
              <tr>
                <td><strong>95th Percentile Billing</strong></td>
                <td><span class="mono-text">Top 5% burst samples excluded</span></td>
                <td>A common burstable billing method; sampling interval and directional treatment remain contract-specific.</td>
              </tr>
              <tr>
                <td><strong>BGP Route Feeds</strong></td>
                <td><span class="mono-text">Full Table feeds</span></td>
                <td>Enables autonomous path engineering; requires routers with adequate memory and TCAM capacity.</td>
              </tr>
              <tr>
                <td><strong>BGP Communities</strong></td>
                <td><span class="mono-text">Blackhole (RTBH) &amp; prepending</span></td>
                <td>Can support blackholing, preference, prepending, or other policy controls where the provider exposes the required communities.</td>
              </tr>
              <tr>
                <td><strong>MMR Cross-Connect Costs</strong></td>
                <td><span class="mono-text">Monthly datacenter charge</span></td>
                <td>Recurring facility patching fees can represent a meaningful portion of total connectivity spend.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 05 Editorial Field Note -->
      <div class="experience-note">
        <h3 class="experience-note-title">A low price per Mbps can cost more after cross-connects and bursts.</h3>
        <p class="experience-note-body">
          Carriers often quote competitive headline unit pricing on high-capacity ports, but total operational costs depend heavily on datacenter cross-connect recurring fees, burst pricing terms, and regional path latency. Before committing to an upstream provider, calculate the blended monthly cost including MMR patching and target eyeball performance.
        </p>
      </div>

      <!-- 06 Available Approaches -->
      <section class="service-section">
        <h2 class="section-headline">Available Transit Approaches</h2>
        <div class="approaches-list">
          <div class="approach-row">
            <div class="approach-col-title">
              <h3>Direct Dual Multi-Homing</h3>
              <span class="approach-sub">Customer ASN</span>
            </div>
            <div class="approach-col-desc">
              <p>Contract two distinct upstream carriers terminated on redundant customer BGP border routers.</p>
            </div>
            <div class="approach-col-points">
              <ul>
                <li>Reduces dependency on a single upstream; physical-path diversity still needs separate evidence</li>
                <li>More direct control over local preference and outbound policy; FlowSpec or RTBH depends on router and provider support</li>
                <li>Requires ASN ownership and dual facility cross-connect fees</li>
              </ul>
            </div>
          </div>

          <div class="approach-row">
            <div class="approach-col-title">
              <h3>Managed Blended Transit</h3>
              <span class="approach-sub">Single Hand-Off Mix</span>
            </div>
            <div class="approach-col-desc">
              <p>Purchase a pre-aggregated multi-carrier BGP blend delivered over a single cross-connect.</p>
            </div>
            <div class="approach-col-points">
              <ul>
                <li>Can simplify upstream management when the blend operator handles carrier selection and failover</li>
                <li>Commercial entry points may differ from contracting multiple carriers directly</li>
                <li>Less granular control over individual upstream carrier communities</li>
              </ul>
            </div>
          </div>

          <div class="approach-row">
            <div class="approach-col-title">
              <h3>Single Transit Provider</h3>
              <span class="approach-sub">Simpler Upstream Model</span>
            </div>
            <div class="approach-col-desc">
              <p>Use one primary transit provider where operational simplicity matters more than provider-level redundancy.</p>
            </div>
            <div class="approach-col-points">
              <ul>
                <li>Simpler routing, support, and commercial management</li>
                <li>Creates greater dependency on one provider and its network path</li>
                <li>Compare routing quality, support, resilience, and contract terms rather than assuming a single-provider advantage</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- Current opportunities are governed by the public offer registry. -->
      <section class="service-offer-card">
        <div class="offer-info">
          <span class="offer-kicker">CURRENT OPPORTUNITIES</span>
          <h3 class="offer-title">Review approved IP Transit offers</h3>
          <p class="offer-desc">Public commercial terms appear only after the provider or supplier, price, validity, and publication status have been confirmed. If no transit allocation is currently public, InfraHub can still qualify the requirement and request current terms.</p>
        </div>
        <a href="/offers" class="btn btn-primary">
          <span>Review Featured Offers</span>
          <span class="link-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </section>

      <!-- 08 Final CTA -->
      <div class="service-footer-cta">
        <div class="cta-left">
          <h2 class="cta-headline">Discuss your IP transit requirements.</h2>
          <p class="cta-desc">Evaluate carrier meet-me room presence, burst structures, and commercial terms with an infrastructure advisor.</p>
        </div>
        <div class="cta-actions">
          <a href="/lets-talk?service=ip-transit" class="btn btn-accent btn-lg">Request Transit Sourcing</a>
          <a href="/how-we-work" class="cta-link">
            <span>Review how we work</span>
            <span class="link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .service-page-wrapper {
    background-color: #ffffff;
    padding: 72px 0 96px;
  }

  .service-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  /* 01 Hero Band */
  .service-hero-band {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 48px;
  }

  .service-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }

  .service-title {
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .service-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  .service-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 8px;
  }

  /* 02 Sections */
  .service-section {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .section-headline {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .section-lead {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 50ch;
  }

  /* Triad */
  .architectural-triad {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 12px;
  }

  @media (min-width: 860px) {
    .architectural-triad {
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }

  .triad-item {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .triad-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-blue);
  }

  .triad-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .triad-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* 03 SVG Topology Diagram */
  .topology-diagram-container {
    background: #0b1120;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 24px;
    overflow-x: auto;
  }

  .topology-svg {
    width: 100%;
    min-width: 760px;
    height: auto;
    display: block;
  }

  /* 04 Table */
  .factors-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .factors-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }

  .factors-table th {
    background: #f8fafc;
    padding: 16px 20px;
    font-weight: 700;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-color);
  }

  .factors-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
    vertical-align: top;
    line-height: 1.55;
  }

  .factors-table tr:last-child td {
    border-bottom: none;
  }

  .mono-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #475569;
    background: #f1f5f9;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-block;
  }

  /* 05 Field Note */
  .experience-note {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--accent-blue);
    border-radius: var(--radius-sm);
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .experience-note-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .experience-note-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 50ch;
  }

  /* 06 Approaches */
  .approaches-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
  }

  .approach-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 28px 24px;
    border-bottom: 1px solid var(--border-color);
    background: #ffffff;
  }

  .approach-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 860px) {
    .approach-row {
      grid-template-columns: 240px 1fr 1.2fr;
      gap: 36px;
      align-items: start;
    }
  }

  .approach-col-title h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .approach-sub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
    margin-top: 4px;
    display: inline-block;
  }

  .approach-col-desc p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .approach-col-points ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .approach-col-points li {
    font-size: 0.88rem;
    line-height: 1.5;
    color: #475569;
    position: relative;
    padding-left: 18px;
  }

  .approach-col-points li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--accent-blue);
    font-weight: bold;
  }

  /* 07 Offer Card */
  .service-offer-card {
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--accent-blue);
    border-radius: var(--radius-sm);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  @media (min-width: 800px) {
    .service-offer-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .offer-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 620px;
  }

  .offer-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-blue);
    letter-spacing: 0.02em;
  }

  .offer-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .offer-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 48ch;
  }

  /* 08 Footer CTA */
  .service-footer-cta {
    background: #0b1120;
    color: #ffffff;
    border-radius: var(--radius-md);
    padding: 48px 40px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  @media (min-width: 860px) {
    .service-footer-cta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }
  }

  .cta-left {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 560px;
  }

  .cta-headline {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 800;
    line-height: 1.2;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .cta-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #cbd5e1;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .cta-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #cbd5e1;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .cta-link:hover {
    color: #ffffff;
  }

  .link-arrow {
    transition: transform 160ms ease;
    display: inline-block;
  }

  .cta-link:hover .link-arrow {
    transform: translateX(3px);
  }
</style>
