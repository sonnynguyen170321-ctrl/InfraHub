---
// src/pages/index.astro — InfraHub Bespoke 5-Act Experience (Master Directive)
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PartnerTrustRibbon from '../components/PartnerTrustRibbon.astro';
import DiscoveryStage from '../components/discovery/DiscoveryStage.astro';
import ConvergenceVisual from '../components/ConvergenceVisual.astro';
import RouteDiversityExplorer from '../components/RouteDiversityExplorer.astro';
import FinalCTA from '../components/FinalCTA.astro';
import AliveMotionLayer from '../components/AliveMotionLayer.astro';
---

<Layout 
  title="Complex Infrastructure. One Place to Solve It. — InfraHub"
  description="Bring us the requirement. InfraHub evaluates technical options and coordinates the right path across network, compute, cloud, security, and managed operations."
  canonicalPath="/"
>
  <!-- ACT 1: INFRAHUB & PARTNER CREDIBILITY -->
  <Hero />
  <PartnerTrustRibbon />

  <!-- ACT 2: WHAT DO YOU NEED? (The InfraHub Infrastructure Lens) -->
  <DiscoveryStage />

  <!-- ACT 3: WHY INFRAHUB? (Signature Convergence Visual & Business Model) -->
  <ConvergenceVisual />

  <!-- ACT 4: PROVE HOW INFRAHUB THINKS (Route Diversity Proof Moment) -->
  <RouteDiversityExplorer isTeaser={true} />

  <!-- ACT 5: START (Low-Friction Requirement Capture & Desk) -->
  <FinalCTA />
  <AliveMotionLayer />

  <!-- HOMEPAGE SCENE SCRIPT -->
  <script src="../scripts/homepage-scene-system.ts"></script>
</Layout>
