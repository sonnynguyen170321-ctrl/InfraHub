---
// src/pages/index.astro | InfraHub VNext Final Premium Commercial Edition
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PartnerTrustRibbon from '../components/PartnerTrustRibbon.astro';
import EcosystemSolutions from '../components/EcosystemSolutions.astro';
import DeliveryModel from '../components/DeliveryModel.astro';
import FeaturedOffers from '../components/FeaturedOffers.astro';
import AudienceAndEditorial from '../components/AudienceAndEditorial.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<Layout 
  title="The Right Infrastructure. The Right Partner."
  description="InfraHub helps businesses evaluate infrastructure requirements and connect with specialist providers across networking, cloud, security, hardware and managed operations."
  canonicalPath="/"
>
  <!-- BAND 1: HERO -->
  <Hero />

  <!-- PARTNER TRUST RIBBON (CLOSING EDGE OF HERO) -->
  <PartnerTrustRibbon />

  <!-- BAND 2: ECOSYSTEM + SOLUTION DISCOVERY -->
  <EcosystemSolutions />

  <!-- BAND 3: HOW INFRAHUB WORKS + WHY INFRAHUB (DELIVERY MODEL) -->
  <DeliveryModel />

  <!-- BAND 4: COMMERCIAL OPPORTUNITIES (FEATURED OFFERS) -->
  <FeaturedOffers />

  <!-- BAND 5: WHO WE HELP + PROOF OF EXPERTISE (AUDIENCE & EDITORIAL) -->
  <AudienceAndEditorial />

  <!-- BAND 6: FINAL CONVERSION + DIRECT FOOTER TRANSITION -->
  <FinalCTA />
</Layout>
