---
// src/pages/index.astro | InfraHub VNext Final Premium Commercial Edition
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PartnerTrustRibbon from '../components/PartnerTrustRibbon.astro';
import EcosystemSolutions from '../components/EcosystemSolutions.astro';
import DeliveryModel from '../components/DeliveryModel.astro';
import RouteDiversityExplorer from '../components/RouteDiversityExplorer.astro';
import FeaturedOffers from '../components/FeaturedOffers.astro';
import AudienceAndEditorial from '../components/AudienceAndEditorial.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<Layout 
  title="The Right Infrastructure. The Right Partner."
  description="InfraHub helps businesses evaluate infrastructure requirements and connect with specialist providers across networking, cloud, security, hardware and managed operations."
  canonicalPath="/"
>
  <!-- CHAPTER 01: ARRIVAL (HERO) -->
  <Hero />

  <!-- CHAPTER 02: ECOSYSTEM (PARTNER TRUST RIBBON) -->
  <PartnerTrustRibbon />

  <!-- CHAPTER 03: DISCOVERY (START WITH THE REQUIREMENT) -->
  <EcosystemSolutions />

  <!-- CHAPTER 04: JUDGMENT (UNDERSTAND → MATCH → INTRODUCE → DELIVER) -->
  <DeliveryModel />

  <!-- CHAPTER 05: REALITY (PHYSICAL ROUTE DIVERSITY SIGNATURE EXPERIENCE) -->
  <RouteDiversityExplorer />

  <!-- CHAPTER 06: MARKET (FEATURED COMMERCIAL OPPORTUNITIES) -->
  <FeaturedOffers />

  <!-- CHAPTER 07: PRACTICE (INDUSTRIES + TECHNICAL ANALYSIS) -->
  <AudienceAndEditorial />

  <!-- CHAPTER 08: CONVERSATION (FINAL CTA) -->
  <FinalCTA />
</Layout>
