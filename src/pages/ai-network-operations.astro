---
// src/pages/ai-network-operations.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="AI Network Operations (AIOps) & Incident Automation — InfraHub"
  description="Autonomous alert clustering, root-cause correlation across syslog events, and automated incident runbooks for complex telecom and enterprise networks."
  canonicalPath="/ai-network-operations"
>
  <div class="section section-hero network-overlay">
    <div class="container service-container">
      <div class="service-header">
        <div class="header-badge-row">
          <span class="pill-badge badge-blue">AIOps & Automation</span>
          <span class="pill-badge badge-teal">Partner Delivered</span>
        </div>
        <h1 class="service-title">AI-Driven Network Operations</h1>
        <p class="service-lead">
          Transform raw network noise into actionable incident remediation. We help infrastructure operators deploy machine-learning models that cluster related alerts, identify underlying root causes, and execute autonomous runbooks.
        </p>
        <div class="service-hero-actions">
          <a href="/lets-talk?service=ai-netops" class="btn btn-accent btn-lg">Request AIOps Evaluation</a>
        </div>
      </div>

      <div class="content-section">
        <span class="section-sub-tag">Operational Impact</span>
        <h2>Key Benefits of AI Network Operations</h2>
        <div class="problem-grid">
          <div class="problem-card">
            <h4>90%+ Alert Noise Suppression</h4>
            <p>Group cascading downstream alerts resulting from a single optical fiber cut or core switch power cycle into one correlated master incident.</p>
          </div>
          <div class="problem-card">
            <h4>Autonomous Runbook Execution</h4>
            <p>Execute pre-approved remediation workflows (restarting hung daemons, rerouting secondary BGP routes) within seconds of anomaly detection.</p>
          </div>
          <div class="problem-card">
            <h4>Predictive Degradation Alerts</h4>
            <p>Identify subtle optical power drops (dBm loss) and CRC error rate increases before physical links drop customer packets.</p>
          </div>
        </div>
      </div>

      <div class="service-footer-cta text-center">
        <h2>Modernize Your Network Operations</h2>
        <a href="/lets-talk?service=ai-netops" class="btn btn-accent btn-lg">Consult an AIOps Architect</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .service-container { max-width: 1040px; }
  .service-header { text-align: center; max-width: 820px; margin: 0 auto 64px; }
  .header-badge-row { display: flex; justify-content: center; gap: 8px; margin-bottom: 16px; }
  .service-title { font-size: clamp(2.2rem, 4vw, 3.4rem); font-weight: 800; line-height: 1.15; margin-bottom: 20px; }
  .service-lead { font-size: 1.15rem; color: var(--text-secondary); line-height: 1.65; margin-bottom: 32px; }
  .service-hero-actions { display: flex; justify-content: center; gap: 14px; }
  .content-section { margin-bottom: 72px; }
  .section-sub-tag { display: block; font-family: var(--font-heading); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-blue); margin-bottom: 8px; }
  .content-section h2 { font-size: 1.85rem; font-weight: 700; margin-bottom: 18px; }
  .problem-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  @media (min-width: 768px) { .problem-grid { grid-template-columns: repeat(3, 1fr); } }
  .problem-card { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 24px; }
  .problem-card h4 { font-size: 1.1rem; margin-bottom: 10px; color: var(--text-primary); }
  .problem-card p { font-size: 0.9rem; color: var(--text-secondary); line-height: 1.5; }
  .service-footer-cta { padding: 40px 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
</style>
