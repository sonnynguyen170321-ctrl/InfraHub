---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  /** Absolute path to the social image for this page, e.g. /images/og/partner.png */
  ogImage?: string;
  /** Description of that image for people who cannot see it. */
  ogImageAlt?: string;
  /** Keep the page out of search results. Use for thin, duplicate or gated pages. */
  noindex?: boolean;
}

const {
  title,
  description = "InfraHub helps businesses navigate infrastructure, cloud, connectivity, security and managed-service requirements by connecting them with specialist providers.",
  canonicalPath = "",
  ogType = "website",
  ogImage = "/images/og/default.png",
  ogImageAlt = "InfraHub — infrastructure sourcing and technical advisory",
  noindex = false
} = Astro.props;

const canonicalURL = new URL(canonicalPath, "https://infrahub.tech").href;
const fullTitle = title.includes("InfraHub") ? title : `${title} | InfraHub`;
const ogImageURL = new URL(ogImage, "https://infrahub.tech").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0b1120" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    
    <!-- OpenGraph / Social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="InfraHub" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Type ships from this origin; the two files the first screen needs are preloaded. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/ibm-plex-sans-var.woff2" crossorigin />

    <!-- Schema.org Organization Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "InfraHub",
        "url": "https://infrahub.tech",
        "logo": "https://infrahub.tech/logo.svg",
        "description": "Infrastructure Sourcing, Advisory and Partner Ecosystem.",
        "sameAs": [
          "https://www.linkedin.com/company/infrahub"
        ]
      }
    </script>

    <title>{fullTitle}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
