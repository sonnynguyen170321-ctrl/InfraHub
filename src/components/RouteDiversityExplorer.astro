---
// src/components/RouteDiversityExplorer.astro — the route diversity exhibit.
//
// The signature scene of the homepage, and the one that has to teach something: two carriers
// and two contracts can still share one physical segment. It runs as four states.
//
//   1. Logical    two independent-looking paths between two sites
//   2. Physical   the same two paths in the ground, converging on one shared crossing
//   3. Risk       the places where convergence usually happens, named
//   4. Conclusion provider diversity and route diversity are different questions
//
// On a desktop viewport with room for it the states follow scroll inside a pinned scene. The
// two toggle buttons drive the same states, so the exhibit is fully usable by click and by
// keyboard, on any viewport, with or without motion. The model is drawn in SVG: no WebGL, no
// canvas, no render loop, and every claim it makes also exists as text in the document.
//
// It is explicitly illustrative. It is not a survey of any real route.

interface Props {
  isTeaser?: boolean;
}

const { isTeaser = false } = Astro.props;

const states = [
  {
    id: 1,
    view: 'logical',
    title: 'Two carriers. Two contracts.',
    body:
      'Redundant transit or wavelengths from two providers usually show separate ASNs, separate NOCs and separate invoices. On paper the two paths are independent.'
  },
  {
    id: 2,
    view: 'physical',
    title: 'One physical dependency.',
    body:
      'In the ground the same two paths can leave through one building entrance, share a duct, and cross the same bridge. The commercial diversity survives; the physical diversity does not.'
  },
  {
    id: 3,
    view: 'physical',
    title: 'Convergence has usual suspects.',
    body:
      'Building entry, local duct, a bridge or rail crossing, the carrier facility, and the meet-me room are where separate providers most often meet. Which of them apply is a question for the specific route.'
  },
  {
    id: 4,
    view: 'physical',
    title: 'Provider diversity and route diversity are different questions.',
    body:
      'Supplier separation is answered by contracts. Physical separation is answered by route evidence: entrance, duct, crossing and facility path, checked per circuit.'
  }
];

// Where separate carriers most often converge. Rendered both as labels on the model and as a
// list in the document, so the exhibit is never the only place the information exists.
const riskPoints = [
  { at: 'Building entry', note: 'One entrance or handhole serving both circuits' },
  { at: 'Local duct', note: 'Shared sub-duct along the same street run' },
  { at: 'Long-haul segment', note: 'Leased capacity riding one underlying fibre pair' },
  { at: 'Bridge or rail crossing', note: 'A single civil crossing for a whole corridor' },
  { at: 'Carrier facility', note: 'Both routes transiting the same building' },
  { at: 'Meet-me room', note: 'Shared distribution path inside the facility' }
];
---

<section
  class={`route-diversity-explorer ${isTeaser ? 'is-teaser' : 'is-full'}`}
  id="route-explorer"
  aria-label="Physical route diversity"
>
  <div class="route-scene" id="routeScene">
    <div class="route-sticky">
      <div class="container route-stage-grid">
        <!-- Narrative: one state at a time, all four present in the document -->
        <div class="route-narrative">
          <div class="state-copy-stack">
            {states.map((state) => (
              <div class={`state-copy ${state.id === 1 ? 'active' : ''}`} data-state-copy={state.id}>
                <h2 class="state-title">{state.title}</h2>
                <p class="state-body">{state.body}</p>
              </div>
            ))}
          </div>

          <div class="route-controls">
            <div class="view-toggle-group" role="group" aria-label="Route perspective">
              <button type="button" class="toggle-btn active" data-view="logical" aria-pressed="true">
                <span class="toggle-indicator" aria-hidden="true"></span>
                <span class="toggle-label">Logical view</span>
              </button>
              <button type="button" class="toggle-btn" data-view="physical" aria-pressed="false">
                <span class="toggle-indicator" aria-hidden="true"></span>
                <span class="toggle-label">Physical path</span>
              </button>
            </div>
            <span class="status-tag" id="statusTag">Illustrative: logical view</span>
          </div>

          <div class="route-actions">
            <a href="/lets-talk?service=route-audit" class="btn btn-accent btn-md">
              <span>Discuss route diversity</span>
            </a>
            <a href="/wavelengths" class="narrative-link">
              <span>Explore metro wavelengths</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Exhibit: one model, two views, drawn in SVG -->
        <div class="route-exhibit">
          <div class="axo-stage" id="axonoStage">
            <svg
              class="schematic-svg state-logical"
              id="svgLogical"
              viewBox="0 0 760 340"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-label="Illustrative logical diagram: two carrier paths between two sites"
              aria-hidden="false"
            >
              <g class="site-group">
                <rect x="40" y="132" width="132" height="76" rx="3" class="site-block" />
                <text x="56" y="162" class="site-name">Site A</text>
                <text x="56" y="182" class="site-meta">Enterprise edge</text>
              </g>

              <g class="site-group">
                <rect x="588" y="132" width="132" height="76" rx="3" class="site-block" />
                <text x="604" y="162" class="site-name">Site B</text>
                <text x="604" y="182" class="site-meta">Primary core</text>
              </g>

              <!-- Independent-looking paths in logical view -->
              <path
                d="M 172 152 C 260 92, 500 92, 588 152"
                class="route-path carrier-alpha"
              />
              <text x="380" y="112" text-anchor="middle" class="path-label label-alpha">
                Carrier Alpha (ASN 1299)
              </text>

              <path
                d="M 172 188 C 260 248, 500 248, 588 188"
                class="route-path carrier-bravo"
              />
              <text x="380" y="238" text-anchor="middle" class="path-label label-bravo">
                Carrier Bravo (ASN 3356)
              </text>

              <text x="380" y="326" text-anchor="middle" class="model-note">
                Illustrative model. Not a survey of any real route.
              </text>
            </svg>

            <!-- Physical schematic: the same two paths in the ground, converging -->
            <svg
              class="schematic-svg state-physical"
              id="svgPhysical"
              viewBox="0 0 760 340"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-label="Illustrative physical diagram: two circuits sharing ground infrastructure"
              aria-hidden="true"
            >
              <g class="site-group">
                <rect x="40" y="132" width="132" height="76" rx="3" class="site-block" />
                <text x="56" y="162" class="site-name">Site A</text>
                <text x="56" y="182" class="site-meta">Enterprise edge</text>
              </g>

              <g class="site-group">
                <rect x="588" y="132" width="132" height="76" rx="3" class="site-block" />
                <text x="604" y="162" class="site-name">Site B</text>
                <text x="604" y="182" class="site-meta">Primary core</text>
              </g>

              <!-- In the ground: routes converge through one crossing -->
              <path
                d="M 172 152 C 230 152, 280 166, 330 166 L 430 166 C 480 166, 530 152, 588 152"
                class="route-path carrier-alpha physical-run"
              />
              <path
                d="M 172 188 C 230 188, 280 166, 330 166 L 430 166 C 480 166, 530 188, 588 188"
                class="route-path carrier-bravo physical-run"
              />

              <!-- The shared choke point: amber highlight on the converged segment -->
              <path
                d="M 330 166 L 430 166"
                class="route-path route-shared shared-segment"
              />

              <text x="380" y="148" text-anchor="middle" class="shared-label">
                Shared civil crossing
              </text>

              <!-- Named 6 convergence points, interactive hotspots -->
              <g class="risk-markers">
                <g class="risk-marker" data-risk-point="building-entry">
                  <circle cx="176" cy="240" r="5" />
                  <text x="186" y="252" class="risk-text">Building entry</text>
                </g>
                <g class="risk-marker" data-risk-point="local-duct">
                  <circle cx="262" cy="200" r="5" />
                  <text x="236" y="176" class="risk-text">Local duct</text>
                </g>
                <g class="risk-marker" data-risk-point="long-haul-segment">
                  <circle cx="320" cy="190" r="5" />
                  <text x="280" y="214" class="risk-text">Long-haul</text>
                </g>
                <g class="risk-marker" data-risk-point="bridge-or-rail-crossing">
                  <circle cx="380" cy="166" r="6" />
                  <text x="430" y="132" class="risk-text">Civil crossing</text>
                </g>
                <g class="risk-marker" data-risk-point="carrier-facility">
                  <circle cx="440" cy="190" r="5" />
                  <text x="420" y="214" class="risk-text">Carrier facility</text>
                </g>
                <g class="risk-marker" data-risk-point="meet-me-room">
                  <circle cx="500" cy="200" r="5" />
                  <text x="518" y="186" class="risk-text">Meet-me room</text>
                </g>
              </g>

              <text x="380" y="326" text-anchor="middle" class="model-note">
                Illustrative model. Not a survey of any real route.
              </text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- The same information as text: the exhibit is an illustration of this, never the only place it exists. -->
  <div class="container route-verify">
    <h3 class="verify-title">What to check before treating two circuits as diverse</h3>
    <ul class="verify-list">
      {riskPoints.map((point) => (
        <li class="verify-item" data-risk-target={point.at.toLowerCase().replace(/[^a-z0-9]+/g, '-')} tabindex="0">
          <span class="verify-at">{point.at}</span>
          <span class="verify-note">{point.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .route-diversity-explorer {
    position: relative;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 64px 0 72px;
  }

  /* ── Scene ────────────────────────────────────────────────────────────── */
  .route-scene {
    position: relative;
  }

  .route-sticky {
    position: relative;
  }

  @media (min-width: 1180px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .route-scene {
      /* Two-act scroll story: logical then physical convergence, followed by interaction */
      min-height: 165vh;
    }

    .route-sticky {
      position: sticky;
      top: var(--header-height);
      min-height: calc(100vh - var(--header-height) - 48px);
      display: flex;
      align-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-scene {
      min-height: 0;
    }

    .route-sticky {
      position: static;
    }
  }

  .route-stage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    width: 100%;
  }

  @media (min-width: 980px) {
    .route-stage-grid {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
      gap: 48px;
    }
  }

  /* ── Narrative ────────────────────────────────────────────────────────── */

  .state-copy-stack {
    position: relative;
    min-height: 200px;
  }

  .state-copy {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--motion-content) var(--ease-out),
      transform var(--motion-content) var(--ease-out);
    pointer-events: none;
  }

  .state-copy.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .state-title {
    font-size: clamp(1.7rem, 2.1vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: var(--text-primary);
    margin: 0 0 18px;
    max-width: 18ch;
  }

  .state-body {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 52ch;
    margin: 0;
  }

  .route-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
  }

  .view-toggle-group {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: #ffffff;
  }

  .toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: none;
    background: transparent;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color var(--motion-ui) var(--ease-out),
      color var(--motion-ui) var(--ease-out);
  }

  .toggle-btn:hover {
    color: var(--text-primary);
  }

  .toggle-btn.active {
    background: var(--text-primary);
    color: #ffffff;
  }

  .toggle-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.7;
  }

  .status-tag {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .route-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
  }

  .narrative-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .narrative-link .link-arrow {
    transition: transform var(--motion-ui) var(--ease-out);
  }

  .narrative-link:hover .link-arrow,
  .narrative-link:focus-visible .link-arrow {
    transform: translateX(4px);
  }

  /* ── Exhibit ──────────────────────────────────────────────────────────── */
  .route-exhibit {
    position: relative;
  }

  .axo-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 760 / 340;
    transform: perspective(1400px) rotateX(0deg) rotateZ(0deg);
    transform-origin: center 60%;
    transition: transform var(--motion-scene) var(--ease-out);
    will-change: transform;
  }

  /* The model tips into its axonometric view once the physical path is the subject. */
  .route-diversity-explorer[data-route-view='physical'] .axo-stage {
    transform: perspective(1400px) rotateX(11deg) rotateZ(-1.5deg);
  }

  .schematic-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    /* The inactive view is genuinely inert rather than transparent: nothing in it is
       reachable, hoverable or announced while the other view is the subject. */
    visibility: hidden;
    /* Out quickly, in at image pace. Two line drawings occupying the same space read as mud
       if they cross-fade symmetrically. */
    transition: opacity var(--motion-ui) var(--ease-out), visibility 0s linear var(--motion-ui);
  }

  .schematic-svg.is-showing {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--motion-image) var(--ease-out), visibility 0s;
  }

  .site-block {
    fill: #ffffff;
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .site-name,
  .model-label {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    fill: var(--text-primary);
  }

  .site-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-muted);
  }

  .route-path {
    stroke-width: 2;
    stroke-linecap: round;
    fill: none;
  }

  .route-a {
    stroke: var(--accent-blue);
  }

  .route-b {
    stroke: var(--accent-teal, #0d9488);
  }

  /* The one segment both routes ride. Amber is reserved for exactly this. */
  .route-shared {
    stroke: var(--accent-amber, #d97706);
    stroke-width: 3.5;
    stroke-linecap: round;
    fill: none;
  }

  .route-label {
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .route-label-a {
    fill: var(--accent-blue);
  }

  .route-label-b {
    fill: var(--accent-teal, #0d9488);
  }

  .shared-label {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--accent-amber, #d97706);
  }

  .model-note {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--text-muted);
  }

  .ground-plane {
    fill: rgba(15, 23, 42, 0.04);
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .building-roof {
    fill: #f8fafc;
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .building-left {
    fill: #e2e8f0;
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .building-right {
    fill: #cbd5e1;
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .is-facility .building-roof {
    fill: #eef2ff;
  }

  .risk-markers {
    opacity: 0;
    transition: opacity var(--motion-content) var(--ease-out);
  }

  .route-diversity-explorer[data-state='3'] .risk-markers,
  .route-diversity-explorer[data-state='4'] .risk-markers {
    opacity: 1;
  }

  .risk-marker {
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
    outline: none;
  }

  .risk-marker circle {
    fill: var(--accent-amber, #d97706);
    transition: fill 140ms ease, r 140ms ease;
  }

  .risk-marker:hover circle,
  .risk-marker:focus-visible circle,
  .risk-marker.is-active circle {
    fill: var(--color-cobalt, #2563eb);
    r: 8px;
  }

  .risk-text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--text-secondary);
    transition: fill 140ms ease;
  }

  .risk-marker:hover .risk-text,
  .risk-marker:focus-visible .risk-text,
  .risk-marker.is-active .risk-text {
    fill: var(--color-cobalt, #2563eb);
    font-weight: 700;
  }

  /* ── The same content as text ─────────────────────────────────────────── */
  .route-verify {
    margin-top: 32px;
    padding-top: 32px;
    border-top: 1px solid var(--border-color);
  }

  .verify-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 20px;
  }

  .verify-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 860px) {
    .verify-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 56px;
    }
  }

  .verify-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    padding: 12px 8px;
    border-bottom: 1px solid var(--border-color);
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 140ms ease, border-color 140ms ease;
    outline: none;
  }

  .verify-item:hover,
  .verify-item:focus-visible,
  .verify-item.is-active {
    background-color: rgba(37, 99, 235, 0.05);
    border-color: var(--color-cobalt, #2563eb);
  }

  .verify-at {
    font-weight: 700;
    color: var(--text-primary);
    min-width: 190px;
    transition: color 140ms ease;
  }

  .verify-item:hover .verify-at,
  .verify-item:focus-visible .verify-at,
  .verify-item.is-active .verify-at {
    color: var(--color-cobalt, #2563eb);
  }

  .verify-note {
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  .photo-bridge-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at 50% 55%, rgba(9, 17, 24, 0.03), transparent 70%);
    transition: opacity var(--motion-image) var(--ease-out);
  }

  .route-diversity-explorer[data-route-view='physical'] .photo-bridge-layer {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .axo-stage,
    .schematic-svg,
    .state-copy,
    .risk-markers {
      transition: none;
    }
  }
</style>

<script>
  import { homepageScheduler, pinnedProgress } from '../scripts/homepage-scheduler';

  // Four states, two ways to drive them.
  //
  // Scroll drives the states where the scene is pinned; the two buttons drive them everywhere.
  // Both go through setState, so the model, the copy, the toggle and the status line can never
  // disagree. There is no canvas and no render loop: state is a class and an attribute.
  function initRouteExplorer() {
    const section = document.getElementById('route-explorer');
    const scene = document.getElementById('routeScene');
    if (!section) return;

    const copies = Array.from(section.querySelectorAll<HTMLElement>('[data-state-copy]'));
    const toggles = Array.from(section.querySelectorAll<HTMLElement>('.toggle-btn'));
    const logical = document.getElementById('svgLogical');
    const physical = document.getElementById('svgPhysical');
    const statusTag = document.getElementById('statusTag');
    const stage = document.getElementById('axonoStage');
    if (copies.length === 0 || !logical || !physical) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pinQuery = window.matchMedia('(min-width: 1180px) and (min-height: 700px)');
    const isPinned = () => pinQuery.matches && !reducedMotion.matches;

    const STATE_COUNT = copies.length;
    const statusFor: Record<number, string> = {
      1: 'Illustrative: logical view',
      2: 'Illustrative: shared physical segment',
      3: 'Illustrative: where routes converge',
      4: 'Illustrative: what to verify'
    };

    let state = 0;

    function setState(next: number) {
      const clamped = Math.min(Math.max(next, 1), STATE_COUNT);
      if (clamped === state) return;
      state = clamped;

      const view = clamped === 1 ? 'logical' : 'physical';

      section!.setAttribute('data-state', String(clamped));
      section!.setAttribute('data-route-view', view);

      copies.forEach((copy) => {
        copy.classList.toggle('active', copy.getAttribute('data-state-copy') === String(clamped));
      });

      logical!.classList.toggle('is-showing', view === 'logical');
      logical!.setAttribute('aria-hidden', view === 'logical' ? 'false' : 'true');
      physical!.classList.toggle('is-showing', view === 'physical');
      physical!.setAttribute('aria-hidden', view === 'physical' ? 'false' : 'true');

      toggles.forEach((button) => {
        const isActive = button.getAttribute('data-view') === view;
        button.classList.toggle('active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      if (statusTag) statusTag.textContent = statusFor[clamped];
    }

    // ── Scroll progression ────────────────────────────────────────────────

    const sticky = scene ? scene.querySelector<HTMLElement>('.route-sticky') : null;

    /** Real normalized travel through the pinned exhibit, shared with the scene system. */
    function sceneProgress(): number {
      if (!isPinned()) return (state - 1) / STATE_COUNT;
      return pinnedProgress(scene, sticky, window.scrollY);
    }

    function stateFromProgress(progress: number): number {
      return Math.min(Math.floor(progress * STATE_COUNT) + 1, STATE_COUNT);
    }

    function scrollToState(target: number) {
      if (!scene || !isPinned()) return;
      const sticky = scene.querySelector<HTMLElement>('.route-sticky');
      const travel = scene.offsetHeight - (sticky ? sticky.offsetHeight : 0);
      if (travel <= 0) return;

      const sceneTop = scene.getBoundingClientRect().top + window.scrollY;
      const band = travel / STATE_COUNT;
      window.scrollTo({
        top: Math.round(sceneTop + band * (target - 1) + band * 0.5),
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });
    }

    toggles.forEach((button) => {
      button.addEventListener('click', () => {
        const target = button.getAttribute('data-view') === 'logical' ? 1 : 2;
        setState(target);
        scrollToState(target);
      });
    });

    const scheduler = homepageScheduler();
    scheduler.registerProgressSource('routeReality', sceneProgress);

    scheduler.onFrame(() => {
      if (isPinned()) setState(stateFromProgress(sceneProgress()));
    });

    const requestFrame = () => scheduler.request();
    pinQuery.addEventListener('change', requestFrame);
    reducedMotion.addEventListener('change', requestFrame);

    // ── Pointer parallax ──────────────────────────────────────────────────
    // The model is an exhibit, not a toy: the pointer tilts it by a couple of degrees and
    // nothing more, and only when the physical view is the subject.
    if (stage && window.matchMedia('(pointer: fine)').matches && !reducedMotion.matches) {
      const MAX_TILT = 2.5;

      stage.addEventListener('mousemove', (event) => {
        if (section!.getAttribute('data-route-view') !== 'physical') return;
        const rect = stage.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - 0.5;
        const y = (event.clientY - rect.top) / rect.height - 0.5;
        stage.style.transform = `perspective(1400px) rotateX(${11 - y * MAX_TILT}deg) rotateZ(${-1.5 + x * MAX_TILT}deg)`;
      });

      stage.addEventListener('mouseleave', () => {
        stage.style.transform = '';
      });
    }

    // ── Interactive Hotspot Inspection (Directives 18 & 19) ─────────────────
    const markers = Array.from(section!.querySelectorAll<HTMLElement>('.risk-marker'));
    const verifyItems = Array.from(section!.querySelectorAll<HTMLElement>('.verify-item'));

    function highlightPoint(targetId: string | null) {
      markers.forEach((m) => {
        const match = targetId && m.getAttribute('data-risk-point') === targetId;
        m.classList.toggle('is-active', Boolean(match));
      });
      verifyItems.forEach((v) => {
        const match = targetId && v.getAttribute('data-risk-target') === targetId;
        v.classList.toggle('is-active', Boolean(match));
      });
    }

    markers.forEach((marker) => {
      const targetId = marker.getAttribute('data-risk-point');
      marker.addEventListener('mouseenter', () => highlightPoint(targetId));
      marker.addEventListener('mouseleave', () => highlightPoint(null));
      marker.addEventListener('focus', () => {
        setState(2);
        highlightPoint(targetId);
      });
      marker.addEventListener('blur', () => highlightPoint(null));
      marker.addEventListener('click', () => {
        setState(2);
        highlightPoint(targetId);
      });
    });

    verifyItems.forEach((item) => {
      const targetId = item.getAttribute('data-risk-target');
      item.addEventListener('mouseenter', () => highlightPoint(targetId));
      item.addEventListener('mouseleave', () => highlightPoint(null));
      item.addEventListener('focus', () => {
        setState(2);
        highlightPoint(targetId);
      });
      item.addEventListener('blur', () => highlightPoint(null));
      item.addEventListener('click', () => {
        setState(2);
        highlightPoint(targetId);
      });
    });

    // First paint: state 1, and the logical view visible without waiting for a scroll event.
    section.setAttribute('data-state', '1');
    section.setAttribute('data-route-view', 'logical');
    logical.classList.add('is-showing');
    state = 1;
    scheduler.request();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRouteExplorer);
  } else {
    initRouteExplorer();
  }
</script>
