---

<section class="section section-solutions" id="solutions-ecosystem">
  <div class="container">
    <!-- Header -->
    <div class="solutions-header">
      <span class="solutions-kicker">SOLUTION DISCOVERY</span>
      <h2 class="solutions-title">Start with the requirement.</h2>
      <p class="solutions-subhead">
        You do not need the provider or product figured out first. Explore by discipline or discuss your operational constraints directly with our advisory desk.
      </p>
    </div>

    <!-- Desktop 3-Column Interactive Console -->
    <div class="console-desktop" id="solutionConsole">
      <!-- Col 1: Family Tabs -->
      <nav class="console-nav" aria-label="Solution Categories">
        {solutionFamilies.map((family, idx) => (
          <button 
            type="button"
            class={`nav-tab-btn ${idx === 0 ? 'active' : ''}`}
            data-target={family.id}
            id={`tab-${family.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            role="tab"
          >
            <span class="tab-num">{family.number}</span>
            <div class="tab-text-wrap">
              <span class="tab-name">{family.name}</span>
            </div>
            <svg class="tab-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        ))}
      </nav>

      <!-- Col 2 & 3: Panels -->
      <div class="console-stage">
        {solutionFamilies.map((family, idx) => (
          <div 
            class={`solution-panel ${idx === 0 ? 'active' : ''}`}
            id={`panel-${family.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${family.id}`}
          >
            <!-- Center Visual -->
            <div class="panel-visual">
              <img 
                src={family.image} 
                alt={family.imageAlt}
                class="panel-img"
                loading="lazy"
                width="600"
                height="450"
              />
              <div class="panel-visual-overlay">
                <span class="visual-category">{family.name}</span>
              </div>
            </div>

            <!-- Right Content -->
            <div class="panel-content">
              <div class="panel-summary-block">
                <h3 class="panel-family-name">{family.name}</h3>
                <p class="panel-narrative">{family.summary}</p>
              </div>

              <div class="panel-services-block">
                <span class="services-block-label">Relevant Services</span>
                <ul class="panel-services-list">
                  {family.services.map(s => (
                    <li class="service-item">
                      <a href={s.url} class="service-link">
                        <span class="s-name">{s.name}</span>
                        <span class="s-desc">{s.desc}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="panel-footer">
                <a href={family.ctaLink} class="btn-panel-cta">
                  <span>Explore All {family.name} Solutions</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile Accordion View -->
    <div class="accordion-mobile" id="solutionAccordion">
      {solutionFamilies.map((family, idx) => (
        <div class="acc-item">
          <button 
            type="button" 
            class={`acc-trigger ${idx === 0 ? 'active' : ''}`}
            aria-expanded={idx === 0 ? 'true' : 'false'}
            data-acc-target={family.id}
          >
            <div class="acc-title-wrap">
              <span class="acc-num">{family.number}</span>
              <span class="acc-name">{family.name}</span>
            </div>
            <svg class="acc-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          
          <div class={`acc-content ${idx === 0 ? 'open' : ''}`} id={`acc-${family.id}`}>
            <p class="acc-narrative">{family.summary}</p>
            <ul class="acc-services">
              {family.services.map(s => (
                <li>
                  <a href={s.url} class="acc-service-link">
                    <span class="acc-s-name">{s.name}</span>
                    <span class="acc-s-desc">{s.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href={family.ctaLink} class="btn-acc-cta">
              <span>View {family.name} Solutions</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  // Interactive Console Switcher
  const buttons = document.querySelectorAll('.nav-tab-btn');
  const panels = document.querySelectorAll('.solution-panel');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      
      buttons.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      panels.forEach(p => {
        p.classList.remove('active');
      });

      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const targetPanel = document.getElementById(`panel-${targetId}`);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });

  // Mobile Accordion
  const accTriggers = document.querySelectorAll('.acc-trigger');
  accTriggers.forEach(trig => {
    trig.addEventListener('click', () => {
      const targetId = trig.getAttribute('data-acc-target');
      const content = document.getElementById(`acc-${targetId}`);
      const isExpanded = trig.getAttribute('aria-expanded') === 'true';

      // Close all
      accTriggers.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-expanded', 'false');
      });
      document.querySelectorAll('.acc-content').forEach(c => {
        c.classList.remove('open');
      });

      // Toggle clicked if it was closed
      if (!isExpanded && content) {
        trig.classList.add('active');
        trig.setAttribute('aria-expanded', 'true');
        content.classList.add('open');
      }
    });
  });
</script>

<style>
  .section-solutions {
    background-color: #ffffff;
    padding: 96px 0;
    border-bottom: 1px solid var(--border-color);
  }

  /* Header */
  .solutions-header {
    max-width: 780px;
    margin-bottom: 56px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .solutions-kicker {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent-blue);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .solutions-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }
  .solutions-subhead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Desktop Console (3-Column Layout) */
  .console-desktop {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 32px;
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  /* Nav Column */
  .console-nav {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-secondary);
    border-right: 1px solid var(--border-color);
  }
  .nav-tab-btn {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 20px;
    text-align: left;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border-color);
    cursor: pointer;
    transition: var(--transition-fast);
    width: 100%;
  }
  .nav-tab-btn:last-child {
    border-bottom: none;
  }
  .nav-tab-btn:hover {
    background-color: #ffffff;
  }
  .nav-tab-btn.active {
    background-color: #ffffff;
    border-left: 3px solid var(--accent-blue);
  }

  .tab-num {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  .nav-tab-btn.active .tab-num {
    color: var(--accent-blue);
  }

  .tab-text-wrap {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .tab-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .nav-tab-btn.active .tab-name {
    color: var(--accent-blue);
  }

  .tab-arrow {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .nav-tab-btn.active .tab-arrow {
    color: var(--accent-blue);
    transform: translateX(3px);
  }

  /* Console Stage & Panels */
  .console-stage {
    position: relative;
    background-color: #ffffff;
    min-height: 480px;
  }
  .solution-panel {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    padding: 32px;
    height: 100%;
  }
  .solution-panel.active {
    display: grid;
    animation: fadeIn 0.25s ease forwards;
  }
  @keyframes fadeIn {
    from { opacity: 0.4; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Visual Column */
  .panel-visual {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: #0b1120;
    aspect-ratio: 4 / 3;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }
  .panel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
  }
  .panel-visual-overlay {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }
  .visual-category {
    font-size: 0.72rem;
    color: #ffffff;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  /* Content Column */
  .panel-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }
  .panel-summary-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .panel-family-name {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .panel-narrative {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .panel-services-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .services-block-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .panel-services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .service-item {
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 6px;
  }
  .service-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .service-link {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
    transition: var(--transition-fast);
  }
  .s-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .service-link:hover .s-name {
    color: var(--accent-blue);
  }
  .s-desc {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .btn-panel-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--accent-blue);
    padding: 10px 0;
    transition: var(--transition-fast);
  }
  .btn-panel-cta:hover {
    color: var(--accent-blue-hover);
  }

  /* Mobile Accordion */
  .accordion-mobile {
    display: none;
  }

  @media (max-width: 1024px) {
    .console-desktop {
      display: none;
    }
    .accordion-mobile {
      display: flex;
      flex-direction: column;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      overflow: hidden;
    }
    .acc-item {
      border-bottom: 1px solid var(--border-color);
    }
    .acc-item:last-child {
      border-bottom: none;
    }
    .acc-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 18px 20px;
      background-color: #ffffff;
      border: none;
      cursor: pointer;
      text-align: left;
    }
    .acc-trigger.active {
      background-color: var(--bg-secondary);
      border-left: 3px solid var(--accent-blue);
    }
    .acc-title-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .acc-num {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--accent-blue);
    }
    .acc-name {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-primary);
    }
    .acc-icon {
      color: var(--text-muted);
      transition: transform 0.2s ease;
    }
    .acc-trigger.active .acc-icon {
      transform: rotate(180deg);
      color: var(--accent-blue);
    }

    .acc-content {
      display: none;
      padding: 20px;
      background-color: #ffffff;
      border-top: 1px solid var(--border-color);
    }
    .acc-content.open {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .acc-narrative {
      font-size: 0.9rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }
    .acc-services {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .acc-service-link {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 6px 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .acc-s-name {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--text-primary);
    }
    .acc-s-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
    }
    .btn-acc-cta {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--accent-blue);
      margin-top: 4px;
    }
  }
</style>
