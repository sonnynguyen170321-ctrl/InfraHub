---
// src/components/EcosystemSolutions.astro — Solution Discovery (Part XXVI: Left/Center/Right Architectural Discovery)
const solutionFamilies = [
  {
    id: "infrastructure",
    index: "01",
    name: "Infrastructure & Compute",
    discipline: "Hardware & Facilities",
    summary: "Dedicated compute, physical colocation, high-density GPU nodes, and enterprise-grade hardware sourcing without hyperscaler lock-in.",
    image: "/images/hero-datacenter.jpg",
    imageAlt: "Enterprise datacenter server racks with precision cooling",
    ctaLink: "/solutions/infrastructure",
    services: [
      { name: "Dedicated Servers", url: "/dedicated-servers", desc: "High-spec bare metal with custom NVMe storage and ECC RAM" },
      { name: "Custom IaaS", url: "/custom-iaas", desc: "Tailored bare-metal clusters and dedicated private hypervisors" },
      { name: "GPU & AI Infrastructure", url: "/gpu-ai-infrastructure", desc: "High-density NVIDIA H100 and L40S accelerators for AI training" },
      { name: "Enterprise Hardware", url: "/enterprise-hardware", desc: "Certified enterprise routing, switching, and optical transceivers" },
      { name: "Colocation", url: "/colocation", desc: "Fractional racks, private cages, and wholesale suites in primary MMRs" }
    ]
  },
  {
    id: "cloud",
    index: "02",
    name: "Cloud & Virtualization",
    discipline: "Hypervisors & Sovereignty",
    summary: "European private cloud deployments, VMware licensing alternatives, managed containers, and off-site disaster recovery architectures.",
    image: "/images/cloud-compute.jpg",
    imageAlt: "Clustered compute hypervisors and private cloud infrastructure",
    ctaLink: "/solutions/cloud-virtualization",
    services: [
      { name: "Private Cloud", url: "/private-cloud", desc: "Dedicated hypervisors with predictable operational economics" },
      { name: "VMware Alternatives", url: "/vmware-alternatives", desc: "Proxmox VE and XCP-ng / Vates migration architectures" },
      { name: "Public Cloud Integration", url: "/solutions/cloud-virtualization", desc: "Direct enterprise interconnects to AWS, Azure, and GCP" },
      { name: "Disaster Recovery", url: "/solutions/cloud-virtualization", desc: "Off-site replication and automated failover architectures" }
    ]
  },
  {
    id: "network",
    index: "03",
    name: "Network & Connectivity",
    discipline: "Optical & Transit Routing",
    summary: "High-bandwidth upstream IP transit, dedicated metro wavelengths, Layer 2 Ethernet, IPv4 transfers, and edge peering.",
    image: "/images/network-fiber.jpg",
    imageAlt: "High-density optical fiber patch panel and LC transceivers",
    ctaLink: "/solutions/network-connectivity",
    services: [
      { name: "IP Transit", url: "/ip-transit", desc: "Direct BGP connectivity with burstable 95th percentile billing" },
      { name: "Wavelengths", url: "/wavelengths", desc: "Dedicated point-to-point lit optical wavelengths across major metros" },
      { name: "Layer 2 Connectivity", url: "/layer-2-connectivity", desc: "Private Ethernet circuits and metro DCI interconnects" },
      { name: "Cloud Connectivity", url: "/cloud-connectivity", desc: "Private direct-connect bypass to cloud access points" },
      { name: "IPv4 Subnet Leasing", url: "/ipv4", desc: "RIPE and ARIN IPv4 subnet leasing and transfer governance" }
    ]
  },
  {
    id: "security",
    index: "04",
    name: "Security & Telemetry",
    discipline: "Defensive Control Plane",
    summary: "BGP DDoS mitigation, near-real-time flow telemetry, automated FlowSpec filtering, and perimeter security assessments.",
    image: "/images/security-operations.jpg",
    imageAlt: "Network operations security monitoring console and BGP telemetry",
    ctaLink: "/solutions/security",
    services: [
      { name: "DDoS Mitigation", url: "/ddos-protection", desc: "Always-on and on-demand traffic scrubbing through specialized scrubbing networks" },
      { name: "Detection Automation", url: "/ddos-detection-automation", desc: "FastNetMon near-real-time FlowSpec and automated diversion triggers" },
      { name: "Routing Intelligence", url: "/bgp-routing-intelligence", desc: "Path telemetry and automated routing optimization" },
      { name: "Cybersecurity Desk", url: "/cybersecurity", desc: "Perimeter defense and managed security capabilities" }
    ]
  },
  {
    id: "managed",
    index: "05",
    name: "Managed Operations",
    discipline: "NOC & Engineering Sourcing",
    summary: "Continuous network operations, automated incident triage, BGP engineering, and infrastructure operations support.",
    image: "/images/managed-noc.jpg",
    imageAlt: "24/7 carrier Network Operations Center control room",
    ctaLink: "/solutions/managed-services",
    services: [
      { name: "24/7 Managed NOC", url: "/managed-noc", desc: "Continuous monitoring and rapid incident escalation workflows" },
      { name: "AI Network Operations", url: "/ai-network-operations", desc: "Telemetry correlation and automated incident dispatch" },
      { name: "Network Engineering", url: "/solutions/managed-services", desc: "BGP route engineering, hardware provisioning, and physical patching" },
      { name: "Infrastructure Automation", url: "/solutions/managed-services", desc: "Ansible, Terraform, and NetBox workflow pipelines" }
    ]
  }
];
---

<section class="section section-solutions" id="solutions-ecosystem" aria-label="Solutions by Discipline">
  <div class="container solutions-container">
    
    <!-- Section Header (Clean Editorial Field Guide) -->
    <div class="solutions-header">
      <div class="solutions-kicker-row">
        <span class="routing-junction" aria-hidden="true"></span>
        <span class="solutions-kicker">INFRASTRUCTURE FIELD GUIDE // DISCIPLINES</span>
      </div>
      <h2 class="solutions-title">Start with the requirement.</h2>
      <p class="solutions-subhead measure-lead">
        You do not need the provider or product figured out first. Explore by discipline or discuss your operational constraints directly with our advisory desk.
      </p>
    </div>

    <!-- Desktop 3-Column Architectural Discovery (Part XXVI: Left/Center/Right) -->
    <div class="discovery-triad-desktop" id="solutionDiscovery">
      
      <!-- Left Column: Typographic Discipline Index -->
      <nav class="triad-col-disciplines" role="tablist" aria-label="Infrastructure Disciplines">
        {solutionFamilies.map((family, idx) => (
          <button 
            role="tab"
            class={`discipline-tab-btn ${idx === 0 ? 'active' : ''}`}
            id={`tab-${family.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`panel-${family.id}`}
            data-target={family.id}
          >
            <div class="tab-index-row">
              <span class="tab-num">{family.index}</span>
              <span class="tab-discipline-kicker">{family.discipline}</span>
            </div>
            <span class="tab-name">{family.name}</span>
          </button>
        ))}
      </nav>

      <!-- Center Column: Authentic Documentary Visual -->
      <div class="triad-col-visual">
        {solutionFamilies.map((family, idx) => (
          <div 
            class={`visual-frame ${idx === 0 ? 'active' : ''}`}
            id={`visual-${family.id}`}
            aria-hidden={idx !== 0 ? "true" : "false"}
          >
            <img 
              src={family.image} 
              alt={family.imageAlt} 
              class="visual-img"
              loading="lazy"
              width="680"
              height="440"
            />
            <div class="visual-caption">
              <span class="caption-marker" aria-hidden="true"></span>
              <span class="caption-text">{family.imageAlt}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column: Concise Explanation & Service Routes -->
      <div class="triad-col-services">
        {solutionFamilies.map((family, idx) => (
          <div 
            role="tabpanel"
            class={`services-panel ${idx === 0 ? 'active' : ''}`}
            id={`panel-${family.id}`}
            aria-labelledby={`tab-${family.id}`}
            hidden={idx !== 0}
          >
            <div class="panel-header">
              <span class="panel-kicker">DISCIPLINE OVERVIEW</span>
              <h3 class="panel-title">{family.name}</h3>
              <p class="panel-summary measure-compact">{family.summary}</p>
            </div>

            <div class="service-routes-list">
              {family.services.map(svc => (
                <a href={svc.url} class="service-route-link">
                  <div class="route-info">
                    <span class="route-name">{svc.name}</span>
                    <span class="route-desc">{svc.desc}</span>
                  </div>
                  <span class="route-arrow" aria-hidden="true">&rarr;</span>
                </a>
              ))}
            </div>

            <div class="panel-footer">
              <a href={family.ctaLink} class="btn btn-secondary btn-sm">
                <span>Explore {family.name} Overview &rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Mobile Architectural Accordion (No horizontal mini tabs) -->
    <div class="discovery-mobile-accordion">
      {solutionFamilies.map((family, idx) => (
        <details class="mobile-discipline-item" open={idx === 0}>
          <summary class="mobile-summary">
            <span class="mobile-num">{family.index}</span>
            <span class="mobile-name">{family.name}</span>
            <span class="mobile-icon" aria-hidden="true">+</span>
          </summary>
          <div class="mobile-content-body">
            <div class="mobile-img-wrapper">
              <img 
                src={family.image} 
                alt={family.imageAlt} 
                class="mobile-img"
                loading="lazy"
                width="400"
                height="220"
              />
            </div>
            <p class="mobile-summary-text">{family.summary}</p>
            <div class="mobile-links-list">
              {family.services.map(svc => (
                <a href={svc.url} class="mobile-link-row">
                  <span class="mobile-svc-name">{svc.name}</span>
                  <span class="mobile-svc-arrow" aria-hidden="true">&rarr;</span>
                </a>
              ))}
            </div>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  .section-solutions {
    background-color: var(--bg-primary);
    padding: 80px 0;
    border-bottom: 1px solid var(--border-color);
  }

  .solutions-container {
    max-width: var(--max-width);
  }

  /* Header */
  .solutions-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 32px;
    margin-bottom: 48px;
  }

  .solutions-kicker-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .solutions-kicker {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    text-transform: uppercase;
  }

  .solutions-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 16px;
  }

  .solutions-subhead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Desktop 3-Column Triad */
  .discovery-triad-desktop {
    display: none;
  }

  @media (min-width: 980px) {
    .discovery-triad-desktop {
      display: grid;
      grid-template-columns: 300px 1fr 340px;
      gap: 36px;
      align-items: start;
      min-height: 520px;
    }
  }

  /* Column 1: Disciplines Navigation */
  .triad-col-disciplines {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-right: 1px solid var(--border-color);
    padding-right: 28px;
  }

  .discipline-tab-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 18px 16px;
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    text-align: left;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out);
    border-radius: var(--radius-sm);
  }

  .discipline-tab-btn:hover {
    background-color: var(--bg-secondary);
  }

  .discipline-tab-btn.active {
    background-color: var(--bg-secondary);
    border-left-color: var(--accent-blue);
  }

  .tab-index-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .tab-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-blue);
    font-weight: 600;
  }

  .tab-discipline-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tab-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .discipline-tab-btn.active .tab-name {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* Column 2: Center Visual */
  .triad-col-visual {
    position: relative;
    height: 100%;
    min-height: 460px;
    display: flex;
    flex-direction: column;
  }

  .visual-frame {
    display: none;
    flex-direction: column;
    height: 100%;
  }

  .visual-frame.active {
    display: flex;
    animation: fadeIn 200ms var(--ease-out);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .visual-img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    display: block;
  }

  .visual-caption {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .caption-marker {
    width: 6px;
    height: 6px;
    background-color: var(--accent-blue);
    border-radius: 1px;
    flex-shrink: 0;
  }

  .caption-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* Column 3: Services & Context */
  .triad-col-services {
    position: relative;
    border-left: 1px solid var(--border-color);
    padding-left: 28px;
  }

  .services-panel {
    display: none;
    flex-direction: column;
    gap: 20px;
  }

  .services-panel.active {
    display: flex;
    animation: fadeIn 200ms var(--ease-out);
  }

  .panel-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 14px;
  }

  .panel-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--accent-blue);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 4px;
  }

  .panel-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
  }

  .panel-summary {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .service-routes-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .service-route-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .service-route-link:hover {
    background-color: #ffffff;
    border-color: var(--accent-blue);
    transform: translateX(2px);
  }

  .route-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .route-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .route-desc {
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .route-arrow {
    font-size: 0.88rem;
    color: var(--accent-blue);
    margin-left: 12px;
    flex-shrink: 0;
  }

  .panel-footer {
    margin-top: 4px;
  }

  /* Mobile Architectural Accordion */
  .discovery-mobile-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 980px) {
    .discovery-mobile-accordion {
      display: none;
    }
  }

  .mobile-discipline-item {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background-color: var(--bg-secondary);
    overflow: hidden;
  }

  .mobile-summary {
    display: flex;
    align-items: center;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--text-primary);
  }

  .mobile-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-blue);
    margin-right: 12px;
  }

  .mobile-name {
    flex-grow: 1;
    font-size: 1rem;
  }

  .mobile-icon {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .mobile-content-body {
    padding: 0 18px 18px;
    border-top: 1px solid var(--border-color);
    margin-top: 8px;
  }

  .mobile-img-wrapper {
    margin: 14px 0;
  }

  .mobile-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    display: block;
  }

  .mobile-summary-text {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .mobile-links-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-link-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-primary);
    font-size: 0.88rem;
    font-weight: 500;
  }
</style>

<script>
  // Solution Discovery Interactive Tab Switching
  function setupSolutionDiscovery() {
    const container = document.getElementById('solutionDiscovery');
    if (!container) return;

    const tabs = container.querySelectorAll('.discipline-tab-btn');
    const visuals = container.querySelectorAll('.visual-frame');
    const panels = container.querySelectorAll('.services-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-target');

        // Update tabs
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        // Update visuals
        visuals.forEach(v => {
          v.classList.remove('active');
          v.setAttribute('aria-hidden', 'true');
          if (v.id === `visual-${target}`) {
            v.classList.add('active');
            v.setAttribute('aria-hidden', 'false');
          }
        });

        // Update panels
        panels.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('hidden', '');
          if (p.id === `panel-${target}`) {
            p.classList.add('active');
            p.removeAttribute('hidden');
          }
        });
      });
    });
  }

  // Initialize on load and on client-side navigation
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSolutionDiscovery);
  } else {
    setupSolutionDiscovery();
  }
</script>
