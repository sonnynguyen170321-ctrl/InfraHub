---
// src/components/EcosystemSolutions.astro
const solutionFamilies = [
  {
    id: "infrastructure",
    number: "01",
    name: "Infrastructure",
    summary: "Dedicated compute, physical colocation, high-density GPU nodes, and enterprise-grade certified hardware.",
    image: "/images/hero-datacenter.jpg",
    imageAlt: "Enterprise datacenter server racks with precision cooling",
    ctaLink: "/solutions/infrastructure",
    services: [
      { name: "Dedicated Servers", url: "/dedicated-servers", desc: "High-spec bare metal with custom storage & RAM" },
      { name: "Custom IaaS", url: "/custom-iaas", desc: "Tailored bare metal clusters & dedicated hypervisors" },
      { name: "GPU & AI Infrastructure", url: "/gpu-ai-infrastructure", desc: "NVIDIA H100 / L40S clusters for inference & training" },
      { name: "Enterprise Hardware", url: "/enterprise-hardware", desc: "Dell, HPE, Cisco servers & optics with full warranty" },
      { name: "Colocation", url: "/colocation", desc: "Fractional racks, private cages, and wholesale suites" }
    ]
  },
  {
    id: "cloud",
    number: "02",
    name: "Cloud & Virtualization",
    summary: "Sovereign European private clouds, VMware licensing alternatives, managed Kubernetes, and multi-region failover.",
    image: "/images/hero-datacenter.jpg",
    imageAlt: "Private cloud virtualization hypervisors and storage pools",
    ctaLink: "/solutions/cloud-virtualization",
    services: [
      { name: "Private Cloud", url: "/private-cloud", desc: "Dedicated sovereign hypervisors with predictable OpEx" },
      { name: "VMware Alternatives", url: "/vmware-alternatives", desc: "Proxmox VE and XCP-ng / Vates migration paths" },
      { name: "Public Cloud Integration", url: "/solutions/cloud-virtualization", desc: "Direct enterprise interconnects to AWS, Azure, and GCP" },
      { name: "Disaster Recovery", url: "/solutions/cloud-virtualization", desc: "Replication and automated failover architectures" }
    ]
  },
  {
    id: "network",
    number: "03",
    name: "Network & Connectivity",
    summary: "Upstream Tier-1 IP Transit, dedicated dark fiber wavelengths, Layer 2 Ethernet, IPv4 transfers, and edge peering.",
    image: "/images/network-fiber.jpg",
    imageAlt: "High-density optical fiber patch panel and LC transceivers",
    ctaLink: "/solutions/network-connectivity",
    services: [
      { name: "IP Transit", url: "/ip-transit", desc: "Tier-1 BGP bandwidth with burstable 95th percentile" },
      { name: "Wavelengths", url: "/wavelengths", desc: "Dedicated 10G to 400G point-to-point optical lit waves" },
      { name: "Layer 2 Connectivity", url: "/layer-2-connectivity", desc: "Private Ethernet circuits and metro DCI interconnects" },
      { name: "Cloud Connectivity", url: "/cloud-connectivity", desc: "Carrier-grade private bypass to hyperscaler cloud ramps" },
      { name: "IPv4 Subnet Leasing", url: "/ipv4", desc: "Clean, verified /24 to /16 ARIN and RIPE allocations" }
    ]
  },
  {
    id: "security",
    number: "04",
    name: "Security",
    summary: "Tbps-scale DDoS mitigation, real-time BGP telemetry, automated flow filtering, and edge web protection.",
    image: "/images/network-fiber.jpg",
    imageAlt: "Network operations security monitoring console",
    ctaLink: "/solutions/security",
    services: [
      { name: "DDoS Mitigation", url: "/ddos-protection", desc: "Always-on and on-demand multiterabit traffic scrubbing" },
      { name: "Detection Automation", url: "/ddos-detection-automation", desc: "FastNetMon real-time FlowSpec & BGP blackholing" },
      { name: "Routing Intelligence", url: "/bgp-routing-intelligence", desc: "Automated latency optimization & path telemetry" },
      { name: "Cybersecurity Desk", url: "/cybersecurity", desc: "WAF, perimeter defense, and managed SOC capabilities" }
    ]
  },
  {
    id: "managed",
    number: "05",
    name: "Managed Services",
    summary: "Round-the-clock Tier 1–3 network operations, automated incident triage, BGP engineering, and infrastructure desks.",
    image: "/images/hero-datacenter.jpg",
    imageAlt: "Network engineering operations control room",
    ctaLink: "/solutions/managed-services",
    services: [
      { name: "24/7 Managed NOC", url: "/managed-noc", desc: "Continuous monitoring with sub-5 minute escalation SLA" },
      { name: "AI Network Operations", url: "/ai-network-operations", desc: "Telemetry correlation and automated incident dispatch" },
      { name: "Network Engineering", url: "/solutions/managed-services", desc: "BGP tuning, hardware provisioning, and rack cabling" },
      { name: "Infrastructure Automation", url: "/solutions/managed-services", desc: "Ansible, Terraform, and NetBox workflow pipelines" }
    ]
  }
