---
// src/components/EcosystemSolutions.astro
const partners = [
  { name: "FastNetMon", tag: "DDoS Telemetry", slug: "fastnetmon" },
  { name: "Zenlayer", tag: "Global Edge & Compute", slug: "zenlayer" },
  { name: "Gcore", tag: "Edge Cloud & AI", slug: "gcore" },
  { name: "Vates", tag: "Open Virtualization", slug: "vates" },
  { name: "StormWall", tag: "Cloud Scrubbing", slug: "stormwall" },
  { name: "ITcare", tag: "Managed Operations", slug: "itcare" },
  { name: "Supertrace", tag: "Route Intelligence", slug: "supertrace" },
  { name: "IPXO", tag: "IPv4 Solutions", slug: "ipxo" }
];

const families = [
  {
    id: "infrastructure",
    name: "Infrastructure",
    tagline: "Dedicated Servers, Custom IaaS, GPU Clusters & Colocation",
    description: "High-density single-tenant compute, custom VoIP/financial hardware architectures, enterprise chassis sourcing, and carrier-neutral colocation halls across Tier-3+ facilities.",
    image: "/images/hero-datacenter.jpg",
    subServices: [
      { name: "Dedicated Servers", url: "/dedicated-servers", desc: "Single-tenant bare metal compute in EU, US, and APAC" },
      { name: "Custom IaaS", url: "/custom-iaas", desc: "Tailored server + network stacks with bespoke AS routing" },
      { name: "GPU & AI Infrastructure", url: "/gpu-ai-infrastructure", desc: "NVIDIA H100/A100 training and inference clusters" },
      { name: "Enterprise Hardware", url: "/enterprise-hardware", desc: "Certified refurbished Dell PowerEdge & Supermicro" },
      { name: "Colocation Sourcing", url: "/colocation", desc: "High-density racks (5kW to 40kW+) in major MMRs" }
    ],
    ctaUrl: "/solutions/infrastructure",
    ctaLabel: "Explore Infrastructure Solutions"
  },
  {
    id: "cloud-virtualization",
    name: "Cloud & Virtualization",
    tagline: "Private Clouds, VMware Alternatives & Sovereign Stacks",
    description: "Architectural evaluation and migration paths away from proprietary hypervisor licensing. Enterprise private cloud deployments, KVM, Proxmox, and Vates (XCP-ng).",
    image: "/images/network-fiber.jpg",
    subServices: [
      { name: "VMware Alternatives", url: "/vmware-alternatives", desc: "Vates XCP-ng & Proxmox migration frameworks" },
      { name: "Private Cloud", url: "/private-cloud", desc: "Sovereign, GDPR-compliant dedicated hypervisors" },
      { name: "Kubernetes & Bare Metal", url: "/solutions/cloud-virtualization", desc: "Container control planes on dedicated compute" },
      { name: "Disaster Recovery", url: "/solutions/cloud-virtualization", desc: "Warm standby and cross-facility SAN replication" }
    ],
    ctaUrl: "/solutions/cloud-virtualization",
    ctaLabel: "Explore Cloud & Virtualization"
  },
  {
    id: "network-connectivity",
    name: "Network & Connectivity",
    tagline: "IP Transit, Wavelengths, Layer 2 & Cloud Interconnects",
    description: "Upstream Tier-1 transit, dedicated lit DWDM optical wavelengths, cross-connects into major exchange points, and clean IPv4 subnet allocations.",
    image: "/images/network-fiber.jpg",
    subServices: [
      { name: "IP Transit", url: "/ip-transit", desc: "10G–400G ports with 95th percentile burst formulas" },
      { name: "Wavelengths", url: "/wavelengths", desc: "Lit DWDM optical circuits with verified path diversity" },
      { name: "Cloud Connectivity", url: "/cloud-connectivity", desc: "Direct private links to AWS, Azure, and Google Cloud" },
      { name: "Layer 2 Connectivity", url: "/layer-2-connectivity", desc: "Private point-to-point Ethernet and metro interconnect" },
      { name: "IPv4 Solutions", url: "/ipv4", desc: "Clean /24 to /20 subnet leasing with instant LOA" }
    ],
    ctaUrl: "/solutions/network-connectivity",
    ctaLabel: "Explore Network & Connectivity"
  },
  {
    id: "security",
    name: "Security & Protection",
    tagline: "DDoS Cloud Scrubbing, Flow Telemetry & Routing Defense",
    description: "Defend your Autonomous System from volumetric attacks and route leaks. Sub-second automated flow analysis, BGP FlowSpec, and multi-Tbps scrubbing capacity.",
    image: "/images/hero-datacenter.jpg",
    subServices: [
      { name: "DDoS Cloud Mitigation", url: "/ddos-protection", desc: "Always-on and on-demand BGP traffic diversion" },
      { name: "Flow Detection & Automation", url: "/ddos-detection-automation", desc: "FastNetMon Advanced with automated RTBH triggers" },
      { name: "BGP Routing Intelligence", url: "/bgp-routing-intelligence", desc: "RPKI ROA validation and AS-path monitoring" },
      { name: "Cybersecurity & Audits", url: "/cybersecurity", desc: "External penetration testing and perimeter hardening" }
    ],
    ctaUrl: "/solutions/security",
    ctaLabel: "Explore Security Solutions"
  },
  {
    id: "managed-services",
    name: "Managed Services",
    tagline: "24/7 NOC, AI Network Operations & Systems Engineering",
    description: "Extend your engineering capacity with 24/7 incident response, alert clustering, proactive transit monitoring, and automated operational runbooks.",
    image: "/images/hero-datacenter.jpg",
    subServices: [
      { name: "24/7 Managed NOC", url: "/managed-noc", desc: "Continuous Tier 1–3 triage and incident remediation" },
      { name: "AI Network Operations", url: "/ai-network-operations", desc: "Machine learning noise reduction and correlation" },
      { name: "BGP Routing Design", url: "/solutions/managed-services", desc: "Carrier multi-homing and traffic engineering" },
      { name: "Infrastructure Automation", url: "/solutions/managed-services", desc: "IaC pipelines with Ansible, Terraform, and NetBox" }
    ],
    ctaUrl: "/solutions/managed-services",
    ctaLabel: "Explore Managed Operations"
  }
];
---

<section class="section section-ecosystem" id="solutions-ecosystem">
  <div class="container">
    <!-- Part A: Restrained Ecosystem Strip -->
    <div class="ecosystem-strip">
      <div class="strip-label">
        <span class="strip-tag">OUR ECOSYSTEM</span>
        <span class="strip-sub">Specialist Infrastructure & Technology Partners</span>
      </div>
      <div class="partners-rail">
        {partners.map(p => (
          <a href={`/partners/${p.slug}`} class="partner-chip" title={`${p.name} — ${p.tag}`}>
            <span class="p-name">{p.name}</span>
            <span class="p-tag">{p.tag}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Part B: Interactive 5-Family Solution Explorer -->
    <div class="explorer-wrapper">
      <div class="section-lead text-left">
        <span class="mono-kicker">SOLUTION FAMILIES</span>
        <h2 class="explorer-headline">Comprehensive infrastructure sourcing across five core domains.</h2>
      </div>

      <div class="selector-console" id="solution-console">
        <!-- Column 1: Five Category Tabs -->
        <nav class="selector-nav" role="tablist" aria-label="Infrastructure Solution Families">
          {families.map((fam, idx) => (
            <button
              class={`family-tab ${idx === 0 ? 'is-active' : ''}`}
              role="tab"
              id={`fam-tab-${fam.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls={`fam-panel-${fam.id}`}
              data-family={fam.id}
            >
              <span class="tab-index">{String(idx + 1).padStart(2, '0')}</span>
              <span class="tab-label">{fam.name}</span>
              <svg class="tab-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          ))}
        </nav>

        <!-- Columns 2 & 3: Active Family Detail (Center: Visual, Right: Scope & Sub-services) -->
        <div class="selector-panels">
          {families.map((fam, idx) => (
            <div
              class={`family-panel ${idx === 0 ? 'is-active' : ''}`}
              id={`fam-panel-${fam.id}`}
              role="tabpanel"
              aria-labelledby={`fam-tab-${fam.id}`}
            >
              <!-- Center Column: Contextual Visual -->
              <div class="panel-visual">
                <img 
                  src={fam.image} 
                  alt={`${fam.name} Infrastructure`} 
                  class="panel-img"
                  loading="lazy"
                  width="720"
                  height="450"
                />
                <div class="panel-visual-overlay">
                  <span class="visual-badge">{fam.name.toUpperCase()}</span>
                </div>
              </div>

              <!-- Right Column: Description & Sub-services -->
              <div class="panel-details">
                <div class="panel-header">
                  <h3 class="panel-title">{fam.tagline}</h3>
                  <p class="panel-desc">{fam.description}</p>
                </div>

                <div class="panel-services-list">
                  <span class="services-list-title">SPECIALIST CAPABILITIES</span>
                  <ul class="services-ul">
                    {fam.subServices.map(sub => (
                      <li class="service-li">
                        <a href={sub.url} class="service-link">
                          <span class="service-name">{sub.name}</span>
                          <span class="service-desc">{sub.desc}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="panel-cta-wrap">
                  <a href={fam.ctaUrl} class="btn btn-accent btn-sm">
                    <span>{fam.ctaLabel}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-ecosystem {
    background-color: #ffffff;
    padding: 72px 0 88px;
    border-bottom: 1px solid var(--border-color);
  }

  /* Ecosystem Strip */
  .ecosystem-strip {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 56px;
  }
  @media (min-width: 1024px) {
    .ecosystem-strip {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
  }

  .strip-label {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .strip-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: 0.1em;
  }
  .strip-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .partners-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }
  .partner-chip {
    display: inline-flex;
    flex-direction: column;
    padding: 6px 12px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
  }
  .partner-chip:hover {
    border-color: var(--accent-blue);
    background-color: var(--bg-primary);
    transform: translateY(-1px);
  }
  .p-name {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }
  .p-tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* Solution Explorer Lead */
  .explorer-wrapper {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .mono-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-blue);
    letter-spacing: 0.1em;
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }
  .explorer-headline {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    max-width: 800px;
  }

  /* Console Layout: Left Nav + Detail Panels */
  .selector-console {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: #ffffff;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .selector-console {
      grid-template-columns: 280px 1fr;
    }
  }

  /* Nav Tabs */
  .selector-nav {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-secondary);
    border-right: 1px solid var(--border-color);
  }
  .family-tab {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    text-align: left;
    background: none;
    border: none;
    border-bottom: 1px solid var(--border-color);
    cursor: pointer;
    transition: var(--transition-fast);
    position: relative;
  }
  .family-tab:last-child {
    border-bottom: none;
  }
  .family-tab:hover {
    background-color: #ffffff;
  }
  .family-tab.is-active {
    background-color: #ffffff;
  }
  .family-tab.is-active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--accent-blue);
  }

  .tab-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .family-tab.is-active .tab-index {
    color: var(--accent-blue);
  }

  .tab-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    flex-grow: 1;
  }
  .tab-arrow {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .family-tab.is-active .tab-arrow {
    color: var(--accent-blue);
    transform: translateX(3px);
  }

  /* Panels Container */
  .selector-panels {
    position: relative;
    background-color: #ffffff;
  }
  .family-panel {
    display: none;
  }
  .family-panel.is-active {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 1024px) {
    .family-panel.is-active {
      grid-template-columns: 1.05fr 1fr;
      min-height: 480px;
    }
  }

  /* Visual Column */
  .panel-visual {
    position: relative;
    overflow: hidden;
    background-color: #0b1120;
    min-height: 240px;
  }
  .panel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.8) contrast(1.1);
  }
  .panel-visual-overlay {
    position: absolute;
    bottom: 16px;
    left: 16px;
  }
  .visual-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    background: rgba(15, 23, 42, 0.85);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    backdrop-filter: blur(4px);
  }

  /* Details Column */
  .panel-details {
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }
  .panel-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .panel-title {
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-primary);
  }
  .panel-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .panel-services-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .services-list-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }
  .services-ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .service-li {
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 8px;
  }
  .service-li:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .service-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .service-link:hover .service-name {
    color: var(--accent-blue);
  }
  .service-name {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: color 0.15s ease;
  }
  .service-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .panel-cta-wrap {
    padding-top: 12px;
  }
</style>

<script>
  function initSelector() {
    const tabs = document.querySelectorAll('.family-tab');
    const panels = document.querySelectorAll('.family-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const familyId = tab.getAttribute('data-family');

        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.remove('is-active'));

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(`fam-panel-${familyId}`);
        if (activePanel) {
          activePanel.classList.add('is-active');
        }
      });
    });
  }

  // Run on mount and page swap
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSelector);
  } else {
    initSelector();
  }
</script>
