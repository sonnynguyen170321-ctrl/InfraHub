---
// src/components/EcosystemSolutions.astro
const solutionFamilies = [
  {
    id: "infrastructure",
    name: "Infrastructure & Compute",
    summary: "Dedicated compute, physical colocation, high-density GPU nodes, and enterprise-grade hardware sourcing.",
    image: "/images/hero-datacenter.jpg",
    imageAlt: "Enterprise datacenter server racks with precision cooling",
    ctaLink: "/solutions/infrastructure",
    services: [
      { name: "Dedicated Servers", url: "/dedicated-servers", desc: "High-spec bare metal with custom storage and memory options" },
      { name: "Custom IaaS", url: "/custom-iaas", desc: "Tailored bare metal clusters and dedicated hypervisors" },
      { name: "GPU & AI Infrastructure", url: "/gpu-ai-infrastructure", desc: "High-density GPU accelerators for compute and AI workloads" },
      { name: "Enterprise Hardware", url: "/enterprise-hardware", desc: "Certified enterprise servers, optical modules, and routing hardware" },
      { name: "Colocation", url: "/colocation", desc: "Fractional racks, private cages, and wholesale suites" }
    ]
  },
  {
    id: "cloud",
    name: "Cloud & Virtualization",
    summary: "European private cloud deployments, VMware licensing alternatives, managed containers, and disaster recovery.",
    image: "/images/cloud-compute.jpg",
    imageAlt: "Clustered compute hypervisors and private cloud infrastructure",
    ctaLink: "/solutions/cloud-virtualization",
    services: [
      { name: "Private Cloud", url: "/private-cloud", desc: "Dedicated hypervisors with predictable operational economics" },
      { name: "VMware Alternatives", url: "/vmware-alternatives", desc: "Proxmox VE and XCP-ng / Vates migration architectures" },
      { name: "Public Cloud Integration", url: "/solutions/cloud-virtualization", desc: "Direct enterprise interconnects to AWS, Azure, and GCP" },
      { name: "Disaster Recovery", url: "/solutions/cloud-virtualization", desc: "Off-site replication and automated failover architectures" }
    ]
  },
  {
    id: "network",
    name: "Network & Connectivity",
    summary: "High-bandwidth upstream IP transit, dedicated metro wavelengths, Layer 2 Ethernet, IPv4 transfers, and edge peering.",
    image: "/images/network-fiber.jpg",
    imageAlt: "High-density optical fiber patch panel and LC transceivers",
    ctaLink: "/solutions/network-connectivity",
    services: [
      { name: "IP Transit", url: "/ip-transit", desc: "Direct BGP connectivity with burstable 95th percentile billing" },
      { name: "Wavelengths", url: "/wavelengths", desc: "Dedicated point-to-point lit optical wavelengths across major metros" },
      { name: "Layer 2 Connectivity", url: "/layer-2-connectivity", desc: "Private Ethernet circuits and metro DCI interconnects" },
      { name: "Cloud Connectivity", url: "/cloud-connectivity", desc: "Private direct-connect bypass to cloud access points" },
      { name: "IPv4 Subnet Leasing", url: "/ipv4", desc: "RIPE and ARIN IPv4 subnet leasing and transfer support" }
    ]
  },
  {
    id: "security",
    name: "Security & Telemetry",
    summary: "DDoS mitigation, real-time BGP routing telemetry, automated flow filtering, and perimeter security.",
    image: "/images/security-operations.jpg",
    imageAlt: "Network operations security monitoring console and BGP telemetry",
    ctaLink: "/solutions/security",
    services: [
      { name: "DDoS Mitigation", url: "/ddos-protection", desc: "Always-on and on-demand traffic scrubbing through specialized scrubbing networks" },
      { name: "Detection Automation", url: "/ddos-detection-automation", desc: "FastNetMon real-time FlowSpec and automated diversion triggers" },
      { name: "Routing Intelligence", url: "/bgp-routing-intelligence", desc: "Path telemetry and automated routing optimization" },
      { name: "Cybersecurity Desk", url: "/cybersecurity", desc: "Perimeter defense and managed security capabilities" }
    ]
  },
  {
    id: "managed",
    name: "Managed Operations",
    summary: "Continuous network operations, automated incident triage, BGP engineering, and infrastructure desks.",
    image: "/images/managed-noc.jpg",
    imageAlt: "24/7 carrier Network Operations Center control room",
    ctaLink: "/solutions/managed-services",
    services: [
      { name: "24/7 Managed NOC", url: "/managed-noc", desc: "Continuous monitoring and rapid incident escalation workflows" },
      { name: "AI Network Operations", url: "/ai-network-operations", desc: "Telemetry correlation and automated incident dispatch" },
      { name: "Network Engineering", url: "/solutions/managed-services", desc: "BGP route engineering, hardware provisioning, and physical patching" },
      { name: "Infrastructure Automation", url: "/solutions/managed-services", desc: "Ansible, Terraform, and NetBox workflow pipelines" }
    ]
  }
];
---

<section class="section section-solutions" id="solutions-ecosystem">
  <div class="container">
    
    <!-- Editorial Header (No Eyebrow) -->
    <div class="solutions-header">
      <h2 class="solutions-title">Start with the requirement.</h2>
      <p class="solutions-subhead">
        You do not need the provider or product figured out first. Explore by discipline or discuss your operational constraints directly with our advisory desk.
      </p>
    </div>

    <!-- Editorial Solution Selector (Desktop) -->
    <div class="selector-desktop" id="solutionSelector">
      
      <!-- Left Column: Navigation Items (No blue 3px rail, typographic active state) -->
      <nav class="selector-nav" role="tablist" aria-label="Infrastructure Disciplines">
        {solutionFamilies.map((family, idx) => (
          <button 
            role="tab"
            class={`selector-tab ${idx === 0 ? 'active' : ''}`}
            id={`tab-${family.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`panel-${family.id}`}
            data-target={family.id}
          >
            <span class="tab-title">{family.name}</span>
          </button>
        ))}
      </nav>

      <!-- Right Column: Active Content Panels -->
      <div class="selector-panels">
        {solutionFamilies.map((family, idx) => (
          <div 
            role="tabpanel"
            class={`selector-panel ${idx === 0 ? 'active' : ''}`}
            id={`panel-${family.id}`}
            aria-labelledby={`tab-${family.id}`}
            hidden={idx !== 0}
          >
            <!-- Panel Photography -->
            <div class="panel-visual">
              <img 
                src={family.image} 
                alt={family.imageAlt} 
                class="panel-img"
                loading="lazy"
                width="720"
                height="400"
              />
            </div>

            <!-- Panel Details & Service List -->
            <div class="panel-details">
              <p class="panel-summary">{family.summary}</p>
              
              <div class="service-links-list">
                {family.services.map(svc => (
                  <a href={svc.url} class="service-row-item">
                    <div class="service-meta">
                      <span class="service-name">{svc.name}</span>
                      <span class="service-desc">{svc.desc}</span>
                    </div>
                    <span class="service-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                ))}
              </div>

              <div class="panel-action">
                <a href={family.ctaLink} class="btn btn-secondary btn-sm">
                  <span>Explore {family.name} Solutions</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- Mobile Clean Accordion (No nested card surfaces) -->
    <div class="solutions-accordion-mobile">
      {solutionFamilies.map((family, idx) => (
        <details class="accordion-item" open={idx === 0}>
          <summary class="accordion-summary">
            <span class="accordion-title">{family.name}</span>
            <span class="accordion-icon" aria-hidden="true">+</span>
          </summary>
          <div class="accordion-body">
            <div class="accordion-visual">
              <img 
                src={family.image} 
                alt={family.imageAlt} 
                class="panel-img"
                loading="lazy"
                width="600"
                height="320"
              />
            </div>
            <p class="accordion-summary-text">{family.summary}</p>
            <div class="accordion-services">
              {family.services.map(svc => (
                <a href={svc.url} class="service-row-item">
                  <div class="service-meta">
                    <span class="service-name">{svc.name}</span>
                    <span class="service-desc">{svc.desc}</span>
                  </div>
                  <span class="service-arrow" aria-hidden="true">&rarr;</span>
                </a>
              ))}
            </div>
            <div class="accordion-cta">
              <a href={family.ctaLink} class="btn btn-secondary btn-sm">
                <span>Explore {family.name} Solutions</span>
              </a>
            </div>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  .section-solutions {
    background-color: #ffffff;
    padding: 96px 0;
    border-bottom: 1px solid var(--border-color);
  }

  /* Editorial Header (No Eyebrow) */
  .solutions-header {
    max-width: 760px;
    margin-bottom: 56px;
  }
  .solutions-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.24;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 16px;
  }
  .solutions-subhead {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Desktop Selector: Open, Architectural, No Outer Box */
  .selector-desktop {
    display: none;
  }
  @media (min-width: 960px) {
    .selector-desktop {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 56px;
      align-items: start;
    }
  }

  /* Left Navigation Tabs (Typographic, Open) */
  .selector-nav {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
  }
  .selector-tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    text-align: left;
    border-bottom: 1px solid var(--border-color);
    background: transparent;
    color: #475569;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    cursor: pointer;
    transition: color 160ms ease;
  }
  .selector-tab:hover {
    color: var(--text-primary);
  }
  .selector-tab.active {
    color: var(--accent-blue);
    font-weight: 800;
  }

  /* Right Panels */
  .selector-panels {
    min-height: 480px;
  }
  .selector-panel {
    display: none;
  }
  .selector-panel.active {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .panel-visual {
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
  }
  .panel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 16 / 10;
  }

  .panel-details {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .panel-summary {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-color);
    max-width: 58ch;
  }

  /* Service Rows (Clean dividers, no cards) */
  .service-links-list,
  .accordion-services {
    display: flex;
    flex-direction: column;
  }
  .service-row-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
    transition: transform 160ms ease;
  }
  .service-row-item:last-child {
    border-bottom: none;
  }
  .service-row-item:hover {
    transform: translateX(3px);
  }
  .service-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .service-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: color 160ms ease;
  }
  .service-row-item:hover .service-name {
    color: var(--accent-blue);
  }
  .service-desc {
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.45;
  }
  .service-arrow {
    font-size: 1.1rem;
    color: var(--accent-blue);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .service-row-item:hover .service-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .panel-action {
    padding-top: 8px;
  }

  /* Mobile Clean Accordion */
  .solutions-accordion-mobile {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
  }
  @media (min-width: 960px) {
    .solutions-accordion-mobile {
      display: none;
    }
  }

  .accordion-item {
    border-bottom: 1px solid var(--border-color);
  }
  .accordion-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    font-family: var(--font-heading);
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
  }
  .accordion-summary::-webkit-details-marker {
    display: none;
  }
  .accordion-icon {
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--text-muted);
    transition: transform 200ms ease;
  }
  details[open] .accordion-icon {
    transform: rotate(45deg);
  }
  .accordion-body {
    padding: 0 0 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .accordion-visual {
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }
  .accordion-summary-text {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .accordion-cta {
    padding-top: 10px;
  }
</style>

<script>
  function setupSolutionSelector() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.selector-tab');
    const panels = document.querySelectorAll<HTMLElement>('.selector-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');

        // Deactivate all
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('hidden', '');
        });

        // Activate selected
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(`panel-${targetId}`);
        if (activePanel) {
          activePanel.classList.add('active');
          activePanel.removeAttribute('hidden');
        }
      });

      // Keyboard navigation support
      tab.addEventListener('keydown', (e) => {
        const tabList = Array.from(tabs);
        const index = tabList.indexOf(tab);

        let newIndex: number | null = null;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          newIndex = (index + 1) % tabList.length;
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          newIndex = (index - 1 + tabList.length) % tabList.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = tabList.length - 1;
        }

        if (newIndex !== null) {
          e.preventDefault();
          tabList[newIndex].focus();
          tabList[newIndex].click();
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupSolutionSelector);
</script>
