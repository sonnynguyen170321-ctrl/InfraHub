---
import { Image } from 'astro:assets';
import infrastructureVisual from '../assets/hero-datacenter.jpg';
import cloudVisual from '../assets/cloud-compute.jpg';
import networkVisual from '../assets/network-fiber.jpg';
import securityVisual from '../assets/security-operations.jpg';
import managedVisual from '../assets/managed-noc.jpg';

// src/components/EcosystemSolutions.astro — Final Solution Discovery (Master Directives 01–36)
const solutionFamilies = [
  {
    id: "infrastructure",
    index: "01",
    name: "Infrastructure & Compute",
    discipline: "Hardware & facilities",
    summary: "Dedicated compute, colocation, GPU infrastructure, and enterprise hardware sourcing matched to workload, facility, and commercial requirements.",
    image: infrastructureVisual,
    imageAlt: "Datacenter compute environment with high-density server racks",
    ctaLink: "/solutions/infrastructure",
    services: [
      { name: "Dedicated Servers", url: "/dedicated-servers", desc: "Bare-metal compute and custom configurations." },
      { name: "Custom IaaS", url: "/custom-iaas", desc: "Dedicated clusters and private hypervisors." },
      { name: "GPU & AI Infrastructure", url: "/gpu-ai-infrastructure", desc: "Accelerator-heavy workloads." },
      { name: "Enterprise Hardware", url: "/enterprise-hardware", desc: "Routing, switching and server sourcing." },
      { name: "Colocation", url: "/colocation", desc: "Rack, cage, power and interconnection." }
    ]
  },
  {
    id: "cloud",
    index: "02",
    name: "Cloud & Virtualization",
    discipline: "Virtualization & data location",
    summary: "Private cloud, public-cloud integration, VMware alternatives, container platforms, backup, and hybrid infrastructure architectures.",
    image: cloudVisual,
    imageAlt: "Clustered compute hypervisors and private cloud infrastructure",
    ctaLink: "/solutions/cloud-virtualization",
    services: [
      { name: "Private Cloud", url: "/private-cloud", desc: "Dedicated hypervisors with predictable economics." },
      { name: "VMware Alternatives", url: "/vmware-alternatives", desc: "Proxmox VE and XCP-ng / Vates architectures." },
      { name: "Public Cloud Integration", url: "/solutions/cloud-virtualization", desc: "Private direct-connect to major clouds." },
      { name: "Disaster Recovery", url: "/solutions/cloud-virtualization", desc: "Off-site replication and failover architectures." }
    ]
  },
  {
    id: "network",
    index: "03",
    name: "Network & Connectivity",
    discipline: "Transit & optical",
    summary: "Upstream IP transit, dedicated wavelengths, Layer 2 Ethernet, cloud connectivity, IPv4 sourcing, and edge-network options.",
    image: networkVisual,
    imageAlt: "High-density optical fiber patch panel and LC transceivers",
    ctaLink: "/solutions/network-connectivity",
    services: [
      { name: "IP Transit", url: "/ip-transit", desc: "Upstream BGP connectivity and committed data rates." },
      { name: "Wavelengths", url: "/wavelengths", desc: "Dedicated point-to-point lit optical wavelengths." },
      { name: "Layer 2 Connectivity", url: "/layer-2-connectivity", desc: "Private Ethernet circuits and metro interconnects." },
      { name: "Cloud Connectivity", url: "/cloud-connectivity", desc: "Direct cloud bypass to major access points." },
      { name: "IPv4 Subnet Leasing", url: "/ipv4", desc: "Verified address space and routing authorization." }
    ]
  },
  {
    id: "security",
    index: "04",
    name: "Security & Telemetry",
    discipline: "DDoS mitigation & telemetry",
    summary: "BGP DDoS mitigation, near-real-time flow telemetry, automated FlowSpec filtering, and perimeter security assessments.",
    image: securityVisual,
    imageAlt: "Network operations security monitoring console and BGP telemetry",
    ctaLink: "/solutions/security",
    services: [
      { name: "DDoS Mitigation", url: "/ddos-protection", desc: "Always-on and on-demand traffic scrubbing." },
      { name: "Detection Automation", url: "/ddos-detection-automation", desc: "Near-real-time FlowSpec and automated diversion." },
      { name: "Routing Intelligence", url: "/bgp-routing-intelligence", desc: "BGP visibility and route analysis support." },
      { name: "Cybersecurity Desk", url: "/cybersecurity", desc: "Perimeter protection through specialist providers." }
    ]
  },
  {
    id: "managed",
    index: "05",
    name: "Managed Operations",
    discipline: "Operations & engineering",
    summary: "Continuous network operations, automated incident triage, BGP engineering, and infrastructure operations support.",
    image: managedVisual,
    imageAlt: "Network operations control room with infrastructure monitoring displays",
    ctaLink: "/solutions/managed-services",
    services: [
      { name: "24/7 Managed NOC", url: "/managed-noc", desc: "Continuous monitoring and incident escalation." },
      { name: "AI Network Operations", url: "/ai-network-operations", desc: "Telemetry correlation and automated dispatch." },
      { name: "Network Engineering", url: "/solutions/managed-services", desc: "BGP routing and network architecture support." },
      { name: "Infrastructure Automation", url: "/solutions/managed-services", desc: "Infrastructure-as-code and configuration." }
    ]
  }
];

// The routing line branches by discipline (Directive 11, 18, 19)
const routeBranches: Record<string, string[]> = {
  infrastructure: ['Compute', 'Hardware', 'Colocation'],
  cloud: ['Private cloud', 'Virtualization', 'Hybrid', 'Backup'],
  network: ['Transit', 'Wavelengths', 'Layer 2', 'Cloud on-ramp', 'IPv4'],
  security: ['Detection', 'Mitigation', 'Diversion'],
  managed: ['Monitor', 'Triage', 'Engineer', 'Escalate']
};

const BRANCH_TOP = 16;
const BRANCH_GAP = 28;
const TRUNK_X = 10;
const ELBOW_X = 32;
const LABEL_X = 42;

const branchSets = solutionFamilies.map((family) => {
  const labels = routeBranches[family.id] ?? [];
  const rows = labels.map((label, i) => {
    const y = BRANCH_TOP + i * BRANCH_GAP;
    return {
      label,
      y,
      d: `M ${TRUNK_X} ${y - BRANCH_GAP / 2} V ${y} H ${ELBOW_X}`,
      isRisk: family.id === 'security' && label === 'Mitigation',
      connectsToPhoto: i === 0
    };
  });
  const height = BRANCH_TOP + Math.max(labels.length - 1, 0) * BRANCH_GAP + 20;
  return { id: family.id, rows, height };
});

const branchViewHeight = Math.max(...branchSets.map((set) => set.height));
---

<section class="section section-solutions" id="discovery-stage" aria-label="Solutions by Discipline">
  <div class="container solutions-container">
    
    <div class="discovery-header-split">
      <div class="header-editorial-left">
        <h2 class="solutions-title">Start with the requirement.</h2>
        <div class="solutions-lead-rhythm">
          <p class="lead-primary">
            Start with the workload, location, capacity and constraints. The provider usually comes later.
          </p>
          <p class="lead-secondary">
            InfraHub helps turn those requirements into a practical infrastructure approach and a shortlist of suitable specialists.
          </p>
        </div>
      </div>

      <div class="header-qualification-right" aria-label="Qualification parameters">
        <div class="qualification-top-rule" aria-hidden="true"></div>
        <span class="qualification-kicker">What we establish first</span>
        <div class="qualification-grid">
          <span class="qual-item">Workload</span>
          <span class="qual-item">Location</span>
          <span class="qual-item">Capacity</span>
          <span class="qual-item">Resilience</span>
          <span class="qual-item">Timing</span>
          <span class="qual-item">Commercial constraints</span>
        </div>
      </div>
    </div>

    <div class="qualification-route-connector" aria-hidden="true">
      <div class="connector-track">
        <div class="connector-line"></div>
      </div>
    </div>

    <div class="discovery-progress-rail" aria-hidden="true">
      <span class="progress-step-num">01</span>
      <div class="progress-track">
        <div class="progress-bar" id="discoveryProgressBar"></div>
      </div>
      <span class="progress-step-num">05</span>
    </div>

    <div class="discovery-scene" id="discoveryScene">
      <div class="discovery-sticky">
        <div class="discovery-triad-desktop" id="solutionDiscovery">
          
          <nav class="triad-col-disciplines" role="tablist" aria-label="Infrastructure Disciplines">
            {solutionFamilies.map((family, idx) => (
              <button 
                role="tab"
                class={`discipline-tab-btn ${idx === 0 ? 'active' : ''}`}
                id={`tab-${family.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`panel-${family.id}`}
                data-target={family.id}
                data-discipline={family.id}
              >
                <div class="tab-index-row">
                  <span class="tab-num">{family.index}</span>
                  <span class="tab-discipline-kicker">{family.discipline}</span>
                </div>
                <span class="tab-name">{family.name}</span>
                <span class="active-route-indicator" aria-hidden="true"></span>
              </button>
            ))}

            <div class="discipline-route" aria-hidden="true">
              <svg
                class="route-svg"
                viewBox={`0 0 240 ${branchViewHeight}`}
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                preserveAspectRatio="xMinYMin meet"
              >
                {branchSets.map((set, idx) => (
                  <g class={`route-set ${idx === 0 ? 'active' : ''}`} data-route-set={set.id}>
                    <path class="route-trunk" d={`M ${TRUNK_X} 0 V ${set.height - 18}`} />
                    {set.rows.map((row) => (
                      <g class="branch-item">
                        <path class={`route-branch ${row.isRisk ? 'is-risk' : ''}`} d={row.d} />
                        <text class="route-label" x={LABEL_X} y={row.y + 3}>{row.label}</text>
                        {row.connectsToPhoto && (
                          <path class="route-connector-to-photo" d={`M ${ELBOW_X} ${row.y} H 238`} />
                        )}
                      </g>
                    ))}
                  </g>
                ))}
              </svg>
            </div>
          </nav>

          <div class="triad-col-visual">
            {solutionFamilies.map((family, idx) => (
              <div 
                class={`visual-frame ${idx === 0 ? 'active' : ''}`}
                id={`visual-${family.id}`}
                data-discipline={family.id}
                aria-hidden={idx !== 0 ? "true" : "false"}
              >
                <div class={`visual-ambient-tint tint-${family.id}`} aria-hidden="true"></div>

                <div class="visual-img-wrapper">
                  <Image
                    src={family.image}
                    alt={family.imageAlt}
                    class="visual-img"
                    loading="lazy"
                    widths={[640, 1080]}
                    sizes="(min-width: 1080px) 52vw, 92vw"
                    quality={74}
                    format="webp"
                  />
                  <div class="discipline-geometry-overlay" aria-hidden="true"></div>
                </div>
                <div class="visual-meta-bar">
                  <span class="visual-caption">Datacenter compute environment</span>
                  <span class="visual-index">{family.index} / 05</span>
                </div>
              </div>
            ))}
          </div>

          <div class="triad-col-services">
            {solutionFamilies.map((family, idx) => (
              <div 
                role="tabpanel"
                class={`services-panel ${idx === 0 ? 'active' : ''}`}
                id={`panel-${family.id}`}
                data-discipline={family.id}
                aria-labelledby={`tab-${family.id}`}
                hidden={idx !== 0}
              >
                <div class="services-panel-header">
                  <span class="panel-category-title">{family.name}</span>
                  <p class="panel-summary">{family.summary}</p>
                  <div class="panel-anchor-hairline" aria-hidden="true"></div>
                </div>

                <div class="service-routes-list">
                  {family.services.map(svc => (
                    <a href={svc.url} class="service-route-link" data-service-name={svc.name}>
                      <div class="route-info">
                        <span class="route-name">{svc.name}</span>
                        <span class="route-desc">{svc.desc}</span>
                      </div>
                      <span class="route-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                  ))}
                </div>

                <div class="panel-footer">
                  <a href={family.ctaLink} class="panel-overview-link">
                    <span>{family.name} overview</span>
                    <span class="link-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* Material warmth surface (Directive 25) */
  .section-solutions {
    background-color: var(--bg-subtle-paper, #F7F7F5);
    padding: 80px 0 72px;
    border-bottom: 1px solid var(--border-color);
  }

  .solutions-container {
    max-width: var(--max-width);
  }

  @media (min-width: 1440px) {
    .solutions-container {
      max-width: 1460px;
    }
  }

  /* Editorial Header Split (Directives 04–07) */
  .discovery-header-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    margin-bottom: 24px;
    padding-bottom: 24px;
  }

  @media (min-width: 980px) {
    .discovery-header-split {
      grid-template-columns: 1.4fr 1fr;
      gap: 56px;
      align-items: start;
    }
  }

  @media (min-width: 1280px) {
    .discovery-header-split {
      grid-template-columns: 1.55fr 0.95fr;
      gap: 72px;
    }
  }

  .header-editorial-left {
    display: flex;
    flex-direction: column;
  }

  /* Authoritative editorial headline (Directive 04) */
  .solutions-title {
    font-size: clamp(2.6rem, 4vw, 4.2rem);
    font-weight: 550;
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 16px;
    text-wrap: balance;
  }

  /* Copy rhythm (Directive 05) */
  .solutions-lead-rhythm {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .lead-primary {
    font-size: clamp(1.08rem, 1.3vw, 1.18rem);
    font-weight: 450;
    line-height: 1.48;
    color: var(--text-primary);
    max-width: 50ch;
  }

  .lead-secondary {
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.58;
    color: var(--text-secondary);
    max-width: 52ch;
  }

  /* Compact Qualification Block (Directive 06) */
  .header-qualification-right {
    display: flex;
    flex-direction: column;
    padding-top: 4px;
  }

  .qualification-top-rule {
    width: 100%;
    height: 1px;
    background-color: var(--border-color);
    margin-bottom: 12px;
  }

  .qualification-kicker {
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .qualification-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 24px;
  }

  .qual-item {
    font-size: 0.88rem;
    font-weight: 450;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Qualification Route Connector (Directive 08) */
  .qualification-route-connector {
    display: none;
  }

  @media (min-width: 980px) {
    .qualification-route-connector {
      display: block;
      width: 100%;
      height: 20px;
      margin-bottom: 16px;
      position: relative;
    }

    .connector-track {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background-color: var(--border-color);
    }

    .connector-line {
      position: absolute;
      left: 0;
      width: 120px;
      height: 1.5px;
      background-color: var(--color-cobalt);
    }
  }

  /* Continuous Scene Progress Rail (Directives 13, 28, 29) */
  .discovery-progress-rail {
    display: none;
  }

  @media (min-width: 980px) {
    .discovery-progress-rail {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
      max-width: 260px;
    }

    .progress-step-num {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .progress-track {
      flex-grow: 1;
      height: 1.5px;
      background-color: var(--border-color);
      position: relative;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 20%;
      background-color: var(--color-cobalt);
      transition: width 240ms var(--ease-out);
    }
  }

  /* Desktop Stage (Directives 09 & 10: 20% Nav / 52% Photo / 28% Detail) */
  .discovery-scene {
    position: relative;
  }

  .discovery-sticky {
    position: relative;
  }

  @media (min-width: 1180px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .discovery-scene {
      min-height: 250vh;
    }

    .discovery-sticky {
      position: sticky;
      top: calc(var(--header-height) + 16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discovery-scene {
      min-height: 0;
    }

    .discovery-sticky {
      position: static;
    }
  }

  .discovery-triad-desktop {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 1080px) {
    .discovery-triad-desktop {
      grid-template-columns: minmax(180px, 20%) minmax(520px, 52%) minmax(280px, 28%);
      gap: 0;
      align-items: start;
      min-height: 520px;
    }
  }

  /* Column 1: Discipline Rail (Directives 14–17) */
  .triad-col-disciplines {
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
  }

  @media (min-width: 1080px) {
    .triad-col-disciplines {
      padding-bottom: 0;
      border-bottom: none;
      border-right: 1px solid var(--border-color);
      padding-right: 24px;
    }
  }

  /* Uneven content-led spacing (Directive 17) */
  .discipline-tab-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 0;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    position: relative;
    border-radius: 0;
    transition: padding 180ms var(--ease-out);
  }

  .discipline-tab-btn.active {
    padding: 16px 0 20px;
  }

  .discipline-tab-btn:hover .tab-name {
    color: var(--color-cobalt);
  }

  /* Single moving cobalt active route indicator (Directive 16) */
  .active-route-indicator {
    position: absolute;
    right: -24px;
    top: 50%;
    width: 24px;
    height: 1.5px;
    background-color: var(--color-cobalt);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
  }

  .discipline-tab-btn.active .active-route-indicator {
    opacity: 1;
    transform: scaleX(1);
  }

  .tab-index-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 2px;
  }

  /* Mono ONLY for 01..05 (Directive 14) */
  .tab-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .discipline-tab-btn.active .tab-num {
    color: var(--color-cobalt);
  }

  /* Descriptors in main sans (Directive 14) */
  .tab-discipline-kicker {
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 450;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  .tab-name {
    font-size: 1.02rem;
    font-weight: 550;
    color: var(--text-primary);
    line-height: 1.3;
    transition: color 140ms var(--ease-out);
  }

  .discipline-tab-btn.active .tab-name {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Routing Branches SVG (Directives 18 & 19) */
  .discipline-route {
    display: none;
  }

  @media (min-width: 1080px) {
    .discipline-route {
      display: block;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--border-color);
    }
  }

  .route-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .route-set {
    opacity: 0;
    transition: opacity var(--motion-ui) var(--ease-out);
  }

  .route-set.active {
    opacity: 1;
  }

  .route-trunk {
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .route-branch {
    stroke: var(--color-cobalt);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .route-branch.is-risk {
    stroke: var(--color-route-amber);
  }

  .route-connector-to-photo {
    stroke: rgba(40, 84, 199, 0.4);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }

  .route-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 450;
    fill: var(--text-secondary);
  }

  /* Column 2: Architectural Environment Visual (Directives 10–13) */
  .triad-col-visual {
    position: relative;
    height: 100%;
    min-height: clamp(260px, 48vw, 540px);
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  @media (min-width: 1080px) {
    .triad-col-visual {
      padding: 0 28px;
      border-right: 1px solid var(--border-color);
    }
  }

  .visual-frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    transform: scale(0.995);
    transition: clip-path 460ms var(--ease-out), opacity 320ms var(--ease-out), transform 460ms var(--ease-out);
    pointer-events: none;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1080px) {
    .visual-frame {
      left: 28px;
      right: 28px;
    }
  }

  .visual-frame.active {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: scale(1.012);
    pointer-events: auto;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .visual-frame {
      clip-path: none !important;
      transform: none !important;
      transition: opacity 120ms ease !important;
    }
  }

  .visual-img-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 2px;
  }

  .visual-img {
    width: 100%;
    height: clamp(260px, 46vh, 520px);
    object-fit: cover;
    border-radius: 2px;
    display: block;
    filter: contrast(1.02);
  }

  /* Quiet editorial caption in main sans (Directive 12) */
  .visual-caption {
    margin-top: 10px;
    display: flex;
    align-items: center;
  }

  .caption-text {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 450;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  /* Column 3: Service Detail & Index (Directives 20–23) */
  .triad-col-services {
    position: relative;
    padding: 0;
  }

  @media (min-width: 1080px) {
    .triad-col-services {
      padding-left: 28px;
    }
  }

  .services-panel {
    display: none;
    flex-direction: column;
    gap: 18px;
  }

  .services-panel.active {
    display: flex;
    animation: panelReveal 300ms var(--ease-out);
  }

  @keyframes panelReveal {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Visual Anchor at top of right column (Directive 21) */
  .panel-header {
    padding-bottom: 6px;
  }

  .panel-title {
    font-size: 1.15rem;
    font-weight: 550;
    color: var(--text-primary);
    margin: 0 0 4px;
    line-height: 1.35;
  }

  .panel-summary {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 10px;
  }

  .panel-anchor-hairline {
    width: 100%;
    height: 1.5px;
    background-color: var(--color-cobalt);
  }

  .service-routes-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Service row interaction: clean hairlines, arrow on hover only (Directive 20, 23) */
  .service-route-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
    transition: border-color 140ms var(--ease-out);
  }

  .service-route-link:hover,
  .service-route-link:focus-visible {
    border-color: var(--color-cobalt);
  }

  .service-route-link:hover .route-name,
  .service-route-link:focus-visible .route-name {
    color: var(--color-cobalt);
  }

  .route-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .route-name {
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--text-primary);
    transition: color 140ms var(--ease-out);
  }

  .route-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  /* Arrow visible on hover/focus only (Directive 20) */
  .route-arrow {
    font-size: 0.88rem;
    color: var(--color-cobalt);
    opacity: 0;
    transform: translateX(-4px);
    transition: transform 140ms var(--ease-out), opacity 140ms var(--ease-out);
    flex-shrink: 0;
  }

  .service-route-link:hover .route-arrow,
  .service-route-link:focus-visible .route-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .panel-footer {
    margin-top: 10px;
  }

  .panel-overview-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 550;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-cobalt);
    padding-bottom: 2px;
    transition: color 140ms var(--ease-out);
  }

  .panel-overview-link:hover,
  .panel-overview-link:focus-visible {
    color: var(--color-cobalt);
  }

  .link-arrow {
    transition: transform 140ms var(--ease-out);
  }

  .panel-overview-link:hover .link-arrow,
  .panel-overview-link:focus-visible .link-arrow {
    transform: translateX(3px);
  }
</style>

<script>
  function setupSolutionDiscovery() {
    const container = document.getElementById('solutionDiscovery');
    const scene = document.getElementById('discoveryScene');
    const progressBar = document.getElementById('discoveryProgressBar');
    if (!container) return;

    const tabs = Array.from(container.querySelectorAll<HTMLElement>('.discipline-tab-btn'));
    const visuals = Array.from(container.querySelectorAll<HTMLElement>('.visual-frame'));
    const panels = Array.from(container.querySelectorAll<HTMLElement>('.services-panel'));
    const routeSets = Array.from(container.querySelectorAll<SVGGElement>('.route-set'));
    if (tabs.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pinQuery = window.matchMedia('(min-width: 1180px) and (min-height: 700px)');
    const isPinned = () => pinQuery.matches && !reducedMotion.matches;

    let activeIndex = 0;

    function activate(index: number) {
      if (index < 0 || index >= tabs.length) return;
      activeIndex = index;

      const target = tabs[index].getAttribute('data-target') || 'infrastructure';

      // Update progress bar
      if (progressBar) {
        const pct = ((index + 1) / tabs.length) * 100;
        progressBar.style.width = `${pct}%`;
      }

      tabs.forEach((tab, i) => {
        const isActive = i === index;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      visuals.forEach((visual) => {
        const isActive = visual.id === `visual-${target}`;
        visual.classList.toggle('active', isActive);
        visual.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      panels.forEach((panel) => {
        const isActive = panel.id === `panel-${target}`;
        panel.classList.toggle('active', isActive);
        if (isActive) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });

      routeSets.forEach((set) => {
        set.classList.toggle('active', set.getAttribute('data-route-set') === target);
      });

      // Dispatch event to HomepageSceneSystem (Directive 02)
      window.dispatchEvent(new CustomEvent('infrahub:discipline-changed', {
        detail: { id: target, index }
      }));
    }

    let ticking = false;

    function progressToIndex() {
      if (!scene) return 0;
      const sticky = scene.querySelector<HTMLElement>('.discovery-sticky');
      const travel = scene.offsetHeight - (sticky ? sticky.offsetHeight : 0);
      if (travel <= 0) return activeIndex;

      const scrolled = window.scrollY - (scene.getBoundingClientRect().top + window.scrollY);
      const progress = Math.min(Math.max(scrolled / travel, 0), 0.9999);
      return Math.floor(progress * tabs.length);
    }

    function onScroll() {
      if (ticking || !isPinned()) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        activate(progressToIndex());
        ticking = false;
      });
    }

    function scrollToIndex(index: number) {
      if (!scene || !isPinned()) return;
      const sticky = scene.querySelector<HTMLElement>('.discovery-sticky');
      const travel = scene.offsetHeight - (sticky ? sticky.offsetHeight : 0);
      if (travel <= 0) return;

      const sceneTop = scene.getBoundingClientRect().top + window.scrollY;
      const band = travel / tabs.length;
      window.scrollTo({
        top: Math.round(sceneTop + band * index + band * 0.5),
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        activate(index);
        scrollToIndex(index);
      });

      tab.addEventListener('keydown', (event) => {
        let newIndex: number | null = null;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
          newIndex = (index + 1) % tabs.length;
        } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
          newIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          newIndex = 0;
        } else if (event.key === 'End') {
          newIndex = tabs.length - 1;
        }

        if (newIndex !== null) {
          event.preventDefault();
          tabs[newIndex].focus();
          tabs[newIndex].click();
        }
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    pinQuery.addEventListener('change', onScroll);
    reducedMotion.addEventListener('change', onScroll);

    activate(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSolutionDiscovery);
  } else {
    setupSolutionDiscovery();
  }
</script>

