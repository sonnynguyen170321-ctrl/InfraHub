---
import { Image } from 'astro:assets';
import infrastructureVisual from '../assets/hero-datacenter.jpg';
import cloudVisual from '../assets/cloud-compute.jpg';
import networkVisual from '../assets/network-fiber.jpg';
import securityVisual from '../assets/security-operations.jpg';
import managedVisual from '../assets/managed-noc.jpg';

// src/components/EcosystemSolutions.astro — Solution Discovery (Master Art Direction Directives 06–16)
const solutionFamilies = [
  {
    id: "infrastructure",
    index: "01",
    name: "Infrastructure & Compute",
    discipline: "Hardware & facilities",
    summary: "Dedicated compute, colocation, GPU infrastructure, and enterprise hardware sourcing matched to workload, facility, and commercial requirements.",
    image: infrastructureVisual,
    imageAlt: "Enterprise datacenter server racks with precision cooling",
    ctaLink: "/solutions/infrastructure",
    services: [
      { name: "Dedicated Servers", url: "/dedicated-servers", desc: "High-spec bare metal with custom NVMe storage and ECC RAM" },
      { name: "Custom IaaS", url: "/custom-iaas", desc: "Tailored bare-metal clusters and dedicated private hypervisors" },
      { name: "GPU & AI Infrastructure", url: "/gpu-ai-infrastructure", desc: "GPU infrastructure for training, inference, and accelerator-heavy workloads" },
      { name: "Enterprise Hardware", url: "/enterprise-hardware", desc: "Enterprise routing, switching, server, and optical hardware sourcing" },
      { name: "Colocation", url: "/colocation", desc: "Rack, cage, power, and interconnection options matched to facility requirements" }
    ]
  },
  {
    id: "cloud",
    index: "02",
    name: "Cloud & Virtualization",
    discipline: "Virtualization & data location",
    summary: "Private cloud, public-cloud integration, VMware alternatives, container platforms, backup, and hybrid infrastructure architectures.",
    image: cloudVisual,
    imageAlt: "Clustered compute hypervisors and private cloud infrastructure",
    ctaLink: "/solutions/cloud-virtualization",
    services: [
      { name: "Private Cloud", url: "/private-cloud", desc: "Dedicated hypervisors with predictable operational economics" },
      { name: "VMware Alternatives", url: "/vmware-alternatives", desc: "Proxmox VE and XCP-ng / Vates migration architectures" },
      { name: "Public Cloud Integration", url: "/solutions/cloud-virtualization", desc: "Private connectivity and cloud on-ramps to major public cloud platforms" },
      { name: "Disaster Recovery", url: "/solutions/cloud-virtualization", desc: "Off-site replication and failover architectures, delivered by the selected provider" }
    ]
  },
  {
    id: "network",
    index: "03",
    name: "Network & Connectivity",
    discipline: "Transit & optical",
    summary: "Upstream IP transit, dedicated wavelengths, Layer 2 Ethernet, cloud connectivity, IPv4 sourcing, and edge-network options.",
    image: networkVisual,
    imageAlt: "High-density optical fiber patch panel and LC transceivers",
    ctaLink: "/solutions/network-connectivity",
    services: [
      { name: "IP Transit", url: "/ip-transit", desc: "Upstream BGP connectivity; commit levels and billing model are confirmed per provider" },
      { name: "Wavelengths", url: "/wavelengths", desc: "Dedicated point-to-point lit optical wavelengths across major metros" },
      { name: "Layer 2 Connectivity", url: "/layer-2-connectivity", desc: "Private Ethernet circuits and metro DCI interconnects" },
      { name: "Cloud Connectivity", url: "/cloud-connectivity", desc: "Private direct-connect bypass to cloud access points" },
      { name: "IPv4 Subnet Leasing", url: "/ipv4", desc: "IPv4 leasing, sourcing, reputation, authorization, and routing considerations" }
    ]
  },
  {
    id: "security",
    index: "04",
    name: "Security & Telemetry",
    discipline: "DDoS mitigation & telemetry",
    summary: "BGP DDoS mitigation, near-real-time flow telemetry, automated FlowSpec filtering, and perimeter security assessments.",
    image: securityVisual,
    imageAlt: "Network operations security monitoring console and BGP telemetry",
    ctaLink: "/solutions/security",
    services: [
      { name: "DDoS Mitigation", url: "/ddos-protection", desc: "Always-on and on-demand traffic scrubbing through provider scrubbing networks" },
      { name: "Detection Automation", url: "/ddos-detection-automation", desc: "FastNetMon near-real-time FlowSpec and automated diversion triggers" },
      { name: "Routing Intelligence", url: "/bgp-routing-intelligence", desc: "BGP visibility, route analysis, and operational routing decision support" },
      { name: "Cybersecurity Desk", url: "/cybersecurity", desc: "Perimeter and managed security options available through specialist providers" }
    ]
  },
  {
    id: "managed",
    index: "05",
    name: "Managed Operations",
    discipline: "Operations & engineering",
    summary: "Continuous network operations, automated incident triage, BGP engineering, and infrastructure operations support.",
    image: managedVisual,
    imageAlt: "Network operations control room with infrastructure monitoring displays",
    ctaLink: "/solutions/managed-services",
    services: [
      { name: "24/7 Managed NOC", url: "/managed-noc", desc: "Continuous monitoring and incident escalation, available through specialist providers" },
      { name: "AI Network Operations", url: "/ai-network-operations", desc: "Telemetry correlation and automated incident dispatch, available through specialist providers" },
      { name: "Network Engineering", url: "/solutions/managed-services", desc: "BGP, peering, routing and network architecture support, available through specialist providers" },
      { name: "Infrastructure Automation", url: "/solutions/managed-services", desc: "Infrastructure-as-code and network automation, available through specialist providers" }
    ]
  }
];

// The routing line branches by discipline (Directive 11)
const routeBranches: Record<string, string[]> = {
  infrastructure: ['Compute', 'Hardware', 'Colocation'],
  cloud: ['Private cloud', 'Virtualization', 'Hybrid', 'Backup'],
  network: ['Transit', 'Wavelengths', 'Layer 2', 'Cloud on-ramp', 'IPv4'],
  security: ['Detection', 'Mitigation', 'Diversion'],
  managed: ['Monitor', 'Triage', 'Engineer', 'Escalate']
};

const BRANCH_TOP = 14;
const BRANCH_GAP = 26;
const TRUNK_X = 10;
const ELBOW_X = 30;
const LABEL_X = 40;

const branchSets = solutionFamilies.map((family) => {
  const labels = routeBranches[family.id] ?? [];
  const rows = labels.map((label, i) => {
    const y = BRANCH_TOP + i * BRANCH_GAP;
    return {
      label,
      y,
      d: `M ${TRUNK_X} ${y - BRANCH_GAP / 2} V ${y} H ${ELBOW_X}`,
      isRisk: family.id === 'security' && label === 'Mitigation'
    };
  });
  const height = BRANCH_TOP + Math.max(labels.length - 1, 0) * BRANCH_GAP + 18;
  return { id: family.id, rows, height };
});

const branchViewHeight = Math.max(...branchSets.map((set) => set.height));
---

<section class="section section-solutions" id="discovery-stage" aria-label="Solutions by Discipline">
  <div class="container solutions-container">
    
    <!-- Section Header (Directive 10: Quiet opening without generic badge) -->
    <div class="solutions-header">
      <h2 class="solutions-title">Start with the requirement.</h2>
      <p class="solutions-subhead measure-lead">
        Start with the workload, location, capacity and constraints. The provider usually comes later. InfraHub helps map those requirements to suitable infrastructure approaches and specialist providers.
      </p>
    </div>

    <!-- Continuous Scene Progress Rail (Directives 13 & 14) -->
    <div class="discovery-progress-rail" aria-hidden="true">
      <span class="progress-step-num">01</span>
      <div class="progress-track">
        <div class="progress-bar" id="discoveryProgressBar"></div>
      </div>
      <span class="progress-step-num">05</span>
    </div>

    <!-- The discovery scene pins on desktop where room permits -->
    <div class="discovery-scene" id="discoveryScene" data-scene-steps={solutionFamilies.length}>
      <div class="discovery-sticky">
        <div class="discovery-triad-desktop" id="solutionDiscovery">
          
          <!-- Column 1: Editorial Discipline Navigation (Directive 07: Single moving indicator, no cards) -->
          <nav class="triad-col-disciplines" role="tablist" aria-label="Infrastructure Disciplines">
            {solutionFamilies.map((family, idx) => (
              <button 
                role="tab"
                class={`discipline-tab-btn ${idx === 0 ? 'active' : ''}`}
                id={`tab-${family.id}`}
                aria-selected={idx === 0 ? "true" : "false"}
                aria-controls={`panel-${family.id}`}
                data-target={family.id}
                data-discipline={family.id}
              >
                <div class="tab-index-row">
                  <span class="tab-num">{family.index}</span>
                  <span class="tab-discipline-kicker">{family.discipline}</span>
                </div>
                <span class="tab-name">{family.name}</span>
                <span class="active-route-indicator" aria-hidden="true"></span>
              </button>
            ))}

            <!-- The branch fan: routing lines specific to discipline (Directive 11) -->
            <div class="discipline-route" aria-hidden="true">
              <svg
                class="route-svg"
                viewBox={`0 0 240 ${branchViewHeight}`}
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                preserveAspectRatio="xMinYMin meet"
              >
                {branchSets.map((set, idx) => (
                  <g class={`route-set ${idx === 0 ? 'active' : ''}`} data-route-set={set.id}>
                    <path class="route-trunk" d={`M ${TRUNK_X} 0 V ${set.height - 18}`} />
                    {set.rows.map((row) => (
                      <g class="branch-item" data-branch-label={row.label}>
                        <path class={`route-branch ${row.isRisk ? 'is-risk' : ''}`} d={row.d} />
                        <text class="route-label" x={LABEL_X} y={row.y + 3}>{row.label}</text>
                      </g>
                    ))}
                  </g>
                ))}
              </svg>
            </div>
          </nav>

          <!-- Column 2: Architectural Environment Visual (Directives 06 & 08: 54% width, large photograph) -->
          <div class="triad-col-visual">
            {solutionFamilies.map((family, idx) => (
              <div 
                class={`visual-frame ${idx === 0 ? 'active' : ''}`}
                id={`visual-${family.id}`}
                data-discipline={family.id}
                aria-hidden={idx !== 0 ? "true" : "false"}
              >
                <div class="visual-img-wrapper">
                  <Image
                    src={family.image}
                    alt={family.imageAlt}
                    class="visual-img"
                    loading="lazy"
                    widths={[640, 1080]}
                    sizes="(min-width: 1080px) 54vw, 92vw"
                    quality={74}
                    format="webp"
                  />
                  <!-- Discipline specific route geometry overlay (Directive 16) -->
                  <div class="discipline-geometry-overlay" aria-hidden="true"></div>
                </div>
                <div class="visual-caption">
                  <span class="caption-marker"></span>
                  <span class="caption-text">{family.imageAlt}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- Column 3: Service Detail Interlock (Directive 09: Hairline interlock, no floating card) -->
          <div class="triad-col-services">
            {solutionFamilies.map((family, idx) => (
              <div 
                role="tabpanel"
                class={`services-panel ${idx === 0 ? 'active' : ''}`}
                id={`panel-${family.id}`}
                aria-labelledby={`tab-${family.id}`}
                hidden={idx !== 0}
              >
                <div class="panel-header">
                  <h3 class="panel-title">{family.name}</h3>
                  <p class="panel-summary measure-compact">{family.summary}</p>
                </div>

                <div class="service-routes-list">
                  {family.services.map(svc => (
                    <a href={svc.url} class="service-route-link" data-service-name={svc.name}>
                      <div class="route-info">
                        <span class="route-name">{svc.name}</span>
                        <span class="route-desc">{svc.desc}</span>
                      </div>
                      <span class="route-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                  ))}
                </div>

                <div class="panel-footer">
                  <a href={family.ctaLink} class="panel-overview-link">
                    <span>{family.name} overview</span>
                    <span class="route-arrow" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            ))}
          </div>

        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .section-solutions {
    background-color: var(--bg-primary);
    padding: 72px 0 64px;
    border-bottom: 1px solid var(--border-color);
  }

  .solutions-container {
    max-width: var(--max-width);
  }

  /* Quiet Header (Directive 10) */
  .solutions-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 28px;
    margin-bottom: 36px;
  }

  .solutions-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 14px;
  }

  .solutions-subhead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Continuous Scene Progress Rail (Directives 13 & 14) */
  .discovery-progress-rail {
    display: none;
  }

  @media (min-width: 980px) {
    .discovery-progress-rail {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 32px;
      max-width: 280px;
    }

    .progress-step-num {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .progress-track {
      flex-grow: 1;
      height: 1.5px;
      background-color: var(--border-color);
      position: relative;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      width: 20%;
      background-color: var(--color-cobalt);
      transition: width 240ms var(--ease-out);
    }
  }

  /* Desktop 3-Column Triad (Directive 06: 20% Nav / 54% Photo / 26% Detail) */
  .discovery-scene {
    position: relative;
  }

  .discovery-sticky {
    position: relative;
  }

  @media (min-width: 1180px) and (min-height: 700px) and (prefers-reduced-motion: no-preference) {
    .discovery-scene {
      min-height: 250vh;
    }

    .discovery-sticky {
      position: sticky;
      top: calc(var(--header-height) + 20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .discovery-scene {
      min-height: 0;
    }

    .discovery-sticky {
      position: static;
    }
  }

  .discovery-triad-desktop {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 1080px) {
    .discovery-triad-desktop {
      grid-template-columns: minmax(190px, 20%) minmax(540px, 54%) minmax(260px, 26%);
      gap: 0;
      align-items: start;
      min-height: 540px;
    }
  }

  /* Column 1: Editorial Navigation & Route Branches (Directive 07) */
  .triad-col-disciplines {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
  }

  @media (min-width: 1080px) {
    .triad-col-disciplines {
      padding-bottom: 0;
      border-bottom: none;
      border-right: 1px solid var(--border-color);
      padding-right: 28px;
    }
  }

  /* Single moving editorial route indicator — NO PALE CARDS (Directive 07) */
  .discipline-tab-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 14px 0;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    position: relative;
    border-radius: 0;
    transition: color 160ms var(--ease-out);
  }

  .discipline-tab-btn:hover .tab-name {
    color: var(--color-cobalt);
  }

  .active-route-indicator {
    position: absolute;
    right: -28px;
    top: 50%;
    width: 28px;
    height: 1.5px;
    background-color: var(--color-cobalt);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }

  .discipline-tab-btn.active .active-route-indicator {
    opacity: 1;
    transform: scaleX(1);
  }

  .tab-index-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 3px;
  }

  .tab-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-cobalt);
    font-weight: 600;
  }

  .tab-discipline-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .tab-name {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
    transition: color 160ms var(--ease-out);
  }

  .discipline-tab-btn.active .tab-name {
    color: var(--color-cobalt);
    font-weight: 700;
  }

  /* Routing Branches SVG */
  .discipline-route {
    display: none;
  }

  @media (min-width: 1080px) {
    .discipline-route {
      display: block;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid var(--border-color);
    }
  }

  .route-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .route-set {
    opacity: 0;
    transition: opacity var(--motion-ui) var(--ease-out);
  }

  .route-set.active {
    opacity: 1;
  }

  .route-trunk {
    stroke: var(--border-color);
    stroke-width: 1;
  }

  .route-branch {
    stroke: var(--color-cobalt);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .route-branch.is-risk {
    stroke: var(--color-route-amber);
  }

  .route-label {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--text-secondary);
  }

  /* Column 2: Architectural Environment Visual (Directive 08) */
  .triad-col-visual {
    position: relative;
    height: 100%;
    min-height: clamp(260px, 52vw, 560px);
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  @media (min-width: 1080px) {
    .triad-col-visual {
      padding: 0 28px;
      border-right: 1px solid var(--border-color);
    }
  }

  .visual-frame {
    position: absolute;
    inset: 0;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    transform: scale(0.99);
    transition: clip-path 460ms var(--ease-out), opacity 320ms var(--ease-out), transform 460ms var(--ease-out);
    pointer-events: none;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1080px) {
    .visual-frame {
      left: 28px;
      right: 28px;
    }
  }

  .visual-frame.active {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .visual-frame {
      clip-path: none !important;
      transform: none !important;
      transition: opacity 120ms ease !important;
    }
  }

  .visual-img-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .visual-img {
    width: 100%;
    height: clamp(260px, 50vh, 520px);
    object-fit: cover;
    border-radius: 0;
    border: none;
    display: block;
    filter: contrast(1.02);
  }

  .visual-caption {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .caption-marker {
    width: 5px;
    height: 5px;
    background-color: var(--color-cobalt);
    flex-shrink: 0;
  }

  .caption-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }

  /* Column 3: Service Detail Interlock (Directive 09: Hairline interlock, no card) */
  .triad-col-services {
    position: relative;
    padding: 0;
  }

  @media (min-width: 1080px) {
    .triad-col-services {
      padding-left: 28px;
    }
  }

  .services-panel {
    display: none;
    flex-direction: column;
    gap: 20px;
  }

  .services-panel.active {
    display: flex;
    animation: panelReveal 320ms var(--ease-out);
  }

  @keyframes panelReveal {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 16px;
  }

  .panel-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 4px;
  }

  .panel-summary {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .service-routes-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Service row interaction (Directive 12) */
  .service-route-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
    transition: color 140ms var(--ease-out), border-color 140ms var(--ease-out);
  }

  .service-route-link:hover,
  .service-route-link:focus-visible {
    border-color: var(--color-cobalt);
  }

  .service-route-link:hover .route-name,
  .service-route-link:focus-visible .route-name {
    color: var(--color-cobalt);
  }

  .service-route-link:hover .route-arrow,
  .service-route-link:focus-visible .route-arrow {
    transform: translateX(3px);
  }

  .route-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .route-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 140ms var(--ease-out);
  }

  .route-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .route-arrow {
    font-size: 0.9rem;
    color: var(--color-cobalt);
    transition: transform 140ms var(--ease-out);
    flex-shrink: 0;
  }

  .panel-footer {
    margin-top: 14px;
  }

  .panel-overview-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-cobalt);
    padding-bottom: 2px;
    transition: color 140ms var(--ease-out);
  }

  .panel-overview-link:hover,
  .panel-overview-link:focus-visible {
    color: var(--color-cobalt);
  }
</style>

<script>
  function setupSolutionDiscovery() {
    const container = document.getElementById('solutionDiscovery');
    const scene = document.getElementById('discoveryScene');
    const progressBar = document.getElementById('discoveryProgressBar');
    if (!container) return;

    const tabs = Array.from(container.querySelectorAll<HTMLElement>('.discipline-tab-btn'));
    const visuals = Array.from(container.querySelectorAll<HTMLElement>('.visual-frame'));
    const panels = Array.from(container.querySelectorAll<HTMLElement>('.services-panel'));
    const routeSets = Array.from(container.querySelectorAll<SVGGElement>('.route-set'));
    if (tabs.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pinQuery = window.matchMedia('(min-width: 1180px) and (min-height: 700px)');
    const isPinned = () => pinQuery.matches && !reducedMotion.matches;

    let activeIndex = 0;

    function activate(index: number) {
      if (index < 0 || index >= tabs.length) return;
      activeIndex = index;

      const target = tabs[index].getAttribute('data-target') || 'infrastructure';

      // Update progress bar
      if (progressBar) {
        const pct = ((index + 1) / tabs.length) * 100;
        progressBar.style.width = `${pct}%`;
      }

      tabs.forEach((tab, i) => {
        const isActive = i === index;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      visuals.forEach((visual) => {
        const isActive = visual.id === `visual-${target}`;
        visual.classList.toggle('active', isActive);
        visual.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      panels.forEach((panel) => {
        const isActive = panel.id === `panel-${target}`;
        panel.classList.toggle('active', isActive);
        if (isActive) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });

      routeSets.forEach((set) => {
        set.classList.toggle('active', set.getAttribute('data-route-set') === target);
      });

      // Dispatch event to HomepageSceneSystem (Directive 02)
      window.dispatchEvent(new CustomEvent('infrahub:discipline-changed', {
        detail: { id: target, index }
      }));
    }

    let ticking = false;

    function progressToIndex() {
      if (!scene) return 0;
      const sticky = scene.querySelector<HTMLElement>('.discovery-sticky');
      const travel = scene.offsetHeight - (sticky ? sticky.offsetHeight : 0);
      if (travel <= 0) return activeIndex;

      const scrolled = window.scrollY - (scene.getBoundingClientRect().top + window.scrollY);
      const progress = Math.min(Math.max(scrolled / travel, 0), 0.9999);
      return Math.floor(progress * tabs.length);
    }

    function onScroll() {
      if (ticking || !isPinned()) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        activate(progressToIndex());
        ticking = false;
      });
    }

    function scrollToIndex(index: number) {
      if (!scene || !isPinned()) return;
      const sticky = scene.querySelector<HTMLElement>('.discovery-sticky');
      const travel = scene.offsetHeight - (sticky ? sticky.offsetHeight : 0);
      if (travel <= 0) return;

      const sceneTop = scene.getBoundingClientRect().top + window.scrollY;
      const band = travel / tabs.length;
      window.scrollTo({
        top: Math.round(sceneTop + band * index + band * 0.5),
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        activate(index);
        scrollToIndex(index);
      });

      tab.addEventListener('keydown', (event) => {
        let newIndex: number | null = null;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
          newIndex = (index + 1) % tabs.length;
        } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
          newIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          newIndex = 0;
        } else if (event.key === 'End') {
          newIndex = tabs.length - 1;
        }

        if (newIndex !== null) {
          event.preventDefault();
          tabs[newIndex].focus();
          tabs[newIndex].click();
        }
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    pinQuery.addEventListener('change', onScroll);
    reducedMotion.addEventListener('change', onScroll);

    activate(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSolutionDiscovery);
  } else {
    setupSolutionDiscovery();
  }
</script>
