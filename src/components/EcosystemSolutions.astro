    background-color: var(--bg-secondary);
  }

  .discipline-tab-btn.active {
    background-color: var(--bg-secondary);
    border-left-color: var(--accent-blue);
  }

  .tab-index-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .tab-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-blue);
    font-weight: 600;
  }

  .tab-discipline-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .tab-name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .discipline-tab-btn.active .tab-name {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* Column 2: Center Visual (Directive 8: Controlled horizontal clip reveal) */
  .triad-col-visual {
    position: relative;
    height: 100%;
    min-height: clamp(240px, 52vw, 560px);
    display: flex;
    flex-direction: column;
  }

  .visual-frame {
    position: absolute;
    inset: 0;
    justify-content: center;
    opacity: 0;
    clip-path: inset(0 100% 0 0);
    transform: scale(0.985);
    transition: clip-path 480ms var(--ease-out), opacity 350ms var(--ease-out), transform 480ms var(--ease-out);
    pointer-events: none;
    display: flex;
    flex-direction: column;
  }

  .visual-frame.active {
    opacity: 1;
    clip-path: inset(0 0 0 0);
    transform: scale(1);
    pointer-events: auto;
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .visual-frame {
      clip-path: none !important;
      transform: none !important;
      transition: opacity 120ms ease !important;
    }
  }

  .visual-img {
    width: 100%;
    height: clamp(240px, 52vh, 560px);
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    display: block;
  }

  .visual-caption {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .caption-marker {
    width: 6px;
    height: 6px;
    background-color: var(--accent-blue);
    border-radius: 1px;
    flex-shrink: 0;
  }

  .caption-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  /* Column 3: Services & Context */
  .triad-col-services {
    position: relative;
    border-left: 1px solid var(--border-color);
    padding-left: 36px;
  }

  .services-panel {
    display: none;
    flex-direction: column;
    gap: 24px;
  }

  .services-panel.active {
    display: flex;
    animation: panelReveal var(--motion-content) var(--ease-out);
  }

  @keyframes panelReveal {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 18px;
  }


  .panel-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 6px;
  }

  .panel-summary {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .service-routes-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .service-route-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
    transition: color var(--motion-ui) var(--ease-out), border-color var(--motion-ui) var(--ease-out);
  }

  .service-route-link:hover,
  .service-route-link:focus-visible {
    border-color: var(--accent-blue);
  }

  .service-route-link:hover .route-name,
  .service-route-link:focus-visible .route-name {
    color: var(--accent-blue);
  }

  .service-route-link:hover .route-arrow,
  .service-route-link:focus-visible .route-arrow {
    transform: translateX(4px);
  }

  .route-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .route-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .route-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .route-arrow {
    font-size: 0.95rem;
    transition: transform var(--motion-ui) var(--ease-out);
    color: var(--accent-blue);
    margin-left: 12px;
    flex-shrink: 0;
  }

  .panel-footer {
    margin-top: 20px;
  }

  .panel-overview-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-blue);
    padding-bottom: 2px;
    transition: color var(--motion-ui) var(--ease-out);
  }

  .panel-overview-link:hover,
  .panel-overview-link:focus-visible {
    color: var(--accent-blue);
  }

  /* Mobile Architectural Accordion */
</style>

<script>
  // Solution discovery: one scene, two ways in.
  //
  // Clicking a discipline is the primary control and works everywhere, with or without
  // JavaScript-driven scrolling. On a desktop viewport with room for it, the scene also pins
  // and the discipline follows scroll position, so the reader moves through the disciplines by
  // reading rather than by clicking. Both paths call the same activate(), so the two can never
  // disagree about which discipline is showing.
  function setupSolutionDiscovery() {
    const container = document.getElementById('solutionDiscovery');
    const scene = document.getElementById('discoveryScene');
    if (!container) return;

    const tabs = Array.from(container.querySelectorAll<HTMLElement>('.discipline-tab-btn'));
    const visuals = Array.from(container.querySelectorAll<HTMLElement>('.visual-frame'));
    const panels = Array.from(container.querySelectorAll<HTMLElement>('.services-panel'));
    const routeSets = Array.from(container.querySelectorAll<SVGGElement>('.route-set'));
    if (tabs.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pinQuery = window.matchMedia('(min-width: 1180px) and (min-height: 700px)');
    const isPinned = () => pinQuery.matches && !reducedMotion.matches;

    let activeIndex = 0;

    function activate(index: number) {
      if (index === activeIndex) return;
      activeIndex = index;

      const target = tabs[index].getAttribute('data-target');

      tabs.forEach((tab, i) => {
        const isActive = i === index;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      visuals.forEach((visual) => {
        const isActive = visual.id === `visual-${target}`;
        visual.classList.toggle('active', isActive);
        visual.setAttribute('aria-hidden', isActive ? 'false' : 'true');
      });

      panels.forEach((panel) => {
        const isActive = panel.id === `panel-${target}`;
        panel.classList.toggle('active', isActive);
        if (isActive) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      });

      routeSets.forEach((set) => {
        set.classList.toggle('active', set.getAttribute('data-route-set') === target);
      });
    }

    // ── Scroll progression ────────────────────────────────────────────────
    // The scene is taller than the viewport; the sticky child holds still through the
    // difference. Progress through that difference selects the discipline.
    let ticking = false;

    function progressToIndex() {
      if (!scene) return 0;
      const sticky = scene.querySelector<HTMLElement>('.discovery-sticky');
      const travel = scene.offsetHeight - (sticky ? sticky.offsetHeight : 0);
      if (travel <= 0) return activeIndex;

      const scrolled = window.scrollY - (scene.getBoundingClientRect().top + window.scrollY);
      const progress = Math.min(Math.max(scrolled / travel, 0), 0.9999);
      return Math.floor(progress * tabs.length);
    }

    function onScroll() {
      if (ticking || !isPinned()) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        activate(progressToIndex());
        ticking = false;
      });
    }

    // Clicking scrolls to the position that represents that discipline, so the scene state and
    // the scroll position stay in agreement rather than fighting on the next wheel event.
    function scrollToIndex(index: number) {
      if (!scene || !isPinned()) return;
      const sticky = scene.querySelector<HTMLElement>('.discovery-sticky');
      const travel = scene.offsetHeight - (sticky ? sticky.offsetHeight : 0);
      if (travel <= 0) return;

      const sceneTop = scene.getBoundingClientRect().top + window.scrollY;
      const band = travel / tabs.length;
      window.scrollTo({
        top: Math.round(sceneTop + band * index + band * 0.5),
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        activate(index);
        scrollToIndex(index);
      });

      tab.addEventListener('keydown', (event) => {
        let newIndex: number | null = null;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
          newIndex = (index + 1) % tabs.length;
        } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
          newIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          newIndex = 0;
        } else if (event.key === 'End') {
          newIndex = tabs.length - 1;
        }

        if (newIndex !== null) {
          event.preventDefault();
          tabs[newIndex].focus();
          tabs[newIndex].click();
        }
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });

    // A resize changes the scene's travel distance, so the mapping has to be recomputed
    // rather than left stale.
    window.addEventListener('resize', onScroll, { passive: true });
    pinQuery.addEventListener('change', onScroll);
    reducedMotion.addEventListener('change', onScroll);

    onScroll();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSolutionDiscovery);
  } else {
    setupSolutionDiscovery();
  }
</script>
