---

<section class="section section-solution-selector" id="what-you-need" aria-labelledby="selector-heading">
  <div class="container">
    <div class="selector-header">
      <div class="selector-kicker">Capabilities</div>
      <h2 id="selector-heading" class="selector-title">What are you looking to solve?</h2>
      <p class="selector-intro">Select an infrastructure area to see how InfraHub coordinates the delivery path.</p>
    </div>

    <div class="selector-shell">
      <!-- Tabs -->
      <div class="selector-tabs" role="tablist" aria-label="Infrastructure Disciplines">
        {categories.map((cat, idx) => (
          <button
            type="button"
            role="tab"
            class={`selector-tab discipline-tab-btn ${idx === 0 ? 'active' : ''}`}
            id={`tab-${cat.id}`}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`panel-${cat.id}`}
            tabindex={idx === 0 ? 0 : -1}
            data-tab-target={cat.id}
          >
            <svg class="tab-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={cat.symbol} />
            </svg>
            <span>{cat.label}</span>
          </button>
        ))}
      </div>

      <!-- Panels -->
      <div class="selector-panels">
        {categories.map((cat, idx) => (
          <div
            class={`selector-panel ${idx === 0 ? 'active' : ''}`}
            id={`panel-${cat.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${cat.id}`}
            data-panel-id={cat.id}
          >
            <div class="panel-content">
              <div class="panel-copy">
                <h3 class="panel-tagline">{cat.tagline}</h3>
                <p class="panel-lead">{cat.lead}</p>
                
                <div class="panel-chips" aria-label={`${cat.label} Key Capabilities`}>
                  {cat.highlights.map(item => (
                    <span class="panel-chip">{item}</span>
                  ))}
                </div>

                <div class="panel-action-wrap">
                  <a href={cat.link} class="btn btn-accent btn-md">
                    <span>{cat.actionLabel}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                  <a href={`/lets-talk?service=${cat.id}`} class="panel-secondary-link">
                    Start a {cat.label} Brief &rarr;
                  </a>
                </div>
              </div>

              <div class="panel-graphic" aria-hidden="true">
                <div class="graphic-frame">
                  <div class="graphic-node-row">
                    <span class="graphic-dot"></span>
                    <span class="graphic-line"></span>
                    <span class="graphic-tag">InfraHub Coordination</span>
                    <span class="graphic-line"></span>
                    <span class="graphic-dot"></span>
                  </div>
                  <div class="graphic-title">{cat.label} Delivery Path</div>
                  <div class="graphic-sub">Single interface &bull; Multi-provider reach</div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initSolutionSelector() {
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.selector-tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.selector-panel'));

    if (!tabs.length) return;

    function activateTab(index: number, moveFocus = true) {
      tabs.forEach((t, i) => {
        const isTarget = i === index;
        t.classList.toggle('active', isTarget);
        t.setAttribute('aria-selected', isTarget ? 'true' : 'false');
        t.setAttribute('tabindex', isTarget ? '0' : '-1');
      });

      const activeTargetId = tabs[index]?.getAttribute('data-tab-target');
      panels.forEach(p => {
        p.classList.toggle('active', p.getAttribute('data-panel-id') === activeTargetId);
      });

      if (moveFocus) {
        tabs[index]?.focus();
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        activateTab(index, false);
      });

      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let newIndex: number | null = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          newIndex = (index + 1) % tabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          newIndex = (index - 1 + tabs.length) % tabs.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = tabs.length - 1;
        }

        if (newIndex !== null) {
          e.preventDefault();
          activateTab(newIndex, true);
        }
      });
    });
  }

  // Run on mount
  initSolutionSelector();
  document.addEventListener('astro:page-load', initSolutionSelector);
</script>

<style>
  .section-solution-selector {
    background: var(--bg-primary);
    padding: clamp(72px, 9vw, 112px) 0;
    border-bottom: 1px solid var(--border-color);
  }

  .selector-header {
    margin-bottom: clamp(36px, 5vw, 56px);
  }

  .selector-kicker {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-blue);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 12px;
  }

  .selector-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    font-weight: 700;
    margin-bottom: 14px;
    color: var(--text-primary);
  }

  .selector-intro {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: var(--text-secondary);
    max-width: 58ch;
    margin: 0;
    line-height: 1.55;
  }

  .selector-shell {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
  }

  /* Tabs Bar */
  .selector-tabs {
    display: flex;
    flex-wrap: wrap;
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 8px 12px 0;
    gap: 6px;
  }

  .selector-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .selector-tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
  }

  .selector-tab.active {
    color: var(--text-primary);
    background: var(--bg-card);
    border-color: var(--border-color);
    font-weight: 600;
  }

  .tab-icon {
    stroke: currentColor;
    opacity: 0.8;
  }

  .selector-tab.active .tab-icon {
    color: var(--accent-blue);
    opacity: 1;
  }

  /* Panels */
  .selector-panel {
    display: none;
    padding: clamp(32px, 5vw, 48px);
  }

  .selector-panel.active {
    display: block;
    animation: panelFadeIn 0.25s ease-out;
  }

  @keyframes panelFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-content {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.9fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  .panel-tagline {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .panel-lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 58ch;
  }

  .panel-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 32px;
  }

  .panel-chip {
    display: inline-block;
    padding: 6px 12px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .panel-action-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .panel-secondary-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .panel-secondary-link:hover {
    color: var(--accent-blue);
  }

  /* Graphic Frame */
  .graphic-frame {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }

  .graphic-node-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .graphic-dot {
    width: 6px;
    height: 6px;
    background: var(--accent-blue);
    border-radius: 50%;
  }

  .graphic-line {
    flex: 1;
    max-width: 48px;
    height: 1px;
    background: rgba(37, 99, 235, 0.4);
  }

  .graphic-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
  }

  .graphic-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
  }

  .graphic-sub {
    font-size: 0.8125rem;
    color: var(--text-muted, #64748b);
  }

  @media (max-width: 860px) {
    .panel-content {
      grid-template-columns: 1fr;
    }
    .panel-graphic {
      order: -1;
    }
  }
</style>
