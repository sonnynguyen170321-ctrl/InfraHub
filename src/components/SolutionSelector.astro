    symbol: "M3 12h18M12 3v18",
    tagline: "Move data reliably between users, facilities, and clouds.",
    lead: "IP Transit, lit wavelengths, Layer 2 Ethernet, and cross-facility route diversity engineered around your exact availability requirements.",
    highlights: ["10G/100G/400G Transit", "Dedicated Wavelengths", "Cloud Interconnects", "Route Diversity"],
    link: "/solutions/network-connectivity",
    actionLabel: "Explore Network"
  },
  {
    id: "compute",
    label: "Compute",
    symbol: "M4 6h16M4 12h16M4 18h16",
    tagline: "High-density bare-metal, accelerator fabrics, and colocation.",
    lead: "Dedicated server clusters, GPU infrastructure, enterprise hardware sourcing, and space/power across Tier-3/4 facilities worldwide.",
    highlights: ["Bare Metal Clusters", "GPU & AI Hardware", "Colocation Cages", "Enterprise Sourcing"],
    link: "/solutions/infrastructure",
    actionLabel: "Explore Compute"
  },
  {
    id: "cloud",
    label: "Cloud",
    symbol: "M3 15a4 4 0 011-8 5 5 0 019 0 4 4 0 011 8H3z",
    tagline: "Sovereign private hypervisors and predictable cloud economics.",
    lead: "Private cloud virtualization, VMware exit architectures (Proxmox VE & XCP-ng), and dedicated direct connects to major public providers.",
    highlights: ["Private Cloud", "VMware Migration", "Direct Hyperscaler Links", "Disaster Recovery"],
    link: "/solutions/cloud-virtualization",
    actionLabel: "Explore Cloud"
  },
  {
    id: "security",
    label: "Security",
    symbol: "M12 2l8 4v6c0 5.25-3.5 10.15-8 12-4.5-1.85-8-6.75-8-12V6l8-4z",
    tagline: "Multi-Tbps volumetric scrubbing and edge routing defense.",
    lead: "Always-on and on-demand DDoS mitigation, sub-second BGP FlowSpec diversion, and real-time routing leak detection.",
    highlights: ["DDoS Mitigation", "BGP FlowSpec", "Route Intelligence", "Perimeter Defense"],
    link: "/solutions/security",
    actionLabel: "Explore Security"
  },
  {
    id: "operations",
    label: "Operations",
    symbol: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
    tagline: "24/7 technical operations and automated lifecycle support.",
    lead: "Round-the-clock incident monitoring, network engineering escalations, configuration automation, and complex migration execution.",
    highlights: ["24/7 Managed NOC", "Network Engineering", "Telemetry & Triage", "Migration Support"],
    link: "/solutions/managed-services",
    actionLabel: "Explore Operations"
  },
  {
    id: "custom",
    label: "Not sure",
    symbol: "M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
    tagline: "Bring us the problem. We evaluate the approach.",
    lead: "If your requirement spans multiple infrastructure layers or you are experiencing recurring failure, describe the symptom to InfraHub.",
    highlights: ["Architecture Review", "Multi-layer Diagnostic", "Carrier Benchmarking", "Vendor Diligence"],
