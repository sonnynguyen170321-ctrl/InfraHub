---
// src/components/WhyInfraHub.astro
const pillars = [
  {
    id: "choice",
    title: "Choice",
    lead: "You are never restricted to one provider's infrastructure or datacenter footprint.",
    body: "Unlike direct sales reps who can only sell their own company's products, InfraHub matches your specific geographic, latency, and commercial constraints across multiple Tier-1 and specialized providers."
  },
  {
    id: "specialization",
    title: "Specialization",
    lead: "Different specialists excel at completely different technical disciplines.",
    body: "The best bare-metal provider in Singapore is rarely the best DDoS scrubbing provider in Frankfurt. We connect you with the specific team that is technically superior in the exact discipline you need."
  },
  {
    id: "experience",
    title: "Experience",
    lead: "Deep engineering and telecom industry expertise informs our qualification process.",
    body: "We understand BGP community routing, 95th percentile burst formulas, conduit diversity risks, and optical latency constraints. We evaluate requirements from an engineering perspective, not a sales script."
  },
  {
    id: "access",
    title: "Access",
    lead: "A single starting conversation opens access across a verified partner ecosystem.",
    body: "Skip spending months vetting vendors, requesting individual quotes, and negotiating minimum volume terms. One conversation with InfraHub maps your requirement to the optimal partners immediately."
  }
];
---

<section class="section section-white" id="why-infrahub">
  <div class="container">
    <div class="section-header text-center">
      <span class="pill-badge badge-teal section-tag">Our Value Proposition</span>
      <h2>Why InfraHub?</h2>
      <p>A transparent, sourcing-led approach that aligns with how technical buyers actually make infrastructure decisions.</p>
    </div>

    <div class="why-tabs-container">
      <!-- Tabs Bar -->
      <div class="why-tab-nav" role="tablist">
        {pillars.map((p, idx) => (
          <button 
            class={`why-tab-btn ${idx === 0 ? 'is-active' : ''}`}
            id={`why-btn-${p.id}`}
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`why-panel-${p.id}`}
            data-target={p.id}
          >
            <span class="why-tab-title">{p.title}</span>
          </button>
        ))}
      </div>

      <!-- Tab Content Area -->
      <div class="why-tab-content">
        {pillars.map((p, idx) => (
          <div 
            class={`why-panel ${idx === 0 ? 'is-active' : ''}`}
            id={`why-panel-${p.id}`}
            role="tabpanel"
            aria-labelledby={`why-btn-${p.id}`}
            hidden={idx !== 0}
          >
            <h3 class="why-panel-lead">{p.lead}</h3>
            <p class="why-panel-body">{p.body}</p>
            <div class="why-panel-footer">
              <a href="/about" class="btn btn-secondary">
                <span>Read About Our Commercial Ethics</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .why-tabs-container {
    max-width: 920px;
    margin: 0 auto;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .why-tab-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-color);
  }
  @media (max-width: 640px) {
    .why-tab-nav {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .why-tab-btn {
    padding: 20px 16px;
    text-align: center;
    background-color: transparent;
    border-bottom: 3px solid transparent;
    transition: var(--transition-fast);
  }
  .why-tab-btn:hover {
    background-color: var(--bg-secondary);
  }
  .why-tab-btn.is-active {
    background-color: var(--bg-secondary);
    border-bottom-color: var(--accent-blue);
  }

  .why-tab-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-secondary);
  }
  .why-tab-btn.is-active .why-tab-title {
    color: var(--text-primary);
  }

  .why-tab-content {
    padding: 48px 40px;
  }
  @media (max-width: 640px) {
    .why-tab-content {
      padding: 30px 24px;
    }
  }

  .why-panel {
    display: none;
    flex-direction: column;
    gap: 20px;
    animation: fadeIn 0.25s ease-out;
  }
  .why-panel.is-active {
    display: flex;
  }

  .why-panel-lead {
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
  }

  .why-panel-body {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 780px;
  }

  .why-panel-footer {
    padding-top: 16px;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('.why-tab-btn');
    const tabPanels = document.querySelectorAll('.why-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        tabButtons.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        tabPanels.forEach(p => {
          p.classList.remove('is-active');
          p.hidden = true;
        });

        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        const activePanel = document.getElementById(`why-panel-${targetId}`);
        if (activePanel) {
          activePanel.classList.add('is-active');
          activePanel.hidden = false;
        }
      });
    });
  });
</script>
