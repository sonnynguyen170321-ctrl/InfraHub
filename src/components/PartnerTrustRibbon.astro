---
// src/components/PartnerTrustRibbon.astro | InfraHub Premium Partner Trust System
import { getCollection } from 'astro:content';

const allPartners = await getCollection('partners');

// Filter strictly for partners with confirmed relationship and approved naming for homepage marquee
const approvedPartners = allPartners
  .filter(p => 
    p.data.homepageMarqueeEnabled && 
    p.data.relationshipConfirmed && 
    p.data.publicNameApproved
  )
  .sort((a, b) => (a.data.homepagePriority ?? 10) - (b.data.homepagePriority ?? 10));
---

<section class="partner-trust-ribbon" aria-label="Partner Ecosystem">
  <div class="ribbon-inner">
    
    <!-- Zone 1: Fixed Left Anchor -->
    <div class="ribbon-fixed-zone">
      <span class="ribbon-kicker">Our partner ecosystem</span>
      <span class="ribbon-subtitle">Specialist infrastructure providers &amp; technologies</span>
    </div>

    <!-- Zone 2: Moving Horizontal Ecosystem Track -->
    <div class="ribbon-track-wrapper">
      <div class="ribbon-marquee-content">
        
        <!-- Primary Track (Accessible, Interactive) -->
        <ul class="marquee-track primary-track" aria-label="Partner Technologies Rail">
          {approvedPartners.map(partner => (
            <li class="partner-item">
              <a 
                href={`/partners/${partner.slug}`} 
                class="partner-logo-link"
                aria-label={`${partner.data.name} — ${partner.data.shortRole || partner.data.tagline}`}
                title={`${partner.data.name} — ${partner.data.shortRole || partner.data.tagline}`}
              >
                {partner.data.logoApproved && partner.data.logoStatus === 'approved' ? (
                  <img 
                    src={partner.data.logo} 
                    alt={`${partner.data.name} logo`} 
                    class="partner-logo-img"
                    style={partner.data.logoScale && partner.data.logoScale !== 1 ? `transform: scale(${partner.data.logoScale});` : undefined}
                    loading="eager"
                    width="140"
                    height="32"
                  />
                ) : (
                  <span class="partner-text-mark">
                    <span class="partner-name">{partner.data.name}</span>
                    {partner.data.shortRole && <span class="partner-role">{partner.data.shortRole}</span>}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>

        <!-- Visual Duplicate Track (Seamless Loop, Hidden from Screen Readers & Non-interactive) -->
        <ul class="marquee-track duplicate-track" aria-hidden="true">
          {approvedPartners.map(partner => (
            <li class="partner-item">
              <span class="partner-logo-link decorative">
                {partner.data.logoApproved && partner.data.logoStatus === 'approved' ? (
                  <img 
                    src={partner.data.logo} 
                    alt="" 
                    class="partner-logo-img"
                    style={partner.data.logoScale && partner.data.logoScale !== 1 ? `transform: scale(${partner.data.logoScale});` : undefined}
                    loading="lazy"
                    width="140"
                    height="32"
                  />
                ) : (
                  <span class="partner-text-mark">
                    <span class="partner-name">{partner.data.name}</span>
                    {partner.data.shortRole && <span class="partner-role">{partner.data.shortRole}</span>}
                  </span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .partner-trust-ribbon {
    position: relative;
    background-color: #ffffff;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 16px 0;
    overflow: hidden;
    z-index: 10;
  }

  .ribbon-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
  }

  @media (min-width: 900px) {
    .ribbon-inner {
      flex-direction: row;
      align-items: center;
      gap: 36px;
    }
  }

  /* Zone 1: Fixed Anchor */
  .ribbon-fixed-zone {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
    width: 100%;
  }

  @media (min-width: 900px) {
    .ribbon-fixed-zone {
      width: 220px;
      padding-bottom: 0;
      border-bottom: none;
      border-right: 1px solid var(--border-color);
    }
  }

  .ribbon-kicker {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .ribbon-subtitle {
    font-size: 0.8rem;
    color: #475569;
    line-height: 1.35;
  }

  /* Typographic Partner Mark (Authentic Non-Synthetic Fallback) */
  .partner-text-mark {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background: #f8fafc;
    border: 1px solid var(--border-color);
    transition: var(--transition-fast);
  }
  .partner-logo-link:hover .partner-text-mark {
    border-color: var(--accent-blue);
    background: #ffffff;
    box-shadow: var(--shadow-sm);
  }
  .partner-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .partner-role {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: #64748b;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.2;
    margin-top: 2px;
  }

  /* Zone 2: Moving Rail */
  .ribbon-track-wrapper {
    flex-grow: 1;
    overflow: hidden;
    position: relative;
    width: 100%;
    /* Edge fade masks for quiet entrance & exit */
    mask-image: linear-gradient(to right, transparent, black 32px, black calc(100% - 32px), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 32px, black calc(100% - 32px), transparent);
  }

  .ribbon-marquee-content {
    display: flex;
    width: max-content;
  }

  /* Marquee animation: compositor-friendly translateX */
  @keyframes marqueeSlide {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-100%, 0, 0);
    }
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 56px;
    padding-right: 56px;
    list-style: none;
    margin: 0;
    padding-left: 0;
    animation: marqueeSlide 50s linear infinite;
    will-change: transform;
  }

  @media (min-width: 1200px) {
    .marquee-track {
      gap: 72px;
      padding-right: 72px;
    }
  }

  /* Pause on hover and keyboard focus so users can inspect/click */
  .ribbon-track-wrapper:hover .marquee-track,
  .ribbon-track-wrapper:focus-within .marquee-track {
    animation-play-state: paused;
  }

  .partner-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .partner-logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.72;
    transition: opacity 0.2s ease, transform 0.2s ease;
    padding: 6px 4px;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .partner-logo-link:hover,
  .partner-logo-link:focus-visible {
    opacity: 1;
    transform: translateY(-1px);
    outline: 2px solid var(--accent-blue);
    outline-offset: 4px;
  }

  .partner-logo-link.decorative {
    cursor: default;
    pointer-events: none;
  }

  .partner-logo-img {
    height: 26px;
    max-height: 28px;
    width: auto;
    max-width: 135px;
    object-fit: contain;
    display: block;
    user-select: none;
    pointer-events: none;
  }

  /* Accessibility: Prefers-reduced-motion fallback */
  @media (prefers-reduced-motion: reduce) {
    .ribbon-track-wrapper {
      mask-image: none;
      -webkit-mask-image: none;
      overflow-x: auto;
    }

    .ribbon-marquee-content {
      width: 100%;
    }

    .marquee-track {
      animation: none !important;
      transform: none !important;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding: 12px 0;
    }

    .duplicate-track {
      display: none !important;
    }
  }
</style>
