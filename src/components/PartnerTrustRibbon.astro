---
// src/components/PartnerTrustRibbon.astro | InfraHub Partner Ecosystem Ribbon — Premium Marquee Pass
import { getCollection } from 'astro:content';
import { logoScaleStyle } from '../lib/partner-logo';

const allPartners = await getCollection('partners');

// Filter strictly for partners with confirmed relationship and approved naming for homepage marquee
const approvedPartners = allPartners
  .filter(p => 
    p.data.homepageMarqueeEnabled && 
    p.data.relationshipConfirmed && 
    p.data.publicNameApproved
  )
  .sort((a, b) => (a.data.homepagePriority ?? 10) - (b.data.homepagePriority ?? 10));

// Optical scale is a property of the artwork, so it lives with the partner record rather
// than in a second table here. A lockup whose wordmark is outlined or whose aspect ratio is
// unusual needs a nudge to carry the same visual weight as the others in its slot.
//
// The base height it multiplies is --ribbon-logo-height in this component's stylesheet, not a
// constant here: the base differs between the wide and narrow layouts, and only CSS can answer
// a media query. Each record contributes --logo-scale and the stylesheet resolves the rest.

---

<section class="partner-trust-ribbon" aria-label="Partner Ecosystem">
  <div class="ribbon-inner">
    <div class="ribbon-fixed-zone">
      <span class="ribbon-kicker">Our partner ecosystem</span>
    </div>

    <div class="ribbon-track-wrapper">
      <div class="marquee-strip">
        <!-- Sequence A: Accessible Primary Sequence -->
        <ul class="marquee-track primary-track" aria-label="Partner ecosystem">
          {approvedPartners.map((partner, index) => (
            <li class="partner-item">
              <a 
                href={`/partners/${partner.slug}`} 
                class="partner-logo-link"
                aria-label={`${partner.data.name} — ${partner.data.shortRole || partner.data.tagline}`}
                title={`${partner.data.name} — ${partner.data.shortRole || partner.data.tagline}`}
              >
                {partner.data.logoApproved && partner.data.logoStatus === 'approved' && partner.data.logo ? (
                  <img 
                    src={partner.data.logo} 
                    alt={`${partner.data.name} logo`} 
                    class="partner-logo-img"
                    style={logoScaleStyle(partner.data.logoScale)}
                    loading={index < 2 ? "eager" : "lazy"}
                    width="140"
                    height="32"
                  />
                ) : (
                  <span class="partner-text-mark">
                    <span class="partner-name">{partner.data.name}</span>
                    {partner.data.shortRole && <span class="partner-role">{partner.data.shortRole}</span>}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>

        <!-- Sequence B: Seamless Duplicate (aria-hidden) -->
        <ul class="marquee-track duplicate-track" aria-hidden="true">
          {approvedPartners.map(partner => (
            <li class="partner-item">
              <span class="partner-logo-link decorative">
                <img 
                  src={partner.data.logo} 
                  alt="" 
                  class="partner-logo-img"
                  style={logoScaleStyle(partner.data.logoScale)}
                  loading="lazy"
                  width="140"
                  height="32"
                />
              </span>
            </li>
          ))}
        </ul>

        <!-- Sequence C: Seamless Ultrawide Triplicate (aria-hidden) -->
        <ul class="duplicate-track" aria-hidden="true">
          {approvedPartners.map(partner => (
            <li class="partner-item">
              <span class="partner-logo-link decorative">
                <img 
                  src={partner.data.logo} 
                  alt="" 
                  class="partner-logo-img"
                  style={logoScaleStyle(partner.data.logoScale)}
                  loading="lazy"
                  width="140"
                  height="32"
                />
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

</section>

<script>
  function initPartnerMarquee() {
    const wrapper = document.querySelector('.partner-trust-ribbon .ribbon-track-wrapper') as HTMLElement | null;
    if (!wrapper) return;
    const primaryTrack = wrapper.querySelector('.primary-track') as HTMLElement | null;
    if (!primaryTrack) return;

    // Larger marks travelling slightly slower read as institutional rather than busy.
    const SPEED_PPS = 26;

    // One cycle must be wider than the rail, or a second copy of the sequence is on screen
    // before the first has left and the same brand appears at both edges at once.
    const DESKTOP_POSITIONS = 7.35;
    const MOBILE_POSITIONS = 2.4;

    // Entering part-way through a slot means no mark is ever aligned as the first one.
    const ENTRY_FRACTION = 0.3;

    const section = wrapper.closest('.partner-trust-ribbon') as HTMLElement | null;

    // One cycle has to stay wider than the rail. Two copies of a mark are exactly one cycle
    // apart, so while the cycle exceeds the rail they cannot both be on screen.
    const CYCLE_MARGIN = 1.08;

    function slotFor(railWidth: number, count: number, gap: number): number {
      const wide = window.matchMedia('(min-width: 900px)').matches;
      const preferred = railWidth / (wide ? DESKTOP_POSITIONS : MOBILE_POSITIONS);
      /*
       * The floor is tiered because one value cannot serve both ends. Held at 190 it starves
       * 1024 of its fourth identity; held at 178 it caps mid-width logos around 142px, short of
       * the 155-185 the marks are meant to read at. The rail decides which constraint binds.
       */
      const min = wide ? (railWidth >= 1150 ? 190 : 178) : 132;
      const max = wide ? 245 : 168;
      const slot = Math.min(Math.max(preferred, min), max);

      /*
       * Above roughly 2100px the preferred slot hits its ceiling while the rail keeps growing,
       * and eight marks no longer span it: measured at 2560 the cycle came to 0.93 of the rail
       * and the duplicate returned. With a fixed number of partners the only remaining variable
       * is the slot, so it is allowed past its ceiling only as far as the rail actually forces.
       */
      const forced = (railWidth * CYCLE_MARGIN) / Math.max(count, 1) - gap;
      return Math.min(Math.max(slot, forced), 320);
    }

    function measure() {
      if (!primaryTrack || !wrapper) return;

      const railWidth = wrapper.clientWidth;
      if (railWidth <= 0) return;

      const gap = parseFloat(getComputedStyle(wrapper).getPropertyValue('--ribbon-gap')) || 28;
      const count = primaryTrack.children.length;

      // Sized from the rail first, because the group width below depends on it.
      const slot = Math.round(slotFor(railWidth, count, gap));
      (section ?? wrapper).style.setProperty('--ribbon-slot', `${slot}px`);

      const width = primaryTrack.getBoundingClientRect().width;
      if (width <= 0) return;

      const duration = Math.max(40, width / SPEED_PPS);
      wrapper.style.setProperty('--marquee-distance', `${width.toFixed(2)}px`);
      wrapper.style.setProperty('--marquee-duration', `${duration.toFixed(2)}s`);

      /*
       * A negative delay starts the animation part-way through rather than translating the
       * strip separately: same phase shift, no extra transform on the composited layer.
       */
      const strip = wrapper.querySelector('.marquee-strip') as HTMLElement | null;
      if (strip) {
        strip.style.animationDelay = `${(-((slot + gap) * ENTRY_FRACTION) / SPEED_PPS).toFixed(2)}s`;
      }
    }

    measure();

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => measure());
      ro.observe(primaryTrack);
    }

    window.addEventListener('resize', measure, { passive: true });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(measure);
    }
  }

  /*
   * The surface arrives rather than appearing: --ribbon-land runs 0 -> 1 across the hero's exit
   * and the CSS turns that into a hinge and a lift, so the ribbon finishes flat at the moment
   * the canvas plane finishes landing. Reads one offsetHeight and window.scrollY, writes one
   * custom property, both behind a single rAF, so a scroll never queues more than one frame.
   */
  function initRibbonLanding() {
    const section = document.querySelector('.partner-trust-ribbon') as HTMLElement | null;
    if (!section) return;

    const hero = document.querySelector('.hero-section') as HTMLElement | null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame = 0;

    function settle() {
      section!.style.setProperty('--ribbon-land', '1');
    }

    function measure() {
      frame = 0;

      /*
       * Keyed to the hero's exit, using the identical mapping hero-3d-transition.ts feeds the
       * canvas, so the ribbon and the plane it lands on settle in lockstep instead of drifting
       * against each other. Tying this to the ribbon's own entry did not work: under a hero
       * shorter than the viewport the ribbon is already on screen at first paint, so the whole
       * motion was spent inside the first hundred pixels of scroll and never actually read.
       */
      const heroHeight = hero ? hero.offsetHeight || 1 : 1;
      const raw = (window.scrollY - heroHeight * 0.45) / (heroHeight * 0.55);
      const land = Math.min(Math.max(raw, 0), 1);

      section!.style.setProperty('--ribbon-land', land.toFixed(3));
    }

    function request() {
      if (frame) return;
      frame = requestAnimationFrame(measure);
    }

    function apply() {
      if (reduce.matches) {
        window.removeEventListener('scroll', request);
        window.removeEventListener('resize', request);
        settle();
        return;
      }
      window.addEventListener('scroll', request, { passive: true });
      window.addEventListener('resize', request, { passive: true });
      measure();
    }

    apply();

    if (typeof reduce.addEventListener === 'function') {
      reduce.addEventListener('change', apply);
    }
  }

  function initRibbon() {
    initPartnerMarquee();
    initRibbonLanding();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRibbon);
  } else {
    initRibbon();
  }
</script>

<style>
  /*
   * The ribbon used to be a white strip fenced by two rules, sitting between a dark hero and
   * the paper ground of the section below — three tones and four edges, which is what made it
   * read as a box dropped onto the page rather than part of it. It now carries the same ground
   * as .section-solutions, so the hero plane lands, the logos ride it, and the content below
   * continues on one uninterrupted surface. The structural axis at the bottom stays: that line
   * means something (DESIGN.md section 2), the borders did not.
   *
   * --ribbon-land is 0 while the surface is still arriving and 1 once it has settled. It
   * defaults to 1 so that without JavaScript the ribbon renders finished, not tilted.
   */
  .partner-trust-ribbon {
    position: relative;
    background-color: var(--bg-subtle-paper, #F7F7F5);
    padding: 13px 0;
    overflow: hidden;
    z-index: 10;
    --ribbon-land: 1;
    --ribbon-gap: 28px;
    --ribbon-logo-height: 36px;
  }

  /*
   * The structural axis is gone. It was a 1px cobalt rule along the ribbon's bottom edge,
   * justified as the hero route flattening into the ecosystem. Measured against the new ground
   * it rendered 164,189,241 on 247,247,245 — plainly visible, and sitting between two surfaces
   * that now carry the identical colour, where the only thing it can read as is a divider. The
   * route it claimed to continue terminates on the plane above, not here.
   */

  /* Composition: dedicated full-width horizontal geometry */
  .ribbon-inner {
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    margin: 0;
    padding-left: clamp(20px, 2vw, 28px);
    padding-right: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    /*
     * The surface hinges up from its own bottom edge as it arrives, finishing flat. Every term
     * is a plain multiplication by a unit, deliberately: a min()/max() around an angle here is
     * what silently invalidated the hero's transform and froze it. Clamping happens in JS.
     */
    transform-origin: 50% 100%;
    transform:
      perspective(900px)
      rotateX(calc((1 - var(--ribbon-land, 1)) * 2.5deg))
      translateY(calc((1 - var(--ribbon-land, 1)) * 8px));
    opacity: calc(0.88 + var(--ribbon-land, 1) * 0.12);
  }

  @media (min-width: 900px) {
    .ribbon-inner {
      display: grid;
      grid-template-columns: clamp(172px, 12vw, 188px) minmax(0, 1fr);
      align-items: center;
      column-gap: clamp(20px, 2vw, 28px);
      gap: 0;
    }
  }

  /* Quiet Fixed Label Zone */
  .ribbon-fixed-zone {
    width: 100%;
    display: flex;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .ribbon-fixed-zone {
      width: auto;
      min-width: 0;
      padding: 0 clamp(18px, 1.8vw, 24px) 0 0;
      border-bottom: none;
      border-right: 1px solid var(--border-color, #e2e8f0);
      justify-content: flex-start;
    }
  }

  .ribbon-kicker {
    font-family: var(--font-heading, "IBM Plex Sans", -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: clamp(0.92rem, 1.1vw, 1rem);
    font-weight: 600;
    color: var(--text-primary, #0f172a);
    letter-spacing: -0.01em;
    line-height: 1.35;
    white-space: nowrap;
    margin: 0;
  }

  /* Marquee Track Wrapper: edge mask + divider safe gap */
  .ribbon-track-wrapper {
    flex-grow: 1;
    overflow: hidden;
    position: relative;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding-left: clamp(16px, 1.5vw, 24px);
    /*
     * Retuned after the slot grew: 64px on both edges started dissolving a logo while it still
     * occupied most of its slot. A mark should pass through the edge, not fade in place.
     */
    mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 56px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 40px, #000 calc(100% - 56px), transparent 100%);
  }

  /* Parent strip: only this element translates */
  .marquee-strip {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: partnerMarquee var(--marquee-duration, 52s) linear infinite;
  }

  @keyframes partnerMarquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(calc(-1 * var(--marquee-distance, 1472px)), 0, 0);
    }
  }

  /* Pause smoothly on hover or focus */
  .ribbon-track-wrapper:hover .marquee-strip,
  .ribbon-track-wrapper:focus-within .marquee-strip {
    animation-play-state: paused;
  }

  /*
   * The seam is the whole loop: group-to-group spacing is the group's padding-right and
   * logo-to-logo spacing is its gap, so the two must be the same value. One custom property
   * holds it, and the marquee script reads that same property rather than repeating the number.
   */
  .primary-track,
  .duplicate-track {
    display: flex;
    align-items: center;
    gap: var(--ribbon-gap);
    padding-right: var(--ribbon-gap);
    list-style: none;
    margin: 0;
    padding-left: 0;
    flex-shrink: 0;
  }

  /*
   * The slot is measured from the rail rather than fixed at 156px. Eight fixed 156px slots plus
   * their gaps came to 1472px, and the visible rail at 1920 is about 1652px, so a whole second
   * group entered before the first had left and the same brand showed at both edges. Sizing the
   * slot from the rail keeps one cycle wider than the window at every width.
   */
  .partner-item {
    flex: 0 0 var(--ribbon-slot, 200px);
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  @media (max-width: 899px) {
    .partner-item {
      flex: 0 0 var(--ribbon-slot, 148px);
      height: 46px;
    }

    /* 28 x 1.5 = 42, which still clears the 46px slot the narrow layout uses. */
    .partner-trust-ribbon {
      --ribbon-logo-height: 28px;
    }
  }

  /* Interactive link area */
  .partner-logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 44px;
    padding: 4px 8px;
    border-radius: var(--radius-sm, 4px);
    text-decoration: none;
    box-sizing: border-box;
    transition: outline-color 160ms ease, background-color 160ms ease;
  }

  .partner-logo-link:hover,
  .partner-logo-link:focus-visible {
    outline: 2px solid var(--accent-blue, #2563eb);
    outline-offset: 2px;
  }

  .partner-logo-link.decorative {
    cursor: default;
    pointer-events: none;
  }

  /* Logos: opacity 1, natural aspect ratio contained in 142x32 box */
  .partner-logo-img {
    /*
     * Height is set, not capped. A max-height only ever scales a lockup down, so any asset
     * whose intrinsic size is already under the cap renders at its natural size and never
     * reaches the optical height it was assigned: stormwall.svg is 174x29 against a 36px cap
     * and was being delivered a quarter smaller than intended. Width stays automatic and is
     * clamped below, and object-fit keeps a wide mark from distorting when that clamp binds.
     */
    width: auto;
    height: calc(var(--ribbon-logo-height, 36px) * var(--logo-scale, 1));
    /*
     * The slot grew for separation and loop length; the artwork must not grow to fill it. The
     * cap is the slot minus its optical margins, so a lockup can reach roughly 155-185px at
     * desktop widths and never stretches.
     */
    max-width: min(calc(var(--ribbon-slot, 200px) - 36px), 185px);
    object-fit: contain;
    display: block;
    user-select: none;
    pointer-events: none;
    opacity: 1;
  }

  /* Text mark fallback */
  .partner-text-mark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: var(--radius-sm, 4px);
    background: #f8fafc;
    border: 1px solid var(--border-color, #e2e8f0);
    text-align: center;
  }
  .partner-name {
    font-family: var(--font-heading, "IBM Plex Sans", sans-serif);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-primary, #0f172a);
    line-height: 1.15;
  }
  .partner-role {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 500;
    color: #64748b;
    line-height: 1.2;
    margin-top: 2px;
  }

  /* Accessible Reduced Motion: static swipeable row */
  @media (prefers-reduced-motion: reduce) {
    .partner-trust-ribbon {
      --ribbon-land: 1;
    }

    .ribbon-inner {
      transform: none;
      opacity: 1;
    }

    .ribbon-track-wrapper {
      mask-image: none;
      -webkit-mask-image: none;
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding-left: 0;
    }

    .marquee-strip {
      animation: none !important;
      transform: none !important;
      width: auto;
    }

    .marquee-track {
      animation: none !important;
      transform: none !important;
    }

    .duplicate-track {
      display: none !important;
    }

    .primary-track {
      overflow-x: auto;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding: 4px 0;
    }
  }
</style>
