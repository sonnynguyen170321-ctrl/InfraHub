---
// src/components/PartnerTrustStrip.astro
const partners = [
  { name: "FastNetMon", category: "DDoS Automation" },
  { name: "Zenlayer", category: "Edge & Bare Metal" },
  { name: "Gcore", category: "Global Cloud & CDN" },
  { name: "StormWall", category: "Network Protection" },
  { name: "Limestone Networks", category: "Dedicated Servers" },
  { name: "Vates", category: "Virtualization" },
  { name: "ZET.NET", category: "IP Transit & Peering" }
];
---

<section class="partner-trust-strip" aria-label="Our Partner Ecosystem">
  <div class="container trust-container">
    <div class="trust-header">
      <span class="trust-label">Our Partner Ecosystem</span>
      <p class="trust-sub">Independent sourcing and qualification across specialized global and regional providers.</p>
    </div>

    <div class="logo-wall">
      {partners.map(p => (
        <div class="partner-badge" title={`${p.name}  -  ${p.category}`}>
          <span class="partner-name">{p.name}</span>
          <span class="partner-category">{p.category}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partner-trust-strip {
    background-color: var(--bg-primary);
    padding: 44px 0 54px;
    border-bottom: 1px solid var(--border-color);
  }

  .trust-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 28px;
  }

  .trust-header {
    max-width: 620px;
  }

  .trust-label {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .trust-sub {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .logo-wall {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .partner-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    min-width: 150px;
    transition: var(--transition-fast);
  }
  .partner-badge:hover {
    border-color: var(--accent-blue);
    background-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .partner-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .partner-category {
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 2px;
  }
</style>
