---
// src/components/AnnouncementBar.astro
interface Props {
  tag?: string;
  headline?: string;
  linkText?: string;
  href?: string;
}

const {
  tag = "CURRENT OFFER",
  headline = "100G IP Transit in Frankfurt  -  Burstable commit options available",
  linkText = "View Details",
  href = "/offers/100g-transit-frankfurt"
} = Astro.props;
---

<div class="announcement-bar" role="complementary" aria-label="Announcement">
  <div class="container announcement-inner">
    <div class="announcement-content">
      <span class="announcement-pill">{tag}</span>
      <span class="announcement-text">{headline}</span>
    </div>
    <a href={href} class="announcement-cta">
      <span>{linkText}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .announcement-bar {
    background-color: var(--text-primary);
    color: #ffffff;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 0;
    font-size: 0.88rem;
  }

  .announcement-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .announcement-content {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .announcement-pill {
    display: inline-block;
    padding: 3px 8px;
    background-color: var(--accent-blue);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .announcement-text {
    font-weight: 500;
    color: #e2e8f0;
  }

  .announcement-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-teal);
    transition: var(--transition-fast);
  }
  .announcement-cta:hover {
    color: #ffffff;
    transform: translateX(2px);
  }
</style>
