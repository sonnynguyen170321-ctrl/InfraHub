---
// src/components/PartnerFeature.astro
const featuredPartners = [
  {
    name: "FastNetMon",
    category: "Security & DDoS",
    desc: "The premier DDoS detection engine for ISPs and hosting networks, enabling sub-second attack detection with automated FlowSpec and RTBH mitigation.",
    url: "/partners/fastnetmon"
  },
  {
    name: "Zenlayer",
    category: "Edge & Bare Metal",
    desc: "Massive edge cloud infrastructure across emerging and established markets, providing high-bandwidth bare metal servers, CDN, and direct cloud fabrics.",
    url: "/partners/zenlayer"
  },
  {
    name: "Gcore",
    category: "Global Cloud & CDN",
    desc: "Global next-generation edge infrastructure, high-throughput content delivery networks, and specialized AI GPU training instances.",
    url: "/partners/gcore"
  },
  {
    name: "Vates",
    category: "Virtualization (XCP-ng)",
    desc: "The proven European open-source virtualization platform delivering complete VMware-alternative hypervisor and backup management architectures.",
    url: "/partners/vates"
  }
];
---

<section class="section section-white" id="partners-feature">
  <div class="container">
    <div class="section-header text-center">
      <span class="pill-badge badge-blue section-tag">Strategic Alliances</span>
      <h2>Specialists in their field.<br />Connected through InfraHub.</h2>
      <p>We work closely with engineering leaders who operate specialized infrastructure rather than generalist resellers.</p>
    </div>

    <div class="partners-feature-grid">
      {featuredPartners.map(partner => (
        <div class="partner-feature-card">
          <div class="card-category-pill">{partner.category}</div>
          <h3 class="partner-title">{partner.name}</h3>
          <p class="partner-desc">{partner.desc}</p>
          <a href={partner.url} class="partner-link">
            <span>Learn about our partnership</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <div class="partner-cta-banner">
      <div class="banner-text">
        <h4>Explore the complete ecosystem directory</h4>
        <p>Review all certified providers across connectivity, compute, security, and hardware.</p>
      </div>
      <a href="/partners" class="btn btn-primary">
        <span>Meet Our Partners</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .partners-feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 48px;
  }
  @media (min-width: 640px) {
    .partners-feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .partners-feature-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .partner-feature-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--transition-fast);
  }
  .partner-feature-card:hover {
    border-color: var(--accent-blue);
    background-color: #ffffff;
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .card-category-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-teal);
    margin-bottom: 12px;
  }

  .partner-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
  }

  .partner-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .partner-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-blue);
  }
  .partner-link:hover {
    text-decoration: underline;
  }

  /* Bottom Banner */
  .partner-cta-banner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: space-between;
    align-items: flex-start;
    padding: 28px 36px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 768px) {
    .partner-cta-banner {
      flex-direction: row;
      align-items: center;
    }
  }

  .banner-text h4 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .banner-text p {
    font-size: 0.92rem;
    color: var(--text-secondary);
  }
</style>
