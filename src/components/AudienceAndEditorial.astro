---
// src/components/AudienceAndEditorial.astro  -  Technical Journal Editorial & Evaluation Matrix (Directives 28-30)
import { industries } from '../data/industry-evaluations';

const initialSector = industries[0];
---

<section class="section section-audience-editorial" id="who-we-help" aria-label="Industries and Editorial Practice">
  <div class="editorial-top-rule-track" aria-hidden="true">
    <div class="editorial-top-rule"></div>
  </div>

  <div class="container">
    <!-- Chapter Opening Statement (Quiet Authority) -->
    <div class="practice-header">
      <h2 class="practice-headline">Infrastructure in practice</h2>
      <p class="practice-subline">
        How technical, physical and commercial constraints change the infrastructure decision.
      </p>
    </div>

    <div class="journal-editorial-stage">
      
      <!-- Dominant Left Column: Featured Technical Analysis (~58%) -->
      <article class="journal-analysis-dominant" id="featuredArticle" aria-labelledby="featured-analysis-title">
        <a href="/insights/physical-path-diversity" class="analysis-image-frame" aria-label="Read technical analysis: Why two diverse network circuits may still share the same physical path">
          <img 
            src="/images/physical-route-diversity.jpg" 
            alt="Physical optical fiber route diversity diagram across bridge choke point" 
            class="analysis-lead-img"
            id="analysisLeadImg"
            loading="lazy"
            width="800"
            height="450"
          />
        </a>

        <div class="analysis-editorial-body">
          <div class="analysis-meta-row">
            <span class="analysis-category">Optical Networks</span>
            <span class="meta-dot" aria-hidden="true">&bull;</span>
            <span class="analysis-time">8 min technical read</span>
            <span class="meta-dot" aria-hidden="true">&bull;</span>
            <span class="analysis-context-hint" id="articleSectorHint">Relevant to ISPs & Network Operators</span>
          </div>

          <h3 class="analysis-title" id="featured-analysis-title">
            <a href="/insights/physical-path-diversity" class="analysis-title-link">
              Why two diverse network circuits may still share the same physical path.
            </a>
          </h3>

          <p class="analysis-excerpt">
            Logical route diversity does not guarantee physical diversity. How shared bridge crossings, rail right-of-ways, and common carrier conduits create invisible single points of failure in enterprise backbones.
          </p>

          <div class="analysis-footer">
            <a href="/insights/physical-path-diversity" class="analysis-read-link">
              <span>Read technical analysis</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Supporting Right Column: Industry Index & Evaluation Detail (~42%) -->
      <aside class="journal-industries-sidebar" aria-label="Target industries and evaluation details">
        <div class="sidebar-header">
          <h3 class="sidebar-title">Who we work with</h3>
          <p class="sidebar-desc">
            Select a sector to compare the constraints and evidence that shape an infrastructure decision.
          </p>
        </div>

        <div class="industries-nav-list" role="tablist" aria-label="Industry Sector Profiles">
          {industries.map((ind, idx) => (
            <button
              type="button"
              role="tab"
              id={`sector-tab-${ind.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls="sectorDetailPanel"
              class={`industry-nav-item ${idx === 0 ? 'is-active' : ''}`}
              data-sector-index={idx}
              data-sector-id={ind.id}
            >
              <span class="ind-index">{String(idx + 1).padStart(2, '0')}</span>
              <div class="ind-text-wrap">
                <span class="ind-name">{ind.name}</span>
                <span class="ind-summary">{ind.summary}</span>
              </div>
              <span class="ind-arrow" aria-hidden="true">&rarr;</span>
            </button>
          ))}
        </div>

        <!-- Sector-specific evaluation detail -->
        <div
          class="sector-detail-panel"
          id="sectorDetailPanel"
          role="tabpanel"
          aria-labelledby="sector-tab-isps"
          aria-live="polite"
        >
          <div class="card-header-bar">
            <span class="eval-tag" id="evalKicker">{initialSector.kicker}</span>
          </div>

          <div class="eval-body">
            <div class="eval-block">
              <div class="eval-label">Typical constraint</div>
              <p class="eval-challenge" id="evalChallenge">{initialSector.challenge}</p>
            </div>

            <div class="eval-block">
              <div class="eval-label">What to compare</div>
              <p class="eval-solution" id="evalSolution">{initialSector.solution}</p>
            </div>

            <div class="eval-metrics-grid" id="evalMetricsGrid">
              {initialSector.metrics.map(m => (
                <div class="eval-metric-item">
                  <span class="metric-label">{m.label}</span>
                  <span class="metric-value">{m.value}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="eval-footer">
            <a href={initialSector.url} class="btn-sector-deepdive" id="evalDeepdiveLink">
              <span id="evalDeepdiveText">View {initialSector.name} guidance</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="ecosystem-strip-link">
          <a href="/partners" class="btn-ecosystem-link">
            <span>Explore the Partner Ecosystem</span>
            <span class="link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </aside>

    </div>
  </div>
</section>

<style>
  .section-audience-editorial {
    position: relative;
    background-color: #ffffff;
    padding: 80px 0 96px;
    border-bottom: 1px solid var(--border-color);
  }
  .editorial-top-rule-track {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
  }
  .editorial-top-rule {
    width: 100%;
    height: 1px;
    background-color: var(--border-color);
  }
  .practice-header {
    margin-bottom: 44px;
    max-width: 800px;
  }

  .practice-headline {
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 8px 0 12px;
  }
  .practice-subline {
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .journal-editorial-stage {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media (min-width: 960px) {
    .journal-editorial-stage {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.15fr);
      gap: 56px;
      align-items: start;
    }
  }
  .journal-analysis-dominant {
    display: flex;
    flex-direction: column;
  }
  .analysis-image-frame {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    background-color: #0b1120;
    border: 1px solid var(--border-color);
    text-decoration: none;
  }
  .analysis-lead-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .analysis-image-frame:hover .analysis-lead-img,
  .analysis-lead-img.shift-crop {
    transform: scale(1.025) translate3d(2px, -2px, 0);
  }
  .analysis-editorial-body {
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .analysis-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .analysis-category {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }
  .meta-dot {
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .analysis-time {
    font-size: 0.82rem;
    color: #475569;
  }
  .analysis-context-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: #475569;
  }
  .analysis-title {
    font-size: clamp(1.35rem, 1.8vw, 1.65rem);
    font-weight: 700;
    line-height: 1.4;
    color: var(--text-primary);
    margin: 4px 0 0;
  }
  .analysis-title-link {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .analysis-title-link:hover {
    color: var(--accent-blue);
  }
  .analysis-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 62ch;
  }
  .analysis-footer {
    padding-top: 8px;
  }
  .analysis-read-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .analysis-read-link:hover {
    color: var(--accent-blue-hover);
  }
  .analysis-read-link:hover .link-arrow,
  .btn-ecosystem-link:hover .link-arrow,
  .btn-sector-deepdive:hover .link-arrow {
    transform: translateX(3px);
  }
  .link-arrow {
    transition: transform 160ms ease;
  }

  /* Right Column: Sidebar & Sector Detail */
  .journal-industries-sidebar {
    display: flex;
    flex-direction: column;
  }
  .sidebar-header {
    margin-bottom: 16px;
  }
  .sidebar-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .sidebar-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .industries-nav-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
  }
  .industry-nav-item {
    display: grid;
    grid-template-columns: 28px 1fr 20px;
    align-items: start;
    gap: 14px;
    padding: 14px 10px;
    border: none;
    border-bottom: 1px solid var(--border-color);
    background: transparent;
    text-align: left;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 160ms ease, border-left-color 160ms ease;
  }
  .industry-nav-item:hover {
    background-color: rgba(40, 84, 199, 0.03);
  }
  .industry-nav-item.is-active {
    background-color: rgba(40, 84, 199, 0.05);
    border-left: 3px solid var(--accent-blue);
    padding-left: 7px;
  }
  .ind-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-blue);
    padding-top: 2px;
  }
  .ind-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .ind-name {
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    transition: color 160ms ease;
  }
  .industry-nav-item:hover .ind-name,
  .industry-nav-item.is-active .ind-name {
    color: var(--accent-blue);
  }
  .ind-summary {
    font-size: 0.82rem;
    color: #475569;
    line-height: 1.4;
  }
  .ind-arrow {
    font-size: 1rem;
    color: var(--text-muted);
    transition: transform 160ms ease, color 160ms ease;
    padding-top: 2px;
  }
  .industry-nav-item:hover .ind-arrow,
  .industry-nav-item.is-active .ind-arrow {
    color: var(--accent-blue);
    transform: translateX(3px);
  }

  /* Sector-specific evaluation detail */
  .sector-detail-panel {
    margin-top: 20px;
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 180ms ease, background-color 180ms ease;
  }
  .card-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding-bottom: 10px;
  }
  .eval-tag {
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent-blue);
  }
  .eval-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .eval-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .eval-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: #64748b;
  }
  .eval-challenge {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-secondary);
    margin: 0;
  }
  .eval-solution {
    font-size: 0.86rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0;
  }
  .eval-metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 4px;
    padding: 10px 12px;
  }
  @media (min-width: 640px) {
    .eval-metrics-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
  }
  .eval-metric-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .metric-label {
    font-size: 0.68rem;
    color: #64748b;
  }
  .metric-value {
    font-size: 0.8rem;
    font-weight: 600;
    color: #0f172a;
  }
  .eval-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 4px;
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }
  .btn-sector-deepdive {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .btn-sector-deepdive:hover {
    color: var(--accent-blue-hover);
  }

  .ecosystem-strip-link {
    margin-top: 18px;
  }
  .btn-ecosystem-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .btn-ecosystem-link:hover {
    color: var(--accent-blue-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .analysis-lead-img,
    .industry-nav-item,
    .ind-name,
    .ind-arrow,
    .link-arrow,
    .sector-detail-panel {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { industries } from '../data/industry-evaluations';

  function initPracticeInteractions() {
    const leadImg = document.getElementById('analysisLeadImg');
    const hint = document.getElementById('articleSectorHint');
    const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.industry-nav-item'));
    
    // Sector detail elements
    const kickerEl = document.getElementById('evalKicker');
    const challengeEl = document.getElementById('evalChallenge');
    const solutionEl = document.getElementById('evalSolution');
    const metricsGridEl = document.getElementById('evalMetricsGrid');
    const deepdiveLink = document.getElementById('evalDeepdiveLink') as HTMLAnchorElement | null;
    const deepdiveText = document.getElementById('evalDeepdiveText');
    const card = document.getElementById('sectorDetailPanel');

    function selectSector(index: number, focusTab = false) {
      if (index < 0 || index >= industries.length) return;
      const sec = industries[index];

      // Update button active state
      items.forEach((item, idx) => {
        const isActive = idx === index;
        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-selected', isActive ? 'true' : 'false');
        item.tabIndex = isActive ? 0 : -1;
        if (isActive && focusTab) {
          item.focus();
        }
      });

      // Update the selected sector detail
      if (kickerEl) kickerEl.textContent = sec.kicker;
      if (challengeEl) challengeEl.textContent = sec.challenge;
      if (solutionEl) solutionEl.textContent = sec.solution;
      if (deepdiveLink) deepdiveLink.href = sec.url;
      if (deepdiveText) deepdiveText.textContent = `View ${sec.name} guidance`;
      if (hint) hint.textContent = `Relevant to ${sec.name}`;

      // Update metrics
      if (metricsGridEl && Array.isArray(sec.metrics)) {
        metricsGridEl.innerHTML = sec.metrics.map((m: any) => `
          <div class="eval-metric-item">
            <span class="metric-label">${m.label}</span>
            <span class="metric-value">${m.value}</span>
          </div>
        `).join('');
      }

      if (card) {
        card.setAttribute('aria-labelledby', `sector-tab-${sec.id}`);
      }
    }

    items.forEach((item, idx) => {
      item.addEventListener('click', () => {
        selectSector(idx);
      });

      item.addEventListener('mouseenter', () => {
        if (leadImg) leadImg.classList.add('shift-crop');
      });

      item.addEventListener('mouseleave', () => {
        if (leadImg) leadImg.classList.remove('shift-crop');
      });

      // Keyboard navigation (Arrow keys, Home, End)
      item.addEventListener('keydown', (e) => {
        let targetIdx = idx;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          targetIdx = (idx + 1) % items.length;
          selectSector(targetIdx, true);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          targetIdx = (idx - 1 + items.length) % items.length;
          selectSector(targetIdx, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          selectSector(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          selectSector(items.length - 1, true);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPracticeInteractions);
  } else {
    initPracticeInteractions();
  }
</script>
