---
// src/components/AudienceAndEditorial.astro  -  Technical Journal Editorial & Evaluation Matrix (Directives 28-30)
const industries = [
  {
    id: "isps",
    name: "ISPs & Network Operators",
    summary: "Transit, optical connectivity, routing and DDoS requirements.",
    url: "/industries/isps-network-operators",
    kicker: "Carrier Peering & DDoS Filtering",
    challenge: "Upstream transit monopolization & BGP route hijack exposure during high-volume volumetric attacks.",
    solution: "Multi-homed carrier mesh with automated BGP FlowSpec diversion and verified diverse fiber ingress.",
    metrics: [
      { label: "BGP Diversion SLA", value: "< 3s automated FlowSpec", verified: true },
      { label: "Transit Diversity", value: "Dual Tier-1 + IX peering", verified: true },
      { label: "Burst Economics", value: "95th percentile commit", verified: true }
    ],
    recommendedDisciplines: ["Network & Connectivity", "Security & Telemetry"]
  },
  {
    id: "hosting",
    name: "Hosting & Cloud Providers",
    summary: "Compute, colocation, IPv4 and network capacity.",
    url: "/industries/hosting-cloud-providers",
    kicker: "Virtualization Economics & Sourcing",
    challenge: "Enterprise hypervisor licensing inflation (VMware Broadcom) & protracted hardware supply chain lead times.",
    solution: "Open-source hypervisor migration (XCP-ng / Proxmox) on burn-in certified refurbished high-density compute.",
    metrics: [
      { label: "Hypervisor TCO", value: "40–60% license savings", verified: true },
      { label: "IPv4 Allocation", value: "Leased /24 to /20 subnets", verified: true },
      { label: "Hardware Delivery", value: "7–14 day facility rack-in", verified: true }
    ],
    recommendedDisciplines: ["Infrastructure & Compute", "Cloud & Virtualization"]
  },
  {
    id: "saas",
    name: "SaaS & Technology",
    summary: "Regional connectivity, cloud economics and private infrastructure.",
    url: "/industries/saas-technology",
    kicker: "Edge Latency & Cloud Repatriation",
    challenge: "Compound hyperscaler egress tolling and cross-regional latency variance impacting real-time user experiences.",
    solution: "Hybrid architecture routing compute to low-latency edge nodes and private inter-datacenter wavelengths.",
    metrics: [
      { label: "Egress Cost Reduction", value: "Up to 65% vs public cloud", verified: true },
      { label: "Edge Latency Target", value: "Sub-20ms regional PoP", verified: true },
      { label: "Direct-Connect Mesh", value: "Zero-public egress routing", verified: true }
    ],
    recommendedDisciplines: ["Cloud & Virtualization", "Network & Connectivity"]
  },
  {
    id: "enterprise",
    name: "Enterprise",
    summary: "Private cloud, connectivity, hardware and managed operations.",
    url: "/industries/enterprise",
    kicker: "Physical Redundancy & Cutover Integrity",
    challenge: "Contract diversity masking common-mode trench failure; multi-facility migrations stalling on NOC operations.",
    solution: "Physically audited route diversity with 24/7 proactive telemetry and hands-on cutover execution.",
    metrics: [
      { label: "Conduit Separation", value: "Dual utility entry verified", verified: true },
      { label: "Operational Guard", value: "24/7/365 proactive NOC", verified: true },
      { label: "Cutover Downtime", value: "Zero unscheduled disruption", verified: true }
    ],
    recommendedDisciplines: ["Managed Operations", "Infrastructure & Compute"]
  }
];

const initialSector = industries[0];
---

<section class="section section-audience-editorial" id="who-we-help" aria-label="Industries and Editorial Practice">
  <div class="editorial-top-rule-track" aria-hidden="true">
    <div class="editorial-top-rule"></div>
  </div>

  <div class="container">
    <!-- Chapter Opening Statement (Quiet Authority) -->
    <div class="practice-header">
      <div class="practice-tag-row">
        <span class="practice-chapter-tag">Chapter 07 / Practice & Proof</span>
      </div>
      <h2 class="practice-headline">Infrastructure in practice</h2>
      <p class="practice-subline">
        How technical, physical and commercial constraints change the infrastructure decision.
      </p>
    </div>

    <div class="journal-editorial-stage">
      
      <!-- Dominant Left Column: Featured Technical Analysis (~58%) -->
      <article class="journal-analysis-dominant" id="featuredArticle" aria-labelledby="featured-analysis-title">
        <a href="/insights/physical-path-diversity" class="analysis-image-frame" aria-label="Read technical analysis: Why two diverse network circuits may still share the same physical path">
          <img 
            src="/images/physical-route-diversity.jpg" 
            alt="Physical optical fiber route diversity diagram across bridge choke point" 
            class="analysis-lead-img"
            id="analysisLeadImg"
            loading="lazy"
            width="800"
            height="450"
          />
          <div class="analysis-image-overlay">
            <span class="analysis-overlay-badge" id="analysisContextBadge">Case Study: Optical Path Diversity</span>
          </div>
        </a>

        <div class="analysis-editorial-body">
          <div class="analysis-meta-row">
            <span class="analysis-category">Optical Networks</span>
            <span class="meta-dot" aria-hidden="true">&bull;</span>
            <span class="analysis-time">8 min technical read</span>
            <span class="meta-dot" aria-hidden="true">&bull;</span>
            <span class="analysis-context-hint" id="articleSectorHint">Relevant to ISPs & Network Operators</span>
          </div>

          <h3 class="analysis-title" id="featured-analysis-title">
            <a href="/insights/physical-path-diversity" class="analysis-title-link">
              Why two diverse network circuits may still share the same physical path.
            </a>
          </h3>

          <p class="analysis-excerpt">
            Logical route diversity does not guarantee physical diversity. How shared bridge crossings, rail right-of-ways, and common carrier conduits create invisible single points of failure in enterprise backbones.
          </p>

          <div class="analysis-footer">
            <a href="/insights/physical-path-diversity" class="analysis-read-link">
              <span>Read technical analysis</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Supporting Right Column: Industry Index & Evaluation Scorecard (~42%) -->
      <aside class="journal-industries-sidebar" aria-label="Target Industries and Sector Matrix">
        <div class="sidebar-header">
          <div class="sidebar-kicker">Operational Sectors</div>
          <h3 class="sidebar-title">Who we work with</h3>
          <p class="sidebar-desc">
            Select a sector to evaluate architectural challenges, verified deliverables, and failure mitigations.
          </p>
        </div>

        <div class="industries-nav-list" role="tablist" aria-label="Industry Sector Profiles">
          {industries.map((ind, idx) => (
            <button 
              type="button"
              role="tab"
              id={`sector-tab-${ind.id}`}
              aria-selected={idx === 0 ? "true" : "false"}
              aria-controls="sectorEvaluationCard"
              class={`industry-nav-item ${idx === 0 ? 'is-active' : ''}`}
              data-sector-index={idx}
              data-sector-id={ind.id}
            >
              <span class="ind-index">{String(idx + 1).padStart(2, '0')}</span>
              <div class="ind-text-wrap">
                <span class="ind-name">{ind.name}</span>
                <span class="ind-summary">{ind.summary}</span>
              </div>
              <span class="ind-arrow" aria-hidden="true">&rarr;</span>
            </button>
          ))}
        </div>

        <!-- Sector Architecture & Evaluation Scorecard HUD (Phase 5) -->
        <div 
          class="sector-evaluation-card" 
          id="sectorEvaluationCard" 
          role="tabpanel" 
          aria-labelledby="sector-tab-isps"
          aria-live="polite"
        >
          <div class="card-header-bar">
            <span class="eval-tag" id="evalKicker">{initialSector.kicker}</span>
            <span class="eval-status-pill">
              <span class="eval-status-dot" aria-hidden="true"></span>
              <span>Audited Model</span>
            </span>
          </div>

          <div class="eval-body">
            <div class="eval-block">
              <div class="eval-label">Operational Challenge</div>
              <p class="eval-challenge" id="evalChallenge">{initialSector.challenge}</p>
            </div>

            <div class="eval-block">
              <div class="eval-label">Verified Architecture Solution</div>
              <p class="eval-solution" id="evalSolution">{initialSector.solution}</p>
            </div>

            <div class="eval-metrics-grid" id="evalMetricsGrid">
              {initialSector.metrics.map(m => (
                <div class="eval-metric-item">
                  <span class="metric-label">{m.label}</span>
                  <span class="metric-value">{m.value}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="eval-footer">
            <a href={initialSector.url} class="btn-sector-deepdive" id="evalDeepdiveLink">
              <span id="evalDeepdiveText">View {initialSector.name} Architecture</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <div class="ecosystem-strip-link">
          <a href="/partners" class="btn-ecosystem-link">
            <span>Explore the Partner Ecosystem</span>
            <span class="link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </aside>

    </div>
  </div>
</section>

<!-- JSON Data for dynamic sector evaluation switching -->
<script is:inline id="sectorDataScript" type="application/json" set:html={JSON.stringify(industries)} />

