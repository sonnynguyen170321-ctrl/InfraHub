---
// src/components/AudienceAndEditorial.astro  -  Asymmetric Editorial Split
const industries = [
  {
    name: "ISPs & Network Operators",
    summary: "Upstream IP transit, optical wavelengths, BGP routing optimization, and automated DDoS flow mitigation.",
    url: "/industries/isps-network-operators"
  },
  {
    name: "Hosting & Cloud Providers",
    summary: "Wholesale bare-metal compute fleets, rack allocations in Tier-3+ facilities, and IPv4 block leasing.",
    url: "/industries/hosting-cloud-providers"
  },
  {
    name: "SaaS & Technology",
    summary: "Egress traffic cost suppression, low-latency regional edge peering, and sovereign private cloud architectures.",
    url: "/industries/saas-technology"
  },
  {
    name: "Enterprise",
    summary: "VMware alternatives, multi-cloud connectivity, enterprise hardware sourcing, and managed network operations.",
    url: "/industries/enterprise"
  }
];
---

<section class="section section-audience-editorial" id="who-we-help" aria-label="Industries and Editorial Practice">
  <!-- Route Line Entry Connector from Offers (Directive 20) -->
  <div class="practice-route-entry" aria-hidden="true">
    <div class="route-line-stem"></div>
  </div>

  <div class="container">
    <div class="split-editorial-layout">
      
      <!-- Left Column: Who We Work With (Industries) -->
      <div class="audience-column">
        <div class="column-header">
          <div class="kicker-row">
            <span class="editorial-kicker">Sectors in practice</span>
          </div>
          <h2 class="column-title">Infrastructure built for technical buyers.</h2>
          <p class="column-desc">
            We tailor sourcing, routing, and hardware evaluation to the exact operational realities of four core sectors.
          </p>
        </div>

        <nav class="industries-nav-list" aria-label="Target Industries">
          {industries.map((ind, idx) => (
            <a href={ind.url} class="industry-nav-item">
              <span class="ind-index">{String(idx + 1).padStart(2, '0')}</span>
              <div class="ind-text-wrap">
                <span class="ind-name">{ind.name}</span>
                <span class="ind-summary">{ind.summary}</span>
              </div>
              <span class="ind-arrow" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </nav>

        <div class="ecosystem-strip-link">
          <a href="/partners" class="btn-ecosystem-link">
            <span>Explore the Partner Ecosystem</span>
            <span class="link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Infrastructure in Practice (Featured Technical Analysis) -->
      <div class="editorial-column">
        <div class="column-header">
          <h2 class="column-title">Engineering Analysis</h2>
          <p class="column-desc">
            Practical technical analysis and decision frameworks for infrastructure buyers.
          </p>
        </div>

        <!-- Featured Technical Analysis Card -->
        <article class="featured-analysis-card">
          <a href="/insights/physical-path-diversity" class="analysis-visual-link">
            <img 
              src="/images/physical-route-diversity.jpg" 
              alt="Physical optical fiber route diversity diagram across bridge choke point" 
              class="analysis-img"
              loading="lazy"
              width="800"
              height="450"
            />
          </a>

          <div class="analysis-body">
            <div class="analysis-meta">
              <span class="analysis-category">Optical Networks</span>
              <span class="analysis-time">9 min read</span>
            </div>

            <h3 class="analysis-title">
              <a href="/insights/physical-path-diversity">Why two diverse network circuits may still share the same physical path.</a>
            </h3>
            <p class="analysis-excerpt">
              Logical route diversity does not guarantee physical diversity. How shared bridge crossings, rail right-of-ways, and common carrier conduits create invisible single points of failure in enterprise backbones.
            </p>
            <div class="analysis-footer">
              <a href="/insights/physical-path-diversity" class="analysis-cta">
                <span>Read the Analysis</span>
                <span class="link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      </div>

    </div>
  </div>

  <!-- Route Line Exit Connector to Final Conversation (Directive 22) -->
  <div class="practice-route-exit" aria-hidden="true">
    <div class="exit-stem"></div>
    <div class="exit-junction"></div>
  </div>
</section>

<style>
  .section-audience-editorial {
    position: relative;
    background-color: #ffffff;
    padding: 72px 0 84px;
    border-bottom: 1px solid var(--border-color);
  }

  /* Route Connectors */
  .practice-route-entry {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 28px;
    z-index: 2;
  }
  .practice-route-entry .route-line-stem {
    width: 1.5px;
    height: 100%;
    background-color: var(--accent-blue);
  }

  .practice-route-exit {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 2;
  }
  .practice-route-exit .exit-stem {
    width: 1.5px;
    height: 100%;
    background: linear-gradient(to bottom, var(--accent-blue), var(--border-color));
  }
  .practice-route-exit .exit-junction {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--accent-blue);
  }

  .editorial-kicker {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
  }

  .split-editorial-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px;
  }
  @media (min-width: 960px) {
    .split-editorial-layout {
      grid-template-columns: 1.15fr 1fr;
      gap: 80px;
      align-items: start;
    }
  }

  /* Header */
  .column-header {
    margin-bottom: 36px;
  }
  .column-title {
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 12px;
  }
  .column-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Left Industries Nav List */
  .industries-nav-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
  }
  .industry-nav-item {
    display: grid;
    grid-template-columns: 36px 1fr 24px;
    align-items: start;
    gap: 18px;
    padding: 22px 8px;
    border-bottom: 1px solid var(--border-color);
    text-decoration: none;
    transition: background-color 160ms ease;
    border-radius: var(--radius-sm);
  }
  .ind-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-blue);
    padding-top: 2px;
  }
  .ind-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ind-name {
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: color 160ms ease;
  }
  .industry-nav-item:hover .ind-name {
    color: var(--accent-blue);
  }
  .ind-summary {
    font-size: 0.86rem;
    color: #475569;
    line-height: 1.45;
  }
  .ind-arrow {
    font-size: 1.1rem;
    color: var(--text-muted);
    transition: transform 160ms ease, color 160ms ease;
    padding-top: 2px;
  }
  .industry-nav-item:hover .ind-arrow {
    color: var(--accent-blue);
    transform: translateX(3px);
  }

  .ecosystem-strip-link {
    margin-top: 28px;
  }
  .btn-ecosystem-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .btn-ecosystem-link:hover {
    color: var(--accent-blue-hover);
  }
  .link-arrow {
    transition: transform 160ms ease;
  }
  .btn-ecosystem-link:hover .link-arrow,
  .analysis-cta:hover .link-arrow {
    transform: translateX(3px);
  }

  /* Right Editorial Column */
  .featured-analysis-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .analysis-visual-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background-color: var(--bg-primary);
  }
  .analysis-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }
  .analysis-visual-link:hover .analysis-img {
    transform: scale(1.02);
  }

  .analysis-body {
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .analysis-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .analysis-category {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }
  .analysis-time {
    font-size: 0.82rem;
    color: #475569;
  }
  .analysis-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.42;
    color: var(--text-primary);
  }
  .analysis-title a:hover {
    color: var(--accent-blue);
  }
  .analysis-excerpt {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 54ch;
  }
  .analysis-footer {
    padding-top: 12px;
  }
  .analysis-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .analysis-cta:hover {
    color: var(--accent-blue-hover);
  }
</style>
