---
// src/components/HowItWorks.astro
const steps = [
  {
    num: "01",
    title: "Understand",
    desc: "We discuss your technical constraints, bandwidth profiles, geographic targets, and budget boundaries."
  },
  {
    num: "02",
    title: "Match",
    desc: "We evaluate suitable technologies, architectures, and vetted providers across our independent partner network."
  },
  {
    num: "03",
    title: "Introduce",
    desc: "We connect you directly with the specialist team who owns the infrastructure and technical delivery."
  },
  {
    num: "04",
    title: "Deliver",
    desc: "The selected specialist handles implementation, direct contracting, and ongoing operational support."
  }
];
---

<section class="section section-dark network-overlay-dark" id="how-it-works">
  <div class="container">
    <div class="section-header text-center">
      <span class="pill-badge badge-dark section-tag">Operating Model</span>
      <h2>One requirement. A network of specialists.</h2>
      <p>InfraHub provides the market intelligence and technical qualification. Our verified partners deliver the infrastructure.</p>
    </div>

    <div class="steps-grid">
      {steps.map((step, idx) => (
        <div class="step-card">
          <div class="step-num-wrap">
            <span class="step-num">{step.num}</span>
            {idx < 3 && <div class="step-connector"></div>}
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>

    <div class="how-it-works-cta text-center">
      <a href="/how-we-work" class="btn btn-on-dark btn-lg">
        <span>How InfraHub Works & Commercial Model</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <span class="cta-sub">Learn why our advisory comes at zero additional markup to your bills.</span>
    </div>
  </div>
</section>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin: 60px 0 54px;
    position: relative;
  }
  @media (min-width: 640px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .step-card {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-lg);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--transition-fast);
  }
  .step-card:hover {
    border-color: var(--border-dark-highlight);
    background-color: rgba(255, 255, 255, 0.06);
    transform: translateY(-3px);
  }

  .step-num-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .step-num {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent-teal);
    line-height: 1;
  }

  .step-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .step-desc {
    color: var(--text-on-dark-muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .how-it-works-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .cta-sub {
    font-size: 0.88rem;
    color: var(--text-on-dark-muted);
  }
</style>
