---
// src/components/Footer.astro
import BrandLogo from './BrandLogo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      
      <!-- Brand & Concise Positioning -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo">
          <BrandLogo size={24} tone="light" />
        </a>
        <p class="footer-desc">
          The right infrastructure. The right partner. We evaluate technical requirements and connect engineering teams with specialist operators.
        </p>
        <p class="footer-transparency-note">
          InfraHub provides infrastructure sourcing and advisory. Partner-delivered services are contracted and delivered directly with the selected specialist provider.
        </p>
      </div>

      <!-- Core Disciplines -->
      <div class="footer-col">
        <h3 class="footer-heading">Solutions</h3>
        <ul class="footer-links">
          <li><a href="/solutions/infrastructure">Infrastructure & Compute</a></li>
          <li><a href="/solutions/cloud-virtualization">Cloud & Virtualization</a></li>
          <li><a href="/solutions/network-connectivity">Network & Connectivity</a></li>
          <li><a href="/solutions/security">Security & DDoS</a></li>
          <li><a href="/solutions/managed-services">Managed Operations</a></li>
        </ul>
      </div>

      <!-- Company & Knowledge -->
      <div class="footer-col">
        <h3 class="footer-heading">Company</h3>
        <ul class="footer-links">
          <li><a href="/about">About InfraHub</a></li>
          <li><a href="/how-we-work">How We Work</a></li>
          <li><a href="/partners">Partner Ecosystem</a></li>
          <li><a href="/offers">Featured Offers</a></li>
          <li><a href="/insights">Technical Insights</a></li>
          <li><a href="/lets-talk">Let's Talk</a></li>
        </ul>
      </div>

      <!-- Direct Contact & Legal -->
      <div class="footer-col">
        <h3 class="footer-heading">Inquiries</h3>
        <p class="footer-contact-desc">Discuss technical requirements with an infrastructure advisor:</p>
        <a href="mailto:inquiries@infrahub.tech" class="footer-email-link">inquiries@infrahub.tech</a>
        
        <div class="footer-legal-row">
          <a href="/privacy">Privacy</a>
          <span class="footer-sep">/</span>
          <a href="/terms">Terms</a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} InfraHub. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #070b14;
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 72px 0 36px;
  }

  .footer-container {
    max-width: var(--max-width);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 40px;
    }
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }


  .footer-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 36ch;
  }

  .footer-transparency-note {
    font-size: 0.8rem;
    line-height: 1.55;
    color: #94a3b8;
    max-width: 38ch;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ffffff;
    margin-bottom: 18px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    font-size: 0.9rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .footer-contact-desc {
    font-size: 0.86rem;
    color: #cbd5e1;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .footer-email-link {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: #93c5fd;
    text-decoration: none;
    transition: color 160ms ease;
    display: inline-block;
    margin-bottom: 20px;
  }
  .footer-email-link:hover {
    color: #ffffff;
  }

  .footer-legal-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
  }
  .footer-legal-row a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .footer-legal-row a:hover {
    color: #ffffff;
  }
  .footer-sep {
    color: #475569;
  }

  .footer-bottom {
    padding-top: 32px;
  }

  .copyright {
    font-size: 0.85rem;
    color: #94a3b8;
    max-width: 48ch;
    line-height: 1.5;
  }
</style>
