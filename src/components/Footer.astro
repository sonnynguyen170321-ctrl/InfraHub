---
// src/components/Footer.astro
import BrandLogo from './BrandLogo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      
      <!-- Brand & Concise Positioning -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo">
          <BrandLogo size={24} tone="light" />
        </a>
        <p class="footer-desc">
          Complex infrastructure. One place to solve it. Sourcing, architecture, and coordination through one trusted relationship.
        </p>
        <p class="footer-transparency-note">
          InfraHub coordinates the right technical and commercial path across global network, compute, cloud, and security infrastructure.
        </p>
      </div>

      <!-- Core Disciplines -->
      <div class="footer-col">
        <h2 class="footer-heading">Solutions</h2>
        <ul class="footer-links">
          <li><a href="/solutions">All Solutions Overview</a></li>
          <li><a href="/solutions/infrastructure">Infrastructure & Compute</a></li>
          <li><a href="/solutions/cloud-virtualization">Cloud & Virtualization</a></li>
          <li><a href="/solutions/network-connectivity">Network & Connectivity</a></li>
          <li><a href="/solutions/security">Security & DDoS</a></li>
          <li><a href="/solutions/managed-services">Managed Operations</a></li>
        </ul>
      </div>

      <!-- Company & Knowledge -->
      <div class="footer-col">
        <h2 class="footer-heading">Company</h2>
        <ul class="footer-links">
          <li><a href="/about">About InfraHub</a></li>
          <li><a href="/how-we-work">How We Work</a></li>
          <li><a href="/industries">Industries</a></li>
          <li><a href="/insights">Technical Insights</a></li>
          <li><a href="/lets-talk">Start a Requirement</a></li>
        </ul>
      </div>

      <!-- Direct Contact & Legal -->
      <div class="footer-col">
        <h2 class="footer-heading">Inquiries</h2>
        <p class="footer-contact-desc">Discuss technical requirements with an infrastructure advisor:</p>
        <a href="mailto:inquiries@infrahub.tech" class="footer-email-link">inquiries@infrahub.tech</a>
        
        <div class="footer-legal-row">
          <a href="/privacy">Privacy</a>
          <span class="footer-sep">/</span>
          <a href="/terms">Terms</a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} InfraHub. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: linear-gradient(to top, #070b14 70%, #0a1120 100%);
    color: #94a3b8;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 100px 0 44px;
  }

  .footer-container {
    max-width: var(--max-width);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 52px;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 48px;
    }
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /*
   * 24px measured - sitting exactly on the SC 2.5.8 floor, like the header lockup was. Same
   * padding/negative-margin pair, so the target clears 44 without moving the mark.
   */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    padding-block: 10px;
    margin-block: -10px;
  }


  .footer-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 36ch;
  }

  .footer-transparency-note {
    font-size: 0.8rem;
    line-height: 1.55;
    color: #94a3b8;
    max-width: 38ch;
  }

  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #ffffff;
    margin-bottom: 18px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /*
   * Padding with a matching negative margin, not extra height.
   *
   * These links were bare inline anchors, so the tap target was the 19px line box and nothing
   * else - under the 24x24 floor in WCAG 2.2 SC 2.5.8, and they do not qualify for the inline
   * exception because each one is the whole content of its own list item rather than a link
   * inside a sentence. inline-block plus vertical padding lifts the target to 29px; the equal
   * negative margin cancels the layout effect, so the footer rhythm is pixel-identical and the
   * 14px column gap absorbs the overlap.
   */
  .footer-links a {
    font-size: 0.9rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 160ms ease;
    display: inline-block;
    padding-block: 5px;
    margin-block: -5px;
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .footer-contact-desc {
    font-size: 0.86rem;
    color: #cbd5e1;
    line-height: 1.5;
    margin-bottom: 8px;
  }

  .footer-email-link {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: #93c5fd;
    text-decoration: none;
    transition: color 160ms ease;
    display: inline-block;
    /* 24px measured, i.e. exactly on the SC 2.5.8 line. Padding puts it clearly over. */
    padding-block: 5px;
    margin-bottom: 15px;
  }
  .footer-email-link:hover {
    color: #ffffff;
  }

  .footer-legal-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
  }
  .footer-legal-row a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 160ms ease;
    display: inline-block;
    padding-block: 6px;
    margin-block: -6px;
  }
  .footer-legal-row a:hover {
    color: #ffffff;
  }
  .footer-sep {
    color: #475569;
  }

  .footer-bottom {
    padding-top: 32px;
  }

  .copyright {
    font-size: 0.85rem;
    color: #94a3b8;
    max-width: 48ch;
    line-height: 1.5;
  }
</style>
