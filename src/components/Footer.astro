---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Commercial Mission -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo">
          <span class="logo-mark">
            <svg width="24" height="24" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="28" height="28" rx="6" fill="#1E293B" />
              <path d="M7 14H11M17 14H21M14 7V11M14 17V21" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" />
              <circle cx="14" cy="14" r="3" fill="#0D9488" />
            </svg>
          </span>
          <span class="brand-name">Infra<span class="brand-highlight">Hub</span></span>
        </a>
        <p class="footer-desc">
          The right infrastructure. The right partner. We help businesses evaluate technologies and connect with specialist providers across infrastructure, cloud, connectivity, security and operations.
        </p>
        <div class="footer-commercial-notice">
          <span class="notice-pill">Model Transparency</span>
          <p>InfraHub acts as an infrastructure sourcing and advisory partner. Services are delivered directly by verified ecosystem partners.</p>
        </div>
      </div>

      <!-- Col 2: Solutions -->
      <div class="footer-col">
        <h3 class="footer-heading">Solutions</h3>
        <ul class="footer-links">
          <li><a href="/solutions/infrastructure">Infrastructure</a></li>
          <li><a href="/solutions/cloud-virtualization">Cloud & Virtualization</a></li>
          <li><a href="/solutions/network-connectivity">Network & Connectivity</a></li>
          <li><a href="/solutions/security">Security & DDoS</a></li>
          <li><a href="/solutions/managed-services">Managed Operations</a></li>
          <li><a href="/dedicated-servers">Dedicated Servers</a></li>
          <li><a href="/ip-transit">IP Transit</a></li>
          <li><a href="/colocation">Colocation Sourcing</a></li>
        </ul>
      </div>

      <!-- Col 3: Company & Ecosystem -->
      <div class="footer-col">
        <h3 class="footer-heading">Company</h3>
        <ul class="footer-links">
          <li><a href="/about">About InfraHub</a></li>
          <li><a href="/how-we-work">How We Work</a></li>
          <li><a href="/partners">Partner Ecosystem</a></li>
          <li><a href="/offers">Featured Offers</a></li>
          <li><a href="/industries">Industries We Serve</a></li>
          <li><a href="/insights">Technical Insights</a></li>
          <li><a href="/lets-talk">Let's Talk</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Legal -->
      <div class="footer-col">
        <h3 class="footer-heading">Contact & Compliance</h3>
        <ul class="footer-links contact-links">
          <li>
            <span class="contact-label">Inquiries</span>
            <a href="mailto:inquiries@infrahub.tech" class="contact-value">inquiries@infrahub.tech</a>
          </li>
          <li>
            <span class="contact-label">Coverage</span>
            <span class="contact-value-text">Europe · North America · Asia-Pacific</span>
          </li>
        </ul>

        <div class="footer-legal-links">
          <a href="/privacy">Privacy Policy</a>
          <span class="divider">·</span>
          <a href="/terms">Terms of Service</a>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        © {currentYear} InfraHub. All rights reserved. Registered infrastructure sourcing, advisory, and partner network.
      </p>
      <div class="footer-certifications">
        <span>ISO 27001 & SOC 2 Partner Facilities</span>
        <span class="divider">·</span>
        <span>Independent Sourcing Advisory</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark);
    color: var(--text-on-dark);
    border-top: 1px solid var(--border-dark);
    padding: 80px 0 40px;
    font-size: 0.92rem;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1.2fr 1.2fr 1.5fr;
      gap: 50px;
    }
  }

  /* Brand Col */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
  }
  .brand-highlight {
    color: var(--accent-blue);
  }

  .footer-desc {
    color: var(--text-on-dark-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 360px;
  }

  .footer-commercial-notice {
    padding: 14px 16px;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-dark);
    border-radius: var(--radius-md);
    max-width: 360px;
  }
  .notice-pill {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-teal);
    margin-bottom: 6px;
  }
  .footer-commercial-notice p {
    font-size: 0.82rem;
    color: var(--text-on-dark-muted);
    line-height: 1.45;
  }

  /* Columns */
  .footer-heading {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-links a {
    color: var(--text-on-dark-muted);
    font-size: 0.88rem;
    transition: var(--transition-fast);
  }
  .footer-links a:hover {
    color: #ffffff;
    transform: translateX(2px);
  }

  /* Contact */
  .contact-links {
    gap: 14px;
    margin-bottom: 24px;
  }
  .contact-label {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 2px;
  }
  .contact-value {
    color: #ffffff !important;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }
  .contact-value-text {
    font-size: 0.88rem;
    color: var(--text-on-dark-muted);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .footer-legal-links a:hover {
    color: #ffffff;
  }

  /* Bottom */
  .footer-bottom {
    padding-top: 30px;
    border-top: 1px solid var(--border-dark);
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-certifications {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .divider {
    color: var(--border-dark);
  }
</style>
