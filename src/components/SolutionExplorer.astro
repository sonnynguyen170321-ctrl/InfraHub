---
// src/components/SolutionExplorer.astro
const solutionTabs = [
  {
    id: "tab-infrastructure",
    name: "Infrastructure",
    title: "Dedicated Servers, Custom IaaS, GPU & Colocation",
    description: "High-performance dedicated bare metal, custom compute configurations, enterprise hardware, GPU/AI training clusters, and colocation sourced across European, North American, and Asian facilities.",
    subServices: [
      { name: "Dedicated Servers", url: "/dedicated-servers", desc: "Single-tenant bare metal from selected providers" },
      { name: "Custom IaaS", url: "/custom-iaas", desc: "Tailored server + network + DC stacks (e.g. VoIP)" },
      { name: "GPU & AI Infrastructure", url: "/gpu-ai-infrastructure", desc: "High-density training and inference clusters" },
      { name: "Colocation Sourcing", url: "/colocation", desc: "Quarter, half, and full racks with high-density power" },
      { name: "Enterprise Hardware", url: "/enterprise-hardware", desc: "Refurbished and direct enterprise servers" }
    ],
    ctaUrl: "/solutions/infrastructure",
    ctaLabel: "Explore Infrastructure Solutions",
    badge: "Direct & Partner Sourced"
  },
  {
    id: "tab-cloud",
    name: "Cloud & Virtualization",
    title: "Private Cloud, VMware Alternatives & Kubernetes",
    description: "Escape vendor lock-in and excessive hyperscaler billing. We help qualify production-ready private clouds, open-source virtualization stacks, container orchestration, and disaster recovery architectures.",
    subServices: [
      { name: "Private Cloud", url: "/private-cloud", desc: "Dedicated, sovereign virtualized infrastructure" },
      { name: "VMware Alternatives", url: "/vmware-alternatives", desc: "Proven KVM, Proxmox, and Vates (XCP-ng) migrations" },
      { name: "Kubernetes & Containers", url: "/solutions/cloud-virtualization#kubernetes", desc: "Managed control planes and bare-metal nodes" },
      { name: "Backup & Disaster Recovery", url: "/solutions/cloud-virtualization#backup-dr", desc: "Cross-datacenter RPO/RTO replication" },
      { name: "Hybrid Cloud", url: "/solutions/cloud-virtualization#hybrid", desc: "Integrated on-premise and public cloud topologies" }
    ],
    ctaUrl: "/solutions/cloud-virtualization",
    ctaLabel: "Explore Cloud & Virtualization",
    badge: "Partner Delivered"
  },
  {
    id: "tab-network",
    name: "Network & Connectivity",
    title: "IP Transit, Wavelengths, Layer 2 & Cloud Fabrics",
    description: "Upstream connectivity, dedicated optical circuits, cloud connections, and IPv4 sourcing. We compare commercial commitments, route design, provider presence, and resilience requirements across suitable carriers and network specialists.",
    subServices: [
      { name: "IP Transit", url: "/ip-transit", desc: "10G-400G ports, 95th percentile billing, full BGP tables" },
      { name: "Layer 2 Connectivity", url: "/layer-2-connectivity", desc: "Private point-to-point and multipoint Ethernet" },
      { name: "Wavelengths", url: "/wavelengths", desc: "High-bandwidth lit optical DWDM for datacenter interconnect" },
      { name: "Cloud Connectivity", url: "/cloud-connectivity", desc: "Direct cross-connects to AWS, Azure, and Google Cloud" },
      { name: "IPv4 Solutions", url: "/ipv4", desc: "Clean IP allocation, transfers, and monetization leasing" }
    ],
    ctaUrl: "/solutions/network-connectivity",
    ctaLabel: "Explore Network & Connectivity",
    badge: "Specialist Carrier Ecosystem"
  },
  {
    id: "tab-security",
    name: "Security & Protection",
    title: "Network Security, DDoS Mitigation & BGP Intelligence",
    description: "Protect Autonomous Systems and digital services with DDoS detection, routing controls, external scrubbing, application protection, and specialist cybersecurity services.",
    subServices: [
      { name: "DDoS Protection", url: "/ddos-protection", desc: "Always-on and on-demand BGP cloud scrubbing centers" },
      { name: "DDoS Detection & Automation", url: "/ddos-detection-automation", desc: "FastNetMon Advanced with FlowSpec and RTBH triggers" },
      { name: "BGP & Routing Intelligence", url: "/bgp-routing-intelligence", desc: "Route leak prevention and real-time AS path telemetry" },
      { name: "Cybersecurity", url: "/cybersecurity", desc: "Perimeter defense, audit hardening, and incident triage" }
    ],
    ctaUrl: "/solutions/security",
    ctaLabel: "Explore Security Solutions",
    badge: "Defensive Operations"
  },
  {
    id: "tab-managed",
    name: "Managed Services",
    title: "24/7 NOC, AI Network Operations & Engineering",
    description: "Augment your engineering team with round-the-clock incident response, proactive infrastructure monitoring, automated runbook workflows, and specialized network architecture consulting.",
    subServices: [
      { name: "24/7 NOC", url: "/managed-noc", desc: "Continuous monitoring, incident triage, carrier coordination, and escalation workflows" },
      { name: "AI Network Operations", url: "/ai-network-operations", desc: "Autonomous alert clustering, correlation, and resolution" },
      { name: "Network Engineering", url: "/solutions/managed-services#network-engineering", desc: "BGP routing design, multi-homing, and capacity planning" },
      { name: "Network Automation", url: "/solutions/managed-services#automation", desc: "Infrastructure as Code (Ansible/Terraform) pipelines" }
    ],
    ctaUrl: "/solutions/managed-services",
    ctaLabel: "Explore Managed Operations",
    badge: "24/7 Specialist Delivery"
  }
];
---

<section class="section section-white" id="solutions-section">
  <div class="container">
    <div class="section-header text-center">
      <span class="pill-badge badge-blue section-tag">Interactive Solution Explorer</span>
      <h2>Solutions for your infrastructure requirements</h2>
      <p>Select an infrastructure category to review technical capabilities, commercial delivery models, and specialized providers.</p>
    </div>

    <div class="explorer-card" id="solution-explorer">
      <!-- Left Column: Category Navigation Tabs -->
      <div class="explorer-tabs" role="tablist" aria-label="Solution Categories">
        {solutionTabs.map((tab, idx) => (
          <button 
            role="tab" 
            class={`tab-button ${idx === 0 ? 'is-active' : ''}`}
            id={`tab-btn-${idx}`}
            aria-selected={idx === 0 ? "true" : "false"}
            aria-controls={`panel-${idx}`}
            data-index={idx}
          >
            <span class="tab-indicator"></span>
            <span class="tab-text">{tab.name}</span>
            <svg class="tab-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        ))}
      </div>

      <!-- Right Column: Interactive Tab Panels -->
      <div class="explorer-panels">
        {solutionTabs.map((tab, idx) => (
          <div 
            role="tabpanel" 
            class={`solution-panel ${idx === 0 ? 'is-active' : ''}`}
            id={`panel-${idx}`}
            aria-labelledby={`tab-btn-${idx}`}
            hidden={idx !== 0}
          >
            <div class="panel-header">
              <span class="pill-badge badge-teal">{tab.badge}</span>
              <h3 class="panel-title">{tab.title}</h3>
              <p class="panel-desc">{tab.description}</p>
            </div>

            <div class="subservices-grid">
              {tab.subServices.map(sub => (
                <a href={sub.url} class="subservice-item">
                  <div class="subservice-title">
                    <span>{sub.name}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </div>
                  <p class="subservice-desc">{sub.desc}</p>
                </a>
              ))}
            </div>

            <div class="panel-footer">
              <a href={tab.ctaUrl} class="btn btn-primary">
                <span>{tab.ctaLabel}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
              <span class="panel-note">Need vendor comparison? <a href="/lets-talk">Talk to our architects →</a></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .explorer-card {
    display: grid;
    grid-template-columns: 1fr;
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  @media (min-width: 992px) {
    .explorer-card {
      grid-template-columns: 320px 1fr;
    }
  }

  /* Left Tabs */
  .explorer-tabs {
    background-color: var(--bg-secondary);
    border-right: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    padding: 16px;
    gap: 8px;
  }

  .tab-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    background-color: transparent;
    text-align: left;
    transition: var(--transition-fast);
    position: relative;
  }
  .tab-button:hover {
    background-color: #ffffff;
    color: var(--accent-blue);
  }
  .tab-button.is-active {
    background-color: #ffffff;
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-color);
  }

  .tab-text {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
  }
  .tab-button.is-active .tab-text {
    font-weight: 700;
    color: var(--accent-blue);
  }

  .tab-arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: var(--transition-fast);
    color: var(--accent-blue);
  }
  .tab-button.is-active .tab-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Panels */
  .explorer-panels {
    padding: 40px;
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 768px) {
    .explorer-panels {
      padding: 24px;
    }
  }

  .solution-panel {
    display: none;
    flex-direction: column;
    gap: 32px;
    animation: fadeIn 0.25s ease-out;
  }
  .solution-panel.is-active {
    display: flex;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-title {
    font-size: 1.6rem;
    font-weight: 700;
    margin: 12px 0 10px;
  }
  .panel-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 740px;
  }

  /* Subservices */
  .subservices-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .subservices-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .subservice-item {
    padding: 16px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
  }
  .subservice-item:hover {
    border-color: var(--accent-blue);
    background-color: #ffffff;
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
  }

  .subservice-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .subservice-item:hover .subservice-title {
    color: var(--accent-blue);
  }

  .subservice-desc {
    font-size: 0.84rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  /* Footer */
  .panel-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .panel-note {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  .panel-note a {
    font-weight: 600;
    color: var(--accent-blue);
  }
  .panel-note a:hover {
    text-decoration: underline;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-button');
    const panels = document.querySelectorAll('.solution-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const index = tab.getAttribute('data-index');

        tabs.forEach(t => {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => {
          p.classList.remove('is-active');
          p.hidden = true;
        });

        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        
        const activePanel = document.getElementById(`panel-${index}`);
        if (activePanel) {
          activePanel.classList.add('is-active');
          activePanel.hidden = false;
        }
      });
    });
  });
</script>
