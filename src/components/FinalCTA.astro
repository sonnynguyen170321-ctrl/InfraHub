---
// src/components/FinalCTA.astro
---

<section class="final-cta-section" id="final-cta">
  <div class="container cta-container">
    <div class="cta-card">
      <div class="cta-content">
        <span class="pill-badge badge-teal">Direct Sourcing Conversation</span>
        <h2 class="cta-headline">Tell us what you're trying to build.</h2>
        <p class="cta-sub">
          You don't need to know which provider, ASN, or exact chassis model you need. Start with the requirement, and our team will help evaluate the optimal architecture and match suitable specialists.
        </p>
        <div class="cta-actions">
          <a href="/lets-talk" class="btn btn-accent btn-xl">
            <span>Let's Talk Infrastructure</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/how-we-work" class="btn btn-on-dark-outline btn-xl">
            <span>How We Work & Transparency</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background: linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
    padding: 60px 0 0;
  }

  .cta-container {
    position: relative;
    z-index: 2;
  }

  .cta-card {
    background: radial-gradient(ellipse at 80% 0%, rgba(37, 99, 235, 0.4) 0%, transparent 60%),
                radial-gradient(ellipse at 20% 100%, rgba(13, 148, 136, 0.3) 0%, transparent 60%),
                #0b1120;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xl);
    padding: 72px 48px;
    text-align: center;
    box-shadow: var(--shadow-xl);
  }
  @media (max-width: 768px) {
    .cta-card {
      padding: 48px 24px;
    }
  }

  .cta-content {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .cta-headline {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cta-sub {
    font-size: 1.15rem;
    color: #cbd5e1;
    line-height: 1.65;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 14px;
  }
  .btn-xl {
    padding: 16px 32px;
    font-size: 1.05rem;
  }
</style>
