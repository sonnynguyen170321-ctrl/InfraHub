---
// src/components/FinalCTA.astro  -  Architectural Conversion Band
---

<section class="section-conversion-band" id="contact">
  <div class="container">
    <div class="conversion-card">
      <div class="conversion-content">
        <h2 class="conversion-headline">Tell us what you're trying to build.</h2>
        <p class="conversion-copy">
          You do not need the provider or product decided first. Start with your technical requirement, location constraints, and timeline.
        </p>
        <div class="conversion-actions">
          <a href="/lets-talk" class="btn btn-accent btn-lg">
            Discuss Your Requirement
          </a>
          <a href="/how-we-work" class="conversion-text-link">
            <span>Review how we work</span>
            <span class="link-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-conversion-band {
    background-color: #0b1120;
    padding: 88px 0 72px;
  }

  .conversion-card {
    background-color: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 64px 32px;
    text-align: center;
  }
  @media (min-width: 768px) {
    .conversion-card {
      padding: 72px 56px;
    }
  }

  .conversion-content {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .conversion-headline {
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #ffffff;
  }

  .conversion-copy {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 54ch;
  }

  .conversion-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 12px;
  }

  .conversion-text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #cbd5e1;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .conversion-text-link:hover {
    color: #ffffff;
  }
  .link-arrow {
    transition: transform 160ms ease;
  }
  .conversion-text-link:hover .link-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .conversion-actions {
      flex-direction: column;
      gap: 16px;
    }
    .btn {
      width: 100%;
    }
  }
</style>
