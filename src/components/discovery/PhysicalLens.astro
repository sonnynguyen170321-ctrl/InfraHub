---
// src/components/discovery/PhysicalLens.astro
// Center stage: Physical Infrastructure Lens with Coordinated SVG Routing Anchors
import { Image } from 'astro:assets';
import { DISCIPLINARY_DATA, DISCIPLINE_KEYS } from '../../data/discovery-disciplines';

import networkImg from '../../assets/network-fiber.jpg';
import computeImg from '../../assets/hero-datacenter.jpg';
import cloudImg from '../../assets/cloud-compute.jpg';
import securityImg from '../../assets/security-operations.jpg';
import operationsImg from '../../assets/managed-noc.jpg';

interface Props {
  activeId?: string;
}

const { activeId = 'network' } = Astro.props;

const imageMap: Record<string, ImageMetadata> = {
  network: networkImg,
  compute: computeImg,
  cloud: cloudImg,
  security: securityImg,
  operations: operationsImg
};

const disciplines = DISCIPLINE_KEYS.map(k => DISCIPLINARY_DATA[k]);
---

<div class="physical-lens-viewport" id="physical-lens-viewport" role="region" aria-label="Physical Infrastructure & Routing Interpretation">
  <!-- Photographic Frames -->
  <div class="lens-canvas" id="lens-canvas">
    {disciplines.map((item) => {
      const isSelected = item.id === activeId;
      const imgAsset = imageMap[item.id];
      return (
        <div 
          class={`lens-slide ${isSelected ? 'active' : ''}`}
          id={`slide-${item.id}`}
          data-slide-id={item.id}
        >
          <div class="lens-image-wrap">
            <Image
              src={imgAsset}
              alt={item.imageAlt}
              class="lens-img"
              loading="lazy"
              widths={[640, 960, 1280]}
              sizes="(max-width: 1024px) 100vw, 55vw"
            />
            <div class="lens-ambient-tint" aria-hidden="true"></div>
          </div>

          <!-- Dynamic SVG Physical Routing Overlay -->
          <div class="lens-svg-overlay" aria-hidden="true">
            <svg 
              class="physical-route-svg" 
              viewBox="0 0 800 500" 
              preserveAspectRatio="xMidYMid meet"
            >
              <defs>
                <linearGradient id={`grad-active-${item.id}`} x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#2854c7" stop-opacity="0.3" />
                  <stop offset="60%" stop-color="#38bdf8" stop-opacity="1" />
                  <stop offset="100%" stop-color="#2854c7" stop-opacity="0.8" />
                </linearGradient>

                <filter id={`subtleGlow-${item.id}`} x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="2" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
              </defs>

              <!-- Physical Visual Anchor Guideline (Faint structural tracing) -->
              <path 
                class="physical-anchor-base"
                d={`M ${item.svgPathAnchor.entryPoint[0]} ${item.svgPathAnchor.entryPoint[1]} C ${item.svgPathAnchor.controlPoints[0][0]} ${item.svgPathAnchor.controlPoints[0][1]}, ${item.svgPathAnchor.controlPoints[1][0]} ${item.svgPathAnchor.controlPoints[1][1]}, ${item.svgPathAnchor.controlPoints[2][0]} ${item.svgPathAnchor.controlPoints[2][1]} L ${item.svgPathAnchor.exitPoint[0]} ${item.svgPathAnchor.exitPoint[1]}`}
                stroke="rgba(255, 255, 255, 0.25)"
                stroke-width="1"
                fill="none"
                stroke-dasharray="4 4"
              />

              <!-- Active InfraHub Routing Line (dynamic stroke-width applied via CSS variable) -->
              <path 
                class="physical-active-route"
                id={`route-line-${item.id}`}
                d={`M ${item.svgPathAnchor.entryPoint[0]} ${item.svgPathAnchor.entryPoint[1]} C ${item.svgPathAnchor.controlPoints[0][0]} ${item.svgPathAnchor.controlPoints[0][1]}, ${item.svgPathAnchor.controlPoints[1][0]} ${item.svgPathAnchor.controlPoints[1][1]}, ${item.svgPathAnchor.controlPoints[2][0]} ${item.svgPathAnchor.controlPoints[2][1]} L ${item.svgPathAnchor.exitPoint[0]} ${item.svgPathAnchor.exitPoint[1]}`}
                stroke={`url(#grad-active-${item.id})`}
                stroke-width="2.5"
                fill="none"
              />

              <!-- Physical Entry Point (Left Margin Cross-Connect) -->
              <circle 
                cx={item.svgPathAnchor.entryPoint[0]} 
                cy={item.svgPathAnchor.entryPoint[1]} 
                r="4" 
                fill="#38bdf8" 
                class="anchor-point"
              />
              <text 
                x={item.svgPathAnchor.entryPoint[0] + 8} 
                y={item.svgPathAnchor.entryPoint[1] + 4} 
                class="svg-anchor-label"
              >
                REQUIREMENT ENTRANCE
              </text>

              <!-- Mid Junction (InfraHub Interpretation) -->
              <circle 
                cx={item.svgPathAnchor.controlPoints[1][0]} 
                cy={item.svgPathAnchor.controlPoints[1][1]} 
                r="5" 
                fill="#2854c7" 
                stroke="#ffffff" 
                stroke-width="1.5" 
                class="anchor-point"
              />
              <text 
                x={item.svgPathAnchor.controlPoints[1][0] - 10} 
                y={item.svgPathAnchor.controlPoints[1][1] - 12} 
                class="svg-anchor-label active"
              >
                INFRAHUB INTERPRETATION
              </text>

              <!-- Physical Exit Point (Right Margin Hand-off to Services) -->
              <circle 
                cx={item.svgPathAnchor.exitPoint[0]} 
                cy={item.svgPathAnchor.exitPoint[1]} 
                r="4" 
                fill="#38bdf8" 
                class="anchor-point"
              />
              <text 
                x={item.svgPathAnchor.exitPoint[0] - 8} 
                y={item.svgPathAnchor.exitPoint[1] - 10} 
                text-anchor="end" 
                class="svg-anchor-label"
              >
                DELIVERY ROUTE
              </text>
            </svg>
          </div>

          <!-- Bottom Visual Bar: Authentic Caption & Status Indicator -->
          <div class="lens-status-bar">
            <span class="status-indicator">
              <span class="status-live-dot"></span>
              {item.imageCaption}
            </span>
            <span class="status-provenance">Physical System Verification</span>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  .physical-lens-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 380px;
    background: #091118;
    border-radius: var(--radius-sm, 3px);
    overflow: hidden;
    border: 1px solid var(--border-color, #d2d7d3);
  }

  .lens-canvas {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 380px;
  }

  .lens-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--motion-image, 650ms) var(--ease-out, ease-out),
                visibility var(--motion-image, 650ms) var(--ease-out, ease-out);
  }

  .lens-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .lens-image-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .lens-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.85) contrast(1.05);
  }

  .lens-ambient-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9, 17, 24, 0.4) 0%, rgba(9, 17, 24, 0.15) 50%, rgba(9, 17, 24, 0.75) 100%);
    pointer-events: none;
  }

  .lens-svg-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .physical-route-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .physical-active-route {
    stroke-dasharray: 600;
    stroke-dashoffset: 0;
    animation: drawActiveRoute 1.2s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  @keyframes drawActiveRoute {
    from {
      stroke-dashoffset: 600;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .svg-anchor-label {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.08em;
    fill: rgba(255, 255, 255, 0.7);
  }

  .svg-anchor-label.active {
    fill: #38bdf8;
  }

  .lens-status-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.875rem;
    background: rgba(9, 17, 24, 0.85);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.6875rem;
    color: #e2e8f0;
  }

  .status-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-cobalt, #38bdf8);
  }

  .status-provenance {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.625rem;
    color: #94a3b8;
  }

  @media (prefers-reduced-motion: reduce) {
    .physical-active-route {
      animation: none;
      stroke-dashoffset: 0;
    }
    .lens-slide {
      transition: none;
    }
  }

  @media (max-width: 1023px) {
    .physical-lens-viewport {
      min-height: 280px;
    }
    .lens-canvas {
      min-height: 280px;
    }
  }
</style>
