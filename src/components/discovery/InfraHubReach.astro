---
// src/components/discovery/InfraHubReach.astro
// Tilted 2.5D Atlas Projection of Verified Ecosystem Reach
import { VERIFIED_NETWORK_FOOTPRINTS, ECOSYSTEM_CAPACITY_METRICS } from '../../data/partner-network-footprints';

const footprints = VERIFIED_NETWORK_FOOTPRINTS;

// Group footprints by region for accessible structured text alternative
const regions = {
  'Europe': footprints.filter(f => f.region === 'Europe'),
  'North America': footprints.filter(f => f.region === 'North America'),
  'Asia Pacific': footprints.filter(f => f.region === 'Asia Pacific')
};
---

<div class="infrahub-reach-wrap" id="infrahub-reach-stage" role="region" aria-labelledby="reach-title">
  <!-- Atlas Stage Header -->
  <div class="reach-header">
    <div class="reach-title-block">
      <span class="reach-kicker">INFRAHUB ECOSYSTEM REACH</span>
      <h3 id="reach-title" class="reach-heading">Verified Geographic Infrastructure Opportunity</h3>
      <p class="reach-sub">Supporting infrastructure availability evaluated across InfraHub's specialist partner ecosystem.</p>
    </div>

    <div class="reach-metric-badges">
      {ECOSYSTEM_CAPACITY_METRICS.map(m => (
        <div class="reach-metric-badge" title={`${m.metricType} (Source: ${m.source})`}>
          <span class="badge-val">{m.value}</span>
          <span class="badge-label">{m.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- 2.5D Atlas Isometric Projection Plane -->
  <div class="atlas-perspective-viewport">
    <div class="atlas-plane" id="reach-atlas-plane">
      <svg 
        class="atlas-svg" 
        viewBox="0 0 1000 500" 
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <!-- Grid Pattern -->
          <pattern id="reachGrid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255, 255, 255, 0.05)" stroke-width="1" />
          </pattern>

          <!-- Interconnect line gradients -->
          <linearGradient id="interconnectGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#2854c7" stop-opacity="0.2" />
            <stop offset="50%" stop-color="#38bdf8" stop-opacity="0.8" />
            <stop offset="100%" stop-color="#2854c7" stop-opacity="0.2" />
          </linearGradient>
        </defs>

        <!-- World Plane Base -->
        <rect width="1000" height="500" rx="6" fill="#091118" />
        <rect width="1000" height="500" fill="url(#reachGrid)" />

        <!-- Simplified Continental Geometries -->
        <g class="continent-paths" fill="none" stroke="rgba(148, 163, 184, 0.18)" stroke-width="1.5">
          <!-- North America approximate contour -->
          <path d="M 120 140 Q 180 120 280 130 T 320 250 T 260 300 T 180 340 T 140 240 Z" />
          <!-- Europe approximate contour -->
          <path d="M 440 160 Q 500 130 560 160 T 540 240 T 460 250 Z" />
          <!-- Asia / East Asia approximate contour -->
          <path d="M 620 160 Q 740 140 840 180 T 880 270 T 780 380 T 680 300 Z" />
        </g>

        <!-- Trans-continental Core Backhaul Arcs (Illustrative interconnect paths) -->
        <g class="interconnect-arcs" fill="none" stroke="url(#interconnectGrad)" stroke-width="1.5" stroke-dasharray="4 4">
          <!-- US West (SJC) to US East (IAD) -->
          <path d="M 165 235 Q 210 190 255 230" />
          <!-- US East (IAD) to London (LON) Transatlantic -->
          <path d="M 255 230 Q 360 150 470 195" />
          <!-- London (LON) to Amsterdam (AMS) -->
          <path d="M 470 195 L 485 190" />
          <!-- Amsterdam (AMS) to Frankfurt (FRA) -->
          <path d="M 485 190 L 495 200" />
          <!-- Frankfurt (FRA) to Singapore (SIN) Eurasia Route -->
          <path d="M 495 200 Q 620 270 745 375" />
          <!-- Singapore (SIN) to Tokyo (TYO) -->
          <path d="M 745 375 Q 810 320 840 240" />
          <!-- Tokyo (TYO) to San Jose (SJC) Transpacific -->
          <path d="M 840 240 Q 940 180 990 200" />
          <path d="M 10 200 Q 80 210 165 235" />
        </g>

        <!-- Geographic Verified Nodes -->
        <g class="reach-nodes">
          {footprints.map(point => (
            <g 
              class="reach-node-group" 
              data-node-id={point.id}
              data-metro={point.metro}
              data-code={point.code}
              data-provider={point.provider}
              transform={`translate(${point.mapX}, ${point.mapY})`}
            >
              <!-- Outer pulse ring -->
              <circle cx="0" cy="0" r="10" fill="#2854c7" fill-opacity="0.2" class="node-ring" />
              <!-- Core node -->
              <circle cx="0" cy="0" r="4.5" fill="#38bdf8" class="node-core" />
              <!-- Metro Code label -->
              <text 
                x="0" 
                y="-14" 
                text-anchor="middle" 
                class="node-text-code"
              >
                {point.code}
              </text>
            </g>
          ))}
        </g>
      </svg>
    </div>
  </div>

  <!-- Selected Node Detail Strip -->
  <div class="reach-node-detail" id="reach-node-detail">
    <div class="detail-lead">
      <span class="detail-label" id="reach-detail-title">Frankfurt (FRA) Gateway</span>
      <span class="detail-provider" id="reach-detail-provider">Evaluated via Gcore / Zenlayer</span>
    </div>
    <div class="detail-caps" id="reach-detail-caps">
      <span class="cap-tag">DE-CIX Peering</span>
      <span class="cap-tag">Tier-1 IP Transit</span>
      <span class="cap-tag">Bare Metal Clusters</span>
      <span class="cap-tag">WAF / Scrubbing</span>
    </div>
  </div>

  <!-- Screen Reader Structured Equivalent (Accessibility Mandate) -->
  <div class="sr-only">
    <h4>Verified Geographic Infrastructure Atlas Text Equivalent</h4>
    {Object.entries(regions).map(([regionName, pts]) => (
      <div>
        <h5>{regionName}</h5>
        <ul>
          {pts.map(pt => (
            <li>
              <strong>{pt.metro} ({pt.code}):</strong> {pt.serviceCategory}. Supporting Providers: {pt.provider}. Capabilities: {pt.primaryCapabilities.join(', ')}. Verified on {pt.retrievedDate}.
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- Footer Legal & Proof Attribution -->
  <div class="reach-footer">
    <span class="reach-attribution">
      * Infrastructure reach represents verified capacity evaluated through InfraHub's specialist ecosystem partners (Gcore &amp; Zenlayer). Verified 2026-09-04.
    </span>
    <a href="/solutions/network-connectivity" class="reach-deep-link">
      Review Connectivity Blueprint &rarr;
    </a>
  </div>
</div>

<style>
  .infrahub-reach-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    background: var(--color-carbon, #091118);
    color: #f8fafc;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm, 4px);
    padding: 1.25rem;
    margin-top: 0.75rem;
  }

  .reach-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.875rem;
  }

  .reach-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .reach-kicker {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-cobalt, #38bdf8);
    text-transform: uppercase;
  }

  .reach-heading {
    font-family: var(--font-heading, 'IBM Plex Sans', sans-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .reach-sub {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.75rem;
    color: #94a3b8;
    margin: 0;
  }

  .reach-metric-badges {
    display: flex;
    gap: 0.75rem;
  }

  .reach-metric-badge {
    display: flex;
    flex-direction: column;
    padding: 0.375rem 0.625rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm, 3px);
  }

  .badge-val {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #38bdf8;
  }

  .badge-label {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.6875rem;
    color: #94a3b8;
  }

  .atlas-perspective-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-sm, 4px);
    perspective: 800px;
    background: #060b11;
  }

  .atlas-plane {
    width: 100%;
    transform: rotateX(8deg);
    transform-origin: center bottom;
  }

  .atlas-svg {
    display: block;
    width: 100%;
    height: auto;
    filter: contrast(1.05);
  }

  .node-ring {
    opacity: 0.35;
    transition: opacity var(--motion-fast, 140ms) var(--ease-out, ease-out);
  }

  .reach-node-group:hover .node-ring {
    opacity: 0.8;
  }

  .node-text-code {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 11px;
    font-weight: 600;
    fill: #e2e8f0;
    letter-spacing: 0.05em;
  }

  .reach-node-group {
    cursor: pointer;
  }

  .reach-node-group:hover .node-core {
    fill: #ffffff;
    stroke: #38bdf8;
    stroke-width: 2px;
  }

  .reach-node-group:hover .node-text-code {
    fill: #38bdf8;
  }

  .reach-node-detail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm, 3px);
    flex-wrap: wrap;
  }

  .detail-lead {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .detail-label {
    font-family: var(--font-heading, 'IBM Plex Sans', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #ffffff;
  }

  .detail-provider {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    color: #94a3b8;
  }

  .detail-caps {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .cap-tag {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    padding: 0.125rem 0.375rem;
    background: rgba(40, 84, 199, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 2px;
    color: #38bdf8;
  }

  .reach-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
  }

  .reach-attribution {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.6875rem;
    color: #64748b;
  }

  .reach-deep-link {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    color: #38bdf8;
    text-decoration: none;
  }

  .reach-deep-link:hover {
    text-decoration: underline;
    color: #ffffff;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .atlas-plane {
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .atlas-plane {
      transform: none;
    }
    .reach-header {
      flex-direction: column;
    }
    .reach-metric-badges {
      width: 100%;
    }
    .reach-node-detail {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
