---
// src/components/discovery/DecisionPanel.astro
// Right column: InfraHub decision information, relevant services, and "what changes the answer"
import { DISCIPLINARY_DATA, DISCIPLINE_KEYS } from '../../data/discovery-disciplines';

interface Props {
  activeId?: string;
}

const { activeId = 'network' } = Astro.props;
const disciplines = DISCIPLINE_KEYS.map(k => DISCIPLINARY_DATA[k]);
---

<div class="decision-panels-wrap">
  {disciplines.map((item) => {
    const isSelected = item.id === activeId;
    return (
      <div
        class={`decision-panel selector-panel ${isSelected ? 'active' : ''}`}
        id={`panel-${item.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${item.id}`}
        data-panel-id={item.id}
      >
        <!-- Panel Header: Headline & Technical Explanation -->
        <div class="panel-header-block">
          <div class="panel-kicker-row">
            <span class="panel-kicker">{item.number} // ADVISORY OVERVIEW</span>
            <span class="panel-discipline-tag">{item.sublabel}</span>
          </div>
          <h3 class="panel-headline">{item.headline}</h3>
          <p class="panel-explanation">{item.technicalExplanation}</p>
        </div>

        <!-- Relevant InfraHub Services / Delivery Routes -->
        <div class="panel-services-block">
          <span class="services-header">RELEVANT INFRAHUB SERVICES</span>
          <div class="services-list" role="list">
            {item.serviceRoutes.map(service => (
              <a 
                href={service.url} 
                class="service-card"
                role="listitem"
                data-min-capacity={service.minCapacity}
              >
                <div class="service-meta">
                  <span class="service-name">{service.name}</span>
                  {service.minCapacity && (
                    <span class="service-min-cap">{service.minCapacity}+</span>
                  )}
                </div>
                <p class="service-desc">{service.desc}</p>
                <span class="service-arrow" aria-hidden="true">&rarr;</span>
              </a>
            ))}
          </div>
        </div>

        <!-- What Changes The Answer Callout -->
        <div class="what-changes-box">
          <div class="what-changes-title-row">
            <span class="what-changes-dot" aria-hidden="true"></span>
            <span class="what-changes-title">{item.whatChangesTitle}</span>
          </div>
          <p class="what-changes-obs">{item.whatChangesObservation}</p>
        </div>

        <!-- Action Bar -->
        <div class="panel-actions">
          <a href={item.primaryCta.url} class="btn btn-primary btn-md">
            <span>{item.primaryCta.label}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href={`/lets-talk?service=${item.briefServiceParam}`} class="panel-desk-link">
            Start a {item.label} Brief &rarr;
          </a>
        </div>
      </div>
    );
  })}
</div>

<style>
  .decision-panels-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-left: var(--space-4, 1rem);
    border-left: 1px solid var(--border-color, #d2d7d3);
  }

  .decision-panel {
    display: none;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    animation: fadeInContent var(--motion-content, 420ms) var(--ease-out, ease-out);
  }

  .decision-panel.active {
    display: flex;
  }

  @keyframes fadeInContent {
    from {
      opacity: 0;
      transform: translateX(6px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .panel-header-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .panel-kicker-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .panel-kicker {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-tertiary, #64748b);
    text-transform: uppercase;
  }

  .panel-discipline-tag {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    color: var(--color-cobalt, #2854c7);
  }

  .panel-headline {
    font-family: var(--font-heading, 'IBM Plex Sans', sans-serif);
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary, #091118);
    letter-spacing: -0.015em;
    margin: 0;
  }

  .panel-explanation {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary, #475569);
    margin: 0;
  }

  .panel-services-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .services-header {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-tertiary, #64748b);
    text-transform: uppercase;
  }

  .services-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    padding: 0.5rem 0.75rem;
    background: var(--bg-surface, #ffffff);
    border: 1px solid var(--border-color, #d2d7d3);
    border-radius: var(--radius-sm, 3px);
    text-decoration: none;
    transition: border-color var(--motion-fast, 140ms) var(--ease-out, ease-out),
                background-color var(--motion-fast, 140ms) var(--ease-out, ease-out);
  }

  .service-card:hover {
    border-color: var(--color-cobalt, #2854c7);
    background-color: var(--bg-surface-elevated, #f8faf9);
  }

  .service-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .service-name {
    font-family: var(--font-heading, 'IBM Plex Sans', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary, #091118);
  }

  .service-min-cap {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.625rem;
    font-weight: 600;
    padding: 0.0625rem 0.25rem;
    background: rgba(40, 84, 199, 0.08);
    color: var(--color-cobalt, #2854c7);
    border-radius: 2px;
  }

  .service-desc {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.6875rem;
    line-height: 1.4;
    color: var(--text-secondary, #64748b);
    margin: 0;
    padding-right: 1.25rem;
  }

  .service-arrow {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.8125rem;
    color: var(--text-tertiary, #94a3b8);
    opacity: 0;
    transition: opacity var(--motion-fast, 140ms) var(--ease-out, ease-out),
                color var(--motion-fast, 140ms) var(--ease-out, ease-out);
  }

  .service-card:hover .service-arrow {
    opacity: 1;
    color: var(--color-cobalt, #2854c7);
  }

  .what-changes-box {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 0.875rem;
    background: var(--bg-surface-elevated, #f4f5f1);
    border: 1px solid var(--border-color, #d2d7d3);
    border-left: 3px solid var(--color-cobalt, #2854c7);
    border-radius: var(--radius-sm, 3px);
  }

  .what-changes-title-row {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .what-changes-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-cobalt, #2854c7);
  }

  .what-changes-title {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-primary, #091118);
    text-transform: uppercase;
  }

  .what-changes-obs {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--text-secondary, #334155);
    margin: 0;
  }

  .panel-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: var(--space-2, 0.5rem);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-family: var(--font-heading, 'IBM Plex Sans', sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--radius-sm, 3px);
    text-decoration: none;
    cursor: pointer;
    transition: background-color var(--motion-fast, 140ms) var(--ease-out, ease-out),
                border-color var(--motion-fast, 140ms) var(--ease-out, ease-out);
  }

  .btn-primary {
    background-color: var(--color-cobalt, #2854c7);
    color: #ffffff;
    border: 1px solid var(--color-cobalt, #2854c7);
  }

  .btn-primary:hover {
    background-color: #1e40af;
    border-color: #1e40af;
  }

  /* 19px measured, same standalone-anchor case as the rail bridge link. */
  .panel-desk-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -12px;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-cobalt, #2854c7);
    text-decoration: none;
    transition: color var(--motion-fast, 140ms) var(--ease-out, ease-out);
  }

  .panel-desk-link:hover {
    color: var(--text-primary, #091118);
    text-decoration: underline;
  }

  @media (max-width: 1023px) {
    .decision-panels-wrap {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--border-color, #d2d7d3);
      padding-top: var(--space-4, 1rem);
    }
  }
</style>
