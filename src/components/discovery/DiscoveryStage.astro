---
// src/components/discovery/DiscoveryStage.astro
// Master Orchestrator for InfraHub Act 2: The Infrastructure Lens
import DisciplineRail from './DisciplineRail.astro';
import PhysicalLens from './PhysicalLens.astro';
import CapacityLens from './CapacityLens.astro';
import InfraHubReach from './InfraHubReach.astro';
import DecisionPanel from './DecisionPanel.astro';
---

<section 
  class="section section-discovery-stage" 
  id="what-you-need" 
  aria-labelledby="discovery-heading"
  data-scene-id="discovery"
>
  <div class="container">
    <!-- Act 2 Editorial Header -->
    <div class="discovery-header">
      <div class="header-left">
        <span class="selector-kicker">CAPABILITIES</span>
        <h2 id="discovery-heading" class="selector-title">What are you looking to solve?</h2>
        <p class="selector-intro">Choose a discipline. See the routes, constraints and decisions that shape the answer.</p>
      </div>

      <!-- View Mode Toggle: Physical System vs Verified Reach Atlas -->
      <div class="view-mode-toggle" role="group" aria-label="Discovery Perspectives">
        <button 
          type="button" 
          class="view-mode-btn active" 
          id="toggle-physical-view" 
          aria-pressed="true"
        >
          <span class="view-mode-dot" aria-hidden="true"></span>
          <span>Physical System</span>
        </button>
        <button 
          type="button" 
          class="view-mode-btn" 
          id="toggle-reach-view" 
          aria-pressed="false"
        >
          <span class="view-mode-dot" aria-hidden="true"></span>
          <span>Ecosystem Reach Atlas</span>
        </button>
      </div>
    </div>

    <!-- Asymmetrical 3-Column Architectural Stage -->
    <div class="discovery-stage-grid">
      <!-- Left Column: 01-05 Discipline Navigation -->
      <div class="stage-col-rail">
        <DisciplineRail activeId="network" />
      </div>

      <!-- Center Column: Physical Lens / Reach Atlas + Requirement Capacity -->
      <div class="stage-col-visual">
        <div class="lens-container" id="lens-primary-container">
          <PhysicalLens activeId="network" />
        </div>
        
        <div class="reach-container" id="reach-atlas-container" style="display: none;">
          <InfraHubReach />
        </div>

        <CapacityLens activeDisciplineId="network" activeCapacity="100G" />
      </div>

      <!-- Right Column: Decision Panel, Service Routes & What Changes The Answer -->
      <div class="stage-col-decision">
        <DecisionPanel activeId="network" />
      </div>
    </div>

    <!-- Act 2 -> Act 3 Route Convergence Anchor Line -->
    <div class="convergence-exit-strip" aria-hidden="true">
      <div class="exit-line-track">
        <div class="exit-line-lead"></div>
        <span class="exit-tag">INFRAHUB RESOLUTION PATH &rarr;</span>
      </div>
    </div>
  </div>
</section>

<style>
  .section-discovery-stage {
    position: relative;
    padding-top: var(--space-8, 2.5rem);
    padding-bottom: var(--space-10, 3.5rem);
    background-color: var(--bg-surface, #ffffff);
    border-bottom: 1px solid var(--border-color, #d2d7d3);
    overflow: hidden;
  }

  .discovery-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4, 1rem);
    margin-bottom: var(--space-6, 1.75rem);
    padding-bottom: var(--space-4, 1rem);
    border-bottom: 1px solid var(--border-color, #d2d7d3);
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: 68ch;
  }

  .selector-kicker {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-cobalt, #2854c7);
    text-transform: uppercase;
  }

  .selector-title {
    font-family: var(--font-heading, 'IBM Plex Sans', sans-serif);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-primary, #091118);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .selector-intro {
    font-family: var(--font-body, 'IBM Plex Sans', sans-serif);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-secondary, #475569);
    margin: 0;
  }

  .view-mode-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--bg-surface-elevated, #f4f5f1);
    border: 1px solid var(--border-color, #d2d7d3);
    border-radius: var(--radius-sm, 4px);
  }

  /* 29px measured - above the AA floor, below the platform target for a primary view switch. */
  .view-mode-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary, #475569);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    cursor: pointer;
    outline: none;
    transition: background-color var(--motion-fast, 140ms) var(--ease-out, ease-out),
                color var(--motion-fast, 140ms) var(--ease-out, ease-out),
                border-color var(--motion-fast, 140ms) var(--ease-out, ease-out);
  }

  .view-mode-btn:hover {
    color: var(--text-primary, #091118);
    background: rgba(0, 0, 0, 0.03);
  }

  .view-mode-btn:focus-visible {
    border-color: var(--color-cobalt, #2854c7);
  }

  .view-mode-btn.active {
    background: #ffffff;
    color: var(--text-primary, #091118);
    border-color: var(--border-color, #d2d7d3);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .view-mode-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--text-tertiary, #94a3b8);
  }

  .view-mode-btn.active .view-mode-dot {
    background-color: var(--color-cobalt, #2854c7);
  }

  /* Asymmetrical 3-Column Composition: 20% / 53% / 27% */
  .discovery-stage-grid {
    display: grid;
    grid-template-columns: 20% 53% 27%;
    gap: var(--space-4, 1rem);
    align-items: stretch;
    min-height: 480px;
  }

  .stage-col-rail {
    display: flex;
    flex-direction: column;
  }

  .stage-col-visual {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .stage-col-decision {
    display: flex;
    flex-direction: column;
  }

  .convergence-exit-strip {
    margin-top: var(--space-6, 1.5rem);
    padding-top: var(--space-4, 1rem);
    border-top: 1px dashed var(--border-color, #d2d7d3);
  }

  .exit-line-track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .exit-line-lead {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, rgba(40, 84, 199, 0.1) 0%, #2854c7 100%);
    border-radius: 1px;
    transform-origin: left center;
    transform: scaleX(var(--route-convergence, 0.4));
    transition: transform 300ms var(--ease-out, ease-out);
  }

  .exit-tag {
    font-family: var(--font-mono, 'IBM Plex Mono', monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-cobalt, #2854c7);
    letter-spacing: 0.06em;
  }

  @media (max-width: 1179px) {
    .discovery-stage-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6, 1.5rem);
    }
  }

  @media (max-width: 639px) {
    .selector-title {
      font-size: 1.625rem;
    }
    .view-mode-toggle {
      width: 100%;
    }
    .view-mode-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<script>
  function initDiscoveryStage() {
    const root = document.getElementById('what-you-need');
    if (!root) return;

    // Tabs / Rail
    const railTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.discipline-tab-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.selector-panel'));
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.lens-slide'));

    // Capacity Lens controls
    const capacityPills = Array.from(root.querySelectorAll<HTMLButtonElement>('.capacity-pill'));
    const capacityCurrentNote = root.querySelector<HTMLElement>('#capacity-current-note');
    const capacityConstraintText = root.querySelector<HTMLElement>('#capacity-constraint-text');

    // Perspective switch (Physical vs Atlas)
    const togglePhysical = root.querySelector<HTMLButtonElement>('#toggle-physical-view');
    const toggleReach = root.querySelector<HTMLButtonElement>('#toggle-reach-view');
    const lensContainer = root.querySelector<HTMLElement>('#lens-primary-container');
    const reachContainer = root.querySelector<HTMLElement>('#reach-atlas-container');

    function setDiscipline(targetId: string, moveFocus = false) {
      root?.setAttribute('data-active-discipline', targetId);

      // Update Tabs
      railTabs.forEach((tab) => {
        const isTarget = tab.getAttribute('data-discipline-id') === targetId;
        tab.classList.toggle('active', isTarget);
        tab.setAttribute('aria-selected', isTarget ? 'true' : 'false');
        tab.setAttribute('tabindex', isTarget ? '0' : '-1');
        if (isTarget && moveFocus) {
          tab.focus();
        }
      });

      // Update Decision Panels
      panels.forEach((p) => {
        const isTarget = p.getAttribute('data-panel-id') === targetId;
        p.classList.toggle('active', isTarget);
      });

      // Update Physical Slides
      slides.forEach((s) => {
        const isTarget = s.getAttribute('data-slide-id') === targetId;
        s.classList.toggle('active', isTarget);
      });

      // Announce custom event for scene controller
      window.dispatchEvent(
        new CustomEvent('infrahub:discipline-changed', {
          detail: { id: targetId }
        })
      );
    }

    // Tab keydown handling (Arrow navigation, Home, End)
    railTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-discipline-id');
        if (targetId) setDiscipline(targetId, false);
      });

      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let newIndex: number | null = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          newIndex = (index + 1) % railTabs.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          newIndex = (index - 1 + railTabs.length) % railTabs.length;
        } else if (e.key === 'Home') {
          newIndex = 0;
        } else if (e.key === 'End') {
          newIndex = railTabs.length - 1;
        }

        if (newIndex !== null) {
          e.preventDefault();
          const nextTarget = railTabs[newIndex]?.getAttribute('data-discipline-id');
          if (nextTarget) {
            setDiscipline(nextTarget, true);
          }
        }
      });
    });

    // Capacity Selector interactions
    capacityPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        capacityPills.forEach(p => {
          const isSelected = p === pill;
          p.classList.toggle('active', isSelected);
          p.setAttribute('aria-checked', isSelected ? 'true' : 'false');
        });

        const desc = pill.getAttribute('data-desc');
        const constraint = pill.getAttribute('data-constraint');
        const weight = pill.getAttribute('data-weight') || '2.5';

        if (capacityCurrentNote && desc) {
          capacityCurrentNote.textContent = desc;
        }
        if (capacityConstraintText && constraint) {
          capacityConstraintText.textContent = constraint;
        }

        // Adjust active route stroke width across SVG lines
        root.querySelectorAll<SVGPathElement>('.physical-active-route').forEach(path => {
          path.setAttribute('stroke-width', weight);
        });

        // Highlight services meeting min capacity
        const selectedCap = pill.getAttribute('data-capacity');
        root.querySelectorAll<HTMLElement>('.service-card').forEach(card => {
          const minCap = card.getAttribute('data-min-capacity');
          if (minCap && selectedCap) {
            const numSelected = parseInt(selectedCap);
            const numMin = parseInt(minCap);
            if (numSelected < numMin) {
              card.style.opacity = '0.4';
            } else {
              card.style.opacity = '1';
            }
          } else {
            card.style.opacity = '1';
          }
        });
      });
    });

    // View Mode Toggle (Physical Lens vs Atlas)
    if (togglePhysical && toggleReach && lensContainer && reachContainer) {
      togglePhysical.addEventListener('click', () => {
        togglePhysical.classList.add('active');
        togglePhysical.setAttribute('aria-pressed', 'true');
        toggleReach.classList.remove('active');
        toggleReach.setAttribute('aria-pressed', 'false');

        lensContainer.style.display = 'block';
        reachContainer.style.display = 'none';
      });

      toggleReach.addEventListener('click', () => {
        toggleReach.classList.add('active');
        toggleReach.setAttribute('aria-pressed', 'true');
        togglePhysical.classList.remove('active');
        togglePhysical.setAttribute('aria-pressed', 'false');

        lensContainer.style.display = 'none';
        reachContainer.style.display = 'block';
      });
    }

    // Atlas Node click handlers
    const atlasNodes = Array.from(root.querySelectorAll<SVGGElement>('.reach-node-group'));
    const detailTitle = root.querySelector<HTMLElement>('#reach-detail-title');
    const detailProvider = root.querySelector<HTMLElement>('#reach-detail-provider');

    atlasNodes.forEach((node) => {
      node.addEventListener('click', () => {
        const metro = node.getAttribute('data-metro');
        const code = node.getAttribute('data-code');
        const provider = node.getAttribute('data-provider');

        if (detailTitle && metro && code) {
          detailTitle.textContent = `${metro} (${code}) Gateway`;
        }
        if (detailProvider && provider) {
          detailProvider.textContent = `Evaluated via ${provider}`;
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiscoveryStage);
  } else {
    initDiscoveryStage();
  }
</script>
