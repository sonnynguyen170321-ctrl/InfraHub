---
// src/components/DeliveryModel.astro
// One observation per step. The note belongs to the step being read, so it changes as the
// reader moves rather than on a timer nobody asked for.
const annotations = [
  {
    step: "understand",
    title: "Price isn't total cost.",
    detail: "A low rate per Mbps can cost significantly more once cross-connect fees, restrictive burst tiers, and regional eyeball hops are tallied."
  },
  {
    step: "match",
    title: "Provider fit depends on the requirement.",
    detail: "Provider fit changes with geography, technical scope, operating model and commercial terms."
  },
  {
    step: "introduce",
    title: "Logical diversity isn't physical diversity.",
    detail: "Two providers can still share building entrances, ducts, crossings, or long-haul segments. Where physical diversity matters, route evidence should be checked."
  },
  {
    step: "deliver",
    title: "The provider's agreement is the one that governs the service.",
    detail: "Pricing, service commitments and support scope are set in the contract you sign with the selected provider, not in an introduction."
  }
];
---

<section class="section section-delivery" id="how-it-works" aria-label="Judgment: How InfraHub Works">
  <div class="container">
    <div class="delivery-asymmetric-split">
      
      <div class="delivery-narrative-col">
        <div class="sticky-narrative-wrapper">
          <h2 class="delivery-title">
            One requirement.<br />
            A network of specialists.
          </h2>
          <p class="delivery-lead">
            InfraHub helps define the requirement, compare suitable approaches and identify specialist providers.
          </p>
          <p class="delivery-body">
            For partner-delivered services, the selected provider confirms the commercial terms, contracts directly and delivers the service.
          </p>

          <!-- Interactive Factor Considerations (Directive 14) -->
          <div class="judgment-factors-wrap">
            <span class="factors-kicker">Key considerations</span>
            <div class="judgment-factors-row" role="group" aria-label="Key considerations">
              <button type="button" class="factor-btn active" data-factor-step="0">Requirement</button>
              <button type="button" class="factor-btn" data-factor-step="1">Provider fit</button>
              <button type="button" class="factor-btn" data-factor-step="2">Commercial terms</button>
              <button type="button" class="factor-btn" data-factor-step="3">Physical diversity</button>
            </div>
          </div>
          
          <div class="delivery-action">
            <a href="/how-we-work" class="delivery-link">
              <span>Review how we work</span>
              <span class="delivery-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="editorial-sideband" id="deliveryAnnotationCard">
            <div class="sideband-header">
              <span class="sideband-kicker">What changes the answer</span>
            </div>
            <div class="annotation-rotator" id="annotationRotator">
              {annotations.map((note, index) => (
                <div class={`annotation-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                  <h3 class="annotation-title">{note.title}</h3>
                  <p class="annotation-desc">{note.detail}</p>
                </div>
              ))}
            </div>
            <div class="annotation-progress" aria-hidden="true">
              <span class="annotation-count" id="annotationCount">01 / {String(annotations.length).padStart(2, '0')}</span>
              <span class="annotation-rule"><span class="annotation-rule-fill" id="annotationRuleFill"></span></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Process Sequence Flow (Directives 11–14) -->
      <div class="delivery-sequence-col">
        
        <div class="process-flow-cap is-start" aria-hidden="true">
          <span class="cap-badge">REQUIREMENT</span>
          <span class="cap-vector">&darr;</span>
        </div>

        <div class="vertical-process-track">
          <!-- Step 01: Understand -->
          <div class="process-node-block" id="step-understand" data-step="understand">
            <div class="node-spine-col">
              <span class="node-number">01</span>
              <div class="spine-line"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Understand</h3>
              <p class="node-desc">Clarify what actually needs to be achieved: workload, throughput, latency, physical routing, and commercial constraints.</p>
              <div class="node-inputs-grid">
                <span class="input-item">Location</span>
                <span class="input-item">Traffic</span>
                <span class="input-item">Capacity</span>
                <span class="input-item">Resilience</span>
                <span class="input-item">Timing</span>
                <span class="input-item">Budget</span>
              </div>
            </div>
          </div>

          <!-- Step 02: Match -->
          <div class="process-node-block" id="step-match" data-step="match">
            <div class="node-spine-col">
              <span class="node-number">02</span>
              <div class="spine-line"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Match</h3>
              <p class="node-desc">Evaluate architecture approaches and identify suitable specialist providers matching your technical footprint.</p>
              <div class="node-branches-grid">
                <div class="branch-item"><span class="branch-rule" aria-hidden="true"></span>Carrier route</div>
                <div class="branch-item"><span class="branch-rule" aria-hidden="true"></span>Cloud approach</div>
                <div class="branch-item"><span class="branch-rule" aria-hidden="true"></span>Hardware route</div>
                <div class="branch-item"><span class="branch-rule" aria-hidden="true"></span>Security specialist</div>
              </div>
            </div>
          </div>

          <!-- Step 03: Introduce -->
          <div class="process-node-block" id="step-introduce" data-step="introduce">
            <div class="node-spine-col">
              <span class="node-number">03</span>
              <div class="spine-line"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Introduce</h3>
              <p class="node-desc">Coordinate an introduction to the selected specialist provider, ensuring technical scope and prerequisites are established upfront.</p>
              <p class="specialist-line">
                <span class="specialist-rule" aria-hidden="true"></span>
                <span>One route is selected and the rest are set aside</span>
              </p>
            </div>
          </div>

          <!-- Step 04: Deliver -->
          <div class="process-node-block" id="step-deliver" data-step="deliver">
            <div class="node-spine-col">
              <span class="node-number">04</span>
              <div class="spine-line spine-terminal"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Deliver</h3>
              <p class="node-desc">The selected specialist contracts and delivers the partner service directly under their agreement with you. InfraHub remains upstream for advisory support.</p>
              <div class="delivery-upstream-flow">
                <span class="flow-party is-upstream">InfraHub qualifies &amp; coordinates</span>
                <span class="flow-rule" aria-hidden="true"></span>
                <span class="flow-party is-provider">Provider contracts &amp; delivers</span>
              </div>
            </div>
          </div>
        </div>

        <div class="process-flow-cap is-end" aria-hidden="true">
          <span class="cap-vector">&darr;</span>
          <span class="cap-badge is-provider">SPECIALIST PROVIDER</span>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .section-delivery {
    position: relative;
    background-color: #0b1120;
    color: #ffffff;
    padding: 80px 0 88px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Factor Considerations (Directive 14) */
  .judgment-factors-wrap {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .factors-kicker {
    font-size: 0.76rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #94a3b8;
  }

  .judgment-factors-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .factor-btn {
    padding: 5px 10px;
    font-size: 0.8rem;
    font-weight: 550;
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    cursor: pointer;
    transition: all 140ms ease;
  }

  .factor-btn:hover,
  .factor-btn:focus-visible,
  .factor-btn.active {
    color: #ffffff;
    background: rgba(37, 99, 235, 0.25);
    border-color: var(--color-cobalt, #2563eb);
  }

  /* Process Flow Boundaries (Directive 11 & 12) */
  .process-flow-cap {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-left: 2px;
    margin-bottom: 12px;
  }

  .process-flow-cap.is-end {
    margin-top: 12px;
    margin-bottom: 0;
  }

  .cap-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
  }

  .cap-badge.is-provider {
    background: rgba(37, 99, 235, 0.18);
    border-color: rgba(37, 99, 235, 0.4);
    color: #93c5fd;
  }

  .cap-vector {
    font-size: 0.95rem;
    color: var(--color-cobalt, #2563eb);
  }

  /* Asymmetric 40 / 60 Split */
  .delivery-asymmetric-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }
  @media (min-width: 960px) {
    .delivery-asymmetric-split {
      grid-template-columns: 1fr 1.35fr;
      gap: 64px;
      align-items: start;
    }
  }

  /* Left Narrative Column (Sticky on capable desktop per Directive 9) */
  .delivery-narrative-col {
    position: relative;
  }

  @media (min-width: 960px) {
    .sticky-narrative-wrapper {
      position: sticky;
      top: 110px;
      display: flex;
      flex-direction: column;
      gap: 22px;
      max-width: 480px;
    }
  }

  .delivery-kicker-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .routing-junction-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-blue);
  }


  .delivery-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .delivery-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin: 0;
  }

  .delivery-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #cbd5e1;
    margin: 0;
  }

  .delivery-action {
    margin-top: 4px;
  }

  .delivery-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #93c5fd;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .delivery-link:hover {
    color: #ffffff;
  }
  .delivery-arrow {
    transition: transform 160ms ease;
  }
  .delivery-link:hover .delivery-arrow {
    transform: translateX(3px);
  }

  /* Editorial Sideband (Directive 19: Small rule, large statement, short explanation) */
  .editorial-sideband {
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    padding: 24px 0 0;
    margin-top: 44px;
    position: relative;
  }

  .sideband-header {
    margin-bottom: 10px;
  }

  .sideband-kicker {
    font-size: 0.82rem;
    font-weight: 600;
    color: #93c5fd;
    display: block;
  }

  .annotation-rotator {
    position: relative;
    min-height: 80px;
  }

  .annotation-slide {
    display: none;
    flex-direction: column;
    gap: 6px;
  }

  .annotation-slide.active {
    display: flex;
    animation: slideFade var(--motion-content) var(--ease-out);
  }

  @keyframes slideFade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .annotation-title {
    font-size: 1.12rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.35;
    margin: 0;
  }

  .annotation-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin: 0;
  }


  .annotation-progress {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }

  .annotation-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(226, 232, 240, 0.7);
    white-space: nowrap;
  }

  .annotation-rule {
    flex: 1;
    height: 1.5px;
    background-color: rgba(255, 255, 255, 0.14);
    display: block;
  }

  .annotation-rule-fill {
    display: block;
    height: 100%;
    width: 100%;
    background-color: var(--accent-blue);
    transform-origin: left center;
    transform: scaleX(0.25);
    transition: transform var(--motion-ui) var(--ease-out);
  }


  /* Right Column: Vertical Process Track (Directive 9) */
  .vertical-process-track {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-node-block {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding-bottom: 48px;
  }

  .node-spine-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .node-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
    flex-shrink: 0;
  }

  .spine-line {
    position: relative;
    width: 1.5px;
    flex-grow: 1;
    background: rgba(255, 255, 255, 0.14);
    margin-top: 8px;
  }

  /* The route itself: a cobalt line that draws down the spine as each step is reached. */
  .spine-line::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--accent-blue);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--motion-scene) var(--ease-out);
  }

  .process-node-block.is-active .spine-line::after,
  .process-node-block.is-passed .spine-line::after {
    transform: scaleY(1);
  }

  .process-node-block .node-number {
    transition: color var(--motion-content) var(--ease-out);
  }

  .process-node-block.is-active .node-number {
    color: var(--accent-blue-on-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .spine-line::after {
      transform: scaleY(1);
      transition: none;
    }
  }

  .spine-terminal {
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.14), var(--accent-blue));
  }

  .node-content-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }

  .node-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .node-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin: 0;
    max-width: 52ch;
  }

  /* Input Tags with Thin Rules (Step 1) */
  .node-inputs-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .input-item {
    font-size: 0.82rem;
    color: #cbd5e1;
    padding: 6px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Architectural Branches (Step 2) */
  .node-branches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 8px;
    margin-top: 8px;
  }

  .branch-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.84rem;
    color: #93c5fd;
    padding: 7px 0;
  }

  .branch-rule {
    width: 6px;
    height: 1.5px;
    background-color: var(--accent-blue);
  }

  /* Specialist Alignment (Step 3) */
  .specialist-line {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    font-size: 0.9rem;
    color: #e2e8f0;
  }

  .specialist-rule {
    width: 40px;
    height: 1.5px;
    background: var(--accent-teal, #0d9488);
    flex-shrink: 0;
  }

  .specialist-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
  }

  .specialist-text {
    font-size: 0.84rem;
    font-weight: 600;
    color: #a7f3d0;
  }

  /* Delivery Upstream Flow (Step 4) */
  .delivery-upstream-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .flow-party {
    font-size: 0.88rem;
    font-weight: 600;
  }

  .flow-party.is-upstream {
    color: #93c5fd;
  }

  .flow-party.is-provider {
    color: #ffffff;
  }

  .flow-rule {
    flex: 1;
    min-width: 32px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent-blue), rgba(255, 255, 255, 0.4));
  }

  .flow-arrow {
    color: #94a3b8;
    font-weight: 700;
  }
</style>

<script>
  // The process story advances with the reader or direct user interaction.
  function initProcessStory() {
    const steps = Array.from(
      document.querySelectorAll<HTMLElement>('.process-node-block[data-step]')
    );
    const slides = Array.from(
      document.querySelectorAll<HTMLElement>('#annotationRotator .annotation-slide')
    );
    const factorBtns = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.factor-btn')
    );
    const count = document.getElementById('annotationCount');
    const ruleFill = document.getElementById('annotationRuleFill');

    if (steps.length === 0) return;

    let activeIndex = -1;

    function showAnnotation(index: number) {
      slides.forEach((slide, i) => slide.classList.toggle('active', i === index));
      if (count) {
        count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }
      if (ruleFill) {
        ruleFill.style.transform = `scaleX(${(index + 1) / slides.length})`;
      }
    }

    function setActiveStep(index: number) {
      if (index === activeIndex) return;
      activeIndex = index;

      steps.forEach((step, i) => {
        step.classList.toggle('is-active', i === index);
        step.classList.toggle('is-passed', i < index);
      });

      factorBtns.forEach((btn, i) => {
        btn.classList.toggle('active', i === index);
      });

      if (index >= 0 && index < slides.length) showAnnotation(index);
    }

    factorBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        setActiveStep(idx);
        steps[idx]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
      btn.addEventListener('mouseenter', () => setActiveStep(idx));
      btn.addEventListener('focus', () => setActiveStep(idx));
    });

    // Reading line: a step becomes current once its top passes the upper third of the
    // viewport, which is where a reader's attention actually sits.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = steps.indexOf(entry.target as HTMLElement);
          if (index >= 0) setActiveStep(index);
        }
      },
      { rootMargin: '-30% 0px -55% 0px', threshold: 0 }
    );

    steps.forEach((step) => observer.observe(step));

    setActiveStep(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProcessStory);
  } else {
    initProcessStory();
  }
</script>
