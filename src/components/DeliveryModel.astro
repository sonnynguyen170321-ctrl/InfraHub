---
// src/components/DeliveryModel.astro
const annotations = [
  {
    title: "Price isn't total cost.",
    detail: "A low rate per Mbps can cost significantly more once cross-connect fees, restrictive burst tiers, and regional eyeball hops are tallied."
  },
  {
    title: "Logical diversity isn't physical diversity.",
    detail: "Two providers can still share building entrances, ducts, crossings, or long-haul segments. Where physical diversity matters, route evidence should be checked."
  },
  {
    title: "Provider fit depends on the requirement.",
    detail: "Provider fit changes with geography, technical scope, operating model and commercial terms."
  }
];
---

<section class="section section-delivery" id="how-it-works" aria-label="Judgment: How InfraHub Works">
  <!-- Subtle Route Line Entry Connector from Solutions -->
  <div class="delivery-route-entry" aria-hidden="true">
    <div class="route-line-stem"></div>
  </div>

  <div class="container">
    <div class="delivery-asymmetric-split">
      
      <!-- Left Column: Sticky Headline & Business Model Narrative (Directive 9) -->
      <div class="delivery-narrative-col">
        <div class="sticky-narrative-wrapper">
          <div class="delivery-kicker-row">
            <span class="routing-junction-light" aria-hidden="true"></span>
            <span class="delivery-kicker">Operational model</span>
          </div>
          <h2 class="delivery-title">
            One requirement.<br />
            A network of specialists.
          </h2>
          <p class="delivery-lead">
            InfraHub qualifies requirements, compares architectural approaches, and introduces specialist providers.
          </p>
          <p class="delivery-body">
            InfraHub helps qualify requirements and connect your team with suitable specialist operators. For partner-delivered services, the selected provider confirms commercial terms, contracts directly, and delivers the service.
          </p>
          
          <div class="delivery-action">
            <a href="/how-we-work" class="delivery-link">
              <span>Review how we work</span>
              <span class="delivery-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <!-- One note at a time, rotating. Rendered from the annotations array above: the
               same copy was previously duplicated here in markup, which is how the two drift. -->
          <div class="single-annotation-card" id="deliveryAnnotationCard">
            <span class="annotation-badge">What changes the answer</span>
            <div class="annotation-rotator" id="annotationRotator">
              {annotations.map((note, index) => (
                <div class={`annotation-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                  <h3 class="annotation-title">{note.title}</h3>
                  <p class="annotation-desc">{note.detail}</p>
                </div>
              ))}
            </div>
            <div class="annotation-stepper" aria-hidden="true">
              {annotations.map((_, index) => (
                <span class={`step-dot ${index === 0 ? 'active' : ''}`}></span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Progressive Vertical Routing Line Sequence (Directive 9) -->
      <div class="delivery-sequence-col">
        
        <div class="vertical-process-track">
          <!-- Step 01: Understand -->
          <div class="process-node-block" id="step-understand">
            <div class="node-spine-col">
              <span class="node-number">01</span>
              <div class="spine-line"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Understand</h3>
              <p class="node-desc">Clarify what actually needs to be achieved: workload, throughput, latency, physical routing, and commercial constraints.</p>
              <!-- Input Tags with Thin Rules (Directive 9) -->
              <div class="node-inputs-grid">
                <span class="input-tag">Location</span>
                <span class="input-tag">Traffic</span>
                <span class="input-tag">Capacity</span>
                <span class="input-tag">Resilience</span>
                <span class="input-tag">Timing</span>
                <span class="input-tag">Budget</span>
              </div>
            </div>
          </div>

          <!-- Step 02: Match -->
          <div class="process-node-block" id="step-match">
            <div class="node-spine-col">
              <span class="node-number">02</span>
              <div class="spine-line"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Match</h3>
              <p class="node-desc">Evaluate architecture approaches and identify suitable specialist providers matching your technical footprint.</p>
              <!-- Architectural Branches (Directive 9) -->
              <div class="node-branches-grid">
                <div class="branch-pill"><span class="branch-rule"></span> Carrier route</div>
                <div class="branch-pill"><span class="branch-rule"></span> Cloud approach</div>
                <div class="branch-pill"><span class="branch-rule"></span> Hardware route</div>
                <div class="branch-pill"><span class="branch-rule"></span> Security specialist</div>
              </div>
            </div>
          </div>

          <!-- Step 03: Introduce -->
          <div class="process-node-block" id="step-introduce">
            <div class="node-spine-col">
              <span class="node-number">03</span>
              <div class="spine-line"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Introduce</h3>
              <p class="node-desc">Coordinate an introduction to the selected specialist provider, ensuring technical scope and prerequisites are established upfront.</p>
              <div class="specialist-route-card">
                <span class="specialist-indicator"></span>
                <span class="specialist-text">Selected specialist alignment</span>
              </div>
            </div>
          </div>

          <!-- Step 04: Deliver -->
          <div class="process-node-block" id="step-deliver">
            <div class="node-spine-col">
              <span class="node-number">04</span>
              <div class="spine-line spine-terminal"></div>
            </div>
            <div class="node-content-col">
              <h3 class="node-title">Deliver</h3>
              <p class="node-desc">The selected specialist contracts and delivers the partner service directly under their agreement with you. InfraHub remains upstream for advisory support.</p>
              <div class="delivery-upstream-flow">
                <span class="upstream-badge">InfraHub (Upstream Advisory)</span>
                <span class="flow-arrow" aria-hidden="true">&rarr;</span>
                <span class="provider-badge">Selected Specialist Provider (Direct Delivery)</span>
              </div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Scene Transition Bridge: Process → Route Diversity (Directive 17) -->
  <div class="process-to-route-bridge" aria-hidden="true">
    <div class="bridge-stem"></div>
    <div class="bridge-junction"></div>
    <div class="bridge-fork">
      <div class="fork-branch branch-a"></div>
      <div class="fork-branch branch-b"></div>
    </div>
  </div>
</section>

<style>
  .section-delivery {
    position: relative;
    background-color: #0b1120;
    color: #ffffff;
    padding: 112px 0 120px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Infrastructure Route Line Entry (Directive 2, 9) */
  .delivery-route-entry {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 32px;
    z-index: 2;
  }
  .route-line-stem {
    width: 1.5px;
    height: 100%;
    background: linear-gradient(to bottom, var(--accent-blue), rgba(40, 84, 199, 0.4));
  }

  /* Asymmetric 40 / 60 Split */
  .delivery-asymmetric-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px;
  }
  @media (min-width: 960px) {
    .delivery-asymmetric-split {
      grid-template-columns: 1fr 1.35fr;
      gap: 80px;
      align-items: start;
    }
  }

  /* Left Narrative Column (Sticky on capable desktop per Directive 9) */
  .delivery-narrative-col {
    position: relative;
  }

  @media (min-width: 960px) {
    .sticky-narrative-wrapper {
      position: sticky;
      top: 110px;
      display: flex;
      flex-direction: column;
      gap: 22px;
      max-width: 480px;
    }
  }

  .delivery-kicker-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .routing-junction-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-blue);
  }

  .delivery-kicker {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #93c5fd;
  }

  .delivery-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .delivery-lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin: 0;
  }

  .delivery-body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #cbd5e1;
    margin: 0;
  }

  .delivery-action {
    margin-top: 4px;
  }

  .delivery-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #93c5fd;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .delivery-link:hover {
    color: #ffffff;
  }
  .delivery-arrow {
    transition: transform 160ms ease;
  }
  .delivery-link:hover .delivery-arrow {
    transform: translateX(3px);
  }

  /* Single Rotating Annotation Card (Directive 10) */
  .single-annotation-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-left: 2px solid var(--accent-blue);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
    margin-top: 18px;
    position: relative;
    overflow: hidden;
  }

  .annotation-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #93c5fd;
    display: block;
    margin-bottom: 8px;
  }

  .annotation-rotator {
    position: relative;
    min-height: 84px;
  }

  .annotation-slide {
    display: none;
    flex-direction: column;
    gap: 6px;
  }

  .annotation-slide.active {
    display: flex;
    animation: slideFade var(--motion-content) var(--ease-out);
  }

  @keyframes slideFade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .annotation-title {
    font-size: 1.02rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .annotation-desc {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #cbd5e1;
    margin: 0;
  }

  .annotation-stepper {
    display: flex;
    gap: 6px;
    margin-top: 14px;
  }

  .step-dot {
    width: 16px;
    height: 2px;
    background: rgba(255, 255, 255, 0.2);
    transition: background 200ms ease;
  }

  .step-dot.active {
    background: var(--accent-blue);
  }

  /* Right Column: Vertical Process Track (Directive 9) */
  .vertical-process-track {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-node-block {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    padding-bottom: 48px;
  }

  .node-spine-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .node-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 700;
    color: #ffffff;
    flex-shrink: 0;
  }

  .spine-line {
    width: 1.5px;
    flex-grow: 1;
    background: rgba(255, 255, 255, 0.14);
    margin-top: 8px;
  }

  .spine-terminal {
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.14), var(--accent-blue));
  }

  .node-content-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }

  .node-title {
    font-size: 1.3rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .node-desc {
    font-size: 0.92rem;
    line-height: 1.65;
    color: #cbd5e1;
    margin: 0;
    max-width: 52ch;
  }

  /* Input Tags with Thin Rules (Step 1) */
  .node-inputs-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }

  .input-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    padding: 4px 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-sm);
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.03);
  }

  /* Architectural Branches (Step 2) */
  .node-branches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 8px;
    margin-top: 8px;
  }

  .branch-pill {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: #93c5fd;
    padding: 6px 10px;
    background: rgba(40, 84, 199, 0.08);
    border: 1px solid rgba(40, 84, 199, 0.25);
    border-radius: var(--radius-sm);
  }

  .branch-rule {
    width: 6px;
    height: 1.5px;
    background-color: var(--accent-blue);
  }

  /* Specialist Alignment (Step 3) */
  .specialist-route-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid rgba(8, 125, 121, 0.35);
    background: rgba(8, 125, 121, 0.08);
    border-radius: var(--radius-sm);
    margin-top: 6px;
    width: fit-content;
  }

  .specialist-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-cyan);
  }

  .specialist-text {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: #a7f3d0;
  }

  /* Delivery Upstream Flow (Step 4) */
  .delivery-upstream-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  .upstream-badge {
    padding: 6px 12px;
    background: rgba(40, 84, 199, 0.15);
    border: 1px solid var(--accent-blue);
    border-radius: var(--radius-sm);
    color: #93c5fd;
    font-weight: 700;
  }

  .flow-arrow {
    color: #94a3b8;
    font-weight: 700;
  }

  .provider-badge {
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-sm);
    color: #ffffff;
    font-weight: 600;
  }

  /* Scene Transition Bridge: Process → Route Diversity (Directive 17) */
  .process-to-route-bridge {
    position: absolute;
    bottom: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 10;
  }

  .bridge-stem {
    width: 1.5px;
    height: 24px;
    background-color: var(--accent-blue);
  }

  .bridge-junction {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent-blue);
  }

  .bridge-fork {
    display: flex;
    justify-content: space-between;
    width: 140px;
    height: 18px;
    border-bottom: 1.5px solid var(--border-color);
  }

  .fork-branch {
    width: 1.5px;
    height: 100%;
  }

  .branch-a {
    background-color: var(--accent-blue);
    margin-left: 20px;
  }

  .branch-b {
    background-color: var(--accent-cyan);
    margin-right: 20px;
  }
</style>

<script>
  // Single Editorial Annotation Rotator (Directive 10)
  function initDeliveryAnnotations() {
    const rotator = document.getElementById('annotationRotator');
    if (!rotator) return;

    const slides = rotator.querySelectorAll('.annotation-slide');
    const dots = document.querySelectorAll('.annotation-stepper .step-dot');
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let intervalId: number | null = null;

    function showSlide(index: number) {
      slides.forEach((s, i) => {
        s.classList.toggle('active', i === index);
      });
      dots.forEach((d, i) => {
        d.classList.toggle('active', i === index);
      });
      currentIndex = index;
    }

    function nextSlide() {
      const next = (currentIndex + 1) % slides.length;
      showSlide(next);
    }

    function startTimer() {
      if (intervalId) clearInterval(intervalId);
      intervalId = window.setInterval(nextSlide, 7000);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        showSlide(i);
        startTimer();
      });
    });

    startTimer();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDeliveryAnnotations);
  } else {
    initDeliveryAnnotations();
  }
</script>
