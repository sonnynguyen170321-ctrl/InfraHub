---
// src/components/DeliveryModel.astro — Human-Authored Delivery Model & Editorial Experience
const steps = [
  {
    num: "01",
    title: "Understand",
    detail: "Clarify what actually needs to be achieved: workload, throughput, latency, physical routing, and commercial constraints."
  },
  {
    num: "02",
    title: "Evaluate & Match",
    detail: "Compare architecture approaches and benchmark independent specialist providers across verified technical footprints."
  },
  {
    num: "03",
    title: "Introduce",
    detail: "Connect your team directly to the engineering and commercial leadership of the selected provider with zero intermediary markup."
  },
  {
    num: "04",
    title: "Deliver",
    detail: "The selected specialist handles partner-delivered implementation and ongoing service directly under contract with you."
  }
];

const annotations = [
  {
    title: "Price isn't total cost.",
    detail: "A low rate per Mbps can cost significantly more once cross-connect fees, restrictive burst tiers, and regional eyeball hops are tallied."
  },
  {
    title: "Logical diversity isn't physical diversity.",
    detail: "Two separate carriers frequently share the same bridge crossing, rail conduit, or building entrance duct. Diversity requires physical path verification."
  },
  {
    title: "The right provider depends on the requirement.",
    detail: "No single provider leads across every metro, route, and platform. Independent evaluation matches you with the specialist that excels in your exact location."
  }
];
---

<section class="section section-delivery" id="how-it-works">
  <div class="container">
    <div class="delivery-asymmetric-split">
      
      <!-- Left Column (40%): Headline & Business Model Narrative -->
      <div class="delivery-narrative-col">
        <h2 class="delivery-title">
          One requirement.<br />
          A network of specialists.
        </h2>
        <p class="delivery-lead">
          InfraHub provides technical qualification, architectural evaluation, and direct specialist introduction.
        </p>
        <p class="delivery-body">
          We do not resell commodity cloud or mark up invoices. Sourcing through InfraHub connects you directly with verified engineering teams, contracting on direct carrier-grade Master Service Agreements.
        </p>
        
        <div class="delivery-action">
          <a href="/how-we-work" class="delivery-link">
            <span>Learn how we work</span>
            <span class="delivery-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Right Column (60%): 4-Step Sequence + Editorial Experience Annotations -->
      <div class="delivery-sequence-col">
        
        <!-- Process Steps (Clean horizontal/vertical sequence, no cards) -->
        <div class="process-flow">
          {steps.map(step => (
            <div class="process-step-item">
              <span class="step-num">{step.num}</span>
              <div class="step-text">
                <h3 class="step-title">{step.title}</h3>
                <p class="step-desc">{step.detail}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Integrated Experience Annotations (Editorial notes woven beneath, optimal measure) -->
        <div class="experience-annotations-block">
          <span class="annotations-heading">What changes the answer</span>
          
          <div class="annotations-list">
            {annotations.map(note => (
              <div class="annotation-item">
                <h4 class="annotation-title">{note.title}</h4>
                <p class="annotation-desc">{note.detail}</p>
              </div>
            ))}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .section-delivery {
    background-color: #0b1120;
    color: #ffffff;
    padding: 104px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Asymmetric 40 / 60 Split */
  .delivery-asymmetric-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
  }
  @media (min-width: 960px) {
    .delivery-asymmetric-split {
      grid-template-columns: 1fr 1.35fr;
      gap: 72px;
      align-items: start;
    }
  }

  /* Left Narrative Column */
  .delivery-narrative-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 480px;
  }
  .delivery-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
  }
  .delivery-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 44ch;
  }
  .delivery-body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: #cbd5e1;
    max-width: 46ch;
  }
  .delivery-action {
    margin-top: 8px;
  }
  .delivery-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #93c5fd;
    font-size: 0.98rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease;
  }
  .delivery-link:hover {
    color: #ffffff;
  }
  .delivery-arrow {
    transition: transform 160ms ease;
  }
  .delivery-link:hover .delivery-arrow {
    transform: translateX(3px);
  }

  /* Right Sequence Column */
  .delivery-sequence-col {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* 4-Step Process Flow */
  .process-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: 28px;
  }
  @media (min-width: 640px) {
    .process-flow {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
  .process-step-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: normal;
  }
  .step-title {
    font-size: 1.18rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.35;
  }
  .step-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 48ch;
  }

  /* Editorial Annotations (Woven beneath, constrained measure) */
  .experience-annotations-block {
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 36px;
    max-width: 620px;
  }
  .annotations-heading {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #94a3b8;
  }
  .annotations-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .annotation-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .annotation-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    max-width: 48ch;
  }
  .annotation-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 58ch;
  }
</style>
