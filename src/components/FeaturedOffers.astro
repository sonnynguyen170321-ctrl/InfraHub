---
// src/components/FeaturedOffers.astro
import { getCollection } from 'astro:content';

const now = new Date();
const allOffers = await getCollection('offers');
const activeOffers = allOffers.filter(o => {
  if (!o.data.publicApproved) return false;
  if (o.data.status !== 'active') return false;
  if (o.data.expiryDate && now > o.data.expiryDate) return false;
  return true;
});

// Primary featured opportunity + secondary opportunities
const primaryOffer = activeOffers.find(o => o.slug === '100g-transit-frankfurt') || activeOffers[0];
const secondaryOffers = primaryOffer 
  ? activeOffers.filter(o => o.slug !== primaryOffer.slug).slice(0, 2)
  : [];
---

<section class="section section-offers" id="featured-offers">
  <div class="container">
    
    <!-- Clean Headline -->
    <div class="offers-header">
      <h2 class="offers-headline">Featured Offers</h2>
      <p class="offers-lead">
        Current infrastructure, connectivity, hardware and security opportunities available through the InfraHub ecosystem.
      </p>
    </div>

    <!-- Empty State Guard -->
    {activeOffers.length === 0 ? (
      <div class="offers-empty-state">
        <p class="empty-state-text">Current commercial allocations are being updated for the current cycle.</p>
        <a href="/lets-talk" class="btn btn-secondary btn-sm">
          <span>Discuss a specific requirement</span>
          <span class="link-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    ) : (
      <!-- Asymmetric Composition: 1 Featured Opportunity + 2 Compact Secondary Rows -->
      <div class="offers-composition">
        
        <!-- Prominent Primary Opportunity -->
        {primaryOffer && (
          <article class="featured-primary-card">
            <div class="primary-card-top">
              <span class="primary-kicker">{primaryOffer.data.category.toUpperCase()} ALLOCATION</span>
              <h3 class="primary-title">
                <a href={`/offers/${primaryOffer.slug}`}>{primaryOffer.data.title}</a>
              </h3>
              <span class="primary-location">{primaryOffer.data.location}</span>
            </div>

            <p class="primary-desc">{primaryOffer.data.shortDescription}</p>

            <ul class="primary-specs-list">
              {primaryOffer.data.specifications.slice(0, 3).map(spec => (
                <li>{spec}</li>
              ))}
            </ul>

            <div class="primary-card-bottom">
              <div class="primary-price">
                <span class="price-figure">{primaryOffer.data.displayPrice || primaryOffer.data.verifiedPrice || 'Request current pricing'}</span>
              </div>
              <a href={`/lets-talk?offer=${primaryOffer.slug}`} class="btn btn-accent btn-sm">
                <span>Request Pricing</span>
              </a>
            </div>
          </article>
        )}

        <!-- Two Compact Secondary Commercial Rows -->
        <div class="secondary-offers-list">
          {secondaryOffers.map(offer => (
            <article class="secondary-offer-row">
              <div class="secondary-meta">
                <div class="secondary-badge-row">
                  <span class="secondary-category">{offer.data.category}</span>
                  <span class="secondary-location">{offer.data.location}</span>
                </div>
                <h4 class="secondary-title">
                  <a href={`/offers/${offer.slug}`}>{offer.data.title}</a>
                </h4>
                <p class="secondary-spec">{offer.data.specifications[0]}</p>
              </div>

              <div class="secondary-action-group">
                <span class="secondary-price">{offer.data.displayPrice || offer.data.verifiedPrice || 'Request current pricing'}</span>
                <a href={`/offers/${offer.slug}`} class="secondary-link">
                  <span>View Offer</span>
                  <span class="link-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          ))}

          <div class="offers-all-link-wrap">
            <a href="/offers" class="offers-view-all">
              <span>View all active commercial offers</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    )}

  </div>
</section>

<style>
  .section-offers {
    background-color: #ffffff;
    padding: 96px 0;
    border-bottom: 1px solid var(--border-color);
  }

  /* Clean Headline */
  .offers-header {
    max-width: 720px;
    margin-bottom: 48px;
  }
  .offers-headline {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.24;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 14px;
  }
  .offers-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Asymmetric 1 Primary + 2 Secondary Composition */
  .offers-composition {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 960px) {
    .offers-composition {
      grid-template-columns: 1.25fr 1fr;
      gap: 48px;
      align-items: stretch;
    }
  }

  /* Primary Featured Opportunity */
  .featured-primary-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }
  .primary-card-top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .primary-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }
  .primary-title {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .primary-title a:hover {
    color: var(--accent-blue);
  }
  .primary-location {
    font-size: 0.88rem;
    color: #475569;
  }
  .primary-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 54ch;
  }
  .primary-specs-list {
    list-style: disc;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .primary-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    margin-top: 8px;
  }
  .primary-price .price-figure {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Secondary Commercial Rows */
  .secondary-offers-list {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }
  .secondary-offer-row {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 24px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: space-between;
  }
  .secondary-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .secondary-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .secondary-category {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }
  .secondary-location {
    font-size: 0.82rem;
    color: #475569;
  }
  .secondary-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
  }
  .secondary-title a:hover {
    color: var(--accent-blue);
  }
  .secondary-spec {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.45;
    max-width: 50ch;
  }
  .secondary-action-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--border-color);
  }
  .secondary-price {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .secondary-link:hover {
    color: var(--accent-blue-hover);
  }
  .link-arrow {
    transition: transform 160ms ease;
  }
  .secondary-link:hover .link-arrow,
  .offers-view-all:hover .link-arrow {
    transform: translateX(3px);
  }

  .offers-all-link-wrap {
    padding-top: 8px;
  }
  .offers-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .offers-view-all:hover {
    color: var(--accent-blue);
  }
</style>
