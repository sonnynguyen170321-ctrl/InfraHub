---
// src/components/FeaturedOffers.astro
import { getCollection } from 'astro:content';

const now = new Date();
const allOffers = await getCollection('offers');
const activeOffers = allOffers.filter(o => {
  if (o.data.status !== 'active') return false;
  if (o.data.expiryDate && now > o.data.expiryDate) return false;
  return true;
});

// Show only the top 3 live offers on the homepage per specification
const homepageOffers = activeOffers.slice(0, 3);
---

<section class="section section-offers" id="featured-offers">
  <div class="container">
    <div class="offers-header">
      <div class="header-left">
        <span class="mono-kicker">COMMERCIAL OPPORTUNITIES</span>
        <h2 class="offers-headline">Featured Infrastructure Offers</h2>
      </div>
      <div class="header-right">
        <p class="offers-lead">Verified hardware stock, transit allocations, and defensive licenses directly through our specialist ecosystem.</p>
      </div>
    </div>

    <div class="offers-triad-grid">
      {homepageOffers.map(offer => (
        <article class="offer-minimal-card">
          <div class="card-meta">
            <span class="offer-category-badge">{offer.data.category.toUpperCase()}</span>
            <span class="offer-location-text">{offer.data.location}</span>
          </div>

          <h3 class="offer-card-title">
            <a href={`/offers/${offer.slug}`}>{offer.data.title}</a>
          </h3>

          <div class="offer-key-spec">
            <span class="spec-label">Key Specification</span>
            <span class="spec-value">{offer.data.specifications[0]}</span>
          </div>

          <div class="offer-card-action">
            <div class="offer-pricing">
              <span class="price-title">Commercial Rate</span>
              <span class="price-amount">{offer.data.verifiedPrice}</span>
            </div>
            <a href={`/lets-talk?offer=${offer.slug}`} class="btn-request">
              <span>Request Pricing</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="offers-bottom-bar">
      <a href="/offers" class="view-all-link">
        <span>View all live commercial offers ({activeOffers.length})</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <span class="offers-disclaimer">Allocations and pricing are verified against partner inventories.</span>
    </div>
  </div>
</section>

<style>
  .section-offers {
    background-color: #f8fafc;
    padding: 80px 0;
    border-bottom: 1px solid var(--border-color);
  }

  .offers-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 48px;
  }
  @media (min-width: 1024px) {
    .offers-header {
      grid-template-columns: 1fr 1fr;
      align-items: flex-end;
      gap: 48px;
    }
  }

  .mono-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-blue);
    letter-spacing: 0.1em;
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }
  .offers-headline {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }
  .offers-lead {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* 3-Card Focused Grid */
  .offers-triad-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-bottom: 36px;
  }
  @media (min-width: 768px) {
    .offers-triad-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .offer-minimal-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    transition: var(--transition-fast);
    box-shadow: var(--shadow-sm);
  }
  .offer-minimal-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .offer-category-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent-blue);
    background: var(--accent-blue-light);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
  }
  .offer-location-text {
    font-size: 0.78rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .offer-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
  }
  .offer-card-title a:hover {
    color: var(--accent-blue);
  }

  .offer-key-spec {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    border-top: 1px solid #f1f5f9;
    border-bottom: 1px solid #f1f5f9;
  }
  .spec-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .spec-value {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.4;
    font-weight: 500;
  }

  .offer-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .offer-pricing {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .price-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .price-amount {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .btn-request {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-blue);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background-color: var(--accent-blue-light);
    transition: var(--transition-fast);
  }
  .btn-request:hover {
    background-color: var(--accent-blue);
    color: #ffffff;
  }

  /* Bottom Bar */
  .offers-bottom-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  @media (min-width: 768px) {
    .offers-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--accent-blue);
  }
  .view-all-link:hover {
    color: var(--accent-blue-hover);
  }

  .offers-disclaimer {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
</style>
