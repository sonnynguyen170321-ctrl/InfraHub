---
// src/components/FeaturedOffers.astro
import { getCollection } from 'astro:content';
import { publicPriceLabel } from '../lib/offer-pricing';

const now = new Date();
const allOffers = await getCollection('offers');
const activeOffers = allOffers.filter(o => {
  if (!o.data.publicApproved) return false;
  if (o.data.status !== 'active') return false;
  if (o.data.expiryDate && now > o.data.expiryDate) return false;
  return true;
});

// Primary featured opportunity + secondary opportunities
const primaryOffer = activeOffers.find(o => o.slug === '100g-transit-frankfurt') || activeOffers[0];
const secondaryOffers = primaryOffer 
  ? activeOffers.filter(o => o.slug !== primaryOffer.slug).slice(0, 2)
  : [];
---

{activeOffers.length > 0 && (
<section class="section section-offers" id="featured-offers" aria-label="Commercial Opportunities">
  <div class="container">
    <div class="offers-populated">
      <div class="offers-header">
        <div class="offers-kicker-row">
          <span class="offers-chapter-tag">Chapter 06 / Commercial Allocations</span>
        </div>
        <h2 class="offers-headline">Current infrastructure opportunities</h2>
        <p class="offers-lead">
          Commercial allocations across connectivity, bare metal, hardware and security available through the InfraHub specialist network.
        </p>
      </div>

      <div class={`offers-composition ${activeOffers.length === 1 ? 'is-single' : ''}`}>
        
        <!-- Prominent Primary Opportunity -->
        {primaryOffer && (
          <article class="featured-primary-card">
            <div class="primary-card-top">
              <span class="primary-kicker">{primaryOffer.data.category}</span>
              <h3 class="primary-title">
                <a href={`/offers/${primaryOffer.slug}`}>{primaryOffer.data.title}</a>
              </h3>
              <span class="primary-location">{primaryOffer.data.location}</span>
            </div>

            <p class="primary-desc">{primaryOffer.data.shortDescription}</p>

            <!-- Interactive Commit Term Selector (Phase 5) -->
            <div class="commit-term-box">
              <div class="commit-term-label">Term & Allocation Model</div>
              <div class="commit-term-options" role="group" aria-label="Commit term options">
                <button type="button" class="term-btn is-active" data-term="12" aria-pressed="true">
                  12-Month Flex
                </button>
                <button type="button" class="term-btn" data-term="24" aria-pressed="false">
                  24-Month Standard
                </button>
                <button type="button" class="term-btn" data-term="36" aria-pressed="false">
                  36-Month Strategic
                </button>
              </div>
              <p class="commit-note" id="allocationCommitNote" aria-live="polite">
                Flexible 95th percentile burstable commit · 14-day port activation SLA.
              </p>
            </div>

            <ul class="primary-specs-list">
              {primaryOffer.data.specifications.slice(0, 3).map(spec => (
                <li>{spec}</li>
              ))}
            </ul>

            <!-- Interactive Technical Specification Detail (Phase 5) -->
            <div class="tech-spec-inspector">
              <div class="spec-tab-row" role="tablist" aria-label="Technical specifications">
                <button type="button" role="tab" class="spec-tab is-active" data-spec-key="routing" aria-selected="true">
                  Routing & BGP
                </button>
                <button type="button" role="tab" class="spec-tab" data-spec-key="handover" aria-selected="false">
                  Facility Handover
                </button>
                <button type="button" role="tab" class="spec-tab" data-spec-key="sla" aria-selected="false">
                  Resilience SLA
                </button>
              </div>
              <div class="spec-detail-content" id="specDetailView" aria-live="polite">
                Dual 100Gbps LR4 optical interfaces with full BGP routing table support and FlowSpec DDoS diversion.
              </div>
            </div>

            <div class="primary-card-bottom">
              <div class="primary-price">
                <span class="price-figure">{publicPriceLabel(primaryOffer.data)}</span>
              </div>
              <a href={`/lets-talk?offer=${primaryOffer.slug}`} class="btn btn-accent btn-sm">
                <span>Request Pricing</span>
              </a>
            </div>
          </article>
        )}

        <!-- Two Compact Secondary Commercial Rows -->
        <div class="secondary-offers-list">
          {secondaryOffers.map(offer => (
            <article class="secondary-offer-row">
              <div class="secondary-meta">
                <div class="secondary-badge-row">
                  <span class="secondary-category">{offer.data.category}</span>
                  <span class="secondary-location">{offer.data.location}</span>
                </div>
                <h4 class="secondary-title">
                  <a href={`/offers/${offer.slug}`}>{offer.data.title}</a>
                </h4>
                <p class="secondary-spec">{offer.data.specifications[0]}</p>
              </div>

              <div class="secondary-action-group">
                <span class="secondary-price">{publicPriceLabel(offer.data)}</span>
                <a href={`/offers/${offer.slug}`} class="secondary-link">
                  <span>View Offer</span>
                  <span class="link-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </article>
          ))}

          <div class="offers-all-link-wrap">
            <a href="/offers" class="offers-view-all">
              <span>View all active commercial offers</span>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
)}

<style>
  .section-offers {
    position: relative;
    background-color: #ffffff;
    padding: 72px 0 80px;
    border-bottom: 1px solid var(--border-color);
  }

  .offers-band {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
  }

  .offers-composition.is-single {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Clean Headline */
  .offers-header {
    max-width: 720px;
    margin-bottom: 48px;
  }
  .offers-kicker-row {
    margin-bottom: 8px;
  }
  .offers-chapter-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .offers-headline {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 14px;
  }
  .offers-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Asymmetric 1 Primary + 2 Secondary Composition */
  .offers-composition {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
  }
  @media (min-width: 960px) {
    .offers-composition {
      grid-template-columns: 1.25fr 1fr;
      gap: 52px;
      align-items: stretch;
    }
  }

  /* Primary Featured Opportunity */
  .featured-primary-card {
    padding: 0 0 34px;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
  }
  .primary-card-top {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .primary-kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }
  .primary-title {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .primary-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .primary-title a:hover {
    color: var(--accent-blue);
  }
  .primary-location {
    font-size: 0.88rem;
    color: #475569;
  }
  .primary-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 54ch;
  }

  /* Commit Term Selector (Phase 5) */
  .commit-term-box {
    background: #f8fafc;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .commit-term-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #64748b;
  }
  .commit-term-options {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .term-btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    padding: 5px 12px;
    border: 1px solid var(--border-color);
    background: #ffffff;
    color: var(--text-secondary);
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  .term-btn:hover {
    border-color: var(--accent-blue);
    color: var(--text-primary);
  }
  .term-btn.is-active {
    background: var(--accent-blue);
    color: #ffffff;
    border-color: var(--accent-blue);
  }
  .commit-note {
    font-size: 0.82rem;
    line-height: 1.45;
    color: #334155;
    margin: 2px 0 0;
  }

  .primary-specs-list {
    list-style: disc;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  /* Technical Specification Inspector (Phase 5) */
  .tech-spec-inspector {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .spec-tab-row {
    display: flex;
    background: #f1f5f9;
    border-bottom: 1px solid var(--border-color);
  }
  .spec-tab {
    flex: 1;
    padding: 8px 10px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    border: none;
    background: transparent;
    color: #64748b;
    cursor: pointer;
    text-align: center;
    border-right: 1px solid var(--border-color);
    transition: background-color 160ms ease, color 160ms ease;
  }
  .spec-tab:last-child {
    border-right: none;
  }
  .spec-tab:hover {
    color: var(--text-primary);
  }
  .spec-tab.is-active {
    background: #ffffff;
    color: var(--accent-blue);
    font-weight: 700;
  }
  .spec-detail-content {
    padding: 10px 14px;
    font-size: 0.82rem;
    line-height: 1.45;
    color: #1e293b;
    background: #ffffff;
  }

  .primary-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    margin-top: 8px;
  }
  .primary-price .price-figure {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  /* Secondary Commercial Rows */
  .secondary-offers-list {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }
  .secondary-offer-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: space-between;
    padding: 22px 0;
    border-bottom: 1px solid var(--border-color);
  }
  .secondary-meta {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .secondary-badge-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .secondary-category {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent-blue);
  }
  .secondary-location {
    font-size: 0.82rem;
    color: #475569;
  }
  .secondary-title {
    font-size: 1.18rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.4;
  }
  .secondary-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .secondary-title a:hover {
    color: var(--accent-blue);
  }
  .secondary-spec {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.5;
    max-width: 50ch;
  }
  .secondary-action-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    border-top: 1px solid var(--border-color);
  }
  .secondary-price {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .secondary-link:hover {
    color: var(--accent-blue-hover);
  }
  .link-arrow {
    transition: transform 160ms ease;
  }
  .secondary-link:hover .link-arrow,
  .offers-view-all:hover .link-arrow {
    transform: translateX(3px);
  }

  .offers-all-link-wrap {
    padding-top: 8px;
  }
  .offers-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms ease;
  }
  .offers-view-all:hover {
    color: var(--accent-blue);
  }

  @media (prefers-reduced-motion: reduce) {
    .term-btn,
    .spec-tab,
    .link-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initOfferInteractions() {
    // Commit term toggling
    const termBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.term-btn'));
    const noteEl = document.getElementById('allocationCommitNote');

    const termNotes: Record<string, string> = {
      '12': 'Flexible 95th percentile burstable commit · 14-day port activation SLA.',
      '24': 'Optimized baseline commit with bundled cross-connect · 7-day port activation SLA.',
      '36': 'Maximum unit bandwidth efficiency · Dedicated redundant port pair · 24/7 proactive NOC.'
    };

    termBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const term = btn.getAttribute('data-term') || '12';
        termBtns.forEach(b => {
          const isActive = b === btn;
          b.classList.toggle('is-active', isActive);
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        if (noteEl && termNotes[term]) {
          noteEl.textContent = termNotes[term];
        }
      });
    });

    // Technical spec tab toggling
    const specTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.spec-tab'));
    const detailEl = document.getElementById('specDetailView');

    const specDetails: Record<string, string> = {
      'routing': 'Dual 100Gbps LR4 optical interfaces with full BGP routing table support and FlowSpec DDoS diversion.',
      'handover': 'Meet-Me Room cross-connect inside Equinix FR5 (Frankfurt) or metro DWDM interconnect to Interxion FRA1-FRA16.',
      'sla': '99.99% availability SLA with sub-15ms European transit latency guarantee and 15-minute emergency NOC MTTR.'
    };

    specTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-spec-key') || 'routing';
        specTabs.forEach(t => {
          const isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        if (detailEl && specDetails[key]) {
          detailEl.textContent = specDetails[key];
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOfferInteractions);
  } else {
    initOfferInteractions();
  }
</script>
