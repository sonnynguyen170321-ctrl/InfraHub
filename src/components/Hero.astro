---
// src/components/Hero.astro
---

<section class="hero-section" id="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <img 
      src="/images/hero-datacenter.jpg" 
      alt="" 
      class="hero-bg-img"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="hero-scrim"></div>
    <div class="hero-grid-lines"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-meta-label">
        <span class="meta-tag">INFRASTRUCTURE SOURCING & ADVISORY</span>
        <span class="meta-sep">//</span>
        <span class="meta-status">INDEPENDENT ECOSYSTEM</span>
      </div>

      <h1 class="hero-title">
        The right infrastructure.<br />
        <span class="hero-title-accent">The right partner.</span>
      </h1>

      <p class="hero-description">
        InfraHub helps businesses evaluate infrastructure requirements and connect with specialist providers across networking, cloud, security, hardware and managed operations.
      </p>

      <div class="hero-actions">
        <a href="#solutions-ecosystem" class="btn btn-accent btn-lg">
          <span>Explore Solutions</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
        <a href="/lets-talk" class="btn btn-outline-light btn-lg">
          <span>Let's Talk</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Technical Editorial Telemetry Rail -->
    <div class="hero-telemetry" aria-hidden="true">
      <div class="telemetry-box">
        <div class="telemetry-header">
          <span class="telemetry-dot"></span>
          <span class="telemetry-title">SOURCING MATRIX</span>
        </div>
        <div class="telemetry-rows">
          <div class="telemetry-row">
            <span class="t-key">MODEL</span>
            <span class="t-val">Direct & Partner Delivered</span>
          </div>
          <div class="telemetry-row">
            <span class="t-key">CONNECTIVITY</span>
            <span class="t-val">10G – 400G Lit Optical / IP Transit</span>
          </div>
          <div class="telemetry-row">
            <span class="t-key">COMPUTE</span>
            <span class="t-val">Bare Metal / Private Cloud / AI</span>
          </div>
          <div class="telemetry-row">
            <span class="t-key">SECURITY</span>
            <span class="t-val">BGP FlowSpec / Scrubbing Centers</span>
          </div>
        </div>
        <div class="telemetry-footer">
          <span>CARRIER-NEUTRAL // INDEPENDENT EVALUATION</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 86vh;
    display: flex;
    align-items: center;
    background-color: #070b14;
    color: #ffffff;
    overflow: hidden;
    padding: 100px 0 80px;
  }

  /* Large Authentic Photography Backdrop */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: brightness(0.65) contrast(1.1);
    transform: scale(1.02);
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 40%, rgba(7, 11, 20, 0.4) 0%, rgba(7, 11, 20, 0.92) 80%),
                linear-gradient(180deg, rgba(7, 11, 20, 0.6) 0%, rgba(7, 11, 20, 0.95) 100%);
  }
  .hero-grid-lines {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at 35% 50%, black 20%, transparent 75%);
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.25fr 0.75fr;
      gap: 64px;
    }
  }

  .hero-content {
    max-width: 720px;
  }

  .hero-meta-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--accent-teal);
    margin-bottom: 24px;
    background: rgba(13, 148, 136, 0.1);
    border: 1px solid rgba(13, 148, 136, 0.3);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
  }
  .meta-sep {
    color: rgba(255, 255, 255, 0.3);
  }
  .meta-status {
    color: rgba(255, 255, 255, 0.7);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.2vw, 4.4rem);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin-bottom: 24px;
  }
  .hero-title-accent {
    color: #93c5fd;
    display: inline-block;
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 40px;
    max-width: 600px;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .btn-outline-light {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    padding: 13px 26px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition-fast);
  }
  .btn-outline-light:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
    color: #ffffff;
  }

  /* Telemetry Box */
  .hero-telemetry {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero-telemetry {
      display: block;
    }
  }

  .telemetry-box {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .telemetry-header {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: #94a3b8;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 16px;
  }
  .telemetry-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-teal);
    box-shadow: 0 0 8px var(--accent-teal);
  }

  .telemetry-rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .telemetry-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .t-key {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #64748b;
    letter-spacing: 0.08em;
  }
  .t-val {
    font-size: 0.88rem;
    color: #f1f5f9;
    font-weight: 500;
  }

  .telemetry-footer {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #64748b;
    letter-spacing: 0.05em;
  }
</style>
