---
// src/components/Hero.astro
---

<section class="section section-hero network-overlay">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrap">
        <span class="pill-badge badge-blue">
          <span class="pulse-dot"></span>
          Infrastructure Sourcing & Advisory
        </span>
      </div>

      <h1 class="hero-title">
        The right infrastructure.<br />
        <span class="gradient-text">The right partner.</span>
      </h1>

      <p class="hero-subhead">
        InfraHub helps businesses navigate infrastructure, cloud, connectivity, security, and managed operations by evaluating suitable technologies and connecting you with specialist providers.
      </p>

      <div class="hero-actions">
        <a href="#solutions-section" class="btn btn-primary btn-lg">
          <span>Explore Solutions</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
        <a href="/lets-talk" class="btn btn-secondary btn-lg">
          <span>Let's Talk</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="hero-highlights">
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Unbiased Provider Selection</span>
        </div>
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0d9488" stroke-width="2.2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Direct Contracting with Specialists</span>
        </div>
        <div class="highlight-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Zero Markups on Advisory</span>
        </div>
      </div>
    </div>

    <!-- Visual Infrastructure Card -->
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-card">
        <!-- SVG Technical Topology Canvas -->
        <svg class="topology-svg" viewBox="0 0 540 380" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Background Grid & Glow -->
          <rect width="540" height="380" rx="14" fill="#0B1120" />
          <circle cx="270" cy="190" r="140" fill="url(#core-glow)" opacity="0.25" />
          
          <!-- Route lines -->
          <path d="M70 190 H470" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" stroke-dasharray="4 4" />
          <path d="M270 50 V330" stroke="rgba(255,255,255,0.08)" stroke-width="1.5" stroke-dasharray="4 4" />
          
          <path d="M120 290 Q 200 130 270 190 T 420 100" stroke="#2563EB" stroke-width="2.5" fill="none" />
          <path d="M100 120 Q 240 260 370 200 T 450 280" stroke="#0D9488" stroke-width="2" stroke-dasharray="6 6" fill="none" />

          <!-- Network Core Nodes -->
          <g transform="translate(270, 190)">
            <circle r="36" fill="#0F172A" stroke="#2563EB" stroke-width="2" />
            <circle r="18" fill="rgba(37, 99, 235, 0.2)" />
            <circle r="6" fill="#2563EB" />
            <text y="50" text-anchor="middle" fill="#94A3B8" font-family="Outfit" font-size="11" font-weight="600">INFRAHUB ADVISORY</text>
          </g>

          <!-- Node 1: Transit -->
          <g transform="translate(120, 120)">
            <circle r="22" fill="#0F172A" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
            <circle r="4" fill="#0D9488" />
            <text y="34" text-anchor="middle" fill="#E2E8F0" font-family="Outfit" font-size="10" font-weight="500">Tier-1 Transit</text>
          </g>

          <!-- Node 2: Bare Metal -->
          <g transform="translate(420, 100)">
            <circle r="22" fill="#0F172A" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
            <circle r="4" fill="#2563EB" />
            <text y="34" text-anchor="middle" fill="#E2E8F0" font-family="Outfit" font-size="10" font-weight="500">Bare Metal & AI</text>
          </g>

          <!-- Node 3: DDoS & Sec -->
          <g transform="translate(120, 290)">
            <circle r="22" fill="#0F172A" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
            <circle r="4" fill="#0D9488" />
            <text y="34" text-anchor="middle" fill="#E2E8F0" font-family="Outfit" font-size="10" font-weight="500">DDoS Detection</text>
          </g>

          <!-- Node 4: 24/7 NOC -->
          <g transform="translate(420, 280)">
            <circle r="22" fill="#0F172A" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />
            <circle r="4" fill="#2563EB" />
            <text y="34" text-anchor="middle" fill="#E2E8F0" font-family="Outfit" font-size="10" font-weight="500">24/7 NOC</text>
          </g>

          <defs>
            <radialGradient id="core-glow" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0%" stop-color="#2563EB" />
              <stop offset="100%" stop-color="#0B1120" stop-opacity="0" />
            </radialGradient>
          </defs>
        </svg>

        <!-- Floating Metric Badges -->
        <div class="floating-badge badge-top">
          <span class="badge-dot"></span>
          <span>Ecosystem: 15+ Specialized Partners</span>
        </div>
        <div class="floating-badge badge-bottom">
          <span class="badge-icon">⚡</span>
          <span>Transparent Commercial Model</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1.15fr 1fr;
      gap: 64px;
    }
  }

  .hero-badge-wrap {
    margin-bottom: 20px;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: var(--accent-blue);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-blue);
  }

  .hero-title {
    font-size: clamp(2.4rem, 4.2vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 20px;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--accent-blue) 0%, #1e40af 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subhead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 36px;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 36px;
  }
  .btn-lg {
    padding: 14px 28px;
    font-size: 1rem;
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }
  .highlight-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* Visual */
  .hero-visual {
    position: relative;
  }
  .visual-card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: visible;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--border-color);
  }
  .topology-svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-xl);
  }

  .floating-badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background-color: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    color: #ffffff;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }
  .badge-top {
    top: 16px;
    left: 16px;
  }
  .badge-bottom {
    bottom: 16px;
    right: 16px;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-teal);
  }
</style>
