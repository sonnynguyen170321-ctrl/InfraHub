---
// src/components/Hero.astro
//
// Split composition: a copy column on solid ground, and a cinematic stage beside it.
//
// The previous hero was one full-bleed photograph with the headline sitting on top of it. That
// composition forced a compromise it could never win: the copy needed the image dark enough to
// read against, and the image needed to stay light enough to be worth looking at, so the frame
// was pulled in both directions and the "transformation" had nowhere to happen except as thin
// lines drawn over a picture that never changed. Reviewers saw exactly that - some blue lines
// over a data centre - which is the correct reading of what was there.
//
// The copy now sits on its own dark ground where contrast is a solved problem rather than a
// negotiated one, and the photograph moves into a dedicated stage that is free to change. The
// stage is what carries the story: a real facility that resolves into the architecture beneath
// it, rather than a static picture with an overlay.
//
// Stage layers, back to front:
//   .stage-physical      the facility as photographed  (state A)
//   .stage-architecture  the same frame as structure   (state B)
//   .stage-topology      nodes and routes the structure implies
//   .hero-scrim          local readability + depth, no longer smothering the whole frame
//   .hero-exit-veil      a small exposure drop on exit only
//
// The physical and architecture layers are the same room from the same camera, so the crossfade
// between them reads as understanding rather than as two unrelated pictures swapping over. That
// alignment is the whole effect; nothing else here matters as much.
import { Image } from 'astro:assets';
import physicalImage from '../assets/hero-physical.png';
import architectureImage from '../assets/hero-architecture.png';
---

<section class="hero-section" id="hero">
  <div class="hero-ground" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="technical-kicker hero-kicker">Architecture • Sourcing • Coordination</div>
      <h1 class="hero-title" aria-label="Complex infrastructure. One place to solve it.">
        <span class="hero-mask"><span class="hero-line hero-line-1">Complex infrastructure.</span></span>
        <span class="hero-mask"><span class="hero-line hero-line-2">One place to solve it.</span></span>
      </h1>

      <p class="hero-description">
        Bring us the requirement. We evaluate the technical options and coordinate the right path across network, compute, cloud, and security.
      </p>

      <div class="hero-actions">
        <a href="/lets-talk" class="btn btn-accent hero-primary-action">
          Start a Requirement
        </a>
        <a href="#what-you-need" class="hero-text-action">
          <span>Explore Solutions</span>
          <span class="action-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <div class="hero-stage" aria-hidden="true">
      <div class="stage-frame">
        <div class="stage-camera">
          <div class="stage-layer stage-physical">
            <Image
              src={physicalImage}
              alt=""
              class="hero-bg-img"
              loading="eager"
              fetchpriority="high"
              widths={[560, 840, 1120]}
              sizes="(max-width: 900px) 100vw, 48vw"
              quality={78}
              format="webp"
            />
          </div>

          <!--
            The same room, same camera, drawn as structure. Because the two plates share a
            vanishing point and rack rhythm, the crossfade reads as the facility being understood
            rather than as one picture replacing another. Lazy: it is not needed for first paint
            and must not compete with the LCP plate for bandwidth.
          -->
          <div class="stage-layer stage-architecture">
            <Image
              src={architectureImage}
              alt=""
              class="stage-architecture-img"
              loading="lazy"
              decoding="async"
              widths={[560, 840, 1120]}
              sizes="(max-width: 900px) 100vw, 48vw"
              quality={80}
              format="webp"
            />
          </div>
        </div>

        <!--
          The structure under the room. Drawn rather than photographed until the matched
          architecture plate is in place, and aligned to the same one-point perspective as the
          photograph so the two read as one frame resolving, not as a dissolve between pictures.
        -->
        <svg
          class="stage-topology"
          viewBox="0 0 700 760"
          preserveAspectRatio="xMidYMid slice"
          focusable="false"
        >
          <defs>
            <linearGradient id="stageResolve" gradientUnits="userSpaceOnUse" x1="350" y1="470" x2="350" y2="760">
              <stop offset="0%" stop-color="#2563eb" />
              <stop offset="30%" stop-color="#f8fafc" />
              <stop offset="72%" stop-color="#f8fafc" />
              <stop offset="100%" stop-color="#f8fafc" stop-opacity="0" />
            </linearGradient>
            <radialGradient id="stageHub">
              <stop offset="0%" stop-color="#2563eb" stop-opacity="0.55" />
              <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
            </radialGradient>
          </defs>

          <!-- The disciplines the racks actually carry, emerging where the equipment sat. -->
          <g class="stage-nodes">
            <circle class="stage-node" cx="150" cy="250" r="4" />
            <circle class="stage-node" cx="196" cy="378" r="4" />
            <circle class="stage-node" cx="168" cy="512" r="4" />
            <circle class="stage-node" cx="550" cy="250" r="4" />
            <circle class="stage-node" cx="504" cy="378" r="4" />
            <circle class="stage-node" cx="532" cy="512" r="4" />
          </g>

          <!-- Routes leaving those nodes and being coordinated at one point. -->
          <g class="stage-routes">
            <path class="stage-route" pathLength="1" d="M 150 250 C 250 300, 300 380, 344 462" />
            <path class="stage-route" pathLength="1" d="M 196 378 C 268 400, 312 430, 348 462" />
            <path class="stage-route" pathLength="1" d="M 168 512 C 250 500, 306 478, 346 468" />
            <path class="stage-route" pathLength="1" d="M 550 250 C 450 300, 400 380, 356 462" />
            <path class="stage-route" pathLength="1" d="M 504 378 C 432 400, 388 430, 352 462" />
            <path class="stage-route" pathLength="1" d="M 532 512 C 450 500, 394 478, 354 468" />
          </g>

          <circle class="stage-hub-halo" cx="350" cy="466" r="62" fill="url(#stageHub)" />
          <rect class="stage-hub" x="308" y="462" width="84" height="6" rx="3" />
          <path class="stage-resolved" pathLength="1" d="M 350 476 L 350 760" />
        </svg>

        <div class="hero-scrim"></div>
        <div class="hero-exit-veil"></div>
        <div class="stage-edge"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    /*
     * Unchanged from the composition that preceded this one, and deliberately so: the partner
     * band has to stay whole above the fold at every viewport height the suite checks, and that
     * is a function of this number. The composition inside the hero changed; its footprint on
     * the first screen did not.
     */
    min-height: min(calc(100dvh - var(--header-height) - 100px), 1100px);
    display: flex;
    align-items: center;
    background-color: #070c14;
    color: #ffffff;
    overflow: hidden;
    padding: clamp(40px, 4.5vh, 60px) 0 clamp(38px, 4.5vh, 56px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* A quiet gradient on the copy side so the column has depth without needing the photograph. */
  .hero-ground {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 18% 30%, rgba(37, 84, 199, 0.14) 0%, transparent 55%),
      linear-gradient(180deg, #070c14 0%, #080e18 60%, #070c14 100%);
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1300px;
    width: 100%;
    display: grid;
    /*
     * The copy takes the smaller half. Giving the stage the larger share is the point of the
     * whole change: the visual needs room to be a place rather than a backdrop.
     */
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .hero-content {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    transform: translateY(calc(var(--hero-progress, 0) * -24px));
    opacity: calc(max(0, 1 - var(--hero-progress, 0) * 1.5));
    will-change: transform, opacity;
  }

  .hero-kicker {
    margin-bottom: -8px;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    color: var(--color-sky);
  }

  .hero-title {
    /*
     * Measured: "Complex infrastructure." occupies about 10.4x the font size, and the copy
     * column resolves to roughly 565px at 1440. Anything above ~54px wraps it, which is what
     * 3.9vw did. The cap is set from that measurement rather than from taste.
     */
    font-size: clamp(2.3rem, 3.5vw, 3.4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0;
    text-wrap: balance;
  }

  .hero-mask {
    display: block;
    overflow: hidden;
  }

  /*
   * The hierarchy is legible from first paint, then settles quickly. Earlier 380-840ms delays
   * left the value proposition absent from real first-frame captures.
   */
  .hero-line {
    display: block;
    transform: translateY(18%);
    opacity: 0.72;
    animation: heroLineReveal 420ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-line-1 {
    animation-delay: 40ms;
  }

  .hero-line-2 {
    color: #e8ecea;
    animation-delay: 100ms;
  }

  @keyframes heroLineReveal {
    0% {
      transform: translateY(18%);
      opacity: 0.72;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-description {
    font-size: clamp(1.02rem, 1.15vw, 1.15rem);
    line-height: 1.62;
    color: #cfd6dc;
    max-width: 46ch;
    opacity: 0.72;
    transform: translateY(8px);
    animation: heroFadeUp 420ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin-top: 10px;
    opacity: 0.72;
    transform: translateY(8px);
    animation: heroFadeUp 380ms cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
  }

  @keyframes heroFadeUp {
    0% {
      opacity: 0.72;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-primary-action {
    background-color: #2450bd;
    padding: 15px 26px;
    border-radius: 4px;
    font-size: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    transition: background-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
                border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-primary-action:hover {
    background-color: #2d5cd6;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .hero-primary-action:active {
    transform: scale(0.99);
  }

  .hero-text-action {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 8px;
    color: rgba(232, 236, 234, 0.85);
    font-size: 1.02rem;
    font-weight: 600;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
    transition: color 180ms cubic-bezier(0.22, 1, 0.36, 1), border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-text-action:hover {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.55);
  }
  .action-arrow {
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    display: inline-block;
  }
  .hero-text-action:hover .action-arrow {
    transform: translateX(4px);
  }

  /* ------------------------------------------------------------------ the stage */

  .hero-stage {
    position: relative;
    /*
     * Taller than it is wide. The plate is a corridor shot in portrait, and the aspect is what
     * makes it read as somewhere you could walk rather than a banner behind text.
     */
    aspect-ratio: 92 / 100;
    /*
     * The stage is capped, not free. Left to its aspect ratio it drove the section to 794px at
     * 1440x900 and pushed the partner band off the first screen - the one thing the hero's
     * footprint is not allowed to do. The cap subtracts the header, the reveal beneath the band
     * and this section's own padding, so the aspect ratio yields before the contract does.
     */
    max-height: min(calc(100dvh - var(--header-height) - 220px), 640px);
    align-self: center;
    justify-self: end;
    width: 100%;
  }

  .stage-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 3px;
    background-color: #05080f;
    /*
     * The stage reads as an aperture onto the facility rather than a floating card: one hairline,
     * no drop shadow, no lift on hover. It is architecture, not a UI panel.
     */
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.07);
  }

  /*
   * The camera moves; the layers inside it do not move independently. One transform, so the
   * photograph and the structure drawn over it stay locked to each other at every scroll offset.
   */
  .stage-camera {
    position: absolute;
    inset: 0;
    transform:
      scale(calc(1 + var(--hero-progress, 0) * 0.06))
      translate3d(
        calc(var(--hero-pointer-x, 0px)),
        calc(var(--hero-pointer-y, 0px) + var(--hero-progress, 0) * -10px),
        0
      );
    transition: transform 220ms var(--ease-out);
    will-change: transform;
  }

  .stage-layer {
    position: absolute;
    inset: 0;
  }

  /*
   * Gates are declared on the frame rather than the svg, because the architecture plate and the
   * topology drawn over it have to advance on exactly the same numbers.
   */
  .stage-frame {
    --p: var(--hero-progress, 0);
    --structure: min(1, max(0, calc((var(--p) - 0.04) / 0.24)));
    --nodes: min(1, max(0, calc((var(--p) - 0.16) / 0.2)));
    --routes: min(1, max(0, calc((var(--p) - 0.26) / 0.2)));
    --resolve: min(1, max(0, calc((var(--p) - 0.36) / 0.2)));
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    /*
     * Exposure is held where the facility is actually legible. The suite samples this frame for
     * luminance spread, so a scrim that flattens it fails a test as well as the composition.
     */
    filter: brightness(0.92) contrast(1.06) saturate(0.94);
    animation: heroAwaken 1150ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes heroAwaken {
    0% {
      filter: brightness(0.72) contrast(1) saturate(0.9);
      transform: scale(1.02);
    }
    100% {
      filter: brightness(0.92) contrast(1.06) saturate(0.94);
      transform: scale(1);
    }
  }

  /*
   * Stage gates. The hero holds states A and B; the deeper transformation runs in the pinned
   * chapter that follows, because --hero-progress only reaches 1 once the hero has travelled its
   * own height and the frame is long gone by then. Compressing the whole story in here is the
   * mistake the previous version made.
   */
  .stage-topology {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
  }

  /*
   * The architecture plate, crossfaded over the photograph on the same gate the structure used
   * to be drawn on. This is the transformation: a photographed room becoming a drawn one, in
   * place, without the camera moving. Hand-drawn rack outlines used to live here and were
   * removed - the plate carries the room's real geometry, and two versions of the same lines
   * fighting each other looked like neither.
   */
  .stage-architecture-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
    opacity: var(--structure);
    filter: brightness(1.05) saturate(1.05);
  }

  .stage-node {
    fill: var(--color-sky);
    opacity: calc(var(--nodes) * 0.85);
  }

  .stage-route {
    fill: none;
    stroke: var(--color-sky);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--routes));
    opacity: calc(var(--routes) * 0.7);
  }

  /* The only cobalt in the frame: the coordination decision. */
  .stage-hub-halo {
    opacity: calc(var(--resolve) * 0.9);
  }

  .stage-hub {
    fill: var(--color-cobalt);
    opacity: calc(var(--resolve) * 0.95);
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleX(calc(0.3 + var(--resolve) * 0.7));
  }

  .stage-resolved {
    fill: none;
    stroke: url(#stageResolve);
    stroke-width: 2.5;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--resolve));
    opacity: var(--resolve);
  }

  /*
   * Local, not global. It lands the bottom of the frame and lifts the corridor a little; it is
   * no longer doing the job of making white text readable, because the text is not on it.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 42%, rgba(120, 170, 220, 0.1) 0%, transparent 62%),
      linear-gradient(180deg, rgba(7, 12, 20, 0.34) 0%, rgba(7, 12, 20, 0) 26%, rgba(7, 12, 20, 0.12) 68%, rgba(7, 12, 20, 0.6) 100%);
  }

  .hero-exit-veil {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background-color: #070c14;
    opacity: calc((var(--hero-progress, 0) - 0.65) / 3.5);
  }

  .stage-edge {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    box-shadow: inset 0 0 90px 10px rgba(5, 8, 15, 0.55);
  }

  /* ------------------------------------------------------------------ tablet */

  @media (max-width: 1080px) {
    .hero-container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: clamp(24px, 3.5vw, 44px);
    }
    .hero-title {
      font-size: clamp(2.1rem, 4.2vw, 3rem);
    }
  }

  /* ------------------------------------------------------------------ mobile */

  /*
   * Mobile is its own composition, not the desktop grid folded in half. The stage becomes a wide
   * band beneath the copy: the corridor still reads, the headline is never pushed below the fold
   * by it, and the transformation runs shorter because there is less travel to spend.
   */
  @media (max-width: 900px) {
    .hero-section {
      min-height: auto;
      padding: 72px 0 56px;
    }

    .hero-container {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    .hero-content {
      max-width: none;
    }

    .hero-title {
      font-size: clamp(1.9rem, 8.2vw, 2.6rem);
    }

    .hero-description {
      max-width: none;
      font-size: 1.02rem;
    }

    .hero-stage {
      aspect-ratio: 132 / 100;
      max-height: 52vh;
      justify-self: stretch;
    }

    .stage-frame {
      --structure: min(1, max(0, calc((var(--p) - 0.02) / 0.16)));
      --nodes: min(1, max(0, calc((var(--p) - 0.1) / 0.14)));
      --routes: min(1, max(0, calc((var(--p) - 0.18) / 0.14)));
      --resolve: min(1, max(0, calc((var(--p) - 0.26) / 0.16)));
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .stage-edge {
      box-shadow: inset 0 0 60px 6px rgba(5, 8, 15, 0.5);
    }
  }

  /* ------------------------------------------------------------------ reduced motion */

  /*
   * A designed state, not an absence. initHeroScroll returns early under reduced motion so
   * --hero-progress is never written; without pinning the gates here the stage would sit at
   * state A forever and these visitors would simply never be shown the idea. They get the
   * resolved architecture immediately and statically instead.
   */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-img {
      animation: none;
      filter: brightness(0.92) contrast(1.06) saturate(0.94);
      transform: none;
    }
    .stage-camera {
      transform: none;
      transition: none;
      will-change: auto;
    }
    .hero-line,
    .hero-description,
    .hero-actions {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .hero-content {
      transform: none;
      opacity: 1;
      will-change: auto;
    }
    .stage-frame {
      --structure: 1;
      --nodes: 1;
      --routes: 1;
      --resolve: 1;
    }
    .stage-hub {
      transform: none;
    }
  }
</style>

<script>
  import { homepageScheduler } from '../scripts/homepage-scheduler';

  /**
   * The hero writes one number. Everything the scroll drives - the stage camera, the structure
   * emerging, the routes resolving, the content exit - is expressed in CSS against
   * --hero-progress, so there is one source of truth and no second scroll pipeline.
   */
  function initHeroScroll() {
    const heroSection = document.getElementById('hero');
    if (!heroSection) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const heroProgress = () => {
      const heroHeight = heroSection.offsetHeight || 1;
      return Math.min(Math.max(window.scrollY / heroHeight, 0), 1);
    };

    const scheduler = homepageScheduler();
    scheduler.registerProgressSource('hero', heroProgress);
    scheduler.onFrame((frame) => {
      if (frame.reducedMotion) return;
      heroSection.style.setProperty('--hero-progress', heroProgress().toFixed(4));
    });
  }

  /**
   * A few pixels of parallax on the stage, so the frame feels like a window onto a room rather
   * than a flat plate. Finishing detail only: never on touch, coarse pointers, narrow viewports
   * or reduced motion.
   */
  function initHeroPointerDepth() {
    const heroSection = document.getElementById('hero');
    if (!heroSection) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches) return;

    let ticking = false;
    let pointerX = 0;
    let pointerY = 0;

    const write = () => {
      heroSection.style.setProperty('--hero-pointer-x', `${pointerX.toFixed(2)}px`);
      heroSection.style.setProperty('--hero-pointer-y', `${pointerY.toFixed(2)}px`);
      ticking = false;
    };

    heroSection.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        const rect = heroSection.getBoundingClientRect();
        pointerX = ((event.clientX - rect.left) / rect.width - 0.5) * -8;
        pointerY = ((event.clientY - rect.top) / rect.height - 0.5) * -5;
        if (!ticking) {
          window.requestAnimationFrame(write);
          ticking = true;
        }
      },
      { passive: true }
    );

    heroSection.addEventListener(
      'pointerleave',
      () => {
        pointerX = 0;
        pointerY = 0;
        write();
      },
      { passive: true }
    );
  }

  function initHero() {
    initHeroScroll();
    initHeroPointerDepth();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
