---
// src/components/Hero.astro
---

<section class="hero-section" id="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <img 
      src="/images/hero-datacenter.jpg" 
      alt="" 
      class="hero-bg-img"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="hero-scrim"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        The right infrastructure.<br />
        <span class="hero-title-accent">The right partner.</span>
      </h1>

      <p class="hero-description">
        InfraHub helps businesses evaluate infrastructure requirements and connect with specialist providers across networking, cloud, security, hardware and managed operations.
      </p>

      <div class="hero-actions">
        <a href="#solutions-ecosystem" class="btn btn-accent btn-lg">
          Explore Solutions
        </a>
        <a href="/lets-talk" class="hero-text-action">
          <span>Tell us what you're building</span>
          <span class="action-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 68dvh;
    max-height: 720px;
    display: flex;
    align-items: center;
    background-color: #070b14;
    color: #ffffff;
    overflow: hidden;
    padding: 96px 0 88px;
  }

  /* Authentic Photography Backdrop */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: brightness(0.65) contrast(1.1);
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(7, 11, 20, 0.94) 0%,
      rgba(7, 11, 20, 0.85) 45%,
      rgba(7, 11, 20, 0.65) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
  }

  .hero-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-title {
    font-size: clamp(2.6rem, 5.2vw, 4.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #ffffff;
  }
  .hero-title-accent {
    color: #e2e8f0;
  }

  .hero-description {
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.65;
    color: #cbd5e1;
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    margin-top: 16px;
  }

  /* Quiet, confident secondary text action */
  .hero-text-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e2e8f0;
    font-size: 1.02rem;
    font-weight: 600;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .hero-text-action:hover {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.6);
  }
  .action-arrow {
    transition: transform 160ms ease;
    display: inline-block;
  }
  .hero-text-action:hover .action-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
      padding: 88px 0 56px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>
