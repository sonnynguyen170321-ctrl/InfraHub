---
// src/components/Hero.astro
---

<section class="hero-section" id="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <img 
      src="/images/hero-datacenter.jpg" 
      alt="" 
      class="hero-bg-img"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="hero-scrim"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title" aria-label="The right infrastructure. The right partner.">
        <span class="hero-mask"><span class="hero-line hero-line-1">The right infrastructure.</span></span>
        <span class="hero-mask"><span class="hero-line hero-line-2">The right partner.</span></span>
      </h1>

      <p class="hero-description">
        InfraHub helps businesses evaluate infrastructure requirements and connect with specialist providers across networking, cloud, security, hardware and managed operations.
      </p>

      <div class="hero-actions">
        <a href="#solutions-ecosystem" class="btn btn-accent btn-lg">
          Explore Solutions
        </a>
        <a href="/lets-talk" class="hero-text-action">
          <span>Tell us what you're building</span>
          <span class="action-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Central Infrastructure Routing Line Exit (Directive 2, 3, 6) -->
  <div class="hero-routing-exit" aria-hidden="true">
    <div class="routing-line-stem"></div>
    <div class="routing-line-junction"></div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 68dvh;
    max-height: 720px;
    display: flex;
    align-items: center;
    background-color: #070b14;
    color: #ffffff;
    overflow: hidden;
    padding: 96px 0 88px;
  }

  /* Authentic Photography Backdrop */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: brightness(0.65) contrast(1.1);
    transform: scale(1);
    transition: transform 600ms cubic-bezier(0.23, 1, 0.32, 1), filter 600ms ease;
    will-change: transform;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(7, 11, 20, 0.94) 0%,
      rgba(7, 11, 20, 0.85) 45%,
      rgba(7, 11, 20, 0.65) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    will-change: transform, opacity;
  }

  .hero-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Vertical Mask Revealing (Directive 6: Line-by-line independent reveals) */
  .hero-title {
    font-size: clamp(2.6rem, 5.2vw, 4.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0;
  }

  .hero-mask {
    display: block;
    overflow: hidden;
  }

  .hero-line {
    display: block;
    transform: translateY(100%);
    opacity: 0;
    animation: heroLineReveal var(--motion-content) var(--ease-out) forwards;
  }

  .hero-line-1 {
    animation-delay: 40ms;
  }

  .hero-line-2 {
    color: #e2e8f0;
    animation-delay: 180ms;
  }

  @keyframes heroLineReveal {
    0% {
      transform: translateY(100%);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-description {
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.65;
    color: #cbd5e1;
    max-width: 700px;
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeUp var(--motion-content) var(--ease-out) 320ms forwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    margin-top: 16px;
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeUp var(--motion-content) var(--ease-out) 460ms forwards;
  }

  @keyframes heroFadeUp {
    0% {
      opacity: 0;
      transform: translateY(16px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Quiet, confident secondary text action */
  .hero-text-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #e2e8f0;
    font-size: 1.02rem;
    font-weight: 600;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }
  .hero-text-action:hover {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.6);
  }
  .action-arrow {
    transition: transform 160ms ease;
    display: inline-block;
  }
  .hero-text-action:hover .action-arrow {
    transform: translateX(3px);
  }

  /* Infrastructure Route Line Exit (Directive 6: Routing line emerges from bottom edge) */
  .hero-routing-exit {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 38px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .routing-line-stem {
    width: 1.5px;
    height: 100%;
    background: linear-gradient(to bottom, rgba(40, 84, 199, 0), var(--accent-blue));
  }

  .routing-line-junction {
    width: 5px;
    height: 5px;
    background-color: var(--accent-blue);
    border-radius: 50%;
    margin-top: -2px;
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
      padding: 88px 0 56px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line,
    .hero-description,
    .hero-actions {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  // Hero Scroll Camera Push & Exit Transition (Directive 6)
  function initHeroScroll() {
    const heroBg = document.querySelector('.hero-bg-img') as HTMLElement;
    const heroContainer = document.querySelector('.hero-container') as HTMLElement;
    const heroSection = document.getElementById('hero');
    const heroScrim = document.querySelector('.hero-scrim') as HTMLElement;

    if (!heroBg || !heroContainer || !heroSection || !heroScrim) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const heroHeight = heroSection.offsetHeight;
          if (scrollY <= heroHeight) {
            const progress = Math.min(scrollY / heroHeight, 1);
            // Camera push 1.00 -> 1.035
            const scale = 1.0 + progress * 0.035;
            heroBg.style.transform = `scale(${scale.toFixed(4)})`;
            // Headline rises slightly (20-30px) and fades smoothly
            heroContainer.style.transform = `translateY(-${(progress * 28).toFixed(1)}px)`;
            heroContainer.style.opacity = `${(1 - progress * 0.6).toFixed(2)}`;
            // The photograph recedes rather than simply scrolling away.
            heroScrim.style.opacity = `${(1 + progress * 0.45).toFixed(2)}`;
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroScroll);
  } else {
    initHeroScroll();
  }
</script>
