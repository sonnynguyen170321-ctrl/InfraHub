---
// src/components/Hero.astro
---

<section class="hero-section" id="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <img 
      src="/images/hero-datacenter.jpg" 
      alt="" 
      class="hero-bg-img"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <div class="hero-scrim"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrap">
        <span class="hero-kicker">INFRASTRUCTURE SOURCING & ADVISORY</span>
      </div>

      <h1 class="hero-title">
        The right infrastructure.<br />
        <span class="hero-title-accent">The right partner.</span>
      </h1>

      <p class="hero-description">
        InfraHub helps businesses understand infrastructure requirements, evaluate suitable approaches and connect with specialist providers across infrastructure, cloud, connectivity, security and managed operations.
      </p>

      <div class="hero-actions">
        <a href="#solutions-ecosystem" class="btn btn-accent btn-lg">
          <span>Explore Solutions</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
        <a href="/lets-talk" class="btn btn-outline-light btn-lg">
          <span>Tell Us What You're Building</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    background-color: #070b14;
    color: #ffffff;
    overflow: hidden;
    padding: 120px 0 96px;
  }

  /* Authentic Photography Backdrop */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: brightness(0.65) contrast(1.1);
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(7, 11, 20, 0.94) 0%,
      rgba(7, 11, 20, 0.85) 45%,
      rgba(7, 11, 20, 0.65) 100%
    );
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
  }

  .hero-content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
  }
  .hero-kicker {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent-teal);
    text-transform: uppercase;
  }

  .hero-title {
    font-size: clamp(2.8rem, 5.5vw, 4.4rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #ffffff;
  }
  .hero-title-accent {
    color: #93c5fd;
  }

  .hero-description {
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 720px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 12px;
  }

  .btn-outline-light {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    padding: 13px 24px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    transition: var(--transition-fast);
  }
  .btn-outline-light:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
      padding: 96px 0 64px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .btn-outline-light,
    .btn-accent {
      justify-content: center;
    }
  }
</style>
