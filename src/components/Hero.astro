---
// src/components/Hero.astro
//
// The hero photograph is the LCP element of the site. It goes through astro:assets so the
// build emits sized, modern-format variants and a srcset, rather than shipping one 1920px
// JPEG to every device.
//
// Lighting model. The photograph used to be darkened twice — brightness(0.65) on the image
// AND a 94%→65% black scrim over it — which flattened a genuinely detailed facility into an
// unreadable dark rectangle. It is now lit locally instead of uniformly: the left third is
// held dark enough to carry the copy, and the right two thirds are left open so the racks,
// cable trays and aisle depth are actually visible. Exposure and scrim were chosen from
// screenshot comparisons at three settings, not from taste alone.
//
// Layer order inside the backdrop, bottom to top:
//   .hero-camera      scroll + pointer transform (the only moving layer)
//     .hero-bg-img    the photograph, carrying the one-time exposure reveal
//   .hero-scrim       localized readability + depth gradients
//   .hero-light-field restrained radial lift around the rack architecture
//   .hero-exit-veil   a 10% exposure drop, applied only in the last third of the exit
//
// The bottom of the frame is landed by one gradient shelf. A canvas used to draw an
// "Architectural Partner Plane" and a route spline here; both were removed because they
// carried no information. An earlier CSS gradient in this stack did the same job with an
// invalid transform (a unitless 0 mixed with a deg value inside max()), so it never
// animated and washed out the bottom of the photograph at every scroll position.
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-datacenter.jpg';
---

<section class="hero-section" id="hero">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-camera">
      <div class="hero-pointer">
        <Image
          src={heroImage}
          alt=""
          class="hero-bg-img"
          loading="eager"
          fetchpriority="high"
          widths={[640, 960, 1376]}
          sizes="100vw"
          quality={76}
          format="webp"
        />
      </div>
    </div>
    <div class="hero-scrim"></div>
    <div class="hero-light-field"></div>
    <div class="hero-exit-veil"></div>

    <!--
      The Living Infrastructure Lens, scene 0 -> 1.

      The photograph is the physical infrastructure; this is the architecture underneath it
      resolving as the visitor scrolls. The geometry is the InfraHub mark at page scale, not a
      new invention: two routes descending, a junction where they are coordinated, one route
      continuing out of the frame. The hero comment above records that an earlier decorative
      spline was removed because it carried no information. This one carries the business model.

      It occupies the right half of the frame only, clear of the copy column, so the directive's
      preference for a lens beside the content is met without giving up the measured scrim that
      holds the headline at AA.

      Every stage is a pure function of --hero-progress. No JS beyond the one number the hero
      already publishes to the scheduler, and no animation that runs because time passed.
    -->
    <svg
      class="hero-lens"
      viewBox="0 0 1000 620"
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <!-- The resolved route dissolves rather than stopping, so the handoff reads as continuing. -->
        <!--
          userSpaceOnUse, not the objectBoundingBox default. The resolved route is a perfectly
          vertical line, so its bounding box is zero-width and a bounding-box gradient on it is
          degenerate - the stroke renders faint or not at all depending on the engine. Explicit
          user-space coordinates are the only reliable way to gradient a straight line.
        -->
        <linearGradient
          id="lensResolvedFade"
          gradientUnits="userSpaceOnUse"
          x1="764" y1="392" x2="764" y2="620"
        >
          <stop offset="0%" stop-color="#2563eb" />
          <stop offset="18%" stop-color="#f8fafc" />
          <stop offset="62%" stop-color="#f8fafc" />
          <stop offset="100%" stop-color="#f8fafc" stop-opacity="0" />
        </linearGradient>
        <radialGradient id="lensJunctionHalo">
          <stop offset="0%" stop-color="#2563eb" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
        </radialGradient>
      </defs>

      <!--
        Five routes, not two: these are the disciplines the site actually sells - network,
        compute, cloud, security, operations - arriving from different parts of the facility and
        being coordinated at one point. The mark's two-leg geometry is the idea; five is the
        truth of the business. They are equally weighted, because none of them outranks another.
      -->
      <g class="lens-legs">
        <path class="lens-leg" pathLength="1" d="M 542 96 C 626 128, 676 258, 748 368" />
        <path class="lens-leg" pathLength="1" d="M 648 72 C 700 140, 720 268, 754 368" />
        <path class="lens-leg" pathLength="1" d="M 792 66 C 788 150, 772 272, 764 368" />
        <path class="lens-leg" pathLength="1" d="M 918 84 C 872 148, 812 268, 772 368" />
        <path class="lens-leg" pathLength="1" d="M 992 128 C 926 176, 828 282, 780 368" />
      </g>

      <g class="lens-nodes">
        <circle class="lens-node" cx="614" cy="152" r="3" />
        <circle class="lens-node" cx="690" cy="176" r="3" />
        <circle class="lens-node" cx="788" cy="152" r="3" />
        <circle class="lens-node" cx="886" cy="168" r="3" />
        <circle class="lens-node" cx="946" cy="196" r="3" />
      </g>

      <circle class="lens-halo" cx="764" cy="378" r="54" fill="url(#lensJunctionHalo)" />
      <rect class="lens-junction" x="726" y="374" width="76" height="5" rx="2.5" />
      <path class="lens-resolved" pathLength="1" d="M 764 392 L 764 620" />
    </svg>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="technical-kicker hero-kicker">Architecture • Sourcing • Coordination</div>
      <h1 class="hero-title" aria-label="Complex infrastructure. One place to solve it.">
        <span class="hero-mask"><span class="hero-line hero-line-1">Complex infrastructure.</span></span>
        <span class="hero-mask"><span class="hero-line hero-line-2">One place to solve it.</span></span>
      </h1>

      <p class="hero-description">
        Bring us the requirement. We evaluate the technical options and coordinate the right path across network, compute, cloud, and security.
      </p>

      <div class="hero-actions">
        <a href="/lets-talk" class="btn btn-accent hero-primary-action">
          Start a Requirement
        </a>
        <a href="#what-you-need" class="hero-text-action">
          <span>Explore Solutions</span>
          <span class="action-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!--
    The photograph is grounded into the partner ribbon by a single gradient shelf. A
    decorative route spline and its canvas used to sit here; both were removed because
    they carried no information (master plan sections 20, 21, 32). The signature
    identity motion is authored in Phase 7, from geometry the identity actually owns.
  -->
  <div class="hero-base-shelf hero-routing-exit" aria-hidden="true">
    <div class="hero-bottom-shelf"></div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    /*
     * min-height beats max-height in CSS, so the two cannot simply be stated side by side:
     * at 1080px tall, 76dvh is 821px and a max-height of 780px would never apply.
     *
     * The height is expressed as "the viewport, less the header, less what should show beneath"
     * rather than as a share of the viewport, because a share does not hold what matters
     * constant. At 76dvh capped to 780px the gap under the hero measured 220px at 1080, 136px at
     * 900 and 104px at 768: the partner band is 84px, so the tall displays were showing it plus
     * up to 136px of bare paper — the empty band the first screen is meant to avoid. Cutting the
     * hero toward 72dvh widens that gap rather than closing it.
     *
     * 100px leaves the whole band plus roughly 16px of the ground beneath it at every size, so
     * the ecosystem is proven above the fold and the next section is only hinted at. The cap
     * matters above ~1180px of viewport height, where the subtraction would otherwise let the
     * photograph grow without limit.
     */
    min-height: min(calc(100dvh - var(--header-height) - 100px), 1100px);
    display: flex;
    align-items: center;
    background-color: #070c14;
    color: #ffffff;
    overflow: hidden;
    padding: clamp(72px, 8vh, 96px) 0 clamp(64px, 7vh, 88px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  /*
   * The camera is a separate layer from the photograph because the two move for different
   * reasons: the image carries the one-time exposure reveal, the camera carries the scroll
   * push and the pointer offset. Putting both on one element means one transform overwriting
   * the other, which is what the previous inline-style approach did.
   */
  .hero-camera {
    position: absolute;
    inset: 0;
    transform:
      scale(calc(1 + var(--hero-progress, 0) * 0.045))
      translate3d(
        calc(var(--hero-progress, 0) * -5px),
        calc(var(--hero-progress, 0) * -8px),
        0
      );
    will-change: transform;
  }

  /*
   * The pointer offset is a separate layer because the two transforms want opposite
   * things. Scroll is written every animation frame and has to land on the frame it was
   * written for; a transition on that same element makes the camera lag the scroll, which
   * reads as viscous. The pointer is an occasional, tiny offset and does want smoothing.
   */
  .hero-pointer {
    position: absolute;
    inset: 0;
    transform: translate3d(var(--hero-pointer-x, 0px), var(--hero-pointer-y, 0px), 0);
    transition: transform 220ms var(--ease-out);
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
     * At desktop widths the hero box is wider than the photograph's 1.79 aspect ratio, so
     * object-fit crops vertically and the horizontal half of this value has no effect there.
     * It is decisive on mobile, where the crop is horizontal — see the 768px block.
     */
    object-position: center 42%;
    filter: brightness(0.92) contrast(1.06) saturate(0.92);
    animation: heroAwaken 1150ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /*
   * The eye adapting to a real technical environment: the facility starts slightly closed
   * down and opens to its final exposure. One time, no loop, no flash.
   */
  @keyframes heroAwaken {
    0% {
      filter: brightness(0.72) contrast(1) saturate(0.9);
      transform: scale(1.018);
    }
    100% {
      filter: brightness(0.92) contrast(1.06) saturate(0.92);
      transform: scale(1);
    }
  }

  /*
   * Layer A is the left-side readability gradient, layer B the bottom atmospheric settle.
   * The relationship that matters is left dark enough for copy, right open enough to inspect.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      /*
       * The copy column reaches to roughly 46% of the frame, and that stop is what carries it.
       * A taller hero re-crops the photograph behind the text and the revised description
       * rewraps across different pixels, which took the first description line to 4.37:1 —
       * under the 4.5:1 AA floor. Raised only where the copy sits; the open right-hand side is
       * untouched so the facility stays visible.
       */
      linear-gradient(
        90deg,
        rgba(7, 12, 20, 0.86) 0%,
        rgba(7, 12, 20, 0.78) 26%,
        rgba(7, 12, 20, 0.54) 46%,
        rgba(7, 12, 20, 0.16) 68%,
        rgba(7, 12, 20, 0.02) 100%
      ),
      linear-gradient(
        180deg,
        rgba(7, 12, 20, 0.1) 0%,
        rgba(7, 12, 20, 0) 44%,
        rgba(7, 12, 20, 0.16) 80%,
        rgba(7, 12, 20, 0.3) 100%
      );
  }

  /* Dimension around the rack architecture. If this ever reads as a blue glow, it is too strong. */
  .hero-light-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 76% 44%,
      rgba(67, 112, 160, 0.13) 0%,
      rgba(40, 84, 199, 0.045) 28%,
      transparent 58%
    );
  }

  /*
   * Exposure drops only in the last third of the exit, so the photograph stays worth looking
   * at while the visitor is still leaving it. Negative opacity clamps to 0 on its own.
   */
  .hero-exit-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-color: #070c14;
    opacity: calc((var(--hero-progress, 0) - 0.65) / 3.5);
  }

  /*
   * The lens sits above the exit veil on purpose. As the visitor leaves, the photograph loses
   * exposure but the architecture stays legible - the physical fades and the understood system
   * remains, which is the whole point of the sequence.
   */
  .hero-lens {
    position: absolute;
    inset: 0;
    z-index: 9;
    width: 100%;
    height: 100%;
    pointer-events: none;

    /*
     * Stage gates. min/max rather than clamp() because the arguments are unitless numbers and
     * min/max has the wider engine support for that case. Each stage overlaps the next so the
     * sequence reads as one continuous resolve rather than four separate events.
     *
     * The gates are compressed into the first 44% of hero travel, and that is deliberate.
     * --hero-progress is scrollY / heroHeight, so it only reaches 1 once the hero has travelled
     * its own height - by which point a 720px hero in a 900px viewport has been off screen for
     * a long time. An earlier version of this ran the junction at 0.56 and the resolve at 0.72,
     * and screenshots showed both stages completing after the visitor could no longer see the
     * hero at all: the sequence existed, and nobody would ever have watched it finish. The
     * whole resolve now lands while the frame still holds most of the viewport.
     */
    --p: var(--hero-progress, 0);
    --draw: min(1, max(0, calc((var(--p) - 0.02) / 0.2)));
    --nodes: min(1, max(0, calc((var(--p) - 0.12) / 0.16)));
    --junction: min(1, max(0, calc((var(--p) - 0.2) / 0.14)));
    --resolve: min(1, max(0, calc((var(--p) - 0.28) / 0.16)));
  }

  /* Secondary infrastructure routes: sky, per the site's colour grammar. */
  .lens-leg {
    fill: none;
    stroke: var(--color-sky);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--leg-draw, var(--draw)));
    opacity: calc(var(--leg-draw, var(--draw)) * 0.44);
  }

  /*
   * The five routes arrive in sequence rather than together. Each leg gets its own slice of the
   * draw window, so the eye follows them in instead of watching a fan appear at once - the same
   * reason a diagram is drawn one line at a time when someone is explaining it to you.
   */
  .lens-leg:nth-child(1) { --leg-draw: min(1, max(0, calc((var(--p) - 0.02) / 0.14))); }
  .lens-leg:nth-child(2) { --leg-draw: min(1, max(0, calc((var(--p) - 0.05) / 0.14))); }
  .lens-leg:nth-child(3) { --leg-draw: min(1, max(0, calc((var(--p) - 0.08) / 0.14))); }
  .lens-leg:nth-child(4) { --leg-draw: min(1, max(0, calc((var(--p) - 0.11) / 0.14))); }
  .lens-leg:nth-child(5) { --leg-draw: min(1, max(0, calc((var(--p) - 0.14) / 0.14))); }

  .lens-node {
    fill: var(--color-sky);
    opacity: calc(var(--nodes) * 0.55);
  }

  /*
   * The junction is the only cobalt in the hero backdrop: it is the coordination decision, and
   * it is the crossbar of the InfraHub mark at page scale. The halo keeps it from reading as a
   * flat UI chip sitting on a photograph - it is a place in the room, not a control.
   */
  .lens-halo {
    opacity: calc(var(--junction) * 0.85);
  }

  .lens-junction {
    fill: var(--color-cobalt);
    opacity: calc(var(--junction) * 0.9);
    transform-box: fill-box;
    transform-origin: center;
    transform: scaleX(calc(0.34 + var(--junction) * 0.66));
  }

  /*
   * The resolved route: cobalt at the junction, mineral through the frame, dissolving at the
   * bottom edge. It must not stop with a visible cap - it is meant to read as continuing into
   * the partner band and the chapters after it.
   */
  .lens-resolved {
    fill: none;
    stroke: url(#lensResolvedFade);
    stroke-width: 2.25;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--resolve));
    opacity: var(--resolve);
  }

  .hero-container {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    transform: translateY(calc(var(--hero-progress, 0) * -28px));
    opacity: calc(max(0, 1 - var(--hero-progress, 0) * 1.5));
    will-change: transform, opacity;
  }

  .hero-content {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-kicker {
    margin-bottom: -10px;
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    color: var(--color-sky);
  }

  .hero-title {
    font-size: clamp(2.6rem, 5.2vw, 4.2rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: #ffffff;
    margin: 0;
  }

  .hero-mask {
    display: block;
    overflow: hidden;
  }

  /*
   * The hierarchy is legible from first paint, then settles quickly. Earlier 380–840ms
   * delays left the value proposition absent from real first-frame captures.
   */
  .hero-line {
    display: block;
    transform: translateY(18%);
    opacity: 0.72;
    animation: heroLineReveal 420ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-line-1 {
    animation-delay: 40ms;
  }

  /* The second line is quieter than the first, not disabled. */
  .hero-line-2 {
    color: #e8ecea;
    animation-delay: 100ms;
  }

  @keyframes heroLineReveal {
    0% {
      transform: translateY(18%);
      opacity: 0.72;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-description {
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    line-height: 1.65;
    color: #d4dade;
    /*
     * 700px ran to about 95 characters a line, and it pushed the last words of each line out
     * past the middle of the frame where the scrim has already opened up — one specular
     * highlight on a rack edge landed behind live glyphs at 2.7:1. A shorter measure keeps
     * the copy inside the zone that is actually lit for it, and reads better besides.
     */
    max-width: 620px;
    opacity: 0.72;
    transform: translateY(8px);
    animation: heroFadeUp 420ms cubic-bezier(0.22, 1, 0.36, 1) 140ms forwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 32px;
    margin-top: 16px;
    opacity: 0.72;
    transform: translateY(8px);
    animation: heroFadeUp 380ms cubic-bezier(0.22, 1, 0.36, 1) 200ms forwards;
  }

  @keyframes heroFadeUp {
    0% {
      opacity: 0.72;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /*
   * A deeper cobalt than the shared button token, because this one sits on a photograph
   * rather than on paper. No glow, gradient, or hover lift, so it stays anchored to the
   * facility composition.
   */
  .hero-primary-action {
    background-color: #2450bd;
    padding: 15px 26px;
    border-radius: 4px;
    font-size: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    transition: background-color 180ms cubic-bezier(0.22, 1, 0.36, 1),
                border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-primary-action:hover {
    background-color: #2d5cd6;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .hero-primary-action:active {
    transform: scale(0.99);
  }

  /* The secondary action stays a text action; the route continues under it on hover. */
  .hero-text-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(232, 236, 234, 0.85);
    font-size: 1.02rem;
    font-weight: 600;
    padding: 8px 0;
    border-bottom: 1px solid transparent;
    transition: color 180ms cubic-bezier(0.22, 1, 0.36, 1), border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-text-action:hover {
    color: #ffffff;
    border-bottom-color: rgba(255, 255, 255, 0.55);
  }
  .action-arrow {
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    display: inline-block;
  }
  .hero-text-action:hover .action-arrow {
    transform: translateX(4px);
  }

  /*
   * The shelf wrapper only positions the gradient that lands the photograph onto the
   * partner ribbon. It keeps .hero-routing-exit so the reduced-motion override below
   * still has a target.
   */
  .hero-base-shelf {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 380px;
    pointer-events: none;
    z-index: 8;
  }

  .hero-bottom-shelf {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48px;
    background: linear-gradient(180deg, rgba(7, 12, 20, 0) 0%, rgba(7, 12, 20, 0.4) 60%, rgba(7, 12, 20, 0.72) 100%);
    pointer-events: none;
    z-index: 3;
  }

  /*
   * Mobile is a different photograph. The crop is horizontal here, so object-position picks
   * which part of the room is on screen; dead centre is the dark vanishing point, which is
   * the least legible part of the frame at 390px. The scrim is a top-to-bottom/left-to-right
   * hybrid rather than the desktop 90deg gradient, which would leave the copy on open image.
   */
  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
      max-height: none;
      padding: 88px 0 64px;
    }
    .hero-bg-img {
      /*
       * 36% of the frame is on screen at 390px. Centre lands on the aisle's vanishing point,
       * which is the darkest and least legible part of the room; 86% lands on the right-hand
       * rack wall, where there is equipment, cabling and an aisle sign to actually see.
       */
      object-position: 86% 44%;
    }
    .hero-scrim {
      background:
        linear-gradient(
          180deg,
          rgba(7, 12, 20, 0.66) 0%,
          rgba(7, 12, 20, 0.5) 34%,
          rgba(7, 12, 20, 0.26) 68%,
          rgba(7, 12, 20, 0.58) 100%
        ),
        linear-gradient(
          90deg,
          rgba(7, 12, 20, 0.34) 0%,
          rgba(7, 12, 20, 0.1) 62%,
          rgba(7, 12, 20, 0) 100%
        );
    }
    .hero-light-field {
      background: radial-gradient(
        ellipse at 62% 40%,
        rgba(67, 112, 160, 0.12) 0%,
        rgba(40, 84, 199, 0.04) 30%,
        transparent 60%
      );
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }

    /*
     * The mobile hero is a different crop of a different photograph, and it is short: there is
     * not enough scroll travel here to earn a four-stage reveal, and the 86% crop already puts
     * the rack wall behind the copy. The lens keeps the one thing worth carrying - routes
     * converging into a junction and leaving as one - and drops the detail that would only add
     * noise at 390px. It is quieter, and it resolves earlier so it is not still assembling as
     * the section leaves.
     */
    .hero-lens {
      --draw: min(1, max(0, calc((var(--p) - 0.02) / 0.16)));
      --junction: min(1, max(0, calc((var(--p) - 0.14) / 0.14)));
      --resolve: min(1, max(0, calc((var(--p) - 0.24) / 0.16)));
    }
    .lens-nodes {
      display: none;
    }
    /* Five converging routes is detail at 1440px and clutter at 390px. Two carry the idea. */
    .lens-leg:nth-child(2),
    .lens-leg:nth-child(3),
    .lens-leg:nth-child(4) {
      display: none;
    }
    /* Re-stated so the two survivors follow the compressed mobile window, not the desktop one. */
    .lens-leg:nth-child(1) { --leg-draw: min(1, max(0, calc((var(--p) - 0.02) / 0.14))); }
    .lens-leg:nth-child(5) { --leg-draw: min(1, max(0, calc((var(--p) - 0.06) / 0.14))); }
    .lens-leg {
      opacity: calc(var(--leg-draw, var(--draw)) * 0.32);
    }
    .lens-resolved {
      opacity: calc(var(--resolve) * 0.55);
    }
  }

  /*
   * Reduced motion gets the finished composition immediately, at the same exposure. It must
   * not be handed a darker or otherwise inferior hero as the price of holding still.
   */
  @media (prefers-reduced-motion: reduce) {
    .hero-bg-img {
      animation: none;
      filter: brightness(0.92) contrast(1.06) saturate(0.92);
      transform: none;
    }
    .hero-camera,
    .hero-pointer {
      transform: none;
      transition: none;
      will-change: auto;
    }
    .hero-line,
    .hero-description,
    .hero-actions,
    .hero-routing-exit {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
    .hero-container {
      transform: none;
      opacity: 1;
      will-change: auto;
    }

    /*
     * Reduced motion is a first-class version of this scene, not the absence of it.
     *
     * initHeroScroll() returns early when reduced motion is requested, so --hero-progress is
     * never written and every stage gate above would evaluate against 0 - the lens would simply
     * not exist for these visitors. The stages are pinned to their resolved values instead, so
     * the finished architecture is present immediately and statically: routes drawn, junction
     * coordinated, one route leaving the frame. Same story, no movement.
     */
    .hero-lens {
      --draw: 1;
      --nodes: 1;
      --junction: 1;
      --resolve: 1;
    }
    /*
     * The staggered per-leg gates compute from --p directly, so pinning --draw above does not
     * reach them: without this the five routes stay invisible and reduced-motion visitors get a
     * junction floating with nothing arriving at it. Caught by screenshot, not by review.
     *
     * :nth-child(n) is not decoration. A media query adds no specificity, so a bare .lens-leg
     * here (0,1,0) loses to the .lens-leg:nth-child(1..5) gates above (0,2,0) and the override
     * silently does nothing - which is exactly what the first attempt at this fix did.
     */
    .lens-leg:nth-child(n) {
      --leg-draw: 1;
    }
    .lens-junction {
      transform: none;
    }
  }
</style>

<script>
  import { homepageScheduler } from '../scripts/homepage-scheduler';

  /**
   * The hero writes one number. Everything the scroll drives — camera push, content exit,
   * the exit exposure, the route extending, the partner surface rising — is expressed in CSS
   * against --hero-progress. The previous version mutated four inline styles directly, one of
   * which set scrim opacity above 1 (meaningless, and it darkened the photograph precisely
   * where the point is to keep it visible).
   */
  function initHeroScroll() {
    const heroSection = document.getElementById('hero');
    if (!heroSection) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const heroProgress = () => {
      const heroHeight = heroSection.offsetHeight || 1;
      return Math.min(Math.max(window.scrollY / heroHeight, 0), 1);
    };

    const scheduler = homepageScheduler();
    scheduler.registerProgressSource('hero', heroProgress);
    scheduler.onFrame((frame) => {
      if (frame.reducedMotion) return;
      heroSection.style.setProperty('--hero-progress', heroProgress().toFixed(4));
    });
  }

  /**
   * A few pixels of crop response to the pointer, so the frame feels like a window onto a
   * room rather than a flat plate. Finishing detail only: ±3px horizontal, ±2px vertical,
   * and never on touch, coarse pointers, narrow viewports or reduced motion.
   */
  function initHeroPointerDepth() {
    const heroSection = document.getElementById('hero');
    if (!heroSection) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1024px)').matches) return;

    let ticking = false;
    let pointerX = 0;
    let pointerY = 0;

    const write = () => {
      heroSection.style.setProperty('--hero-pointer-x', `${pointerX.toFixed(2)}px`);
      heroSection.style.setProperty('--hero-pointer-y', `${pointerY.toFixed(2)}px`);
      ticking = false;
    };

    heroSection.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        const rect = heroSection.getBoundingClientRect();
        pointerX = ((event.clientX - rect.left) / rect.width - 0.5) * -6;
        pointerY = ((event.clientY - rect.top) / rect.height - 0.5) * -4;
        if (!ticking) {
          window.requestAnimationFrame(write);
          ticking = true;
        }
      },
      { passive: true }
    );

    heroSection.addEventListener(
      'pointerleave',
      () => {
        pointerX = 0;
        pointerY = 0;
        write();
      },
      { passive: true }
    );
  }

  function initHero() {
    initHeroScroll();
    initHeroPointerDepth();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHero);
  } else {
    initHero();
  }
</script>
